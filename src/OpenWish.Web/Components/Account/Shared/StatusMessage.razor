@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var isError = DisplayMessage.StartsWith("Error", StringComparison.Ordinal);
    var hasErrorPrefix = DisplayMessage.StartsWith("Error:", StringComparison.Ordinal);
    var visibleMessage = hasErrorPrefix ? DisplayMessage["Error:".Length..].TrimStart() : DisplayMessage;
    <div class="alert alert-@(isError ? "danger" : "success") auth-status" role="alert">
        <OpenWishIcon Name="@(isError ? "exclamation-circle" : "check-circle")" />
        <span>
            @if (hasErrorPrefix)
            {
                <span class="visually-hidden">Error: </span>
            }
            <span>@visibleMessage</span>
        </span>
    </div>
}

@code {
    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
