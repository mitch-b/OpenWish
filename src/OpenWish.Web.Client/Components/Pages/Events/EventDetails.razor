@page "/events/{EventId}"
@attribute [Authorize]

@using OpenWish.Shared.Services
@using OpenWish.Web.Client.Components.Event
@using System.Collections.Generic
@using System.Linq
@using OpenWish.Shared.Models

@inject IEventService EventService
@inject IUserContextService UserContextService
@inject NavigationManager NavigationManager
@inject ILogger<EventDetails> Logger

@rendermode InteractiveAuto

<PageTitle>@(_event?.Name ?? "Event Details")</PageTitle>

@if (_isLoading && _event == null)
{
    <div class="event-page" aria-busy="true">
        <div class="event-header event-header-loading" role="status">
            <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
            <span>Loading event...</span>
        </div>
    </div>
}
else if (_event == null)
{
    <div class="event-page" aria-busy="@(_isLoading ? "true" : "false")">
        <PageHeader Title="Event unavailable"
                    Description="We couldn't load this event. It may have been removed, or you may no longer have access." />
        @if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <div class="alert alert-danger" role="alert">@_loadError</div>
        }
        <div class="event-unavailable-actions">
            @if (!_isUnavailable)
            {
                <button class="btn btn-primary" type="button" disabled="@_isLoading" @onclick="RetryLoadAsync">
                    @(_isLoading ? "Retrying..." : "Try again")
                </button>
            }
            <a class="btn @(_isUnavailable ? "btn-primary" : "btn-outline-secondary")" href="/events">Back to events</a>
        </div>
    </div>
}
else
{
    var isPast = EventCountdown.IsPast(_event.Date, DateTimeOffset.UtcNow);
    var tags = (_event.Tags ?? []).Where(tag => !string.IsNullOrWhiteSpace(tag)).Select(tag => tag.Trim()).ToList();
    <div class="event-page" aria-busy="@(_isLoading ? "true" : "false")">
    <header class="event-header" data-testid="event-header">
        <div class="event-header-copy">
            <p class="event-kind">
                <OpenWishIcon Name="@(_event.IsGiftExchange ? "gift" : "calendar-event")" />
                <span>@EventTypeLabel</span>
            </p>
            <h1>@_event.Name</h1>
            <ul class="event-meta" aria-label="Event summary">
                <li class="event-when" data-testid="event-countdown">
                    <OpenWishIcon Name="calendar-event" />
                    <span>@_event.Date.ToString("dddd, MMM d, yyyy")</span>
                    <strong class="event-countdown-badge @(isPast ? "is-past" : null)">@EventCountdown.Badge(_event.Date, DateTimeOffset.UtcNow)</strong>
                </li>
                @if (_event.Budget is { } budget)
                {
                    <li data-testid="event-header-budget">
                        <OpenWishIcon Name="cash" />
                        <span><strong>@budget.ToString("C")</strong> budget</span>
                    </li>
                }
                @if (!_isOwner)
                {
                    <li>
                        <OpenWishIcon Name="person-circle" />
                        <span>Hosted by <strong>@GetOwnerDisplayName()</strong></span>
                    </li>
                }
            </ul>
            @if (!string.IsNullOrWhiteSpace(_event.Description))
            {
                <p class="event-description">@_event.Description</p>
            }
            @if (tags.Count > 0)
            {
                <ul class="event-tags" aria-label="Tags">
                    @foreach (var tag in tags)
                    {
                        <li class="event-tag">@tag</li>
                    }
                </ul>
            }
        </div>
        @if (_isOwner || (!_isPendingInvitee && !isPast))
        {
            <div class="event-header-actions">
                @if (!_isPendingInvitee && !isPast)
                {
                    <a href="/api/events/@EventId/calendar.ics" class="btn btn-outline-secondary event-manage-action" data-testid="add-to-calendar" download>
                        <OpenWishIcon Name="download" /> Add to calendar
                    </a>
                }
                @if (_isOwner)
                {
                    <a href="/events/@EventId/manage" class="btn btn-outline-secondary event-manage-action">
                        <OpenWishIcon Name="gear" /> Manage event
                    </a>
                }
            </div>
        }
    </header>

    <div class="event-body">
        @if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <div class="alert alert-danger" role="alert">
                @_loadError
                <button class="btn btn-outline-danger d-block mt-2"
                        type="button"
                        disabled="@_isLoading"
                        @onclick="RetryLoadAsync">
                    @(_isLoading ? "Retrying..." : "Try again")
                </button>
            </div>
        }

        @if (Rerun == 1 && _isOwner)
        {
            <div class="alert alert-success" role="status" data-testid="rerun-success">
                Your new event is ready. Everyone from the last one has a pending invitation, and nothing has been drawn yet.
            </div>
        }

        @if (!_isPendingInvitee)
        {
        <PageSections Label="Event sections" Items="Sections" Active="@ActiveSection">
        @if (_event.IsGiftExchange && _isOwner && !_event.NamesDrawnOn.HasValue)
        {
        <div class="page-section-panel" hidden="@(ActiveSection != "setup")">
            @if (_event.AvoidsPreviousPairings)
            {
                <p class="alert alert-info" role="status" data-testid="avoid-last-year">
                    <strong>Fresh pairings.</strong>
                    When you draw names, OpenWish avoids repeating last time's matches whenever the group allows it.
                </p>
            }
            <div id="gift-exchange-setup">
                <SecretSantaSetup Event="@_event" CurrentUserId="@(_currentUserId ?? string.Empty)" WishlistsLoaded="@_wishlistsLoaded"
                                  OnInviteRequested="FocusInvitationComposer" />
            </div>
        </div>
        }

        <div class="page-section-panel" id="event-wishlists" hidden="@(ActiveSection != "event-wishlists")">
        @if (_isAcceptedParticipant && !_isOwner && !_event.NamesDrawnOn.HasValue)
        {
            @if (!_wishlistsLoaded)
            {
                <p role="status">Checking your shared gift ideas...</p>
            }
            else if (HasSharedGiftIdeas)
            {
                <div class="alert alert-success" role="status" data-testid="participant-wishlist-shared">
                    <strong>Your wishlist is shared with this event.</strong>
                    Everyone can see it below@(_event.IsGiftExchange ? ", and the organizer can draw names whenever the group is ready." : ".")
                </div>
            }
            else
            {
                <div class="alert alert-info d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" role="status" data-testid="participant-add-wishlist">
                    <div>
                        <strong>@(_event.IsGiftExchange ? "You're in this gift exchange." : "You're in this event.")</strong>
                        Add a few gift ideas now@(_event.IsGiftExchange ? ", then you can leave the rest to the organizer." : " so friends know what to get.")
                    </div>
                    @if (MySharedWishlist is { } wishlist)
                    {
                        <a class="btn btn-primary" href="/wishlists/@wishlist.PublicId/items/new">Add gift ideas</a>
                    }
                    else
                    {
                        <a class="btn btn-primary" href="@WishlistFormLink">Add my wishlist</a>
                    }
                </div>
            }
        }

        else if (_isAcceptedParticipant && !_isOwner && _event.IsGiftExchange && _wishlistsLoaded && !HasSharedGiftIdeas)
        {
            <div class="alert alert-info d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" role="status" data-testid="participant-add-wishlist-after-draw">
                <div>
                    <strong>Help your gift giver choose something you'll love.</strong>
                    Add a few gift ideas so they know what you'd love.
                </div>
                @if (MySharedWishlist is { } wishlist)
                {
                    <a class="btn btn-primary" href="/wishlists/@wishlist.PublicId/items/new">Add gift ideas</a>
                }
                else
                {
                    <a class="btn btn-primary" href="@WishlistFormLink">Add my wishlist</a>
                }
            </div>
        }

            <div id="event-wishlists-form">
            <EventWishlistManager EventId="@EventId"
                                   Event="@_event"
                                   CurrentUserId="@_currentUserId"
                                   OnWishlistsChanged="HandleWishlistsChanged" />
            </div>
        </div>

        @if (_event.IsGiftExchange && _event.NamesDrawnOn.HasValue)
        {
            <div class="page-section-panel" hidden="@(ActiveSection != "match")">
                    <GiftExchangeDisplay @key="_event.NamesDrawnOn" EventId="@EventId"
                                         UseGiftBoxReveal="@(_event.UseGiftBoxReveal == true)"
                                         CurrentUserId="@_currentUserId"
                                         ExchangeDate="@_event.Date"
                                         WishlistsLoaded="@_wishlistsLoaded"
                                         OnMatchBudgetResolved="HandleMatchBudgetResolved"
                                         EventWishlists="@_event.EventWishlists" />
                    <ExchangeReveal EventId="@EventId"
                                    CurrentUserId="@(_currentUserId ?? string.Empty)"
                                    EventDate="@_event.Date"
                                    IsOwner="@_isOwner"
                                    RevealedOn="@_event.AssignmentsRevealedOn"
                                    OnRevealed="HandleNamesDrawn" />
            </div>
        }

                <div class="page-section-panel" hidden="@(ActiveSection != "overview")">
                        <h2 class="h5 mb-3">Event overview</h2>
                        <div class="event-facts">
                            <div class="event-fact">
                                <span class="event-fact-label">Date and time</span>
                                <strong>@_event.Date.ToString("ddd, MMM d, yyyy 'at' h:mm tt")</strong>
                            </div>
                            <div class="event-fact">
                                <span class="event-fact-label">Budget</span>
                                <strong>@(_event.Budget?.ToString("C") ?? "No budget set")</strong>
                            </div>
                            <div class="event-fact">
                                <span class="event-fact-label">Hosted by</span>
                                <strong>@GetOwnerDisplayName()</strong>
                            </div>
                            <div class="event-fact">
                                <span class="event-fact-label">Event type</span>
                                <strong>@EventTypeLabel</strong>
                            </div>
                            @if (_isOwner && !string.IsNullOrEmpty(_event.CopiedFromEventPublicId))
                            {
                                <div class="event-fact" data-testid="copied-from">
                                    <span class="event-fact-label">Copied from</span>
                                    <strong><a href="/events/@_event.CopiedFromEventPublicId">@_event.CopiedFromEventName</a></strong>
                                </div>
                            }
                            @if (_event.IsRecurring)
                            {
                                <div class="event-fact">
                                    <span class="event-fact-label">Schedule</span>
                                    <strong>Recurring event</strong>
                                </div>
                            }
                        </div>

                        @{
                            var participants = GetParticipantList().ToList();
                            var hasOwner = _event.CreatedBy != null;
                            var participantCount = participants.Count + (hasOwner ? 1 : 0);
                        }
                        <div class="section-heading">
                            <h3 class="h5 mb-0">People</h3>
                            <span>@participantCount total</span>
                        </div>
                        <div class="participant-grid">
                            @if (!hasOwner && participants.Count == 0)
                            {
                                <p class="participant-empty">No participants yet.</p>
                            }
                            else if (hasOwner)
                            {
                                <div class="participant-card">
                                    <strong>@GetOwnerDisplayName()</strong>
                                    @if (GetOwnerContactDetail() is { } ownerContact)
                                    {
                                        <span class="participant-contact">@ownerContact</span>
                                    }
                                    <span class="participant-status">Organizer</span>
                                </div>
                            }

                            @foreach (var participant in participants)
                            {
                                <div class="participant-card">
                                    <strong>@GetParticipantDisplayName(participant)</strong>
                                    @if (GetParticipantContactDetail(participant) is { } contact)
                                    {
                                        <span class="participant-contact">@contact</span>
                                    }
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="participant-status">@participant.Role</span>
                                        <span class="participant-status @GetStatusClass(participant)">@GetNormalizedStatus(participant)</span>
                                    </div>
                                </div>
                            }
                        </div>
                </div>

                @if (_event.IsGiftExchange && _isOwner)
                {
                    <div class="page-section-panel" id="gift-exchange" hidden="@(ActiveSection != "gift-exchange")">
                        <GiftExchangeManager Event="@_event"
                                             CurrentUserId="@_currentUserId"
                                             OnNamesDrawn="HandleNamesDrawn" />
                    </div>
                }

                @if (_isOwner)
                {
                    @InvitationsSection
                }

                @if (_isOwner && HasEventElapsed)
                {
                    <div class="page-section-panel" hidden="@(ActiveSection != "run-again")">
                        @RunAgainPanel
                    </div>
                }

                <div class="page-section-panel" hidden="@(ActiveSection != "reserved")">
                    <EventReservedItems EventId="@EventId"
                                         CurrentUserId="@_currentUserId"
                                         Budget="@_matchBudget" />
                </div>

        </PageSections>
        }
        else
        {
            <section class="event-invite-callout" aria-labelledby="event-invite-title">
                <OpenWishIcon Name="envelope" Class="event-invite-icon" />
                <div class="event-invite-copy">
                    <h2 class="h5" id="event-invite-title">Accept your invitation to join</h2>
                    <p>Accept before the organizer draws names so you can be included and add gift ideas for your match.</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(PendingInvitationEmail))
                {
                    <a class="btn btn-primary" href="@PendingInvitationLink">Review invitation</a>
                }
                else
                {
                    <a class="btn btn-primary" href="/events">Open my invitations</a>
                }
            </section>
        }
    </div>
    </div>
}

@code {
    [Parameter] public string EventId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "rerun")] public int? Rerun { get; set; }
    [SupplyParameterFromQuery(Name = "section")] public string? Section { get; set; }
    private string WishlistFormLink =>
        $"{NavigationManager.GetUriWithQueryParameters(NavigationManager.Uri.Split('#')[0],
            new Dictionary<string, object?> { ["section"] = "event-wishlists" })}#event-wishlists-form";

    private string? RequestedSection => Section ?? new Uri(NavigationManager.Uri).Fragment.TrimStart('#');
    private string ActiveSection => Sections.FirstOrDefault(item => item.Id == RequestedSection)?.Id ?? Sections[0].Id;

    private IReadOnlyList<PageSection> Sections =>
    [
        .. (_event?.IsGiftExchange == true && _event.NamesDrawnOn.HasValue
            ? new PageSection[] { new("match", "My match", "gift") } : []),
        .. (_event?.IsGiftExchange == true && _isOwner && !_event.NamesDrawnOn.HasValue
            ? new PageSection[] { new("setup", "Exchange setup", "clipboard") } : []),
        .. (_isOwner ? new PageSection[] { new("event-invitations", "Invitations", "envelope") } : []),
        new("event-wishlists", "Wishlists", "list-ul"),
        new("overview", "Event details", "calendar-event"),
        new("reserved", "My reservations", "box-seam"),
        .. (_event?.IsGiftExchange == true && _isOwner
            ? new PageSection[] { new("gift-exchange", "Manage draw", "gear") } : []),
        .. (_isOwner && HasEventElapsed
            ? new PageSection[] { new("run-again", "Run again", "arrow-clockwise") } : []),
    ];
    private EventModel? _event;
    private string? _currentUserId;
    private bool _isOwner;
    private bool _isAcceptedParticipant;
    private bool _isPendingInvitee;
    private bool _wishlistsLoaded;
    private decimal? _matchBudget; // The budget the match panel shops within, so both panels agree
    private EventUserModel? _pendingInvitation;
    private string? _loadedEventId;
    private string? _loadError;
    private bool _isUnavailable; // Removed or not shared with this user; retrying won't help
    private bool _isLoading = true;
    private int _loadVersion;

    private string EventTypeLabel => _event?.IsGiftExchange == true
        ? string.Equals(_event.GiftExchangeStyle, "SecretSanta", StringComparison.Ordinal)
            ? "Gift exchange · Secret Santa style"
            : "Gift exchange"
        : "Celebration";

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = await UserContextService.GetUserIdAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedEventId, EventId, StringComparison.Ordinal))
        {
            return;
        }

        _loadedEventId = EventId;
        _event = null;
        _wishlistsLoaded = false;
        _loadError = null;
        _isLoading = true;
        await LoadEvent();
    }

    private async Task<bool> LoadEvent()
    {
        var eventId = EventId;
        var loadVersion = ++_loadVersion;
        _isLoading = true;
        _loadError = null;
        _isUnavailable = false;

        try
        {
            if (string.IsNullOrWhiteSpace(_currentUserId))
            {
                throw new InvalidOperationException("The current user could not be determined.");
            }

            var loadedEvent = await EventService.GetEventByPublicIdAsync(eventId, _currentUserId);
            var isOwner = loadedEvent?.CreatedBy?.Id == _currentUserId;
            var isAcceptedParticipant = isOwner ||
                (loadedEvent?.EventUsers?.Any(participant =>
                    !participant.Deleted &&
                    participant.IsAccepted &&
                    string.Equals(participant.Status, "Accepted", StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(participant.UserId, _currentUserId, StringComparison.Ordinal)) ?? false);
            var isPendingInvitee = !isOwner && !isAcceptedParticipant;
            EventUserModel? pendingInvitation = null;

            if (isPendingInvitee)
            {
                var invitations = await EventService.GetPendingInvitationsForUserAsync(_currentUserId);
                pendingInvitation = invitations.FirstOrDefault(invitation =>
                    string.Equals(invitation.Event?.PublicId, eventId, StringComparison.Ordinal));
            }

            if (loadVersion != _loadVersion || !string.Equals(EventId, eventId, StringComparison.Ordinal))
            {
                return false;
            }

            if (_wishlistsLoaded && loadedEvent is not null && _event?.EventWishlists is { } hydratedWishlists)
            {
                // The event payload carries list metadata only; keep the item-loaded lists from EventWishlistManager.
                loadedEvent.EventWishlists = hydratedWishlists;
            }

            _event = loadedEvent;
            _isOwner = isOwner;
            _isAcceptedParticipant = isAcceptedParticipant;
            _isPendingInvitee = isPendingInvitee;
            _pendingInvitation = pendingInvitation;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load event {EventId}", eventId);
            if (loadVersion == _loadVersion && string.Equals(EventId, eventId, StringComparison.Ordinal))
            {
                _isUnavailable = _event is null && IsUnavailable(ex);
                _loadError = _isUnavailable ? null : "We couldn't load this event. Check your connection and try again.";
            }
            return false;
        }
        finally
        {
            if (loadVersion == _loadVersion)
            {
                _isLoading = false;
            }
        }
    }

    private static bool IsUnavailable(Exception ex) => ex is KeyNotFoundException or UnauthorizedAccessException ||
        ex is HttpRequestException { StatusCode: System.Net.HttpStatusCode.NotFound or System.Net.HttpStatusCode.Forbidden };

    private async Task RetryLoadAsync()
    {
        if (_isLoading)
        {
            return;
        }

        await LoadEvent();
    }

    private WishlistModel? MySharedWishlist =>
        _event?.EventWishlists?
            .Where(wishlist => string.Equals(wishlist.OwnerId, _currentUserId, StringComparison.Ordinal))
            .OrderByDescending(EventGiftIdeas.Count)
            .FirstOrDefault();

    private bool HasSharedGiftIdeas =>
        MySharedWishlist is { } wishlist && EventGiftIdeas.Count(wishlist) > 0;

    private string PendingInvitationLink =>
        $"/events/{EventId}/accept-invite?email={Uri.EscapeDataString(PendingInvitationEmail!)}";

    private string? PendingInvitationEmail =>
        _pendingInvitation?.InviteeEmail ?? _pendingInvitation?.User?.Email;

    private IEnumerable<EventUserModel> GetParticipantList() =>
        _event?.EventUsers?
            .Where(eu => !IsOwner(eu))
            .OrderBy(eu => GetStatusSortOrder(eu))
            .ThenBy(eu => GetParticipantDisplayName(eu), StringComparer.OrdinalIgnoreCase)
        ?? Enumerable.Empty<EventUserModel>();

    private bool IsOwner(EventUserModel eventUser) =>
        !string.IsNullOrWhiteSpace(_event?.CreatedBy?.Id) &&
        string.Equals(eventUser.User?.Id, _event!.CreatedBy!.Id, StringComparison.Ordinal);

    private static int GetStatusSortOrder(EventUserModel eventUser) => GetNormalizedStatus(eventUser) switch
    {
        "Accepted" => 0,
        "Pending" => 1,
        "Rejected" => 2,
        _ => 3
    };

    private static string GetStatusClass(EventUserModel eventUser) => GetNormalizedStatus(eventUser) switch
    {
        "Accepted" => "participant-status-success",
        "Pending" => "participant-status-warning",
        "Rejected" => "participant-status-danger",
        _ => string.Empty
    };

    private static string GetParticipantDisplayName(EventUserModel eventUser)
    {
        if (!string.IsNullOrWhiteSpace(eventUser.User?.UserName))
        {
            return eventUser.User.UserName!;
        }

        if (!string.IsNullOrWhiteSpace(eventUser.InviteeEmail))
        {
            return eventUser.InviteeEmail!;
        }

        return "Pending Invitation";
    }

    private static string? GetParticipantContactDetail(EventUserModel eventUser)
    {
        if (!string.IsNullOrWhiteSpace(eventUser.User?.Email))
        {
            var email = eventUser.User.Email!;
            return string.Equals(email, GetParticipantDisplayName(eventUser), StringComparison.OrdinalIgnoreCase)
                ? null
                : email;
        }

        return string.Equals(eventUser.InviteeEmail, GetParticipantDisplayName(eventUser), StringComparison.OrdinalIgnoreCase)
            ? null
            : eventUser.InviteeEmail;
    }

    private string GetOwnerDisplayName()
    {
        if (!string.IsNullOrWhiteSpace(_event?.CreatedBy?.UserName))
        {
            return _event!.CreatedBy!.UserName!;
        }

        if (!string.IsNullOrWhiteSpace(_event?.CreatedBy?.Email))
        {
            return _event!.CreatedBy!.Email!;
        }

        return "Event Owner";
    }

    private string? GetOwnerContactDetail()
    {
        var email = _event?.CreatedBy?.Email;
        return string.IsNullOrWhiteSpace(email) ||
               string.Equals(email, GetOwnerDisplayName(), StringComparison.OrdinalIgnoreCase)
            ? null
            : email;
    }

    private static string GetNormalizedStatus(EventUserModel eventUser)
    {
        if (!string.IsNullOrWhiteSpace(eventUser.Status))
        {
            return eventUser.Status;
        }

        return eventUser.IsAccepted ? "Accepted" : "Pending";
    }

    private Task HandleWishlistsChanged(IReadOnlyList<WishlistModel> wishlists)
    {
        if (_event != null)
        {
            _event.EventWishlists = wishlists.ToList();
            _wishlistsLoaded = true;
        }

        return Task.CompletedTask;
    }

    private void HandleMatchBudgetResolved(decimal? budget) => _matchBudget = budget;

    private async Task HandleNamesDrawn()
    {
        await LoadEvent();
    }

    private EventInvitations? _eventInvitations;

    private bool HasEventElapsed => _event is not null && EventCountdown.IsPast(_event.Date, DateTimeOffset.UtcNow);

    private RenderFragment InvitationsSection => __builder =>
    {
        <div class="page-section-panel" id="event-invitations" hidden="@(ActiveSection != "event-invitations")">
            <EventInvitations @ref="_eventInvitations"
                              EventId="@EventId"
                              IsOwner="true"
                              AllowGuests="@(_event!.AllowGuestParticipants == true && _event.IsGiftExchange)"
                              CurrentUserId="@_currentUserId"
                              NamesDrawn="@_event.NamesDrawnOn.HasValue"
                              OnInvitationsChanged="HandleInvitationsChanged" />
        </div>
    };

    private RenderFragment RunAgainPanel => __builder =>
    {
        <RunEventAgain EventId="@EventId"
                       EventName="@_event!.Name"
                       EventDate="@_event.Date"
                       CurrentUserId="@(_currentUserId ?? string.Empty)" />
    };

    private async Task HandleInvitationsChanged()
    {
        await LoadEvent();
    }

    private bool _focusInvitationComposer;

    private void FocusInvitationComposer()
    {
        _focusInvitationComposer = true;
        NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("section", "event-invitations"));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusInvitationComposer && ActiveSection == "event-invitations" && _eventInvitations is not null)
        {
            _focusInvitationComposer = false;
            await _eventInvitations.FocusComposerAsync();
        }
    }
}