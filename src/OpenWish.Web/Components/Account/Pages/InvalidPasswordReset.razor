@page "/Account/InvalidPasswordReset"

<PageTitle>Reset link not valid</PageTitle>

<div class="auth-page auth-page-compact">
    <header class="auth-heading">
        <span class="auth-mark auth-mark-warning"><OpenWishIcon Name="exclamation-triangle" /></span>
        <div>
            <h1>This reset link doesn't work</h1>
            <p>It may be incomplete, already used, or expired.</p>
        </div>
    </header>
    <section class="auth-card">
        <p class="auth-card-text" role="alert">Request a new link and use the most recent email we send you.</p>
        <div class="auth-actions">
            <a class="btn btn-primary" href="Account/ForgotPassword">Request a new link</a>
            <a class="btn btn-outline-secondary" href="Account/Login">Back to sign in</a>
        </div>
    </section>
</div>
