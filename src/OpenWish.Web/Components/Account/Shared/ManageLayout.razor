@inherits LayoutComponentBase
@layout OpenWish.Web.Components.Layout.MainLayout

<div class="account-page">
    <header class="account-heading">
        <span class="account-mark"><OpenWishIcon Name="person-circle" /></span>
        <div>
            <h1>Account settings</h1>
            <p>Manage your profile, sign-in methods, and personal data.</p>
        </div>
    </header>
    <div class="row g-4">
        <div class="col-lg-3">
            <aside class="account-nav">
                <ManageNavMenu />
            </aside>
        </div>
        <div class="col-lg-9">
            <section class="account-content">
                @Body
            </section>
        </div>
    </div>
</div>
