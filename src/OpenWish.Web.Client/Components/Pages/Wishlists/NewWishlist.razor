@attribute [Authorize]
@page "/wishlists/new"

@using OpenWish.Web.Client.Components.Wishlist

@inject IWishlistService WishlistService
@inject NavigationManager NavigationManager
@inject IUserContextService UserContextService
@inject ILogger<NewWishlist> Logger

@rendermode InteractiveAuto

<PageTitle>Create a wishlist</PageTitle>

<div class="container page-shell">
    <PageHeader Title="Create a wishlist"
                Description="Start with a name and choose who can see your gift ideas.">
        <Actions>
            <a href="/wishlists" class="btn btn-outline-secondary">
                <OpenWishIcon Name="arrow-left" /> Back to wishlists
            </a>
        </Actions>
    </PageHeader>
    <div class="row">
        <div class="col-lg-8">
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }
        <WishlistForm Model="@_wishlist"
                      OnSubmit="@HandleSubmit"
                      OnCancel="@HandleCancel"
                      AutoFocusName="true"
                      IsSubmitting="@_isSubmitting" />
        </div>
    </div>
</div>


@code {
    private readonly WishlistModel? _wishlist = new() { Name = "" };
    private bool _isSubmitting;
    private string? _errorMessage;

    private async Task HandleSubmit(WishlistModel submittedWishlist)
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var userId = await UserContextService.GetUserIdAsync();
            if (userId is null)
            {
                Logger.LogError("Could not determine UserId from new Wishlist page.");
                _errorMessage = "We couldn't confirm your account. Please sign in again.";
                return;
            }

            await WishlistService.CreateWishlistAsync(submittedWishlist, userId);
            NavigationManager.NavigateTo("/wishlists");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create wishlist");
            _errorMessage = "We couldn't create the wishlist. Review the details and try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void HandleCancel()
    {
        NavigationManager.NavigateTo("/wishlists");
    }
}
