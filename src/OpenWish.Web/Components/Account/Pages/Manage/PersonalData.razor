@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Personal data</PageTitle>

<StatusMessage />
<h3>Personal data</h3>

<div class="row">
    <div class="col-xl-7">
        <h4 class="h5">Download your data</h4>
        <p>Get a JSON copy of the personal data stored with your OpenWish account.</p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">
                <OpenWishIcon Name="download" />
                Download personal data
            </button>
        </form>
        <hr class="my-4" />
        <h4 class="h5 text-danger">Delete your account</h4>
        <p>Deleting your account permanently removes your personal data and cannot be undone.</p>
        <a href="Account/Manage/DeletePersonalData" class="btn btn-outline-danger">
            <OpenWishIcon Name="trash3" />
            Review account deletion
        </a>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
