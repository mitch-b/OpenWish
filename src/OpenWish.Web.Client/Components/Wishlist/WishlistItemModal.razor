@using OpenWish.Shared.Products
@implements IAsyncDisposable

@inject IJSRuntime JSRuntime
@inject ILogger<WishlistItemModal> Logger

@if (IsVisible)
{
    <div class="modal-backdrop" data-dialog-background-allowed @onclick="Cancel"></div>
    <div class="modal-dialog-container"
         id="wishlist-item-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="wishlist-item-dialog-title"
         @onclick:stopPropagation="true">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="wishlist-item-dialog-title" class="modal-title">@(Model?.Id > 0 ? "Edit item" : "Add item")</h5>
                <button type="button"
                        class="btn-close"
                        data-dialog-close
                        @onclick="Cancel"
                        aria-label="Close"
                        disabled="@IsBusy"></button>
            </div>
            <div class="modal-body">
                <div class="url-import-section mb-4">
                    <ProductLinkImporter Model="@Model"
                                         InputId="product-url-import-modal"
                                         HelpText="Optional: paste a link or text shared from a shopping app and we'll fill in what we can. Existing details won't be replaced."
                                         Disabled="@_isSubmitting"
                                         @bind-IsImporting="_isImporting"
                                         InitialLink="@_initialImportText"
                                         OnImported="HandleProductImported"
                                         data-dialog-initial-focus="true" />
                </div>

                <EditForm Model="@Model"
                          OnValidSubmit="@HandleSubmit"
                          FormName="WishlistItemModal"
                          id="wishlist-item-form"
                          aria-busy="@_isSubmitting">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    @if (!string.IsNullOrWhiteSpace(_saveError))
                    {
                        <div class="alert alert-danger" role="alert">@_saveError</div>
                    }

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
                                <InputText id="name" class="form-control" @bind-Value="@Model!.Name"
                                           aria-describedby="modal-item-name-help" placeholder="e.g., A travel mug" />
                                <div id="modal-item-name-help" class="form-text">A name is enough to save an idea.</div>
                                <ValidationMessage For="@(() => Model.Name)" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="priority" class="form-label">Priority</label>
                                <InputSelect id="priority" class="form-select" @bind-Value="@Model!.Priority">
                                    <option value="">None</option>
                                    <option value="1">High</option>
                                    <option value="2">Medium</option>
                                    <option value="3">Low</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <InputTextArea id="description" class="form-control" rows="2" @bind-Value="@Model!.Description" placeholder="Color, size, or anything that would help a gift giver" />
                        <ValidationMessage For="@(() => Model.Description)" />
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="price" class="form-label">Estimated price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <InputNumber id="price" class="form-control" inputmode="decimal" min="0" step="0.01" @bind-Value="@Model!.Price" placeholder="0.00" />
                                </div>
                                <ValidationMessage For="@(() => Model.Price)" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="whereToBuy" class="form-label">Where to buy</label>
                                <InputText id="whereToBuy" class="form-control" @bind-Value="@Model!.WhereToBuy" placeholder="e.g., Amazon, Target" />
                                <ValidationMessage For="@(() => Model.WhereToBuy)" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="url" class="form-label">Product Link</label>
                        <InputText id="url" class="form-control" type="url" inputmode="url" autocomplete="url" @bind-Value="@Model!.Url" placeholder="https://..." />
                        <ValidationMessage For="@(() => Model.Url)" />
                    </div>

                    <div class="mb-3 form-check">
                        <InputCheckbox id="isPrivate" class="form-check-input" @bind-Value="@Model!.IsPrivate" />
                        <label class="form-check-label" for="isPrivate">Keep this idea private</label>
                        <div class="form-text">Only you can see private ideas, even on a shared wishlist.</div>
                        <ValidationMessage For="@(() => Model.IsPrivate)" />
                    </div>
                </EditForm>
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-dialog-close
                        @onclick="Cancel"
                        disabled="@IsBusy">Cancel</button>
                <button type="submit" form="wishlist-item-form" class="btn btn-primary" disabled="@IsBusy">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>@(Model?.Id > 0 ? "Saving changes..." : "Adding item...")</span>
                    }
                    else
                    {
                        <OpenWishIcon Name="check-lg" />
                        <span>@(Model?.Id > 0 ? "Save changes" : "Add item")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public WishlistItemModel Model { get; set; } = new();
    [Parameter] public EventCallback<WishlistItemModel> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsVisible { get; set; }

    private bool _isImporting;
    private bool _isSubmitting;
    private string? _initialImportText;
    private string? _saveError;
    private bool _dialogActive;
    private bool IsBusy => _isImporting || _isSubmitting;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && !_dialogActive)
        {
            await JSRuntime.InvokeVoidAsync("openWishActivateDialog", "wishlist-item-dialog");
            _dialogActive = true;
        }
    }

    /// <summary>
    /// Opens the dialog. When <paramref name="importText"/> contains a product link, its details are imported right away.
    /// </summary>
    public void Show(WishlistItemModel? model = null, string? importText = null)
    {
        Model = model ?? new WishlistItemModel();
        _initialImportText = importText;
        _saveError = null;
        if (Model.Id == 0 && string.IsNullOrWhiteSpace(Model.PublicId))
        {
            Model.PublicId = Guid.NewGuid().ToString();
        }
        IsVisible = true;
        StateHasChanged();
    }

    private async Task HideAsync()
    {
        if (_dialogActive)
        {
            await JSRuntime.InvokeVoidAsync("openWishDeactivateDialog", "wishlist-item-dialog");
            _dialogActive = false;
        }

        IsVisible = false;
        _initialImportText = null;
        StateHasChanged();
    }

    private void HandleProductImported(ProductImportResult result)
    {
        if (result.Kind != ProductImportKind.Unavailable && !Model.Priority.HasValue)
        {
            Model.Priority = 2;
        }
    }

    private async Task HandleSubmit()
    {
        if (_isSubmitting || _isImporting || Model is null)
        {
            return;
        }

        _isSubmitting = true;
        _saveError = null;
        StateHasChanged();
        await Task.Yield();

        var saved = false;
        try
        {
            if (!OnSubmit.HasDelegate)
            {
                throw new InvalidOperationException("The item dialog does not have a save handler.");
            }

            await OnSubmit.InvokeAsync(Model);
            saved = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save wishlist item {WishlistItemId}", Model.Id);
            _saveError = Model.Id > 0
                ? "We couldn't save these changes. Review the details and try again."
                : "We couldn't add this item. Review the details and try again.";
        }
        finally
        {
            _isSubmitting = false;
        }

        if (saved)
        {
            await HideAsync();
        }
    }

    private async Task Cancel()
    {
        if (IsBusy)
        {
            return;
        }

        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }

        await HideAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (!_dialogActive)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("openWishDeactivateDialog", "wishlist-item-dialog");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
