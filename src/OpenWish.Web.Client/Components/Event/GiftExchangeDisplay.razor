@using OpenWish.Shared.Models
@using OpenWish.Shared.Services
@using System.Globalization

@inject IEventService EventService
@inject ILogger<GiftExchangeDisplay> Logger

<section class="gift-match" aria-labelledby="gift-match-title" aria-busy="@_loading">
    <h2 id="gift-match-title">Your gift exchange match</h2>

    @if (_loading)
    {
        <div class="gift-match-loading" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Loading your match...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger mb-0" role="alert">
            <p>@_errorMessage</p>
            <button type="button" class="btn btn-outline-danger" disabled="@_loading" @onclick="LoadGiftExchange">
                Try again
            </button>
        </div>
    }
    else if (_giftExchange == null)
    {
        <div class="alert alert-info mb-0" role="status">
            Your assignment isn't available yet. Ask the organizer to check the draw.
        </div>
    }
    else
    {
        @if (NeedsFirstOpen)
        {
            <div class="gift-match-unopened" data-testid="gift-match-unopened" aria-busy="@_opening">
                <div class="gift-match-invitation">
                    <h3>A little surprise, just for you</h3>
                    <p>The names are drawn. Open your gift to see who you're shopping for.</p>
                    <p class="gift-match-privacy"><OpenWishIcon Name="eye-slash" /><span>Only your match is shown here. The rest stays a surprise.</span></p>
                </div>
                <button type="button" class="gift-box-button" disabled="@_opening" @onclick="OpenMatch" aria-describedby="gift-box-help">
                    <GiftBoxArt />
                    <span class="gift-box-label">@(_opening ? "Opening your gift..." : "Open my gift")</span>
                </button>
                <p id="gift-box-help" class="gift-box-help">Tap, click, or press Enter. This is only for your first visit.</p>
                @if (_openError is not null)
                {
                    <div class="alert alert-danger" role="alert">
                        @_openError
                        <button type="button" class="btn btn-outline-danger mt-2" @onclick="LoadGiftExchange">Reload my match</button>
                    </div>
                }
            </div>
        }
        else
        {
        <div class="gift-match-content @(_justOpened ? "gift-match-just-opened" : string.Empty)" data-testid="gift-match-opened">
            @if (_justOpened)
            {
                <p class="visually-hidden" role="status">@($"Your gift is open. You're shopping for {RecipientDisplayName}.")</p>
                <FocusOnFirstRender ElementId="revealed-match-name" />
            }
            <div class="gift-match-introduction">
                <p class="gift-match-label">You're shopping for</p>
                <h3 id="revealed-match-name" class="gift-match-name" tabindex="-1">@RecipientDisplayName</h3>
            </div>

            <dl class="gift-match-facts">
                <div>
                    <dt>Suggested budget</dt>
                    <dd>@(_giftExchange.Budget?.ToString("C") ?? "Not set")</dd>
                </div>
                <div>
                    <dt>Exchange date</dt>
                    <dd>
                        @ExchangeDate.ToString("ddd, MMM d, yyyy")
                        @if (EventCountdown.Describe(ExchangeDate, DateTimeOffset.Now, TimeZoneInfo.Local) is { } countdown)
                        {
                            <span class="text-muted" data-testid="exchange-countdown">· @countdown</span>
                        }
                    </dd>
                </div>
            </dl>

            <div class="gift-match-next-step">
                @if (!WishlistsLoaded)
                {
                    <p role="status">Checking shared gift ideas...</p>
                    <a class="btn btn-outline-primary gift-match-action" href="@($"/events/{EventId}#event-wishlists")">See event wishlists</a>
                }
                else if (_recipientWishlist != null && RecipientItemCount > 0)
                {
                    <p>@($"{RecipientDisplayName} has {RecipientItemCount} gift {(RecipientItemCount == 1 ? "idea" : "ideas")} to explore.")</p>
                    <a href="@RecipientWishlistUrl" class="btn btn-primary gift-match-action">
                        <OpenWishIcon Name="list-check" />
                        <span>@RecipientWishlistActionLabel</span>
                    </a>
                    <p class="gift-match-guidance">Reserve an idea to avoid buying the same gift as someone else.</p>
                }
                else if (_recipientWishlist != null)
                {
                    <p>@($"{RecipientDisplayName} hasn't added gift ideas to their wishlist yet.")</p>
                    <a href="@RecipientWishlistUrl" class="btn btn-outline-primary gift-match-action">
                        @RecipientWishlistActionLabel
                    </a>
                }
                else
                {
                    <p>@($"{RecipientDisplayName} hasn't shared a wishlist for this exchange yet. Check back for gift ideas.")</p>
                }
            </div>

            <p class="gift-match-privacy">
                <OpenWishIcon Name="eye-slash" />
                <span>@($"Your match stays private. {RecipientDisplayName} won't see your reservations.")</span>
            </p>
        </div>
        }
    }
</section>

@code {
    [Parameter] public string EventId { get; set; } = string.Empty;
    [Parameter] public string CurrentUserId { get; set; } = string.Empty;
    [Parameter] public DateTimeOffset ExchangeDate { get; set; }
    [Parameter] public bool WishlistsLoaded { get; set; }
    [Parameter] public bool UseGiftBoxReveal { get; set; }
    [Parameter] public ICollection<WishlistModel>? EventWishlists { get; set; }
    [Parameter] public EventCallback<decimal?> OnMatchBudgetResolved { get; set; }

    private GiftExchangeModel? _giftExchange;
    private WishlistModel? _recipientWishlist;
    private bool _loading = true;
    private string? _errorMessage;
    private string? _openError;
    private bool _opening;
    private bool _justOpened;
    private bool NeedsFirstOpen => UseGiftBoxReveal && _giftExchange?.MatchOpenedOn is null;

    private string RecipientDisplayName => _giftExchange?.ReceiverDisplayName
        ?? _giftExchange?.Receiver?.UserName
        ?? _giftExchange?.Receiver?.Email
        ?? _giftExchange?.ReceiverEmail
        ?? "your match";

    private int RecipientItemCount => _recipientWishlist is null ? 0 : GetItemCount(_recipientWishlist);

    private string RecipientWishlistUrl => _recipientWishlist is null
        ? "#event-wishlists"
        : _giftExchange?.Budget is { } budget && GiftBudget.IsValid(budget)
            ? $"/wishlists/{_recipientWishlist.PublicId}?budget={budget.ToString(CultureInfo.InvariantCulture)}"
            : $"/wishlists/{_recipientWishlist.PublicId}";

    private string RecipientWishlistActionLabel => _giftExchange?.Budget is { } budget && GiftBudget.IsValid(budget)
        ? $"Shop within {budget:C} budget"
        : $"View {RecipientDisplayName}'s wishlist";

    private static int GetItemCount(WishlistModel wishlist) =>
        EventGiftIdeas.Count(wishlist);

    private string? _loadedKey;

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{EventId}/{CurrentUserId}";
        if (key != _loadedKey)
        {
            _loadedKey = key;
            await LoadGiftExchange();
        }
        else
        {
            // The parent re-renders as its wishlists arrive; keep the match on screen instead of reloading it.
            UpdateRecipientWishlist();
        }
    }

    private void UpdateRecipientWishlist()
    {
        _recipientWishlist = _giftExchange?.ReceiverId != null && EventWishlists != null
            ? EventWishlists
                .Where(wishlist => wishlist.OwnerId == _giftExchange.ReceiverId)
                .OrderByDescending(GetItemCount)
                .FirstOrDefault()
            : null;
    }

    private async Task LoadGiftExchange()
    {
        _loading = true;
        _errorMessage = null;
        _openError = null;
        _justOpened = false;
        try
        {
            _giftExchange = await EventService.GetMyGiftExchangeByPublicIdAsync(EventId, CurrentUserId);

            UpdateRecipientWishlist();
            await OnMatchBudgetResolved.InvokeAsync(_giftExchange?.Budget);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the gift exchange assignment for event {EventPublicId}", EventId);
            _giftExchange = null;
            _recipientWishlist = null;
            _errorMessage = "We couldn't load your gift exchange match. Try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenMatch()
    {
        if (_opening || _giftExchange is null)
        {
            return;
        }
        _opening = true;
        _openError = null;
        try
        {
            _giftExchange = await EventService.OpenGiftExchangeMatchAsync(EventId, _giftExchange.PublicId, CurrentUserId);
            UpdateRecipientWishlist();
            _justOpened = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open the gift exchange match for event {EventPublicId}", EventId);
            _openError = "We couldn't confirm your gift was opened. Try again, or reload your match if the organizer changed the draw.";
        }
        finally
        {
            _opening = false;
        }
    }
}
