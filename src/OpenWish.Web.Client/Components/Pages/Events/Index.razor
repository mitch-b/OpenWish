@page "/events"
@attribute [Authorize]

@using OpenWish.Web.Client.Components.Event
@using OpenWish.Web.Client.Components.Shared
@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IEventService EventService
@inject IUserContextService UserContextService
@inject ILogger<Index> Logger
@inject IJSRuntime JSRuntime

@rendermode InteractiveServer

<PageTitle>Events</PageTitle>

<div class="container page-shell">
    <PageHeader Title="Events"
                Description="Plan an exchange or a shared occasion.">
        <Actions>
            <div class="events-header-actions">
                @if (_events is { Count: > 0 })
                {
                    <button type="button" class="btn btn-outline-secondary" data-testid="events-download"
                            disabled="@(!RendererInfo.IsInteractive)" @onclick="DownloadEventsAsync">
                        <OpenWishIcon Name="download" /> Download CSV
                    </button>
                }
                <a href="/events/new" class="btn btn-primary events-new-action">
                    <OpenWishIcon Name="plus-lg" /> New event
                </a>
            </div>
        </Actions>
    </PageHeader>

    <PendingInvitations OnInvitationChanged="HandleInvitationChanged" />

    <section aria-labelledby="events-list-title" aria-busy="@(_isLoading ? "true" : "false")">
        <h2 id="events-list-title" class="visually-hidden">Your events</h2>

        @if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <div class="alert alert-danger" role="alert">
                <p class="mb-2">@_loadError</p>
                <button class="btn btn-outline-danger btn-sm"
                        type="button"
                        disabled="@_isLoading"
                        @onclick="RetryLoadAsync">
                    Try again
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_downloadError))
        {
            <div class="alert alert-danger" role="alert">
                <p class="mb-2">@_downloadError</p>
                <button class="btn btn-outline-danger btn-sm" type="button"
                        disabled="@(!RendererInfo.IsInteractive)" @onclick="DownloadEventsAsync">
                    Try again
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <p class="visually-hidden" role="status" aria-live="polite">@_statusMessage</p>
        }

        @if (_events == null && _isLoading)
        {
            <div class="events-loading" role="status">
                <div class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></div>
                <span>Loading events...</span>
            </div>
        }
        else if (_events?.Any() == false)
        {
            <div class="empty-state">
                <span class="empty-state-icon" aria-hidden="true"><OpenWishIcon Name="calendar-event" /></span>
                <h3>No events yet</h3>
                <p>Create a gift exchange or shared occasion, or accept an invitation, and it will show up here.</p>
                <a href="/events/new" class="btn btn-outline-secondary">
                    <OpenWishIcon Name="plus-lg" /> Create your first event
                </a>
            </div>
        }
        else if (_events?.Any() == true)
        {
            <section class="events-group" aria-labelledby="events-upcoming-title">
                <h3 id="events-upcoming-title" class="events-group-title">
                    Upcoming <span class="events-group-count">@UpcomingEvents.Count</span>
                </h3>
                @if (UpcomingEvents.Count == 0)
                {
                    <p class="events-group-empty">Nothing coming up. <a href="/events/new">Plan your next event</a>.</p>
                }
                else
                {
                    <div class="row g-3 event-grid">
                        @foreach (var evt in UpcomingEvents)
                        {
                            <div class="col-md-6 col-xl-4" @key="evt.PublicId">
                                <EventCard Event="@evt" OnDelete="@HandleEventDeleted" />
                            </div>
                        }
                    </div>
                }
            </section>

            @if (PastEvents.Count > 0)
            {
                <section class="events-group events-group-past" aria-labelledby="events-past-title">
                    <h3 id="events-past-title" class="events-group-title">
                        Past events <span class="events-group-count">@PastEvents.Count</span>
                    </h3>
                    <div class="row g-3 event-grid">
                        @foreach (var evt in PastEvents)
                        {
                            <div class="col-md-6 col-xl-4" @key="evt.PublicId">
                                <EventCard Event="@evt" OnDelete="@HandleEventDeleted" />
                            </div>
                        }
                    </div>
                </section>
            }
        }
    </section>
</div>


@code {
    private List<EventModel>? _events;
    private bool _isLoading = true;
    private string? _loadError;
    private string? _statusMessage;
    private string? _userId;
    private int _loadVersion;

    private List<EventModel> UpcomingEvents => (_events ?? [])
        .Where(evt => !EventCountdown.IsPast(evt.Date, DateTimeOffset.UtcNow))
        .OrderBy(evt => evt.Date)
        .ToList();

    private List<EventModel> PastEvents => (_events ?? [])
        .Where(evt => EventCountdown.IsPast(evt.Date, DateTimeOffset.UtcNow))
        .OrderByDescending(evt => evt.Date)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadEventsAsync();
    }

    private string? _downloadError;

    private async Task DownloadEventsAsync()
    {
        if (_events is null)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("openWishDownloadText", "events.csv", EventsCsv.Build(_events), "text/csv");
            _downloadError = null;
            _statusMessage = "Events downloaded as a spreadsheet.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not download events as CSV.");
            _downloadError = "Your events could not be downloaded.";
        }
    }

    private async Task LoadEventsAsync(bool announceRefresh = false)
    {
        var loadVersion = ++_loadVersion;
        _isLoading = true;
        _loadError = null;
        _statusMessage = null;

        try
        {
            _userId ??= await UserContextService.GetUserIdAsync();
            if (string.IsNullOrWhiteSpace(_userId))
            {
                if (loadVersion == _loadVersion)
                {
                    _loadError = "Sign in again to load your events.";
                }
                return;
            }

            var events = (await EventService.GetUserEventsAsync(_userId)).ToList();
            if (loadVersion != _loadVersion)
            {
                return;
            }

            _events = events;
            if (announceRefresh)
            {
                _statusMessage = $"{events.Count} {(events.Count == 1 ? "event" : "events")} refreshed.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load events.");
            if (loadVersion == _loadVersion)
            {
                _loadError = _events is null
                    ? "Your events could not be loaded. Try again."
                    : "Your events could not be refreshed. The events already shown are still available.";
            }
        }
        finally
        {
            if (loadVersion == _loadVersion)
            {
                _isLoading = false;
            }
        }
    }

    private Task RetryLoadAsync() => LoadEventsAsync(announceRefresh: _events is not null);

    private Task HandleEventDeleted(EventModel evt)
    {
        return LoadEventsAsync(announceRefresh: true);
    }

    private Task HandleInvitationChanged()
    {
        return LoadEventsAsync(announceRefresh: true);
    }
}