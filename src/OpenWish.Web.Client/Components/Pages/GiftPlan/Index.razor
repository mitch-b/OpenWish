@page "/gift-plan"
@attribute [Authorize]

@using OpenWish.Shared.Models
@using OpenWish.Shared.Services
@using OpenWish.Web.Client.Components.Shared

@inject IGiftPlanService GiftPlanService
@inject IUserContextService UserContextService
@inject ILogger<Index> Logger
@inject IJSRuntime JSRuntime

@rendermode InteractiveAuto

<PageTitle>My gift plan</PageTitle>

<div class="container page-shell gift-plan" data-testid="gift-plan">
    <PageHeader Title="My gift plan"
                Description="Every gift you've reserved, by person, what is still to buy, and gifts you've already given. Only you can see this page." />

    <section aria-labelledby="gift-plan-heading" aria-busy="@(_isLoading ? "true" : "false")">
        <h2 id="gift-plan-heading" class="visually-hidden" tabindex="-1">Gifts you've reserved</h2>

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <p class="visually-hidden" role="status" aria-live="polite">@_statusMessage</p>
        }
        @if (_actionError is not null)
        {
            <div class="alert alert-danger" role="alert">@_actionError</div>
        }

        @if (_loadError is not null)
        {
            <div class="alert alert-danger" role="alert">
                <p class="mb-2">@_loadError</p>
                <button class="btn btn-outline-danger btn-sm" type="button" disabled="@_isLoading" @onclick="LoadAsync">Try again</button>
            </div>
        }
        else if (_plan is null)
        {
            <div class="text-center" role="status">
                <div class="spinner-border text-primary" aria-hidden="true"></div>
                <div class="mt-2">Loading your gift plan...</div>
            </div>
        }
        else if (_plan.ItemCount == 0 && _plan.HistoryCount == 0)
        {
            <div class="empty-state text-center" data-testid="gift-plan-empty">
                <OpenWishIcon Name="gift" Class="empty-state-icon" />
                <h2>Nothing reserved yet</h2>
                <p class="lead">Reserve an idea on a friend's wishlist and it will show up here, grouped by person.</p>
                <a href="/wishlists" class="btn btn-primary btn-lg mt-3">Browse wishlists</a>
            </div>
        }
        else
        {
            @if (_plan.ItemCount == 0)
            {
                <p class="lead" data-testid="gift-plan-nothing-to-buy">Nothing left to buy. Your earlier gifts are listed below.</p>
            }
            else
            {
                <dl class="plan-summary" data-testid="gift-plan-summary">
                    <div>
                        <dt>Gifts reserved</dt>
                        <dd data-testid="gift-plan-count">@_plan.ItemCount</dd>
                    </div>
                    <div>
                        <dt>Still to buy</dt>
                        <dd data-testid="gift-plan-to-buy">@_plan.ToBuyCount</dd>
                        <dd class="plan-note">@_plan.PurchasedCount bought</dd>
                    </div>
                    <div>
                        <dt>People</dt>
                        <dd>@_plan.Recipients.Count</dd>
                    </div>
                    <div>
                        <dt>Estimated total</dt>
                        <dd data-testid="gift-plan-total">@_plan.Total.ToString("C")</dd>
                        <dd class="plan-note">@_plan.ToBuyTotal.ToString("C") still to buy</dd>
                        @if (_plan.UnpricedCount > 0)
                        {
                            <dd class="plan-note">@UnpricedText(_plan.UnpricedCount)</dd>
                        }
                    </div>
                </dl>

                <div class="plan-toolbar" data-testid="gift-plan-toolbar">
                    <div class="btn-group" role="group" aria-label="Which gifts to show">
                        <button type="button" class="btn btn-sm @(_onlyToBuy ? "btn-outline-primary" : "btn-primary")"
                                aria-pressed="@(!_onlyToBuy ? "true" : "false")"
                                id="gift-plan-show-all"
                                data-testid="gift-plan-show-all"
                                @onclick="() => SetOnlyToBuy(false)">All gifts</button>
                        <button type="button" class="btn btn-sm @(_onlyToBuy ? "btn-primary" : "btn-outline-primary")"
                                aria-pressed="@(_onlyToBuy ? "true" : "false")"
                                id="gift-plan-show-to-buy"
                                data-testid="gift-plan-show-to-buy"
                                @onclick="() => SetOnlyToBuy(true)">Still to buy (@_plan.ToBuyCount)</button>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="gift-plan-copy"
                            data-copy-text="@ShoppingListText"
                            disabled="@(_plan.ToBuyCount == 0 || _busyKey is not null)" @onclick="CopyShoppingListAsync">
                        <OpenWishIcon Name="clipboard" /> @(_listCopied ? "List copied" : "Copy shopping list")
                    </button>
                </div>

                @if (_plan.OverBudgetCount > 0)
                {
                    <p class="plan-note plan-over-budget-note" data-testid="gift-plan-over-budget-summary">
                        @(_plan.OverBudgetCount == 1 ? "1 gift is" : $"{_plan.OverBudgetCount} gifts are") over an occasion's budget.
                    </p>
                }

                @if (_onlyToBuy && _plan.ToBuyCount == 0)
                {
                    <p class="lead" data-testid="gift-plan-all-bought">Everything is bought. Switch to "All gifts" to review them.</p>
                }

                @foreach (var recipient in VisibleRecipients)
                {
                    <section class="plan-recipient" aria-labelledby="@RecipientId(recipient)" data-testid="gift-plan-recipient" @key="RecipientKey(recipient)">
                        <header class="plan-recipient-header">
                            <h3 id="@RecipientId(recipient)">@recipient.RecipientName</h3>
                            <p>
                                @(recipient.Items.Count == 1 ? "1 gift" : $"{recipient.Items.Count} gifts")
                                &middot; @recipient.Total.ToString("C")
                                &middot; @recipient.ToBuyCount to buy
                                @if (recipient.UnpricedCount > 0)
                                {
                                    <span class="plan-note">(@UnpricedText(recipient.UnpricedCount))</span>
                                }
                            </p>
                            @if (recipient.GetNextOccasion(_now) is { } occasion)
                            {
                                <p class="plan-occasion" data-testid="gift-plan-occasion">
                                    <OpenWishIcon Name="calendar" />
                                    @OccasionText(occasion)
                                </p>
                            }
                        </header>
                        <ul class="plan-items">
                            @foreach (var item in recipient.Items)
                            {
                                <li class="plan-item" data-testid="gift-plan-item" @key="@($"{item.WishlistPublicId}/{item.ItemPublicId}")">
                                    <div class="plan-item-main">
                                        <a class="plan-item-name" href="/wishlists/@item.WishlistPublicId">@item.ItemName</a>
                                        <small>
                                            @item.WishlistName
                                            @if (item.EventName is not null)
                                            {
                                                <span> &middot; <a href="/events/@item.EventPublicId">@item.EventName</a></span>
                                            }
                                        </small>
                                        <small>Reserved @item.ReservedOn.ToLocalTime().ToString("MMM d, yyyy")</small>
                                        @if (item.IsOverBudget)
                                        {
                                            <small class="plan-over-budget" data-testid="gift-plan-over-budget">
                                                Over the @item.EventBudget!.Value.ToString("C") budget for @item.EventName
                                            </small>
                                        }
                                        @if (item.PurchasedOn is { } purchasedOn)
                                        {
                                            <small class="plan-bought" data-testid="gift-plan-bought">
                                                <OpenWishIcon Name="check-circle" /> Bought @purchasedOn.ToLocalTime().ToString("MMM d, yyyy")
                                            </small>
                                        }
                                    </div>
                                    <div class="plan-item-side">
                                        <button class="btn btn-sm @(item.IsPurchased ? "btn-outline-secondary" : "btn-primary")"
                                                type="button"
                                                data-testid="gift-plan-toggle"
                                                disabled="@(_busyKey is not null)"
                                                @onclick="() => TogglePurchasedAsync(item)">
                                            @(_busyKey == KeyOf(item) ? "Saving..." : item.IsPurchased ? "Not bought yet" : "Mark as bought")
                                            <span class="visually-hidden"> for @item.ItemName</span>
                                        </button>
                                        <span class="plan-price">@(item.Price is { } price ? price.ToString("C") : "No price")</span>
                                        @if (_confirmReleaseKey == KeyOf(item))
                                        {
                                            <div class="plan-release-confirm" role="group" aria-label="Release @item.ItemName">
                                                <p class="plan-release-text" data-testid="gift-plan-release-text">
                                                    Release @item.ItemName?
                                                    @(item.IsPurchased
                                                        ? "It is marked as bought; releasing removes it from your plan and its bought record, and someone else can reserve it."
                                                        : "It leaves your plan and someone else can reserve it.")
                                                </p>
                                                <button class="btn btn-outline-secondary btn-sm" type="button" id="@ElementIdFor("keep", item)"
                                                        disabled="@(_busyKey is not null)" @onclick="() => CancelRelease(item)">Keep</button>
                                                <button class="btn btn-danger btn-sm" type="button" data-testid="gift-plan-release-confirm"
                                                        disabled="@(_busyKey is not null)" @onclick="() => ReleaseAsync(item)">
                                                    @(_busyKey == KeyOf(item) ? "Releasing..." : "Release it")
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary btn-sm" type="button" data-testid="gift-plan-release"
                                                    id="@ElementIdFor("release", item)"
                                                    disabled="@(_busyKey is not null)" @onclick="() => AskToRelease(item)">
                                                Release<span class="visually-hidden"> @item.ItemName so someone else can reserve it</span>
                                            </button>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Url))
                                        {
                                            <a class="btn btn-outline-primary btn-sm"
                                               href="@item.Url"
                                               target="_blank"
                                               rel="noopener noreferrer nofollow"
                                               aria-label="Open store page for @item.ItemName (opens in a new tab)">
                                                <OpenWishIcon Name="box-arrow-up-right" /> Store
                                            </a>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </section>
                }
            }

            @if (_plan.HistoryCount > 0)
            {
                <details class="plan-history mt-4" data-testid="gift-history">
                    <summary><h3 class="h5 d-inline">Gifts you've given (@_plan.HistoryCount)</h3></summary>
                    <p class="plan-note mt-2">Gifts you marked as bought for occasions that have passed. Private to you.</p>
                    @foreach (var recipient in _plan.History)
                    {
                        <section class="plan-recipient" aria-labelledby="@("history-" + RecipientId(recipient))" data-testid="gift-history-recipient" @key="@("history-" + RecipientKey(recipient))">
                            <header class="plan-recipient-header">
                                <h4 id="@("history-" + RecipientId(recipient))" class="h6">@recipient.RecipientName</h4>
                            </header>
                            <ul class="plan-items">
                                @foreach (var item in recipient.Items)
                                {
                                    <li class="plan-item" data-testid="gift-history-item" @key="@($"history-{item.WishlistPublicId}/{item.ItemPublicId}")">
                                        <div class="plan-item-main">
                                            <a class="plan-item-name" href="/wishlists/@item.WishlistPublicId">@item.ItemName</a>
                                            <small>
                                                @item.WishlistName
                                                @if (item.EventName is not null)
                                                {
                                                    <span> &middot; @item.EventName</span>
                                                }
                                            </small>
                                            <small>Marked bought @item.PurchasedOn!.Value.ToLocalTime().ToString("MMM d, yyyy")</small>
                                        </div>
                                        <div class="plan-item-side">
                                            <span class="plan-price">@(item.Price is { } price ? price.ToString("C") : "No price")</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </details>
            }
        }
    </section>
</div>

@code {
    private GiftPlanModel? _plan;
    private bool _isLoading = true;
    private string? _loadError;
    private string? _actionError;
    private string? _statusMessage;
    private string? _busyKey;
    private string? _userId;
    private bool _onlyToBuy;
    private bool _listCopied;
    private string? _confirmReleaseKey;

    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private string? _pendingFocusId;

    private IReadOnlyList<GiftPlanRecipientModel> VisibleRecipients =>
        _plan is null ? [] : _onlyToBuy ? _plan.GetRecipientsToBuy(_now) : _plan.Recipients;

    private string ShoppingListText => _plan is null ? string.Empty : GiftPlanText.Build(_plan, _now);

    private static string ElementIdFor(string prefix, GiftPlanItemModel item) =>
        $"plan-{prefix}-" + new string(KeyOf(item).Where(char.IsLetterOrDigit).ToArray());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocusId is { } id)
        {
            _pendingFocusId = null;
            try
            {
                await JSRuntime.InvokeVoidAsync("openWishFocusElement", id);
            }
            catch (JSException)
            {
                // The element is gone; leaving focus where the browser put it is acceptable.
            }
        }
    }

    // Focus stays useful when the row that held it disappears.
    private string FocusAfterRowRemoved() =>
        _plan is { ItemCount: > 0 } ? (_onlyToBuy ? "gift-plan-show-to-buy" : "gift-plan-show-all") : "gift-plan-heading";

    private void AskToRelease(GiftPlanItemModel item)
    {
        _confirmReleaseKey = KeyOf(item);
        _pendingFocusId = ElementIdFor("keep", item);
    }

    private void CancelRelease(GiftPlanItemModel item)
    {
        _confirmReleaseKey = null;
        _pendingFocusId = ElementIdFor("release", item);
    }

    private void SetOnlyToBuy(bool value)
    {
        _onlyToBuy = value;
        _confirmReleaseKey = null;
        _now = DateTimeOffset.UtcNow;
    }

    private static string OccasionText(DateTimeOffset occasion)
    {
        var badge = EventCountdown.Badge(occasion, DateTimeOffset.UtcNow);
        return $"{badge} · {occasion.ToString("MMM d")}";
    }

    // The browser writes the clipboard in the click itself (see app.js); this reports whether it worked.
    private async Task CopyShoppingListAsync()
    {
        _actionError = null;
        try
        {
            var copied = await JSRuntime.InvokeAsync<bool>("openWishLastCopyResult");
            if (!copied)
            {
                _actionError = "We couldn't copy the list. Try again.";
                return;
            }

            _listCopied = true;
            _statusMessage = "Shopping list copied.";
            StateHasChanged();
            await Task.Delay(2000);
            _listCopied = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Copying the shopping list failed.");
            _actionError = "We couldn't copy the list. Try again.";
        }
    }

    private async Task ReleaseAsync(GiftPlanItemModel item)
    {
        if (_busyKey is not null || _userId is null)
        {
            return;
        }

        _busyKey = KeyOf(item);
        _actionError = null;
        _statusMessage = null;
        try
        {
            var released = true;
            try
            {
                await GiftPlanService.ReleaseGiftAsync(_userId, item.WishlistPublicId, item.ItemPublicId);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Releasing a reserved gift failed.");
                released = false;
            }

            try
            {
                _plan = await GiftPlanService.GetGiftPlanAsync(_userId);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Refreshing the gift plan after a release failed.");
                _confirmReleaseKey = null;
                _loadError = released
                    ? $"{item.ItemName} was released, but your plan couldn't be refreshed. Try again."
                    : $"We couldn't confirm whether {item.ItemName} was released. Reload your plan to check.";
                return;
            }

            // A lost response may still have released the gift, so trust the refreshed plan.
            var stillReserved = _plan.Recipients.SelectMany(recipient => recipient.Items).Any(i => KeyOf(i) == KeyOf(item));
            _confirmReleaseKey = null;
            if (stillReserved)
            {
                _actionError = $"We couldn't release {item.ItemName}. Try again.";
                _pendingFocusId = ElementIdFor("release", item);
                return;
            }

            _statusMessage = released
                ? $"{item.ItemName} released. Someone else can reserve it now."
                : $"{item.ItemName} is no longer on your plan.";
            _pendingFocusId = FocusAfterRowRemoved();
        }
        finally
        {
            _busyKey = null;
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private static string KeyOf(GiftPlanItemModel item) => $"{item.WishlistPublicId}/{item.ItemPublicId}";

    private async Task TogglePurchasedAsync(GiftPlanItemModel item)
    {
        if (_busyKey is not null || _userId is null)
        {
            return;
        }

        var markBought = !item.IsPurchased;
        _busyKey = KeyOf(item);
        _actionError = null;
        _statusMessage = null;
        try
        {
            await GiftPlanService.SetGiftPurchasedAsync(_userId, item.WishlistPublicId, item.ItemPublicId, markBought);
            _plan = await GiftPlanService.GetGiftPlanAsync(_userId);
            _statusMessage = markBought ? $"{item.ItemName} marked as bought." : $"{item.ItemName} moved back to still to buy.";
            if (_onlyToBuy && markBought)
            {
                _pendingFocusId = FocusAfterRowRemoved();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Updating a gift's bought status failed.");
            _actionError = $"We couldn't update {item.ItemName}. Try again.";
        }
        finally
        {
            _busyKey = null;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            _userId ??= await UserContextService.GetUserIdAsync();
            if (string.IsNullOrWhiteSpace(_userId))
            {
                _loadError = "Sign in again to see your gift plan.";
                return;
            }

            _plan = await GiftPlanService.GetGiftPlanAsync(_userId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the gift plan.");
            _loadError = "Your gift plan could not be loaded. Try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string UnpricedText(int count) => count == 1 ? "1 gift has no price" : $"{count} gifts have no price";

    // Display names can repeat (for example "Shared event list"), so key on the first list instead.
    private static string RecipientKey(GiftPlanRecipientModel recipient) => recipient.Items[0].WishlistPublicId;

    private static string RecipientId(GiftPlanRecipientModel recipient) =>
        "plan-recipient-" + new string(RecipientKey(recipient).Where(char.IsLetterOrDigit).ToArray());
}
