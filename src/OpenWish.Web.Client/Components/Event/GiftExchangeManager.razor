@using System
@using System.Collections.Generic
@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IEventService EventService
@inject ILogger<GiftExchangeManager> Logger
@inject NavigationManager NavigationManager

<div class="card shadow-sm mb-4 gift-exchange-manager">
    <div class="card-header">
        <h3 class="h5 mb-0"><OpenWishIcon Name="gift" /> Gift exchange</h3>
    </div>
    <div class="card-body">
        @if (Event?.IsGiftExchange == true)
        {
            @if (Event.NamesDrawnOn.HasValue)
            {
                <div class="alert alert-success draw-status" role="status">
                    <OpenWishIcon Name="check-circle-fill" />
                    <div>
                        <strong>Assignments are ready.</strong>
                        Names were drawn on @Event.NamesDrawnOn.Value.ToLocalTime().ToString("MMMM d, yyyy 'at' h:mm tt").
                        <span class="d-block mt-1">Each participant can open this event to see only the person they're shopping for.</span>
                    </div>
                </div>

                @if (Event.AssignmentsRevealedOn.HasValue)
                {
                    <p class="text-muted mt-4 mb-0">Assignments were revealed to the group on @Event.AssignmentsRevealedOn.Value.ToLocalTime().ToString("MMMM d, yyyy"), so the exchange can no longer be reset.</p>
                }
                else
                {
                <section class="reset-panel mt-4" aria-labelledby="reset-gift-exchange-heading">
                    <h4 id="reset-gift-exchange-heading" class="h6 fw-semibold mb-1">Need to change the group or rules?</h4>
                    <p class="text-muted">Reset the gift exchange to cancel every match, update invitations or exclusion rules, then draw again.</p>

                    @if (!_showResetConfirm)
                    {
                        <button type="button" class="btn btn-outline-danger"
                                @onclick="OpenResetConfirmation"
                                disabled="@(!RendererInfo.IsInteractive || _eventStateChanged)">
                            <OpenWishIcon Name="arrow-clockwise" /> Reset gift exchange
                        </button>
                    }
                    else
                    {
                        <div class="confirm-panel confirm-panel-danger" role="group" aria-labelledby="reset-confirm-title">
                            <p id="reset-confirm-title" class="confirm-panel-title">
                                <OpenWishIcon Name="exclamation-triangle" /> Reset the gift exchange?
                            </p>
                            <ul class="confirm-consequences">
                                <li>Every match is cancelled, including any people have already seen. This can't be undone.</li>
                                <li>Everyone in the draw gets an email that the exchange was reset.</li>
                                <li>Guest private links stop working until you draw names again.</li>
                                <li>Wishlists, reservations, and exclusion rules stay as they are.</li>
                            </ul>
                            <div class="confirm-actions">
                                <button type="button" class="btn btn-danger" @onclick="ResetGiftExchange" disabled="@(_resetting || _eventStateChanged)">
                                    @if (_resetting)
                                    {
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>Resetting...</span>
                                    }
                                    else
                                    {
                                        <OpenWishIcon Name="arrow-clockwise" />
                                        <span>Reset and cancel matches</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @ref="_resetCancelButton" @onclick="CancelReset" disabled="@(_resetting || _eventStateChanged)">
                                    Keep current matches
                                </button>
                            </div>
                        </div>
                    }

                    @if (_resetErrorMessage != null)
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            <OpenWishIcon Name="exclamation-circle" /> @_resetErrorMessage
                            @if (_eventStateChanged)
                            {
                                <button type="button" class="btn btn-outline-danger d-block mt-2" @onclick="ReloadEvent">
                                    Reload event
                                </button>
                            }
                        </div>
                    }
                </section>
                }
            }
            else
            {
                <section class="draw-panel mb-4" aria-labelledby="draw-heading">
                    <h4 id="draw-heading" class="h5 mb-1">@AssignmentActionLabel</h4>
                    <p class="text-muted">@AssignmentExplanation</p>

                    <ul class="readiness-list" aria-label="Draw readiness">
                        @if (_participantCount < 2)
                        {
                            <li class="readiness-item readiness-blocker">
                                <OpenWishIcon Name="x-circle-fill" />
                                <div>
                                    <strong>Needs one more person</strong>
                                    <span>Only you have joined so far. At least one invitee has to accept before you can draw.</span>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="readiness-item readiness-ok">
                                <OpenWishIcon Name="check-circle-fill" />
                                <div>
                                    <strong>@_participantCount people will be included</strong>
                                    <span>You and everyone who accepted.</span>
                                </div>
                            </li>
                        }
                        @if (_pendingParticipantCount > 0)
                        {
                            <li class="readiness-item readiness-advisory">
                                <OpenWishIcon Name="hourglass-split" />
                                <div>
                                    <strong>@_pendingParticipantCount @(_pendingParticipantCount == 1 ? "invitation is" : "invitations are") still pending</strong>
                                    <span>Pending invitees are left out. If someone said yes outside OpenWish, mark them as accepted under Invitations.</span>
                                </div>
                            </li>
                        }
                        @if (_participantCount >= 2)
                        {
                            @if (_participantsWithWishlists >= _participantCount)
                            {
                                <li class="readiness-item readiness-ok">
                                    <OpenWishIcon Name="check-circle-fill" />
                                    <div>
                                        <strong>Everyone has gift ideas</strong>
                                        <span>Each match will have a wishlist to shop from.</span>
                                    </div>
                                </li>
                            }
                            else
                            {
                                <li class="readiness-item readiness-advisory">
                                    <OpenWishIcon Name="info-circle" />
                                    <div>
                                        <strong>@_participantsWithWishlists of @_participantCount people have gift ideas</strong>
                                        <span>Not required to draw. People can add ideas after the draw too.</span>
                                    </div>
                                </li>
                            }
                        }
                    </ul>

                    @if (_participantCount < 2)
                    {
                        <a class="btn btn-primary" href="@($"/events/{Event.PublicId}?section=event-invitations")">
                            <OpenWishIcon Name="envelope" />
                            <span>Invite people</span>
                        </a>
                    }
                    else if (!_showDrawConfirm)
                    {
                        <button type="button" class="btn btn-primary btn-lg draw-action"
                                @onclick="OpenDrawConfirmation"
                                disabled="@(!RendererInfo.IsInteractive || _eventStateChanged)">
                            <OpenWishIcon Name="shuffle" />
                            <span>@AssignmentActionLabel</span>
                        </button>
                    }
                    else
                    {
                        <div class="confirm-panel" role="group" aria-labelledby="draw-confirm-title">
                            <p id="draw-confirm-title" class="confirm-panel-title">@ConfirmationPrompt</p>
                            <ul class="confirm-consequences">
                                <li>Each person privately sees only who they're shopping for.</li>
                                <li>Everyone in the draw gets an email that names are ready.</li>
                                <li>To add someone or change rules later, you'll reset and draw again.</li>
                            </ul>
                            <div class="confirm-actions">
                                <button type="button" class="btn btn-primary" @ref="_drawConfirmButton" @onclick="DrawNames" disabled="@(_drawing || _eventStateChanged)">
                                    @if (_drawing)
                                    {
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>@DrawingBusyLabel</span>
                                    }
                                    else
                                    {
                                        <OpenWishIcon Name="shuffle" />
                                        <span>@ConfirmAssignmentActionLabel</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelDrawConfirmation" disabled="@(_drawing || _eventStateChanged)">
                                    Not yet
                                </button>
                            </div>
                        </div>
                    }
                </section>

                @if (_drawErrorMessage != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <OpenWishIcon Name="exclamation-circle" /> @_drawErrorMessage
                        @if (_eventStateChanged)
                        {
                            <button type="button" class="btn btn-outline-danger d-block mt-2" @onclick="ReloadEvent">
                                Reload event
                            </button>
                        }
                    </div>
                }

                <hr />

                <h4 class="h6 fw-semibold mb-1">Pairing rules <span class="text-muted fw-normal">(optional)</span></h4>
                <p class="text-muted pairing-rules-intro">Keep certain people from drawing each other, like partners or housemates. Rules apply the next time names are drawn.</p>

                <div class="pairing-rules" aria-busy="@(_loadingPairingRules || _updatingPairingRules ? "true" : "false")">
                @if (_loadingPairingRules)
                {
                    <div class="d-flex align-items-center gap-2 mb-3" role="status">
                        <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                        <span>Loading pairing rules...</span>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_pairingRulesLoadError))
                {
                    <div class="alert alert-danger" role="alert">
                        <p class="mb-2">@_pairingRulesLoadError</p>
                        <button type="button" class="btn btn-outline-danger" @onclick="LoadPairingRules" disabled="@(!RendererInfo.IsInteractive)">
                            Try again
                        </button>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_pairingRuleMessage))
                    {
                        <div class="alert alert-success" role="status" aria-live="polite">
                            @_pairingRuleMessage
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_pairingRuleError))
                    {
                        <div class="alert alert-danger" role="alert">
                            @_pairingRuleError
                        </div>
                    }

                    @if (_pairingRules.Any())
                    {
                        var renderedRuleIds = new HashSet<int>();
                        <div class="list-group mb-3 pairing-rule-list">
                            @foreach (var rule in _pairingRules)
                            {
                                if (!renderedRuleIds.Add(rule.Id))
                                {
                                    continue;
                                }

                                var reciprocalRule = FindReciprocalRule(rule);
                                var isBidirectional = reciprocalRule is not null;

                                if (reciprocalRule is not null)
                                {
                                    renderedRuleIds.Add(reciprocalRule.Id);
                                }

                                <div class="list-group-item pairing-rule-item">
                                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">
                                        <div>
                                            <span>
                                                <strong>@FormatRuleParticipant(rule, true)</strong>
                                                cannot be matched with
                                                <strong>@FormatRuleParticipant(rule, false)</strong>
                                            </span>
                                        </div>
                                        <div class="d-flex flex-wrap gap-2 justify-content-end">
                                            <button type="button"
                                                    class="btn btn-sm text-nowrap @(isBidirectional ? "btn-success" : "btn-outline-success")"
                                                    title="@(isBidirectional ? "Limit the rule to only this direction" : "Apply the exclusion in both directions")"
                                                    disabled="@_updatingPairingRules"
                                                    @onclick="() => ToggleBidirectionalRuleAsync(rule)">
                                                @if (_updatingRuleId == rule.Id && _updatingRuleAction == PairingRuleAction.Toggle)
                                                {
                                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                    <span>Updating...</span>
                                                }
                                                else
                                                {
                                                    <OpenWishIcon Name="arrow-left-right" Class="me-1" />
                                                    <span>@(isBidirectional ? "Limit to one way" : "Make both ways")</span>
                                                }
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger text-nowrap d-flex align-items-center gap-1"
                                                    title="Remove this exclusion rule"
                                                    disabled="@_updatingPairingRules"
                                                    @onclick="() => RemoveRule(rule.Id)">
                                                @if (_updatingRuleId == rule.Id && _updatingRuleAction == PairingRuleAction.Remove)
                                                {
                                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                    <span>Removing...</span>
                                                }
                                                else
                                                {
                                                    <OpenWishIcon Name="trash3" />
                                                    <span>Remove</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (_showAddRule)
                    {
                        <div class="card surface-alt pairing-rule-card mb-3">
                            <div class="card-body">
                                <h5 class="h6">Add exclusion rule</h5>
                                <div class="row g-2">
                                    <div class="col-md-5">
                                        <label for="pairing-rule-source" class="form-label">Person</label>
                                        <select id="pairing-rule-source" class="form-select" @bind="_newRuleSourceKey" disabled="@_updatingPairingRules">
                                            <option value="">Choose someone</option>
                                            @foreach (var participant in _participants)
                                            {
                                                <option value="@participant.Key">@participant.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        <label for="pairing-rule-target" class="form-label">Can't be matched with</label>
                                        <select id="pairing-rule-target" class="form-select" @bind="_newRuleTargetKey" disabled="@_updatingPairingRules">
                                            <option value="">Choose someone</option>
                                            @foreach (var participant in _participants)
                                            {
                                                <option value="@participant.Key">@participant.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-2 d-flex align-items-end">
                                        <button type="button" class="btn btn-primary w-100" @onclick="AddRule" disabled="@(DisableAddRuleButton || _updatingPairingRules)">
                                            @if (_updatingPairingRules)
                                            {
                                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                <span>Adding...</span>
                                            }
                                            else
                                            {
                                                <OpenWishIcon Name="plus" />
                                                <span>Add rule</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-secondary mt-2" @onclick="() => _showAddRule = false" disabled="@_updatingPairingRules">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="() => _showAddRule = true" disabled="@(!RendererInfo.IsInteractive || _updatingPairingRules)">
                            <OpenWishIcon Name="plus-circle" /> Add exclusion rule
                        </button>
                    }
                }
                </div>
            }
        }
        else
        {
            <p class="text-muted">This event is not configured as a gift exchange.</p>
        }
    </div>
</div>

@code {
    [Parameter] public EventModel? Event { get; set; }
    [Parameter] public string CurrentUserId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnNamesDrawn { get; set; }

    private List<CustomPairingRuleModel> _pairingRules = new();
    private List<ParticipantOption> _participants = new();
    private bool _drawing = false;
    private bool _resetting = false;
    private bool _showAddRule = false;
    private bool _showResetConfirm = false;
    private bool _showDrawConfirm = false;
    private bool _focusDrawConfirm;
    private bool _focusResetConfirm;
    private ElementReference _drawConfirmButton;
    private ElementReference _resetCancelButton;
    private string? _newRuleSourceKey;
    private string? _newRuleTargetKey;
    private string? _drawErrorMessage;
    private string? _resetErrorMessage;
    private string? _pairingRulesLoadError;
    private string? _pairingRuleError;
    private string? _pairingRuleMessage;
    private bool _loadingPairingRules;
    private bool _updatingPairingRules;
    private bool _eventStateChanged;
    private string? _loadedEventPublicId;
    private int? _updatingRuleId;
    private PairingRuleAction? _updatingRuleAction;
    private int _participantCount = 0;
    private int _pendingParticipantCount;
    private int _participantsWithWishlists;
    private bool DisableAddRuleButton =>
        string.IsNullOrEmpty(_newRuleSourceKey) ||
        string.IsNullOrEmpty(_newRuleTargetKey) ||
        string.Equals(_newRuleSourceKey, _newRuleTargetKey, StringComparison.Ordinal);
    private bool IsSecretSantaStyle =>
        string.Equals(Event?.GiftExchangeStyle, "SecretSanta", StringComparison.Ordinal);
    private string AssignmentActionLabel => IsSecretSantaStyle ? "Draw Secret Santa names" : "Make assignments";
    private string ConfirmAssignmentActionLabel => IsSecretSantaStyle ? "Confirm and draw names" : "Confirm assignments";
    private string DrawingBusyLabel => IsSecretSantaStyle ? "Drawing names..." : "Making assignments...";
    private string ConfirmationPrompt => IsSecretSantaStyle
        ? $"Ready to draw Secret Santa names for {_participantCount} people?"
        : $"Ready to make private assignments for {_participantCount} people?";
    private string AssignmentExplanation => IsSecretSantaStyle
        ? "OpenWish privately draws a Secret Santa name for every accepted participant."
        : "OpenWish privately assigns every accepted participant one person to shop for.";

    protected override async Task OnParametersSetAsync()
    {
        if (Event != null)
        {
            if (!string.Equals(_loadedEventPublicId, Event.PublicId, StringComparison.Ordinal))
            {
                _loadedEventPublicId = Event.PublicId;
                ResetEventMutationState();
            }

            await LoadPairingRules();
            LoadParticipants();
        }
    }

    private void LoadParticipants()
    {
        if (Event == null) return;

        _participants.Clear();

        bool HasUser(string userId) => _participants.Any(p => string.Equals(p.UserId, userId, StringComparison.Ordinal));
        bool HasEmail(string email) => _participants.Any(p => !string.IsNullOrEmpty(p.Email) && string.Equals(p.Email, email, StringComparison.OrdinalIgnoreCase));

        if (Event.CreatedBy != null)
        {
            _participants.Add(new ParticipantOption(
                $"user:{Event.CreatedBy.Id}",
                Event.CreatedBy.UserName ?? Event.CreatedBy.Email ?? "Event Owner",
                Event.CreatedBy.Id,
                Event.CreatedBy.Email));
        }

        if (Event.EventUsers != null)
        {
            foreach (var eventUser in Event.EventUsers.Where(IsAccepted))
            {
                if (eventUser.User != null)
                {
                    if (!HasUser(eventUser.User.Id))
                    {
                        _participants.Add(new ParticipantOption(
                            $"user:{eventUser.User.Id}",
                            eventUser.User.UserName ?? eventUser.User.Email ?? "Participant",
                            eventUser.User.Id,
                            eventUser.User.Email));
                    }
                }
                else if (!string.IsNullOrWhiteSpace(eventUser.InviteeEmail))
                {
                    var normalizedEmail = eventUser.InviteeEmail.Trim();
                    if (!HasEmail(normalizedEmail))
                    {
                        _participants.Add(new ParticipantOption(
                            $"invite:{eventUser.PublicId}",
                            eventUser.GuestDisplayName ?? $"{normalizedEmail} (email invite)",
                            null,
                            normalizedEmail));
                    }
                }
            }
        }

        _participantCount = _participants.Count;
        _pendingParticipantCount = (Event.EventUsers ?? []).Count(eventUser =>
            !eventUser.Deleted &&
            string.Equals(eventUser.Status, "Pending", StringComparison.OrdinalIgnoreCase));
        var acceptedUserIds = _participants
            .Select(participant => participant.UserId)
            .Where(userId => !string.IsNullOrWhiteSpace(userId))
            .ToHashSet(StringComparer.Ordinal);
        _participantsWithWishlists = Event.EventWishlists
            .Where(wishlist => GetWishlistItemCount(wishlist) > 0)
            .Select(wishlist => wishlist.OwnerId)
            .Where(ownerId => !string.IsNullOrWhiteSpace(ownerId) && acceptedUserIds.Contains(ownerId))
            .Distinct(StringComparer.Ordinal)
            .Count();
    }

    private async Task LoadPairingRules()
    {
        if (Event?.PublicId == null) return;

        _loadingPairingRules = true;
        _pairingRulesLoadError = null;
        try
        {
            var rules = await EventService.GetPairingRulesByPublicIdAsync(Event.PublicId, CurrentUserId);
            _pairingRules = rules.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load pairing rules for event {EventPublicId}", Event.PublicId);
            _pairingRulesLoadError = "We couldn't load pairing rules. Try again.";
        }
        finally
        {
            _loadingPairingRules = false;
        }
    }

    private async Task DrawNames()
    {
        if (Event?.PublicId == null || _drawing || _eventStateChanged) return;

        _drawing = true;
        _drawErrorMessage = null;

        try
        {
            try
            {
                await EventService.DrawNamesByPublicIdAsync(Event.PublicId, CurrentUserId);
                _eventStateChanged = true;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to draw names for event {EventPublicId}", Event.PublicId);
                await ReconcileGiftExchangeStateAsync(
                    namesShouldBeDrawn: true,
                    "Names couldn't be drawn. Check the participant list and try again. If you added exclusion rules, they may leave someone without a possible match.",
                    "Names were drawn, but the response was interrupted.");
                return;
            }

            try
            {
                await OnNamesDrawn.InvokeAsync();
                CancelDrawConfirmation();
                _eventStateChanged = false;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Names were drawn but event {EventPublicId} did not refresh", Event.PublicId);
                _drawErrorMessage = "Names were drawn, but event details couldn't refresh. Reload this event.";
            }
        }
        finally
        {
            _drawing = false;
        }
    }

    private async Task AddRule()
    {
        if (_updatingPairingRules)
        {
            return;
        }

        _pairingRuleError = null;
        _pairingRuleMessage = null;

        if (Event?.PublicId == null || string.IsNullOrEmpty(_newRuleSourceKey) || string.IsNullOrEmpty(_newRuleTargetKey))
        {
            return;
        }

        if (string.Equals(_newRuleSourceKey, _newRuleTargetKey, StringComparison.Ordinal))
        {
            _pairingRuleError = "Select two different participants for an exclusion.";
            return;
        }

        var source = FindParticipant(_newRuleSourceKey);
        var target = FindParticipant(_newRuleTargetKey);

        if (source is null || target is null)
        {
            _pairingRuleError = "Selected participants are no longer available.";
            return;
        }

        var newRule = new CustomPairingRuleModel
        {
            SourceUserId = source.UserId,
            SourceInviteeEmail = source.IsEmailOnly ? source.Email : null,
            TargetUserId = target.UserId,
            TargetInviteeEmail = target.IsEmailOnly ? target.Email : null,
            RuleType = "Exclusion",
            RuleDescription = "Cannot be matched together"
        };

        _updatingPairingRules = true;
        try
        {
            await EventService.AddPairingRuleByPublicIdAsync(Event.PublicId, newRule, CurrentUserId);
            _newRuleSourceKey = null;
            _newRuleTargetKey = null;
            _showAddRule = false;
            await RefreshPairingRulesAfterMutationAsync("Exclusion rule added.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add a pairing rule for event {EventPublicId}", Event.PublicId);
            await ReconcilePairingRuleAddAsync(
                newRule,
                "Exclusion rule added.",
                "The exclusion rule couldn't be added. Try again.");
        }
        finally
        {
            _updatingPairingRules = false;
        }
    }

    private CustomPairingRuleModel? FindReciprocalRule(CustomPairingRuleModel rule) =>
        _pairingRules.FirstOrDefault(other =>
            other.Id != rule.Id &&
            ParticipantsMatch(rule, other) &&
            string.Equals(other.RuleType, rule.RuleType, StringComparison.OrdinalIgnoreCase));

    private bool IsBidirectional(CustomPairingRuleModel rule) => FindReciprocalRule(rule) != null;

    private async Task EnsureBidirectionalRuleAsync(CustomPairingRuleModel rule)
    {
        if (Event?.PublicId == null ||
            _updatingPairingRules ||
            string.IsNullOrEmpty(CurrentUserId) ||
            IsBidirectional(rule) ||
            (!HasParticipantData(rule.SourceUserId, rule.SourceInviteeEmail)) ||
            (!HasParticipantData(rule.TargetUserId, rule.TargetInviteeEmail)))
        {
            return;
        }

        var reciprocalRule = new CustomPairingRuleModel
        {
            SourceUserId = rule.TargetUserId,
            SourceInviteeEmail = rule.TargetInviteeEmail,
            TargetUserId = rule.SourceUserId,
            TargetInviteeEmail = rule.SourceInviteeEmail,
            RuleType = rule.RuleType,
            RuleDescription = string.IsNullOrWhiteSpace(rule.RuleDescription)
                ? "Cannot be matched together"
                : rule.RuleDescription
        };

        _pairingRuleError = null;
        _pairingRuleMessage = null;
        _updatingPairingRules = true;
        _updatingRuleId = rule.Id;
        _updatingRuleAction = PairingRuleAction.Toggle;
        try
        {
            await EventService.AddPairingRuleByPublicIdAsync(Event.PublicId, reciprocalRule, CurrentUserId);
            await RefreshPairingRulesAfterMutationAsync("Exclusion now applies both ways.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to make pairing rule {PairingRuleId} bidirectional", rule.Id);
            await ReconcilePairingRuleAddAsync(
                reciprocalRule,
                "Exclusion now applies both ways.",
                "The exclusion rule couldn't be updated. Try again.");
        }
        finally
        {
            _updatingPairingRules = false;
            _updatingRuleId = null;
            _updatingRuleAction = null;
        }
    }

    private async Task ToggleBidirectionalRuleAsync(CustomPairingRuleModel rule)
    {
        if (Event?.PublicId == null ||
            _updatingPairingRules ||
            string.IsNullOrEmpty(CurrentUserId) ||
            !HasParticipantData(rule.SourceUserId, rule.SourceInviteeEmail) ||
            !HasParticipantData(rule.TargetUserId, rule.TargetInviteeEmail))
        {
            return;
        }

        var reciprocalRule = FindReciprocalRule(rule);
        if (reciprocalRule is null)
        {
            await EnsureBidirectionalRuleAsync(rule);
            return;
        }

        _pairingRuleError = null;
        _pairingRuleMessage = null;
        _updatingPairingRules = true;
        _updatingRuleId = rule.Id;
        _updatingRuleAction = PairingRuleAction.Toggle;
        try
        {
            var removed = await EventService.RemovePairingRuleAsync(reciprocalRule.Id, CurrentUserId);
            if (!removed)
            {
                _pairingRuleError = "The exclusion rule is no longer available. Reload the rules and try again.";
                return;
            }

            await RefreshPairingRulesAfterMutationAsync("Exclusion now applies one way.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update pairing rule {PairingRuleId}", rule.Id);
            _pairingRuleError = "The exclusion rule couldn't be updated. Try again.";
        }
        finally
        {
            _updatingPairingRules = false;
            _updatingRuleId = null;
            _updatingRuleAction = null;
        }
    }

    private async Task RemoveRule(int ruleId)
    {
        if (_updatingPairingRules)
        {
            return;
        }

        _pairingRuleError = null;
        _pairingRuleMessage = null;
        _updatingPairingRules = true;
        _updatingRuleId = ruleId;
        _updatingRuleAction = PairingRuleAction.Remove;
        try
        {
            var removed = await EventService.RemovePairingRuleAsync(ruleId, CurrentUserId);
            if (!removed)
            {
                _pairingRuleError = "The exclusion rule is no longer available. Reload the rules and try again.";
                return;
            }

            await RefreshPairingRulesAfterMutationAsync("Exclusion rule removed.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove pairing rule {PairingRuleId}", ruleId);
            _pairingRuleError = "The exclusion rule couldn't be removed. Try again.";
        }
        finally
        {
            _updatingPairingRules = false;
            _updatingRuleId = null;
            _updatingRuleAction = null;
        }
    }

    private async Task ResetGiftExchange()
    {
        if (Event?.PublicId == null || _resetting || _eventStateChanged) return;

        _resetting = true;
        _resetErrorMessage = null;

        try
        {
            try
            {
                await EventService.ResetGiftExchangeByPublicIdAsync(Event.PublicId, CurrentUserId);
                _eventStateChanged = true;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to reset gift exchange for event {EventPublicId}", Event.PublicId);
                await ReconcileGiftExchangeStateAsync(
                    namesShouldBeDrawn: false,
                    "The gift exchange couldn't be reset. Try again.",
                    "The gift exchange was reset, but the response was interrupted.");
                return;
            }

            try
            {
                await OnNamesDrawn.InvokeAsync();
                CancelReset();
                _eventStateChanged = false;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Gift exchange was reset but event {EventPublicId} did not refresh", Event.PublicId);
                _resetErrorMessage = "The gift exchange was reset, but event details couldn't refresh. Reload this event.";
            }
        }
        finally
        {
            _resetting = false;
        }
    }

    private void OpenDrawConfirmation()
    {
        _drawErrorMessage = null;
        _showDrawConfirm = true;
        _focusDrawConfirm = true;
    }

    private void OpenResetConfirmation()
    {
        _resetErrorMessage = null;
        _showResetConfirm = true;
        _focusResetConfirm = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDrawConfirm && _showDrawConfirm)
        {
            _focusDrawConfirm = false;
            await _drawConfirmButton.FocusAsync();
        }

        if (_focusResetConfirm && _showResetConfirm)
        {
            _focusResetConfirm = false;
            await _resetCancelButton.FocusAsync();
        }
    }

    private void CancelReset()
    {
        _showResetConfirm = false;
        _resetErrorMessage = null;
    }

    private void CancelDrawConfirmation()
    {
        _showDrawConfirm = false;
        _drawErrorMessage = null;
    }

    private async Task RefreshPairingRulesAfterMutationAsync(string successMessage)
    {
        if (Event?.PublicId == null)
        {
            return;
        }

        try
        {
            var rules = await EventService.GetPairingRulesByPublicIdAsync(Event.PublicId, CurrentUserId);
            _pairingRules = rules.ToList();
            _pairingRuleMessage = successMessage;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Pairing rule changed but refresh failed for event {EventPublicId}", Event.PublicId);
            _pairingRulesLoadError = "Your change was saved, but the rule list couldn't be refreshed. Try again.";
        }
    }

    private void ReloadEvent() => NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);

    private async Task ReconcilePairingRuleAddAsync(
        CustomPairingRuleModel expectedRule,
        string successMessage,
        string failureMessage)
    {
        try
        {
            var rules = (await EventService.GetPairingRulesByPublicIdAsync(Event!.PublicId, CurrentUserId)).ToList();
            _pairingRules = rules;
            if (rules.Any(rule => RulesMatch(rule, expectedRule)))
            {
                _newRuleSourceKey = null;
                _newRuleTargetKey = null;
                _showAddRule = false;
                _pairingRuleMessage = successMessage;
                return;
            }

            _pairingRuleError = failureMessage;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not reconcile pairing-rule change for event {EventPublicId}", Event?.PublicId);
            _pairingRulesLoadError = "The change outcome couldn't be confirmed. Reload the rules before trying again.";
        }
    }

    private async Task ReconcileGiftExchangeStateAsync(
        bool namesShouldBeDrawn,
        string failureMessage,
        string completedMessage)
    {
        try
        {
            var refreshedEvent = await EventService.GetEventByPublicIdAsync(Event!.PublicId, CurrentUserId);
            if (refreshedEvent.NamesDrawnOn.HasValue == namesShouldBeDrawn)
            {
                _eventStateChanged = true;
                await NotifyEventChangedAfterReconciliationAsync(completedMessage);
                return;
            }

            SetGiftExchangeError(namesShouldBeDrawn, failureMessage);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not reconcile gift-exchange state for event {EventPublicId}", Event?.PublicId);
            _eventStateChanged = true;
            SetGiftExchangeError(
                namesShouldBeDrawn,
                "The result couldn't be confirmed. Reload this event before trying again.");
        }
    }

    private async Task NotifyEventChangedAfterReconciliationAsync(string completedMessage)
    {
        try
        {
            await OnNamesDrawn.InvokeAsync();
            _eventStateChanged = false;
            _showDrawConfirm = false;
            _showResetConfirm = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Gift-exchange state changed but event {EventPublicId} did not refresh", Event?.PublicId);
            if (Event?.NamesDrawnOn.HasValue == true)
            {
                _resetErrorMessage = $"{completedMessage} Reload this event.";
            }
            else
            {
                _drawErrorMessage = $"{completedMessage} Reload this event.";
            }
        }
    }

    private void SetGiftExchangeError(bool drawingNames, string message)
    {
        if (drawingNames)
        {
            _drawErrorMessage = message;
        }
        else
        {
            _resetErrorMessage = message;
        }
    }

    private void ResetEventMutationState()
    {
        _eventStateChanged = false;
        _drawErrorMessage = null;
        _resetErrorMessage = null;
        _showDrawConfirm = false;
        _showResetConfirm = false;
    }

    private static bool RulesMatch(CustomPairingRuleModel first, CustomPairingRuleModel second) =>
        ParticipantEquals(first.SourceUserId, first.SourceInviteeEmail, second.SourceUserId, second.SourceInviteeEmail) &&
        ParticipantEquals(first.TargetUserId, first.TargetInviteeEmail, second.TargetUserId, second.TargetInviteeEmail) &&
        string.Equals(first.RuleType, second.RuleType, StringComparison.OrdinalIgnoreCase);

    private static bool IsAccepted(EventUserModel participant) =>
        !participant.Deleted &&
        participant.IsAccepted &&
        string.Equals(participant.Status, "Accepted", StringComparison.OrdinalIgnoreCase);

    private static int GetWishlistItemCount(WishlistModel wishlist) =>
        wishlist.ItemCount > 0 ? wishlist.ItemCount : wishlist.Items?.Count ?? 0;

    private ParticipantOption? FindParticipant(string key) =>
        _participants.FirstOrDefault(p => string.Equals(p.Key, key, StringComparison.Ordinal));

    private static string FormatRuleParticipant(CustomPairingRuleModel rule, bool isSource)
    {
        var user = isSource ? rule.SourceUser : rule.TargetUser;
        var inviteeEmail = isSource ? rule.SourceInviteeEmail : rule.TargetInviteeEmail;
        var userId = isSource ? rule.SourceUserId : rule.TargetUserId;

        return user?.UserName
            ?? user?.Email
            ?? inviteeEmail
            ?? (!string.IsNullOrEmpty(userId) ? "Participant" : "Guest");
    }

    private static bool ParticipantsMatch(CustomPairingRuleModel first, CustomPairingRuleModel second)
    {
        return ParticipantEquals(first.SourceUserId, first.SourceInviteeEmail, second.TargetUserId, second.TargetInviteeEmail) &&
               ParticipantEquals(first.TargetUserId, first.TargetInviteeEmail, second.SourceUserId, second.SourceInviteeEmail);
    }

    private static bool ParticipantEquals(string? firstUserId, string? firstEmail, string? secondUserId, string? secondEmail)
    {
        if (!string.IsNullOrEmpty(firstUserId) && string.Equals(firstUserId, secondUserId, StringComparison.Ordinal))
        {
            return true;
        }

        if (!string.IsNullOrWhiteSpace(firstEmail) && !string.IsNullOrWhiteSpace(secondEmail))
        {
            return string.Equals(firstEmail, secondEmail, StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }

    private static bool HasParticipantData(string? userId, string? email) =>
        !string.IsNullOrEmpty(userId) || !string.IsNullOrWhiteSpace(email);

    private enum PairingRuleAction
    {
        Toggle,
        Remove
    }

    private sealed record ParticipantOption(string Key, string Label, string? UserId, string? Email)
    {
        public bool IsEmailOnly => string.IsNullOrEmpty(UserId) && !string.IsNullOrWhiteSpace(Email);
    }
}
