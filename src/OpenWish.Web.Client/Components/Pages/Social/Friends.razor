@page "/friends"
@using OpenWish.Web.Client.Components.Social
@using OpenWish.Web.Client.Components.Shared
@attribute [Authorize]

@rendermode InteractiveAuto

<PageTitle>Friends</PageTitle>

<div class="container page-shell">
    <PageHeader Title="Friends"
                Description="Connect with friends and manage trusted sharing relationships." />

    <div class="friends-layout">
        <div>
            <div class="card friends-panel mb-4">
                <div class="card-body">
                    <FriendSearch />
                </div>
            </div>
            
            <div class="card friends-panel mb-4">
                <div class="card-body">
                    <ConnectInPerson />
                </div>
            </div>

            <FriendSuggestions OnRequestSent="HandleRequestSent" />

            <div class="card friends-panel mb-4">
                <div class="card-body">
                    <FriendRequestList @ref="_requestList" OnFriendshipsChanged="HandleFriendshipsChanged" />
                </div>
            </div>
        </div>
        
        <div>
            <div class="card friends-panel">
                <div class="card-body">
                    <FriendList @ref="_friendList" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private FriendList? _friendList;
    private FriendRequestList? _requestList;

    private Task HandleRequestSent() => _requestList?.ReloadAsync() ?? Task.CompletedTask;

    private Task HandleFriendshipsChanged() => _friendList?.ReloadAsync() ?? Task.CompletedTask;
}
