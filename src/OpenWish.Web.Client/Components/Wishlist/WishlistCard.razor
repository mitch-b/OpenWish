@inject IWishlistService WishlistService
@inject ILogger<WishlistCard> Logger
@inject IUserContextService UserContextService

@using OpenWish.Shared.Services

@if (Wishlist == null)
{
    <p role="status">Loading wishlist...</p>
}
else
{
    <div class="card h-100 wishlist-card">
        <div class="card-body">
            <div class="card-title-row">
                <span class="wishlist-card-icon" aria-hidden="true">
                    @if (string.IsNullOrEmpty(Wishlist.Icon))
                    {
                        <OpenWishIcon Name="gift" />
                    }
                    else
                    {
                        @Wishlist.Icon
                    }
                </span>
                <div class="wishlist-card-heading">
                    <h5 class="card-title"><a class="wishlist-card-link" href="/wishlists/@Wishlist.PublicId">@Wishlist.Name</a></h5>
                    @if (ShowOwner && !string.IsNullOrWhiteSpace(Wishlist.Owner?.UserName))
                    {
                        <span class="card-owner">By @Wishlist.Owner.UserName</span>
                    }
                </div>
                @if (isCurrentUserOwner)
                {
                    <div class="dropdown d-inline-block wishlist-card-actions">
                        <button class="btn btn-outline-secondary btn-sm kebab-menu"
                                type="button"
                                id="dropdownMenu@(Wishlist.PublicId)"
                                data-bs-toggle="dropdown"
                                aria-label="Actions for @Wishlist.Name"
                                aria-expanded="false"
                                @onclick:stopPropagation="true">
                            <OpenWishIcon Name="three-dots-vertical" />
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenu@(Wishlist.PublicId)">
                            <li>
                                <button class="dropdown-item text-danger"
                                        type="button"
                                        disabled="@(!RendererInfo.IsInteractive)"
                                        @onclick:stopPropagation="true"
                                        @onclick="ShowDeleteDialog">
                                    <OpenWishIcon Name="trash3" /> Delete
                                </button>
                            </li>
                        </ul>
                    </div>
                }
            </div>
            <div class="wishlist-meta">
                <span class="wishlist-meta-count"><strong>@DisplayItemCount</strong> @(DisplayItemCount == 1 ? "idea" : "ideas")</span>
                @if (Wishlist.IsCollaborative)
                {
                    <span class="wishlist-meta-chip"><OpenWishIcon Name="people" /> Collaborative</span>
                }
                @if (isCurrentUserOwner)
                {
                    <span class="wishlist-meta-chip" title="@PrivacyDescription"><OpenWishIcon Name="@PrivacyIcon" /> <span aria-hidden="true">@PrivacyLabel</span><span class="visually-hidden">@PrivacyDescription</span></span>
                }
            </div>
            @if (Wishlist.Event is { PublicId: { Length: > 0 } eventPublicId } wishlistEvent)
            {
                <a class="wishlist-card-event" href="/events/@eventPublicId">
                    <OpenWishIcon Name="calendar-event" />
                    <span>For <strong>@wishlistEvent.Name</strong></span>
                </a>
            }
        </div>
    </div>

    <WishlistDeleteDialog @ref="deleteDialog" OnConfirm="HandleDelete" />
}

@code {
    [Parameter]
    public WishlistModel? Wishlist { get; set; }
    [Parameter]
    public EventCallback<WishlistModel> OnDelete { get; set; }
    [Parameter]
    public bool ShowOwner { get; set; } = true;
    [Parameter]
    public int? ItemCount { get; set; }

    private WishlistDeleteDialog deleteDialog = default!;
    private bool isCurrentUserOwner = false;
    private int DisplayItemCount => ItemCount ?? Wishlist?.Items?.Count ?? Wishlist?.ItemCount ?? 0;

    private bool HasEventAccess => Wishlist?.EventId is not null || Wishlist?.Event is not null;

    private string PrivacyLabel => Wishlist switch
    {
        { IsPrivate: true } => "Private",
        { IsFriendsOnly: true } => HasEventAccess ? "Specific friends + event" : "Specific friends",
        _ => HasEventAccess ? "All friends + event" : "All friends"
    };

    private string PrivacyDescription => Wishlist switch
    {
        { IsPrivate: true } => "Private: only you and people you share it with can see it",
        { IsFriendsOnly: true } => HasEventAccess ? "Shared with specific friends and event members" : "Shared with specific friends",
        _ => HasEventAccess ? "Shared with all friends and event members" : "Shared with all friends"
    };

    private string PrivacyIcon => Wishlist switch
    {
        { IsPrivate: true } => "lock",
        { IsFriendsOnly: true } => "person-check",
        _ => "eye"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Wishlist != null)
        {
            try
            {
                var currentUserId = await UserContextService.GetUserIdAsync();
                isCurrentUserOwner = !string.IsNullOrEmpty(currentUserId) && currentUserId == Wishlist.OwnerId;
            }
            catch
            {
                // During SSR, authentication might not be available yet
                isCurrentUserOwner = false;
            }
        }
    }

    private Task ShowDeleteDialog()
    {
        return deleteDialog.ShowAsync(
            "Delete wishlist",
            $"Are you sure you want to delete the wishlist '{Wishlist?.Name}'? This action cannot be undone.",
            $"dropdownMenu{Wishlist?.PublicId}"
        );
    }

    private async Task HandleDelete()
    {
        if (Wishlist != null)
        {
            Logger.LogInformation("Deleting wishlist {WishlistPublicId}", Wishlist.PublicId);
            await WishlistService.DeleteWishlistByPublicIdAsync(Wishlist.PublicId);
            if (OnDelete.HasDelegate)
            {
                await OnDelete.InvokeAsync(Wishlist);
            }
        }
    }
}
