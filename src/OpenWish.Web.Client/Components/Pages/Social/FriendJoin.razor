@page "/friends/join/{Code}"
@using OpenWish.Shared.Models
@using OpenWish.Shared.Services
@using OpenWish.Web.Client.Components.Shared
@attribute [Authorize]

@rendermode InteractiveAuto

@inject IFriendJoinService FriendJoinService
@inject IUserContextService UserContextService
@inject ILogger<FriendJoin> Logger

<PageTitle>Connect in person</PageTitle>

<div class="friend-join-page">
    <section class="friend-join" data-testid="friend-join" aria-labelledby="friend-join-title" aria-busy="@(_loading || _busy ? "true" : "false")">
        <div class="friend-join-mark" aria-hidden="true">
            <OpenWishIcon Name="@MarkIcon" />
        </div>
        <h1 id="friend-join-title" class="friend-join-title">Connect in person</h1>

        <div class="friend-join-body" aria-live="polite">
            @if (_loading)
            {
                <p class="friend-join-loading" role="status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>Checking the code...</span>
                </p>
            }
            else if (_failed)
            {
                <div class="alert alert-danger" role="alert" data-testid="join-error">
                    We couldn't check that code. Try again in a moment.
                </div>
                <div class="friend-join-actions">
                    <button class="btn btn-primary" type="button" disabled="@(!RendererInfo.IsInteractive)" @onclick="LoadAsync">
                        <OpenWishIcon Name="arrow-clockwise" /> Try again
                    </button>
                    <a class="btn btn-outline-secondary" href="friends">Back to friends</a>
                </div>
            }
            else
            {
                switch (_preview?.Status)
                {
                    case FriendJoinStatus.Valid:
                        <div class="friend-join-person">
                            <span class="friend-join-avatar" aria-hidden="true">@Initial</span>
                            <h2 class="friend-join-lead" data-testid="join-confirm-title">Connect with @_preview.DisplayName?</h2>
                        </div>
                        <p class="friend-join-muted">You'll both be able to see what each other shares with friends. Nothing else changes, and you can remove each other later.</p>
                        <div class="friend-join-actions">
                            <button class="btn btn-primary friend-join-primary" type="button" data-testid="join-confirm"
                                    disabled="@(_busy || !RendererInfo.IsInteractive)" @onclick="ConfirmAsync">
                                <OpenWishIcon Name="person-plus" /> @(_busy ? "Connecting..." : "Connect")
                            </button>
                            <a class="btn btn-outline-secondary" href="friends">Not now</a>
                        </div>
                        break;
                    case FriendJoinStatus.Connected:
                        <div class="alert alert-success friend-join-status" role="status" data-testid="join-success">
                            <OpenWishIcon Name="check-circle-fill" />
                            <span>You're now connected with <strong>@_preview.DisplayName</strong>.</span>
                        </div>
                        <div class="friend-join-actions">
                            <a class="btn btn-primary friend-join-primary" href="@ListsHref" data-testid="join-view-lists" @ref="_nextAction">View their lists</a>
                            <a class="btn btn-outline-secondary" href="friends">Back to friends</a>
                        </div>
                        break;
                    case FriendJoinStatus.AlreadyFriends:
                        <div class="alert alert-info friend-join-status" role="status" data-testid="join-already">
                            <OpenWishIcon Name="person-check" />
                            <span>You're already friends with <strong>@_preview.DisplayName</strong>.</span>
                        </div>
                        <div class="friend-join-actions">
                            <a class="btn btn-primary friend-join-primary" href="@ListsHref">View their lists</a>
                            <a class="btn btn-outline-secondary" href="friends">Back to friends</a>
                        </div>
                        break;
                    case FriendJoinStatus.OwnCode:
                        <div class="alert alert-info friend-join-status" role="status" data-testid="join-own">
                            <OpenWishIcon Name="info-circle" />
                            <span>This is your own code. Show it to the person you want to connect with.</span>
                        </div>
                        <div class="friend-join-actions">
                            <a class="btn btn-primary friend-join-primary" href="friends?section=in-person">Show my code</a>
                        </div>
                        break;
                    default:
                        <div class="alert alert-warning friend-join-status" role="alert" data-testid="join-invalid">
                            <OpenWishIcon Name="exclamation-triangle" />
                            <span>This code has expired or isn't valid. Ask your friend for a new one.</span>
                        </div>
                        <div class="friend-join-actions">
                            <a class="btn btn-primary friend-join-primary" href="friends?section=in-person">Enter another code</a>
                            <a class="btn btn-outline-secondary" href="friends">Back to friends</a>
                        </div>
                        break;
                }
            }
        </div>
    </section>
</div>

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private FriendJoinPreviewModel? _preview;
    private string? _userId;
    private bool _loading = true;
    private bool _failed;
    private bool _busy;
    private bool _focusNextAction;
    private ElementReference _nextAction;

    private string MarkIcon => _preview?.Status switch
    {
        FriendJoinStatus.Connected or FriendJoinStatus.AlreadyFriends => "person-check",
        _ => "people",
    };

    private string Initial => string.IsNullOrWhiteSpace(_preview?.DisplayName)
        ? "?"
        : _preview.DisplayName.Trim()[..1].ToUpperInvariant();

    private string ListsHref => string.IsNullOrWhiteSpace(_preview?.FriendUserName)
        ? "wishlists?tab=friends"
        : $"wishlists?tab=friends&owner={Uri.EscapeDataString(_preview.FriendUserName)}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNextAction)
        {
            _focusNextAction = false;
            await _nextAction.FocusAsync();
        }
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _failed = false;
        try
        {
            _userId ??= await UserContextService.GetUserIdAsync();
            _preview = await FriendJoinService.PreviewJoinCodeAsync(_userId ?? string.Empty, Code);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Connection code preview failed.");
            _failed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ConfirmAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _preview = await FriendJoinService.RedeemJoinCodeAsync(_userId ?? string.Empty, Code);
            _focusNextAction = _preview?.Status == FriendJoinStatus.Connected;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Connection code redemption failed.");
            _failed = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
