@page "/friends"
@using OpenWish.Web.Client.Components.Social
@using OpenWish.Web.Client.Components.Shared
@attribute [Authorize]

@rendermode InteractiveAuto

<PageTitle>Friends</PageTitle>

<div class="container page-shell">
    <PageHeader Title="Friends"
                Description="Connect with friends and choose who you share wishlists with." />

    <PageSections Label="Friends sections" Items="Sections" Active="@ActiveSection">
        <div class="page-section-panel" hidden="@(ActiveSection != "friends")">
            <FriendList @ref="_friendList" OnFriendRemoved="HandleFriendRemoved" />
        </div>
        <div class="page-section-panel" hidden="@(ActiveSection != "requests")" data-testid="friend-requests-panel">
            <FriendRequestList @ref="_requestList" OnFriendshipsChanged="HandleFriendshipsChanged" />
        </div>
        <div class="page-section-panel" hidden="@(ActiveSection != "invite")">
            <FriendSearch OnInvitesSent="HandleRequestSent" />
            <FriendSuggestions OnRequestSent="HandleRequestSent" />
        </div>
        <div class="page-section-panel" hidden="@(ActiveSection != "in-person")">
            <ConnectInPerson />
        </div>
        <div class="page-section-panel" hidden="@(ActiveSection != "circles")">
            <CirclesPanel @ref="_circlesPanel" OnCirclesChanged="HandleCirclesChanged" />
        </div>
    </PageSections>
</div>

@code {
    private static readonly PageSection[] Sections =
    [
        new("friends", "My friends", "people"),
        new("requests", "Requests", "envelope"),
        new("invite", "Invite friends", "person-plus"),
        new("in-person", "Connect in person", "link-45deg"),
        new("circles", "Circles", "people"),
    ];

    [SupplyParameterFromQuery(Name = "section")] public string? Section { get; set; }
    private string ActiveSection => Sections.FirstOrDefault(item => item.Id == Section)?.Id ?? "friends";

    private FriendList? _friendList;
    private FriendRequestList? _requestList;
    private CirclesPanel? _circlesPanel;

    private Task HandleRequestSent() => _requestList?.ReloadAsync() ?? Task.CompletedTask;

    private async Task HandleFriendshipsChanged()
    {
        await (_friendList?.ReloadAsync() ?? Task.CompletedTask);
        await (_circlesPanel?.ReloadAsync() ?? Task.CompletedTask);
    }

    private Task HandleFriendRemoved() => _circlesPanel?.ReloadAsync() ?? Task.CompletedTask;

    private Task HandleCirclesChanged() => _friendList?.ReloadAsync() ?? Task.CompletedTask;
}
