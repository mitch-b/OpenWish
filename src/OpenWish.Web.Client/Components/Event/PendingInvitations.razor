@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IEventService EventService
@inject IUserContextService UserContextService
@inject NavigationManager NavigationManager
@inject ILogger<PendingInvitations> Logger

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <p class="visually-hidden" role="status" aria-live="polite">@_statusMessage</p>
}

@if (ShouldShowCard)
{
    <section class="card mb-4 pending-invitations-card"
             aria-busy="@(_isLoading ? "true" : "false")"
             aria-labelledby="pending-invitations-title">
        <div class="card-body">
            <div class="pending-invitations-header">
                <span class="pending-invitations-icon" aria-hidden="true"><OpenWishIcon Name="envelope" /></span>
                <div>
                    <h2 class="pending-invitations-title" id="pending-invitations-title">
                        Pending invitations
                        @if (_invitations?.Any() == true)
                        {
                            <span class="pending-invitations-count">@_invitations.Count()</span>
                        }
                    </h2>
                    <p class="pending-invitations-hint">Accept to see the event and share your wishlist with the group.</p>
                </div>
            </div>

            @if (_isLoading)
            {
                <div class="pending-invitations-loading" role="status">
                    <div class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></div>
                    <span>Loading invitations...</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <div class="alert alert-danger mb-0" role="alert">
                    <p class="mb-2">@_loadError</p>
                    <button class="btn btn-outline-danger btn-sm" type="button"
                            disabled="@(!RendererInfo.IsInteractive)" @onclick="LoadInvitations">
                        Try again
                    </button>
                </div>
            }
            else if (_invitations?.Any() == true)
            {
                @if (!string.IsNullOrWhiteSpace(_actionError))
                {
                    <div class="alert alert-danger" role="alert">@_actionError</div>
                }
                <ul class="pending-invitation-list">
                    @foreach (var invitation in _invitations)
                    {
                        <li class="pending-invitation" @key="invitation.PublicId">
                            <div class="pending-invitation-info">
                                <h3 class="pending-invitation-name">@(invitation.Event?.Name ?? "Event")</h3>
                                <p class="pending-invitation-meta">
                                    @if (invitation.Event?.Date != null)
                                    {
                                        <span><OpenWishIcon Name="calendar-event" /> @invitation.Event.Date.ToString("ddd, MMM d, yyyy")</span>
                                        @if (!EventCountdown.IsPast(invitation.Event.Date, DateTimeOffset.UtcNow))
                                        {
                                            <span class="pending-invitation-countdown">@EventCountdown.Badge(invitation.Event.Date, DateTimeOffset.UtcNow)</span>
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(invitation.Event?.CreatedBy?.UserName))
                                    {
                                        <span>Invited by @invitation.Event.CreatedBy.UserName</span>
                                    }
                                </p>
                            </div>
                            <div class="pending-invitation-actions">
                                @if (_pendingDeclinePublicId == invitation.PublicId)
                                {
                                    <div id="decline-invitation-@invitation.PublicId" role="group"
                                         class="pending-invitation-confirm"
                                         aria-label="Confirm declining @(invitation.Event?.Name ?? "this event")">
                                        <p class="pending-invitation-confirm-text">Decline this invitation? It will be removed from your list.</p>
                                        <button class="btn btn-outline-secondary"
                                                type="button"
                                                aria-expanded="true"
                                                aria-controls="decline-invitation-@invitation.PublicId"
                                                @onclick="CancelDecline"
                                                disabled="@(!RendererInfo.IsInteractive || IsProcessing(invitation.PublicId))">
                                            Keep invitation
                                        </button>
                                        <button class="btn btn-danger"
                                                type="button"
                                                @onclick="() => DeclineInvitation(invitation)"
                                                disabled="@(!RendererInfo.IsInteractive || IsProcessing(invitation.PublicId))">
                                            @if (IsProcessing(invitation.PublicId) && _processingAction == "decline")
                                            {
                                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                                <span>Declining...</span>
                                            }
                                            else
                                            {
                                                <span>Confirm decline</span>
                                            }
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <button class="btn btn-outline-secondary"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="decline-invitation-@invitation.PublicId"
                                            @onclick="() => ConfirmDecline(invitation.PublicId)"
                                            disabled="@(!RendererInfo.IsInteractive || IsProcessing(invitation.PublicId))">
                                        Decline
                                    </button>
                                    <button class="btn btn-primary"
                                            type="button"
                                            @onclick="() => AcceptInvitation(invitation)"
                                            disabled="@(!RendererInfo.IsInteractive || IsProcessing(invitation.PublicId))">
                                        @if (IsProcessing(invitation.PublicId) && _processingAction == "accept")
                                        {
                                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                            <span>Accepting...</span>
                                        }
                                        else
                                        {
                                            <OpenWishIcon Name="check-lg" />
                                            <span>Accept</span>
                                        }
                                    </button>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
}

@code {
    [Parameter]
    public EventCallback OnInvitationChanged { get; set; }

    private List<EventUserModel>? _invitations;
    private bool _isLoading = true;
    private string? _userId;
    private string? _processingInvitationPublicId;
    private string? _pendingDeclinePublicId;
    private string? _processingAction;
    private string? _loadError;
    private string? _actionError;
    private string? _statusMessage;

    private bool ShouldShowCard =>
        _isLoading ||
        !string.IsNullOrWhiteSpace(_loadError) ||
        _invitations?.Any() == true;

    protected override async Task OnInitializedAsync()
    {
        await LoadInvitations();
    }

    private async Task LoadInvitations()
    {
        _isLoading = true;
        _loadError = null;
        _actionError = null;
        try
        {
            _userId ??= await UserContextService.GetUserIdAsync();
            if (string.IsNullOrWhiteSpace(_userId))
            {
                _loadError = "Sign in again to load pending invitations.";
                return;
            }

            var invitations = await EventService.GetPendingInvitationsForUserAsync(_userId);
            _invitations = invitations.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load pending event invitations.");
            _loadError = "Pending invitations could not be loaded. Try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool IsProcessing(string invitationPublicId) =>
        _processingInvitationPublicId == invitationPublicId;

    private async Task AcceptInvitation(EventUserModel invitation)
    {
        if (_userId == null || IsProcessing(invitation.PublicId)) return;

        _processingInvitationPublicId = invitation.PublicId;
        _processingAction = "accept";
        _actionError = null;
        _statusMessage = null;

        try
        {
            var success = await EventService.AcceptEventInvitationByPublicIdAsync(invitation.PublicId, _userId);
            if (!success)
            {
                _actionError = $"{GetEventName(invitation)} could not be accepted. Try again.";
                return;
            }

            _invitations?.RemoveAll(i => i.PublicId == invitation.PublicId);
            _statusMessage = $"{GetEventName(invitation)} accepted.";
            if (OnInvitationChanged.HasDelegate)
            {
                await OnInvitationChanged.InvokeAsync();
            }

            if (!string.IsNullOrEmpty(invitation.Event?.PublicId))
            {
                NavigationManager.NavigateTo($"/events/{invitation.Event.PublicId}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to accept event invitation {InvitationPublicId}.", invitation.PublicId);
            _actionError = $"{GetEventName(invitation)} could not be accepted. Try again.";
        }
        finally
        {
            _processingInvitationPublicId = null;
            _processingAction = null;
        }
    }

    private async Task DeclineInvitation(EventUserModel invitation)
    {
        if (_userId == null || IsProcessing(invitation.PublicId)) return;

        _processingInvitationPublicId = invitation.PublicId;
        _processingAction = "decline";
        _actionError = null;
        _statusMessage = null;

        try
        {
            var success = await EventService.RejectEventInvitationByPublicIdAsync(invitation.PublicId, _userId);
            if (!success)
            {
                _actionError = $"{GetEventName(invitation)} could not be declined. Try again.";
                return;
            }

            _pendingDeclinePublicId = null;
            _invitations?.RemoveAll(i => i.PublicId == invitation.PublicId);
            _statusMessage = $"{GetEventName(invitation)} declined.";
            if (OnInvitationChanged.HasDelegate)
            {
                await OnInvitationChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to decline event invitation {InvitationPublicId}.", invitation.PublicId);
            _actionError = $"{GetEventName(invitation)} could not be declined. Try again.";
        }
        finally
        {
            _processingInvitationPublicId = null;
            _processingAction = null;
        }
    }

    private void ConfirmDecline(string invitationPublicId) =>
        _pendingDeclinePublicId = invitationPublicId;

    private void CancelDecline() => _pendingDeclinePublicId = null;

    private static string GetEventName(EventUserModel invitation) =>
        invitation.Event?.Name ?? "This invitation";
}
