@attribute [Authorize]
@page "/wishlists"

@using Microsoft.Extensions.Logging
@using OpenWish.Web.Client.Components.Shared
@using OpenWish.Web.Client.Components.Wishlist
@using OpenWish.Shared.Services

@inject ILogger<Index> Logger
@inject IUserContextService UserContextService
@inject IWishlistService WishlistService

@rendermode InteractiveAuto

<div class="container page-shell">
    <PageHeader Title="Wishlists"
                Description="Manage your wishlists and explore wishlists shared by friends.">
        <Actions>
            <a href="/wishlists/new" class="btn btn-light btn-lg">Create wishlist</a>
        </Actions>
    </PageHeader>

    <ul class="nav nav-tabs mb-3" id="wishlistTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "my-wishlists" ? "active" : "")" id="my-wishlists-tab" 
                    @onclick='() => SetActiveTab("my-wishlists")' type="button" role="tab"
                    aria-selected="@(activeTab == "my-wishlists")"
                    aria-controls="my-wishlists-panel">
                <OpenWishIcon Name="list-ul" Class="me-2" />My Wishlists
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "friends-wishlists" ? "active" : "")" id="friends-wishlists-tab" 
                    @onclick='() => SetActiveTab("friends-wishlists")' type="button" role="tab"
                    aria-selected="@(activeTab == "friends-wishlists")"
                    aria-controls="friends-wishlists-panel">
                <OpenWishIcon Name="people" Class="me-2" />Friends' Wishlists
            </button>
        </li>
    </ul>

    <div class="tab-content" id="wishlistTabsContent">
            <div class="tab-pane fade @(activeTab == "my-wishlists" ? "show active" : string.Empty)"
                 id="my-wishlists-panel"
                 role="tabpanel"
                 aria-labelledby="my-wishlists-tab"
                 aria-busy="@(filteredWishlists is null ? "true" : "false")"
                 hidden="@(activeTab != "my-wishlists")">
                <div class="wishlist-toolbar">
                    <div class="filter-cluster">
                        <div class="filter-field">
                            <label for="wishlist-search" class="form-label">Search wishlists</label>
                            <div class="input-group search-control">
                                <input id="wishlist-search" type="search" class="form-control" placeholder="Search by name"
                                       aria-controls="wishlist-results"
                                       @bind="searchTerm" @bind:event="oninput" @bind:after="HandleSearch" />
                                @if (!string.IsNullOrWhiteSpace(searchTerm))
                                {
                                    <button class="btn btn-outline-secondary" type="button"
                                            aria-label="Clear wishlist search"
                                            @onclick="ClearSearch">
                                        <OpenWishIcon Name="x-lg" /> Clear
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="filter-field">
                            <label for="wishlist-filter" class="form-label">Show</label>
                            <select id="wishlist-filter" class="form-select" @bind="filterBy" @bind:after="HandleSearch">
                                <option value="all">All wishlists</option>
                                <option value="collaborative">Collaborative only</option>
                                <option value="private">Private only</option>
                            </select>
                        </div>
                        <div class="filter-field">
                            <label for="wishlist-sort" class="form-label">Sort by</label>
                            <select id="wishlist-sort" class="form-select" @bind="sortBy" @bind:after="HandleSort">
                                <option value="nameAsc">Name (A-Z)</option>
                                <option value="nameDesc">Name (Z-A)</option>
                                <option value="recent">Most recent</option>
                                <option value="oldest">Oldest</option>
                                <option value="itemCount">Most items</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div id="wishlist-results">
                @if (!string.IsNullOrWhiteSpace(_wishlistLoadError))
                {
                    <div class="alert alert-danger" role="alert">
                        @_wishlistLoadError
                    </div>
                }
                else if (filteredWishlists == null)
                {
                    <div class="d-flex align-items-center gap-2" role="status">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>Loading wishlists...</span>
                    </div>
                }
                else if (filteredWishlists.Count == 0)
                {
                    <p class="visually-hidden" role="status" aria-live="polite">No wishlists found.</p>
                    <div class="empty-state">
                        <h2>No wishlists found</h2>
                        <p>Create a wishlist or change the current search and filters.</p>
                        <a href="/wishlists/new" class="btn btn-primary">Create your first wishlist</a>
                    </div>
                }
                else
                {
                    <p class="visually-hidden" role="status" aria-live="polite">
                        @filteredWishlists.Count @(filteredWishlists.Count == 1 ? "wishlist" : "wishlists") found.
                    </p>
                    <div class="row g-3">
                        @foreach (var wishlist in filteredWishlists)
                        {
                            <div class="col-md-6 col-xl-4">
                                <WishlistCard Wishlist="@wishlist" OnDelete="@HandleWishlistDeleted" />
                            </div>
                        }
                    </div>
                }
                </div>
            </div>
            <div class="tab-pane fade @(activeTab == "friends-wishlists" ? "show active" : string.Empty)"
                 id="friends-wishlists-panel"
                 role="tabpanel"
                 aria-labelledby="friends-wishlists-tab"
                 aria-busy="@(loadingFriendsWishlists ? "true" : "false")"
                 hidden="@(activeTab != "friends-wishlists")">
                @if (loadingFriendsWishlists)
                {
                    <div class="d-flex justify-content-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading friends' wishlists...</span>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_friendsWishlistLoadError))
                {
                    <div class="alert alert-danger" role="alert">
                        @_friendsWishlistLoadError
                    </div>
                }
                else if (friendsWishlists?.Any() == true)
                {
                    <div class="row">
                        @foreach (var wishlist in friendsWishlists)
                        {
                            <div class="col-md-6 col-lg-4 mb-3">
                                <WishlistCard Wishlist="@wishlist" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <OpenWishIcon Name="info-circle" Class="me-2" />
                        No public wishlists from your friends yet. When your friends create public wishlists, they'll appear here.
                    </div>
                }
            </div>
    </div>
</div>


@code {
    private IEnumerable<WishlistModel>? wishlists;
    private IReadOnlyList<WishlistModel>? filteredWishlists;
    private IEnumerable<WishlistModel>? friendsWishlists;
    private string? _userId;
    private string activeTab = "my-wishlists";
    private bool loadingFriendsWishlists = false;
    private string? _wishlistLoadError;
    private string? _friendsWishlistLoadError;
    
    // Filter and sort properties
    private string searchTerm = "";
    private string filterBy = "all";
    private string sortBy = "nameAsc";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _userId = await UserContextService.GetUserIdAsync();
            if (_userId != null)
            {
                await LoadWishlists();
            }
            else
            {
                // During SSR, authentication might not be ready yet
                // The component will re-render when it becomes interactive
                wishlists = new List<WishlistModel>();
                ApplyFiltersAndSort();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing the Index component.");
            _wishlistLoadError = "Your wishlists could not be loaded. Refresh the page to try again.";
            wishlists = new List<WishlistModel>();
            ApplyFiltersAndSort();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && (_userId == null || !wishlists?.Any() == true))
        {
            // If we didn't get user data during SSR, try again after first render
            try
            {
                _userId = await UserContextService.GetUserIdAsync();
                if (_userId != null)
                {
                    await LoadWishlists();
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error loading user data after first render.");
                _wishlistLoadError = "Your wishlists could not be loaded. Refresh the page to try again.";
                StateHasChanged();
            }
        }
    }

    private async Task SetActiveTab(string tab)
    {
        activeTab = tab;
        
        if (tab == "friends-wishlists" && friendsWishlists == null)
        {
            await LoadFriendsWishlists();
        }
        
        StateHasChanged();
    }

    private async Task LoadWishlists()
    {
        if (!string.IsNullOrWhiteSpace(_userId))
        {
            _wishlistLoadError = null;
            wishlists = await WishlistService.GetUserWishlistsAsync(_userId);
            ApplyFiltersAndSort();
        }
    }

    private async Task LoadFriendsWishlists()
    {
        Logger.LogInformation("Loading friends' wishlists.");
        try
        {
            loadingFriendsWishlists = true;
            _friendsWishlistLoadError = null;
            if (_userId != null)
            {
                friendsWishlists = await WishlistService.GetFriendsWishlistsAsync(_userId);
            }
            else
            {
                // If userId is null (e.g., during SSR), retry getting it
                _userId = await UserContextService.GetUserIdAsync();
                if (_userId != null)
                {
                    friendsWishlists = await WishlistService.GetFriendsWishlistsAsync(_userId);
                }
                else
                {
                    friendsWishlists = new List<WishlistModel>();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading friends' wishlists");
            _friendsWishlistLoadError = "Friends' wishlists could not be loaded. Refresh the page to try again.";
            friendsWishlists = new List<WishlistModel>();
        }
        finally
        {
            loadingFriendsWishlists = false;
            Logger.LogInformation("Finished loading friends' wishlists.");
            StateHasChanged();
        }
    }

    private void ApplyFiltersAndSort()
    {
        if (wishlists == null)
        {
            filteredWishlists = [];
            return;
        }

        // Apply filters
        var filtered = wishlists;
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            filtered = filtered.Where(w => 
                w.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        if (filterBy == "collaborative")
        {
            filtered = filtered.Where(w => w.IsCollaborative);
        }
        else if (filterBy == "private")
        {
            filtered = filtered.Where(w => w.IsPrivate);
        }

        // Apply sorting
        filtered = sortBy switch
        {
            "nameAsc" => filtered.OrderBy(w => w.Name),
            "nameDesc" => filtered.OrderByDescending(w => w.Name),
            "recent" => filtered.OrderByDescending(w => w.CreatedOn),
            "oldest" => filtered.OrderBy(w => w.CreatedOn),
            "itemCount" => filtered.OrderByDescending(w => w.ItemCount),
            _ => filtered.OrderBy(w => w.Name)
        };

        filteredWishlists = filtered.ToList();
    }

    private void HandleSearch()
    {
        ApplyFiltersAndSort();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        ApplyFiltersAndSort();
    }

    private void HandleSort()
    {
        ApplyFiltersAndSort();
    }

    private async Task HandleWishlistDeleted(WishlistModel wishlist)
    {
        await LoadWishlists();
    }
}
