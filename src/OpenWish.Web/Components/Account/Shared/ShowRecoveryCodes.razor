<StatusMessage Message="@StatusMessage" />
<h3>Save your recovery codes</h3>
<div class="alert alert-warning" role="alert">
    <strong>Store these codes somewhere private before leaving this page.</strong>
    Each code works once when you cannot use your authenticator app. They will not be shown again.
</div>
<ul class="list-unstyled row row-cols-1 row-cols-sm-2 g-2" aria-label="Recovery codes">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <li class="col"><code class="recovery-code d-block p-2">@recoveryCode</code></li>
    }
</ul>
<a class="btn btn-primary mt-3" href="Account/Manage/TwoFactorAuthentication">Done saving codes</a>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
