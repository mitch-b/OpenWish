@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IEventService EventService
@inject ILogger<ExchangeReveal> Logger

@if (RevealedOn.HasValue || IsOwner)
{
    <section class="exchange-reveal" aria-labelledby="exchange-reveal-title" aria-busy="@(_busy || _loading ? "true" : "false")" data-testid="exchange-reveal">
        <h2 id="exchange-reveal-title" class="exchange-reveal-title">
            <OpenWishIcon Name="gift" />
            <span>Who drew whom</span>
        </h2>

        @if (RevealedOn.HasValue)
        {
            <p class="exchange-reveal-lead">The organizer revealed every match on @RevealedOn.Value.ToLocalTime().ToString("MMMM d, yyyy").</p>
            @if (_loading)
            {
                <div class="exchange-reveal-status" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> <span>Loading who drew whom...</span></div>
            }
            else if (_errorMessage is not null)
            {
                <div class="alert alert-danger mb-0" role="alert">
                    <p class="mb-2">@_errorMessage</p>
                    <button type="button" class="btn btn-outline-danger" disabled="@(!RendererInfo.IsInteractive)" @onclick="LoadPairings">Try again</button>
                </div>
            }
            else if (_pairings.Count == 0)
            {
                <p class="exchange-reveal-lead mb-0">No matches to show for this exchange.</p>
            }
            else
            {
                <ul class="reveal-list">
                    @foreach (var pairing in _pairings)
                    {
                        <li>
                            <span class="reveal-giver">@pairing.GiverName</span>
                            <span class="reveal-arrow" aria-hidden="true"><OpenWishIcon Name="arrow-right" /></span>
                            <span class="visually-hidden">drew</span>
                            <span class="reveal-receiver">@pairing.ReceiverName</span>
                        </li>
                    }
                </ul>
            }
        }
        else if (!IsPast)
        {
            <p class="exchange-reveal-lead mb-0">Every match stays private for now. After the event on @EventDate.ToString("MMM d, yyyy"), you can reveal who drew whom to the group.</p>
        }
        else
        {
            <p class="exchange-reveal-lead">The event has passed. Reveal who drew whom so everyone can see how the exchange played out. Until then, every match stays private.</p>
            @if (_errorMessage is not null)
            {
                <div class="alert alert-danger" role="alert">@_errorMessage</div>
            }
            @if (_confirming)
            {
                <div class="exchange-reveal-confirm" role="group" aria-labelledby="exchange-reveal-confirm-title">
                    <p id="exchange-reveal-confirm-title" class="exchange-reveal-confirm-title">Show every match to the whole group?</p>
                    <p class="exchange-reveal-confirm-copy">Everyone in the exchange will see who drew whom. This can't be undone, and the draw can no longer be reset.</p>
                    <div class="exchange-reveal-actions">
                        <button type="button" class="btn btn-outline-secondary" id="exchange-reveal-cancel" disabled="@(_busy || !RendererInfo.IsInteractive)" @onclick="CancelReveal">Keep private</button>
                        <button type="button" class="btn btn-primary" disabled="@(_busy || !RendererInfo.IsInteractive)" @onclick="Reveal">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>Revealing...</span>
                            }
                            else
                            {
                                <OpenWishIcon Name="eye" />
                                <span>Reveal to everyone</span>
                            }
                        </button>
                    </div>
                    <FocusOnFirstRender ElementId="exchange-reveal-cancel" />
                </div>
            }
            else
            {
                <button type="button" class="btn btn-primary exchange-reveal-start" id="exchange-reveal-start" disabled="@(!RendererInfo.IsInteractive)" @onclick="StartReveal">
                    <OpenWishIcon Name="eye" />
                    <span>Reveal assignments</span>
                </button>
                <p class="exchange-reveal-note">You'll confirm before anything is shared.</p>
                <FocusOnFirstRender ElementId="exchange-reveal-start" Enabled="@_returnFocus" />
            }
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public string EventId { get; set; } = string.Empty;
    [Parameter] public DateTimeOffset EventDate { get; set; }
    [Parameter] public bool IsOwner { get; set; }
    [Parameter] public DateTimeOffset? RevealedOn { get; set; }
    [Parameter] public string CurrentUserId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnRevealed { get; set; }

    private List<RevealedPairingModel> _pairings = [];
    private bool _loading;
    private bool _busy;
    private bool _confirming;
    private bool _returnFocus;
    private string? _errorMessage;
    private bool? _loadedForRevealed;

    private bool IsPast => EventDate <= DateTimeOffset.UtcNow;

    protected override async Task OnParametersSetAsync()
    {
        var revealed = RevealedOn.HasValue;
        if (revealed && _loadedForRevealed != true)
        {
            _loadedForRevealed = true;
            await LoadPairings();
        }
        else if (!revealed)
        {
            _loadedForRevealed = false;
        }
    }

    private async Task LoadPairings()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _pairings = (await EventService.GetRevealedPairingsByPublicIdAsync(EventId, CurrentUserId)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load revealed pairings for event {EventPublicId}", EventId);
            _errorMessage = "We couldn't load the assignments. Try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartReveal()
    {
        _errorMessage = null;
        _confirming = true;
    }

    private void CancelReveal()
    {
        _confirming = false;
        _returnFocus = true;
    }

    private async Task Reveal()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _errorMessage = null;
        try
        {
            await EventService.RevealGiftExchangeByPublicIdAsync(EventId, CurrentUserId);
            await OnRevealed.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to reveal the gift exchange for event {EventPublicId}", EventId);
            _errorMessage = "We couldn't reveal the assignments. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
