@using OpenWish.Web.Client.CustomEvents
@implements IAsyncDisposable

@inject IProductService ProductService
@inject IJSRuntime JSRuntime
@inject ILogger<WishlistItemModal> Logger

@if (IsVisible)
{
    <div class="modal-backdrop" data-dialog-background-allowed @onclick="Cancel"></div>
    <div class="modal-dialog-container"
         id="wishlist-item-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="wishlist-item-dialog-title"
         @onclick:stopPropagation="true">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="wishlist-item-dialog-title" class="modal-title">@(Model?.Id > 0 ? "Edit item" : "Add item")</h5>
                <button type="button"
                        class="btn-close"
                        data-dialog-close
                        @onclick="Cancel"
                        aria-label="Close"
                        disabled="@IsBusy"></button>
            </div>
            <div class="modal-body">
                <div class="url-import-section mb-4" aria-busy="@_isImporting">
                    <label for="product-url-import-modal" class="form-label">Product URL</label>
                    <div class="input-group">
                        <input id="product-url-import-modal"
                               class="form-control"
                               type="url"
                               inputmode="url"
                               autocomplete="url"
                               aria-describedby="product-url-import-modal-help"
                               data-dialog-initial-focus
                               placeholder="Paste a product URL"
                               value="@ImportUrl"
                               @oninput="UpdateImportUrl"
                               @onopenwishpaste="HandleUrlPaste"
                               disabled="@IsBusy" />
                        <button class="btn btn-primary"
                                type="button"
                                @onclick="ImportFromUrl"
                                disabled="@(IsBusy || string.IsNullOrWhiteSpace(ImportUrl))">
                            @if (_isImporting)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>Importing...</span>
                            }
                            else
                            {
                                <OpenWishIcon Name="download" />
                                <span>Import</span>
                            }
                        </button>
                    </div>
                    <small id="product-url-import-modal-help" class="text-muted">Paste a product URL to fill in details, or enter them manually below.</small>
                    @if (_isImporting)
                    {
                        <div class="alert alert-info mt-2 mb-0" role="status">Importing product details...</div>
                    }
                    else if (_showImportMessage && !string.IsNullOrEmpty(_importMessage))
                    {
                        <div class="alert @ImportMessageClass mt-2 mb-0" role="@(_importFailed ? "alert" : "status")">
                            @_importMessage
                        </div>
                    }
                </div>

                <EditForm Model="@Model"
                          OnValidSubmit="@HandleSubmit"
                          FormName="WishlistItemModal"
                          aria-busy="@_isSubmitting">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    @if (!string.IsNullOrWhiteSpace(_saveError))
                    {
                        <div class="alert alert-danger" role="alert">@_saveError</div>
                    }

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
                                <InputText id="name" class="form-control" @bind-Value="@Model!.Name" placeholder="e.g., Wireless Headphones" />
                                <ValidationMessage For="@(() => Model.Name)" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="priority" class="form-label">Priority</label>
                                <InputSelect id="priority" class="form-select" @bind-Value="@Model!.Priority">
                                    <option value="">None</option>
                                    <option value="1">High</option>
                                    <option value="2">Medium</option>
                                    <option value="3">Low</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <InputTextArea id="description" class="form-control" rows="3" @bind-Value="@Model!.Description" placeholder="Add any details, preferences, or specifications..." />
                        <ValidationMessage For="@(() => Model.Description)" />
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="price" class="form-label">Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <InputNumber id="price" class="form-control" @bind-Value="@Model!.Price" placeholder="0.00" />
                                </div>
                                <ValidationMessage For="@(() => Model.Price)" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="whereToBuy" class="form-label">Where to Buy</label>
                                <InputText id="whereToBuy" class="form-control" @bind-Value="@Model!.WhereToBuy" placeholder="e.g., Amazon, Target" />
                                <ValidationMessage For="@(() => Model.WhereToBuy)" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="url" class="form-label">Product Link</label>
                        <InputText id="url" class="form-control" type="url" inputmode="url" autocomplete="url" @bind-Value="@Model!.Url" placeholder="https://..." />
                        <ValidationMessage For="@(() => Model.Url)" />
                    </div>

                    <div class="mb-3 form-check">
                        <InputCheckbox id="isPrivate" class="form-check-input" @bind-Value="@Model!.IsPrivate" />
                        <label class="form-check-label" for="isPrivate">
                            Make this item private (only you can see it)
                        </label>
                        <ValidationMessage For="@(() => Model.IsPrivate)" />
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-dialog-close
                                @onclick="Cancel"
                                disabled="@IsBusy">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@IsBusy">
                            @if (_isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>@(Model.Id > 0 ? "Saving changes..." : "Adding item...")</span>
                            }
                            else
                            {
                                <OpenWishIcon Name="check-lg" />
                                <span>@(Model.Id > 0 ? "Save changes" : "Add item")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public WishlistItemModel? Model { get; set; } = new();
    [Parameter] public EventCallback<WishlistItemModel> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsVisible { get; set; }

    private bool _isImporting;
    private bool _isSubmitting;
    private string ImportUrl { get; set; } = string.Empty;
    private string _importMessage = string.Empty;
    private bool _showImportMessage;
    private bool _importSuccess;
    private bool _importFailed;
    private string? _saveError;
    private bool _dialogActive;
    private bool IsBusy => _isImporting || _isSubmitting;
    private string ImportMessageClass => _importFailed
        ? "alert-danger"
        : _importSuccess
            ? "alert-success"
            : "alert-info";

    private void UpdateImportUrl(ChangeEventArgs eventArgs)
    {
        ImportUrl = eventArgs.Value?.ToString() ?? string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && !_dialogActive)
        {
            await JSRuntime.InvokeVoidAsync("openWishActivateDialog", "wishlist-item-dialog");
            _dialogActive = true;
        }
    }

    public void Show(WishlistItemModel? model = null)
    {
        Model = model ?? new WishlistItemModel();
        ImportUrl = string.Empty;
        _showImportMessage = false;
        _importMessage = string.Empty;
        _saveError = null;
        IsVisible = true;
        StateHasChanged();
    }

    private async Task HideAsync()
    {
        if (_dialogActive)
        {
            await JSRuntime.InvokeVoidAsync("openWishDeactivateDialog", "wishlist-item-dialog");
            _dialogActive = false;
        }

        IsVisible = false;
        ImportUrl = string.Empty;
        _showImportMessage = false;
        _importMessage = string.Empty;
        StateHasChanged();
    }

    private async Task ImportFromUrl()
    {
        if (_isImporting || _isSubmitting || string.IsNullOrWhiteSpace(ImportUrl))
        {
            return;
        }

        await ProcessUrlImport(ImportUrl);
    }

    private async Task HandleUrlPaste(OpenWishPasteEventArgs e)
    {
        if (_isImporting || _isSubmitting)
        {
            return;
        }

        ImportUrl = e.PastedData ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(ImportUrl))
        {
            await ProcessUrlImport(ImportUrl);
        }
    }

    private async Task ProcessUrlImport(string url)
    {
        if (_isImporting || Model is null)
        {
            return;
        }

        if (!Uri.TryCreate(url.Trim(), UriKind.Absolute, out var productUri) ||
            (productUri.Scheme != Uri.UriSchemeHttp && productUri.Scheme != Uri.UriSchemeHttps))
        {
            _importMessage = "Enter a complete product link that starts with http:// or https://.";
            _importSuccess = false;
            _importFailed = true;
            _showImportMessage = true;
            return;
        }

        var normalizedUrl = productUri.AbsoluteUri;
        ImportUrl = normalizedUrl;
        _showImportMessage = false;
        _importFailed = false;

        try
        {
            _isImporting = true;
            StateHasChanged();
            await Task.Yield();

            var product = await ProductService.TryScrapeProductFromUrl(normalizedUrl);
            var importedDetails = false;

            if (string.IsNullOrWhiteSpace(Model.Url))
            {
                Model.Url = normalizedUrl;
            }

            if (string.IsNullOrWhiteSpace(Model.WhereToBuy))
            {
                Model.WhereToBuy = productUri.Host.Replace("www.", "", StringComparison.OrdinalIgnoreCase);
            }

            if (product != null)
            {
                if (string.IsNullOrWhiteSpace(Model.Name) && !string.IsNullOrWhiteSpace(product.Name))
                {
                    Model.Name = product.Name;
                    importedDetails = true;
                }

                if (string.IsNullOrWhiteSpace(Model.Description) && !string.IsNullOrWhiteSpace(product.Description))
                {
                    Model.Description = product.Description;
                    importedDetails = true;
                }

                if (!Model.Price.HasValue && product.Price.HasValue)
                {
                    Model.Price = product.Price;
                    importedDetails = true;
                }

                if (!Model.Priority.HasValue)
                {
                    Model.Priority = 2;
                }

                _importMessage = importedDetails
                    ? "Product details imported. Review them before saving."
                    : "No product details were found. The product link is ready; add any details you want.";
                _importSuccess = importedDetails;
            }
            else
            {
                _importMessage = "We couldn't import product details. The link is still here so you can try again.";
                _importSuccess = false;
                _importFailed = true;
            }

            _showImportMessage = true;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Failed to import product details from {ProductHost}", productUri.Host);
            _importMessage = "We couldn't import product details. The link is still here so you can try again.";
            _importSuccess = false;
            _importFailed = true;
            _showImportMessage = true;
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogError(ex, "Product import timed out for {ProductHost}", productUri.Host);
            _importMessage = "We couldn't import product details. The link is still here so you can try again.";
            _importSuccess = false;
            _importFailed = true;
            _showImportMessage = true;
        }
        finally
        {
            _isImporting = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        if (_isSubmitting || _isImporting || Model is null)
        {
            return;
        }

        _isSubmitting = true;
        _saveError = null;
        StateHasChanged();
        await Task.Yield();

        var saved = false;
        try
        {
            if (!OnSubmit.HasDelegate)
            {
                throw new InvalidOperationException("The item dialog does not have a save handler.");
            }

            await OnSubmit.InvokeAsync(Model);
            saved = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save wishlist item {WishlistItemId}", Model.Id);
            _saveError = Model.Id > 0
                ? "We couldn't save these changes. Review the details and try again."
                : "We couldn't add this item. Review the details and try again.";
        }
        finally
        {
            _isSubmitting = false;
        }

        if (saved)
        {
            await HideAsync();
        }
    }

    private async Task Cancel()
    {
        if (IsBusy)
        {
            return;
        }

        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }

        await HideAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (!_dialogActive)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("openWishDeactivateDialog", "wishlist-item-dialog");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
