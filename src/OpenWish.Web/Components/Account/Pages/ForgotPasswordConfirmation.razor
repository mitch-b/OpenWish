@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Check your email</PageTitle>

<div class="auth-page auth-page-compact">
    <header class="auth-heading">
        <span class="auth-mark"><OpenWishIcon Name="envelope" /></span>
        <div>
            <h1>Check your email</h1>
            <p>Your reset link is on its way.</p>
        </div>
    </header>
    <section class="auth-card">
        <p class="auth-card-text" role="status">If an account matches the address you entered, we sent a link to choose a new password.</p>
        <p class="auth-card-text text-muted">It can take a few minutes to arrive. Can't find it? Check spam or junk, or request another link.</p>
        <div class="auth-actions">
            <a class="btn btn-primary" href="Account/Login">Back to sign in</a>
            <a class="btn btn-outline-secondary" href="Account/ForgotPassword">Send another link</a>
        </div>
    </section>
</div>
