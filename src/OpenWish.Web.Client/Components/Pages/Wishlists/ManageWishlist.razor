@attribute [Authorize]
@page "/wishlists/{WishlistId}/manage"
@using OpenWish.Web.Client.Components.Wishlist
@using OpenWish.Shared.Models
@using System.Collections.Generic
@using System.Linq
@using System.Net.Http

@inject IWishlistService WishlistService
@inject IFriendService FriendService
@inject ICircleService CircleService
@inject NavigationManager NavigationManager
@inject IUserContextService UserContextService
@inject ILogger<ManageWishlist> Logger
@inject IEventService EventService

@rendermode InteractiveAuto

<PageTitle>@(_wishlist is null ? "Manage wishlist" : $"Manage {_wishlist.Name}")</PageTitle>

<div class="container page-shell">
<PageHeader Title="Manage wishlist" Description="@_wishlist?.Name">
    <Actions>
        <a href="/wishlists/@WishlistId" class="btn btn-outline-secondary page-header-back">
            <OpenWishIcon Name="arrow-left" /> Back to wishlist
        </a>
    </Actions>
</PageHeader>

@if (_loadingWishlist)
{
    <div class="loading-state" role="status">
        <span class="spinner-border text-primary" aria-hidden="true"></span>
        <span>Loading wishlist settings...</span>
    </div>
}
else if (_loadErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">
        <p class="mb-2">@_loadErrorMessage</p>
        <button class="btn btn-outline-danger" type="button" disabled="@(!RendererInfo.IsInteractive)" @onclick="LoadWishlistAsync">
            Try again
        </button>
    </div>
}
else if (_wishlist is null)
{
    <div class="alert alert-danger" role="alert">
        This wishlist is unavailable. Return to your wishlists and try again.
    </div>
}
else if (!_isOwner)
{
    <div class="alert alert-danger" role="alert">
        You don't have permission to manage this wishlist.
    </div>
}
else
{
    <PageSections Label="Wishlist settings sections" Items="Sections" Active="@ActiveSection">
        <div class="page-section-panel manage-wishlist-details" hidden="@(ActiveSection != "details")">
            <h2 class="h4">Wishlist details</h2>
            <p class="manage-wishlist-intro">Rename the list, pick an icon, and choose who can see it.</p>
            <WishlistForm Model="_wishlist" OnSubmit="HandleSubmit" IsSubmitting="@_savingDetails">
                <StatusContent>
                    @if (!string.IsNullOrEmpty(_detailsStatusMessage))
                    {
                        <div class="alert alert-success manage-wishlist-feedback" role="status" aria-live="polite">
                            <OpenWishIcon Name="check-circle" /> <span>@_detailsStatusMessage</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_detailsErrorMessage))
                    {
                        <div class="alert alert-danger manage-wishlist-feedback" role="alert">
                            <OpenWishIcon Name="exclamation-circle" /> <span>@_detailsErrorMessage</span>
                        </div>
                    }
                </StatusContent>
            </WishlistForm>
        </div>

        <div class="page-section-panel friends-access-card" hidden="@(ActiveSection != "sharing")"
             aria-busy="@(_loadingFriendsWithAccess || _loadingAvailableFriends || _sharingBusy ? "true" : "false")">
            <h2 class="h4">Who can see this?</h2>

            <div class="visibility-status">
                @if (_wishlist.IsPrivate)
                {
                    <span class="status-badge status-private"><OpenWishIcon Name="lock" /> Private</span>
                }
                else if (_wishlist.IsFriendsOnly)
                {
                    <span class="status-badge status-specific"><OpenWishIcon Name="person-check" /> Specific friends</span>
                }
                else
                {
                    <span class="status-badge status-all"><OpenWishIcon Name="people" /> All friends</span>
                }
                @if (!_loadingFriendsWithAccess && _friendsLoadErrorMessage is null && _friendsWithAccess.Count > 0)
                {
                    <span class="friend-count">@_friendsWithAccess.Count friend@(_friendsWithAccess.Count != 1 ? "s" : "") can see this</span>
                }
            </div>
            <p class="manage-wishlist-intro" data-testid="sharing-summary">
                @SharingSummary
                <a href="@DetailsSectionHref" class="manage-wishlist-change-link"
                   data-enhance-nav="@(RendererInfo.IsInteractive ? null : "false")">Change visibility</a>
            </p>

            @if (_loadingFriendsWithAccess)
            {
                <div class="loading-state" role="status">
                    <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                    <span>Loading who can see this list...</span>
                </div>
            }
            else if (_friendsLoadErrorMessage is not null)
            {
                <div class="alert alert-danger" role="alert">
                    <p class="mb-2">@_friendsLoadErrorMessage</p>
                    <button class="btn btn-outline-danger" type="button"
                            disabled="@(!RendererInfo.IsInteractive)"
                            @onclick="RefreshFriendsWithAccessAsync">
                        Try again
                    </button>
                </div>
            }
            else if (_friendsWithAccess.Count == 0)
            {
                @if (_wishlist.IsFriendsOnly)
                {
                    <div class="empty-state-card">
                        <div class="empty-icon"><OpenWishIcon Name="person-check" /></div>
                        <div>
                            <h3 class="h6">No one has access yet</h3>
                            <p>Choose friends or a circle below when you're ready to share.</p>
                        </div>
                    </div>
                }
                else if (!_wishlist.IsPrivate)
                {
                    <div class="empty-state-card">
                        <div class="empty-icon"><OpenWishIcon Name="people" /></div>
                        <div>
                            <h3 class="h6">Add friends to share this list</h3>
                            <p>Once you add friends, they'll be able to see this wishlist.</p>
                            <a href="/friends?section=invite" class="btn btn-primary">
                                <OpenWishIcon Name="person-plus" /> Find friends
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <ul class="friends-grid" aria-label="Friends who can see this list">
                    @foreach (var friend in _friendsWithAccess)
                    {
                        <li class="friend-chip">
                            <span class="friend-avatar" aria-hidden="true">
                                @((friend.UserName ?? friend.Email ?? "?")[0].ToString().ToUpper())
                            </span>
                            <span class="friend-chip-text">
                                <span class="friend-name">@(friend.UserName ?? friend.Email ?? "Unknown")</span>
                                @if (CircleNamesFor(friend) is { Count: > 0 } viaCircles)
                                {
                                    <span class="badge circle-badge" data-testid="friend-via-circle">via @CircleRules.JoinNames(viaCircles)</span>
                                }
                            </span>
                            @if (_wishlist.IsFriendsOnly || _wishlist.IsPrivate)
                            {
                                var friendName = GetFriendName(friend);
                                <button class="remove-btn"
                                        type="button"
                                        @onclick="() => RemoveFriendAccess(friend.Id!)"
                                        disabled="@(_sharingBusy || !RendererInfo.IsInteractive)"
                                        aria-label="Remove access for @friendName"
                                        title="Remove access">
                                    <OpenWishIcon Name="x-lg" />
                                </button>
                            }
                        </li>
                    }
                </ul>
            }

            @if (_friendsLoadErrorMessage is null && _wishlist.IsFriendsOnly && _loadingAvailableFriends)
            {
                <div class="loading-state" role="status">
                    <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                    <span>Loading friends to share with...</span>
                </div>
            }
            else if (_friendsLoadErrorMessage is null &&
                     _wishlist.IsFriendsOnly &&
                     _availableFriendsLoadErrorMessage is not null)
            {
                <div class="alert alert-danger" role="alert">
                    <p class="mb-2">@_availableFriendsLoadErrorMessage</p>
                    <button class="btn btn-outline-danger" type="button"
                            disabled="@(!RendererInfo.IsInteractive)"
                            @onclick="RefreshAvailableFriendsAsync">
                        Try again
                    </button>
                </div>
            }
            else if (_friendsLoadErrorMessage is null &&
                     _wishlist.IsFriendsOnly &&
                     _availableFriendsToShare.Count > 0)
            {
                <div class="add-friend-section">
                    <h3 class="add-friend-header">
                        <OpenWishIcon Name="person-plus" />
                        <span>Add a friend</span>
                    </h3>
                    <div class="add-friend-form">
                        <label class="form-label" for="friend-access-select">Friend to share with</label>
                        <select id="friend-access-select"
                                class="form-select friend-select"
                                @bind="_selectedFriendToShareId"
                                disabled="@_sharingBusy">
                            <option value="">Choose a friend...</option>
                            @foreach (var friend in _availableFriendsToShare)
                            {
                                <option value="@friend.Id">@(friend.UserName ?? friend.Email ?? "Unknown")</option>
                            }
                        </select>
                        <button class="btn btn-primary btn-add"
                                type="button"
                                disabled="@(string.IsNullOrEmpty(_selectedFriendToShareId) || _sharingBusy || !RendererInfo.IsInteractive)"
                                @onclick="AddFriendAccess">
                            @if (_sharingBusy)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>Sharing...</span>
                            }
                            else
                            {
                                <OpenWishIcon Name="share" />
                                <span>Share</span>
                            }
                        </button>
                    </div>
                </div>
            }

            @if (_friendsLoadErrorMessage is null && _wishlist.IsFriendsOnly)
            {
                <div class="add-friend-section circle-share-section" data-testid="circle-share">
                    <h3 class="add-friend-header">
                        <OpenWishIcon Name="people-fill" />
                        <span>Share with a circle</span>
                    </h3>
                    @if (_circles.Count == 0)
                    {
                        <p class="text-muted mb-0">Group friends into a circle, like Family, to share this list with all of them at once.
                            <a href="/friends?section=circles">Create a circle</a></p>
                    }
                    else
                    {
                        @if (SharingCircles.Count > 0)
                        {
                            <ul class="list-unstyled circle-share-list">
                                @foreach (var circle in SharingCircles)
                                {
                                    <li>
                                        <span><strong>@circle.Name</strong> (@circle.Members.Count) can see this list, including friends who join later.</span>
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                disabled="@(_circleBusy || !RendererInfo.IsInteractive)"
                                                aria-label="Stop sharing with @circle.Name"
                                                @onclick="() => UnshareWithCircleAsync(circle)">Stop sharing</button>
                                    </li>
                                }
                            </ul>
                        }

                        @if (AvailableCircles.Count > 0)
                        {
                            <div class="add-friend-form">
                                <label class="form-label" for="circle-share-select">Circle to share with</label>
                                <select id="circle-share-select" class="form-select friend-select"
                                        @bind="_selectedCircleId" disabled="@_circleBusy">
                                    <option value="">Choose a circle...</option>
                                    @foreach (var circle in AvailableCircles)
                                    {
                                        <option value="@circle.PublicId">@circle.Name (@circle.Members.Count)</option>
                                    }
                                </select>
                                <button class="btn btn-primary btn-add" type="button"
                                        disabled="@(string.IsNullOrEmpty(_selectedCircleId) || _circleBusy || !RendererInfo.IsInteractive)"
                                        @onclick="ShareWithCircleAsync">
                                    @if (_circleBusy)
                                    {
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>Sharing...</span>
                                    }
                                    else
                                    {
                                        <OpenWishIcon Name="share" />
                                        <span>Share with circle</span>
                                    }
                                </button>
                            </div>
                        }
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_sharingStatusMessage))
            {
                <div class="alert alert-success success-toast mt-3" role="status" aria-live="polite">
                    <OpenWishIcon Name="check-circle" /> @_sharingStatusMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(_sharingErrorMessage))
            {
                <div class="alert alert-danger error-toast mt-3" role="alert">
                    <OpenWishIcon Name="exclamation-circle" /> @_sharingErrorMessage
                </div>
            }
        </div>

        <div class="page-section-panel" hidden="@(ActiveSection != "event")" aria-busy="@(_loadingEvents || _eventBusy ? "true" : "false")">
            <h2 class="h4">Event connection</h2>
            <p class="manage-wishlist-intro">Connect this list to a gift exchange or celebration so it appears with that event.</p>

            @if (!string.IsNullOrEmpty(_eventStatusMessage))
            {
                <div class="alert alert-success" role="status" aria-live="polite">@_eventStatusMessage</div>
            }

            @if (!string.IsNullOrEmpty(_eventErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@_eventErrorMessage</div>
            }

            @if (_eventLoadErrorMessage is not null)
            {
                <div class="alert alert-danger" role="alert">
                    <p class="mb-2">@_eventLoadErrorMessage</p>
                    <button class="btn btn-outline-danger" type="button"
                            disabled="@(!RendererInfo.IsInteractive)"
                            @onclick="RefreshEventsAsync">Try again</button>
                </div>
            }

            @if (_loadingEvents)
            {
                <div class="loading-state" role="status">
                    <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                    <span>Loading event connections...</span>
                </div>
            }
            else if (_attachedEvent is not null)
            {
                <div class="manage-wishlist-event">
                    <span class="manage-wishlist-event-icon" aria-hidden="true"><OpenWishIcon Name="calendar-event" /></span>
                    <div class="manage-wishlist-event-info">
                        <div class="manage-wishlist-event-name">@_attachedEvent.Name</div>
                        <div class="manage-wishlist-event-meta">
                            <span>@_attachedEvent.Date.ToString("MMMM d, yyyy")</span>
                            @if (_attachedEvent.Budget.HasValue)
                            {
                                <span>Budget @_attachedEvent.Budget.Value.ToString("C")</span>
                            }
                        </div>
                    </div>
                    <div class="manage-wishlist-event-actions">
                        <a href="/events/@_attachedEvent.PublicId" class="btn btn-outline-primary">View event</a>
                        <button class="btn btn-outline-secondary"
                                type="button"
                                disabled="@(_eventBusy || !RendererInfo.IsInteractive)"
                                aria-label="Remove this wishlist from @_attachedEvent.Name"
                                @onclick="DetachFromEventAsync">
                            @(_eventBusy ? "Removing..." : "Remove")
                        </button>
                    </div>
                </div>
                @if (_wishlist.IsPrivate)
                {
                    <p class="manage-wishlist-note" data-testid="private-event-note">
                        <OpenWishIcon Name="lock" /> This list is private, so event participants can't see it.
                        <a href="@DetailsSectionHref" data-enhance-nav="@(RendererInfo.IsInteractive ? null : "false")">Change visibility</a>
                    </p>
                }
            }
            else if (_eventLoadErrorMessage is null && _wishlist.IsPrivate)
            {
                <p class="manage-wishlist-note" data-testid="private-event-note">
                    <OpenWishIcon Name="lock" /> Private lists can't be connected to an event. Share this list with friends first.
                    <a href="@DetailsSectionHref" data-enhance-nav="@(RendererInfo.IsInteractive ? null : "false")">Change visibility</a>
                </p>
            }
            else if (_eventLoadErrorMessage is null && _availableEvents.Any())
            {
                <div class="manage-wishlist-event-attach">
                    <label class="form-label" for="event-connection-select">Attach to an event</label>
                    <div class="manage-wishlist-event-attach-row">
                        <select id="event-connection-select"
                                class="form-select"
                                @bind="_selectedEventId"
                                disabled="@_eventBusy">
                            <option value="">Choose an event...</option>
                            @foreach (var evt in _availableEvents)
                            {
                                <option value="@evt.Id">@GetEventOptionLabel(evt)</option>
                            }
                        </select>
                        <button class="btn btn-primary"
                                type="button"
                                disabled="@(!_selectedEventId.HasValue || _eventBusy || !RendererInfo.IsInteractive)"
                                @onclick="AttachToSelectedEventAsync">
                            @(_eventBusy ? "Attaching..." : "Attach")
                        </button>
                    </div>
                </div>
            }
            else if (_eventLoadErrorMessage is null)
            {
                <div class="empty-state-card">
                    <div class="empty-icon"><OpenWishIcon Name="calendar-event" /></div>
                    <div>
                        <h3 class="h6">No events to connect yet</h3>
                        <p>Create or join an event, then come back to connect this list.</p>
                        <a href="/events/new" class="btn btn-outline-secondary">
                            <OpenWishIcon Name="plus-lg" /> Create an event
                        </a>
                    </div>
                </div>
            }
        </div>
        <div class="page-section-panel" hidden="@(ActiveSection != "delete")">
            <h2 class="h4">Delete wishlist</h2>
            <div class="manage-wishlist-danger-zone">
                <p>Deleting <strong>@_wishlist.Name</strong> removes it and all of its gift ideas, for you and everyone it's shared with. This can't be undone.</p>
                <button id="manage-wishlist-delete"
                        class="btn btn-outline-danger"
                        type="button"
                        disabled="@(!RendererInfo.IsInteractive)"
                        @onclick="ShowDeleteDialog">
                    <OpenWishIcon Name="trash" /> Delete wishlist
                </button>
            </div>
        </div>
    </PageSections>
}
</div>

<WishlistDeleteDialog @ref="deleteDialog"
                      OnConfirm="HandleDeleteWishlist"
                      IsBusy="@_isDeleting"
                      ErrorMessage="@_deleteErrorMessage"
                      CloseOnConfirm="false"
                      ConfirmLabel="Delete wishlist" />


@code {
    private static readonly PageSection[] Sections =
    [
        new("details", "Wishlist details", "gear"),
        new("sharing", "Sharing", "people"),
        new("event", "Event connection", "calendar-event"),
        new("delete", "Delete wishlist", "trash"),
    ];

    [SupplyParameterFromQuery(Name = "section")] public string? Section { get; set; }
    private string ActiveSection => Sections.FirstOrDefault(item => item.Id == Section)?.Id ?? "details";

    [Parameter]
    public string WishlistId { get; set; } = string.Empty;

    private WishlistModel? _wishlist;
    private WishlistDeleteDialog deleteDialog = null!;
    private bool _savingDetails;
    private string? _detailsStatusMessage;
    private string? _detailsErrorMessage;
    private bool _isDeleting;
    private string? _deleteErrorMessage;
    private string? _currentUserId;
    private bool _isOwner;
    private bool _loadingWishlist = true;
    private string? _loadErrorMessage;
    private List<EventModel> _availableEvents = [];
    private EventModel? _attachedEvent;
    private int? _selectedEventId;
    private bool _eventBusy;
    private bool _loadingEvents;
    private string? _eventLoadErrorMessage;
    private string? _eventStatusMessage;
    private string? _eventErrorMessage;

    // Friends with access
    private List<ApplicationUserModel> _friendsWithAccess = [];
    private List<ApplicationUserModel> _allFriends = [];
    private List<ApplicationUserModel> _availableFriendsToShare = [];
    private bool _loadingFriendsWithAccess = true;
    private bool _loadingAvailableFriends;
    private string? _friendsLoadErrorMessage;
    private string? _availableFriendsLoadErrorMessage;
    private string _selectedFriendToShareId = "";
    private bool _sharingBusy;
    private string? _sharingStatusMessage;
    private string? _sharingErrorMessage;

    // Circles
    private List<CircleModel> _circles = [];
    private string _selectedCircleId = "";
    private bool _circleBusy;

    private List<CircleModel> SharingCircles =>
        _circles.Where(circle => circle.Wishlists.Any(list => list.PublicId == WishlistId)).ToList();

    private IReadOnlyList<string> CircleNamesFor(ApplicationUserModel friend) =>
        CircleRules.GetSharingCircleNames(_circles, WishlistId, friend.Id);

    private string DetailsSectionHref => NavigationManager.GetUriWithQueryParameter("section", "details");

    private string SharingSummary => _wishlist switch
    {
        { IsPrivate: true } => "Only you can see this list.",
        { IsFriendsOnly: true } => "Only the friends and circles you choose can see this list.",
        _ => "Everyone in your friend list can see this list.",
    };

    private List<CircleModel> AvailableCircles =>
        _circles.Where(circle => circle.Wishlists.All(list => list.PublicId != WishlistId)).ToList();

    protected override Task OnInitializedAsync() => LoadWishlistAsync();

    private async Task LoadWishlistAsync()
    {
        _loadingWishlist = true;
        _loadErrorMessage = null;

        try
        {
            _currentUserId = await UserContextService.GetUserIdAsync();
            _wishlist = await WishlistService.GetWishlistByPublicIdAsync(WishlistId, _currentUserId);
            await SetupSecurity();

            if (_isOwner)
            {
                await Task.WhenAll(RefreshEventsAsync(), RefreshFriendsWithAccessAsync(), RefreshCirclesAsync());
            }
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo("/wishlists", replace: true);
        }
        catch (KeyNotFoundException)
        {
            NavigationManager.NavigateTo("/wishlists", replace: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load wishlist management for {WishlistId}", WishlistId);
            _loadErrorMessage = "We couldn't load this wishlist's settings. Try again.";
        }
        finally
        {
            _loadingWishlist = false;
        }
    }

    private Task SetupSecurity()
    {
        if (_wishlist == null || string.IsNullOrEmpty(_currentUserId))
            return Task.CompletedTask;

        _isOwner = _wishlist.OwnerId == _currentUserId;
        return Task.CompletedTask;
    }

    private async Task RefreshCirclesAsync()
    {
        try
        {
            _circles = (await CircleService.GetCirclesAsync(_currentUserId!)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load circles for wishlist {WishlistId}", WishlistId);
            _circles = [];
        }
    }

    private Task ShareWithCircleAsync() =>
        ChangeCircleSharingAsync(
            _selectedCircleId,
            circle => CircleService.ShareWishlistAsync(_currentUserId!, circle, WishlistId),
            circle => $"Shared with {circle.Name}. Friends who join it later will see this list too.");

    private Task UnshareWithCircleAsync(CircleModel circle) =>
        ChangeCircleSharingAsync(
            circle.PublicId,
            id => CircleService.UnshareWishlistAsync(_currentUserId!, id, WishlistId),
            updated => $"Stopped sharing with {updated.Name}.");

    private async Task ChangeCircleSharingAsync(string circlePublicId, Func<string, Task<CircleModel>> action, Func<CircleModel, string> message)
    {
        if (_circleBusy || string.IsNullOrEmpty(circlePublicId))
        {
            return;
        }

        _circleBusy = true;
        _sharingStatusMessage = null;
        _sharingErrorMessage = null;
        try
        {
            var updated = await action(circlePublicId);
            _selectedCircleId = "";
            await RefreshCirclesAsync();
            await RefreshFriendsWithAccessAsync();
            _sharingStatusMessage = message(updated);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or KeyNotFoundException)
        {
            _sharingErrorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to change circle sharing for wishlist {WishlistId}", WishlistId);
            _sharingErrorMessage = "We couldn't change sharing for that circle. Try again.";
        }
        finally
        {
            _circleBusy = false;
        }
    }

    private async Task RefreshFriendsWithAccessAsync()
    {
        if (string.IsNullOrEmpty(_currentUserId) || _wishlist == null)
        {
            _friendsWithAccess.Clear();
            _loadingFriendsWithAccess = false;
            return;
        }

        try
        {
            _loadingFriendsWithAccess = true;
            _friendsLoadErrorMessage = null;

            _friendsWithAccess = (await WishlistService.GetFriendsWithAccessByPublicIdAsync(WishlistId)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load friends with access for wishlist {WishlistId}", WishlistId);
            _friendsWithAccess.Clear();
            _allFriends.Clear();
            _availableFriendsToShare.Clear();
            _availableFriendsLoadErrorMessage = null;
            _friendsLoadErrorMessage = "We couldn't load who can see this wishlist. Try again.";
            return;
        }
        finally
        {
            _loadingFriendsWithAccess = false;
        }

        if (_wishlist.IsFriendsOnly)
        {
            await RefreshAvailableFriendsAsync();
        }
        else
        {
            _allFriends.Clear();
            _availableFriendsToShare.Clear();
            _availableFriendsLoadErrorMessage = null;
        }
    }

    private async Task RefreshAvailableFriendsAsync()
    {
        if (string.IsNullOrEmpty(_currentUserId))
        {
            return;
        }

        try
        {
            _loadingAvailableFriends = true;
            _availableFriendsLoadErrorMessage = null;
            _allFriends = (await FriendService.GetFriendsAsync(_currentUserId)).ToList();

            var friendsWithAccessIds = _friendsWithAccess.Select(friend => friend.Id).ToHashSet();
            _availableFriendsToShare = _allFriends
                .Where(friend => !friendsWithAccessIds.Contains(friend.Id))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load available friends for wishlist {WishlistId}", WishlistId);
            _allFriends.Clear();
            _availableFriendsToShare.Clear();
            _availableFriendsLoadErrorMessage = "We couldn't load friends to share with. Try again.";
        }
        finally
        {
            _loadingAvailableFriends = false;
        }
    }

    private async Task AddFriendAccess()
    {
        if (string.IsNullOrEmpty(_selectedFriendToShareId) || _wishlist == null || _sharingBusy)
        {
            return;
        }

        try
        {
            _sharingBusy = true;
            _sharingErrorMessage = null;
            _sharingStatusMessage = null;

            await WishlistService.ShareWishlistByPublicIdAsync(WishlistId, _selectedFriendToShareId, "View");

            var friendName = _allFriends.FirstOrDefault(f => f.Id == _selectedFriendToShareId)?.UserName ?? "Friend";
            _sharingStatusMessage = $"Access granted to {friendName}.";
            _selectedFriendToShareId = "";

            await RefreshFriendsWithAccessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add friend access for wishlist {WishlistId}", WishlistId);
            _sharingErrorMessage = "Failed to grant access. Please try again.";
        }
        finally
        {
            _sharingBusy = false;
            StateHasChanged();
        }
    }

    private async Task RemoveFriendAccess(string friendId)
    {
        if (string.IsNullOrEmpty(friendId) || _wishlist == null || _sharingBusy)
        {
            return;
        }

        try
        {
            _sharingBusy = true;
            _sharingErrorMessage = null;
            _sharingStatusMessage = null;

            var removed = await WishlistService.RemoveWishlistPermissionByPublicIdAsync(WishlistId, friendId);

            var friendName = _friendsWithAccess.FirstOrDefault(f => f.Id == friendId)?.UserName ?? "Friend";
            await RefreshFriendsWithAccessAsync();

            if (_friendsLoadErrorMessage is not null)
            {
                return;
            }

            // Judge what is left from the refreshed access list, not circle membership alone.
            var stillSees = _friendsWithAccess.FirstOrDefault(f => f.Id == friendId);
            var viaCircles = stillSees is null ? [] : CircleNamesFor(stillSees);
            if (stillSees is null)
            {
                if (removed)
                {
                    _sharingStatusMessage = $"Access removed for {friendName}.";
                }
                else
                {
                    _sharingErrorMessage = $"{friendName} no longer has direct access to this list.";
                }
            }
            else if (viaCircles.Count > 0)
            {
                var circleNames = CircleRules.JoinNames(viaCircles);
                if (removed)
                {
                    _sharingStatusMessage = $"Direct access removed for {friendName}, who still sees this list through {circleNames}.";
                }
                else
                {
                    _sharingErrorMessage = $"{friendName} sees this list through {circleNames}. Stop sharing with the circle or remove {friendName} from it to end their access.";
                }
            }
            else
            {
                _sharingErrorMessage = $"{friendName} still has access to this list. Try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove friend access for wishlist {WishlistId}", WishlistId);
            _sharingErrorMessage = "Failed to remove access. Please try again.";
        }
        finally
        {
            _sharingBusy = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit(WishlistModel updatedWishlist)
    {
        if (_savingDetails)
        {
            return;
        }

        _detailsStatusMessage = null;
        _detailsErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_currentUserId))
        {
            _detailsErrorMessage = "Sign in again to update this wishlist.";
            return;
        }

        _savingDetails = true;
        StateHasChanged();
        await Task.Yield();

        try
        {
            updatedWishlist.Name = updatedWishlist.Name.Trim();
            await WishlistService.UpdateWishlistByPublicIdAsync(WishlistId, updatedWishlist, _currentUserId);
            // Refresh to show updated visibility
            _wishlist = await WishlistService.GetWishlistByPublicIdAsync(WishlistId, _currentUserId);
            _sharingStatusMessage = null;
            _sharingErrorMessage = null;
            _detailsStatusMessage = "Changes saved.";
            await RefreshFriendsWithAccessAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save wishlist details for {WishlistId}", WishlistId);
            _detailsErrorMessage = "We couldn't save your changes. Check your connection and try again.";
        }
        finally
        {
            _savingDetails = false;
        }
    }

    private Task ShowDeleteDialog()
    {
        _deleteErrorMessage = null;
        // ShowAsync renders the title and message before the dialog opens.
        return deleteDialog.ShowAsync(
            "Delete wishlist",
            $"Delete {_wishlist?.Name} and all of its gift ideas? Everyone it's shared with loses access. This can't be undone.",
            "manage-wishlist-delete"
        );
    }

    private async Task HandleDeleteWishlist()
    {
        if (_isDeleting)
        {
            return;
        }

        _isDeleting = true;
        _deleteErrorMessage = null;

        try
        {
            await WishlistService.DeleteWishlistByPublicIdAsync(WishlistId);
            NavigationManager.NavigateTo("/wishlists");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting wishlist {WishlistId}", WishlistId);
            _deleteErrorMessage = "We couldn't delete this wishlist. Check your connection and try again.";
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task RefreshEventsAsync()
    {
        _loadingEvents = true;
        _eventLoadErrorMessage = null;

        if (string.IsNullOrEmpty(_currentUserId))
        {
            _availableEvents.Clear();
            _attachedEvent = null;
            _loadingEvents = false;
            return;
        }

        try
        {
            var events = (await EventService.GetUserEventsAsync(_currentUserId)).ToList();
            _availableEvents = events
                .Where(e => _wishlist?.EventId == null || e.Id != _wishlist.EventId)
                .OrderBy(e => e.Date)
                .ToList();

            if (_wishlist?.EventId is int eventId)
            {
                _attachedEvent = await EventService.GetEventAsync(eventId);
            }
            else
            {
                _attachedEvent = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load events for wishlist {WishlistId}", WishlistId);
            _availableEvents.Clear();
            _eventLoadErrorMessage = "We couldn't load event connections. Try again.";

            if (_wishlist?.EventId is int eventId)
            {
                try
                {
                    _attachedEvent = await EventService.GetEventAsync(eventId);
                }
                catch (Exception innerEx)
                {
                    Logger.LogWarning(innerEx, "Failed to fetch event {EventId} for wishlist {WishlistId}", eventId, WishlistId);
                    _attachedEvent = null;
                }
            }
        }
        finally
        {
            _loadingEvents = false;
        }
    }

    private async Task AttachToSelectedEventAsync()
    {
        if (!_selectedEventId.HasValue || _wishlist == null || string.IsNullOrEmpty(_currentUserId))
        {
            return;
        }

        var eventId = _selectedEventId.Value;

        await ExecuteEventAction(async () =>
        {
            // Get the event to get its PublicId
            var selectedEvent = await EventService.GetEventAsync(eventId);
            await EventService.AttachWishlistByPublicIdAsync(selectedEvent.PublicId, WishlistId, _currentUserId);
            _wishlist.EventId = eventId;
            _attachedEvent = selectedEvent;
            _eventStatusMessage = $"Attached to '{_attachedEvent.Name}'.";
            _selectedEventId = null;
        });
    }

    private async Task DetachFromEventAsync()
    {
        if (_attachedEvent == null || _wishlist == null || string.IsNullOrEmpty(_currentUserId))
        {
            return;
        }

        var eventPublicId = _attachedEvent.PublicId;
        var eventName = _attachedEvent.Name;

        await ExecuteEventAction(async () =>
        {
            var removed = await EventService.DetachWishlistByPublicIdAsync(eventPublicId, WishlistId, _currentUserId);
            if (removed)
            {
                _wishlist.EventId = null;
                _attachedEvent = null;
                _eventStatusMessage = $"Removed this wishlist from '{eventName}'.";
            }
        });
    }

    private async Task ExecuteEventAction(Func<Task> action)
    {
        if (_eventBusy)
        {
            return;
        }

        try
        {
            _eventBusy = true;
            _eventErrorMessage = null;
            _eventStatusMessage = null;

            await action();
            await RefreshEventsAsync();
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Network error updating events for wishlist {WishlistId}", WishlistId);
            _eventErrorMessage = "We couldn't reach the server. Please try again.";
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Unauthorized attempt to modify event assignment for wishlist {WishlistId}", WishlistId);
            _eventErrorMessage = "You do not have permission to update event associations.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error updating event association for wishlist {WishlistId}", WishlistId);
            _eventErrorMessage = "We couldn't update the event connection. Try again.";
        }
        finally
        {
            _eventBusy = false;
            StateHasChanged();
        }
    }

    private static string GetEventOptionLabel(EventModel evt)
    {
        return $"{evt.Name} ({evt.Date:MMM d, yyyy})";
    }

    private static string GetFriendName(ApplicationUserModel friend) =>
        friend.UserName ?? friend.Email ?? "this friend";
}
