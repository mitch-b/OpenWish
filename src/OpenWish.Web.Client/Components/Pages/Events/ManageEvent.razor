@page "/events/{EventId}/manage"
@attribute [Authorize]

@using OpenWish.Web.Client.Components.Event
@using OpenWish.Shared.Services
@using OpenWish.Web.Client.Components.Shared
@using System.Collections.Generic
@using System.Linq

@inject IEventService EventService
@inject IUserContextService UserContextService
@inject NavigationManager NavigationManager
@inject ILogger<ManageEvent> Logger

@rendermode InteractiveAuto

<PageTitle>Manage Event - @(_event?.Name ?? "")</PageTitle>

@if (_isLoading && _event == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading event...</span>
        </div>
    </div>
}
else if (_event == null)
{
    <div class="container page-shell">
        <PageHeader Title="Event management unavailable"
                    Description="We couldn't load the event settings. The event itself has not been changed." />
        <div class="alert alert-danger" role="alert">@_loadError</div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="button" @onclick="RetryLoadAsync">Try again</button>
            <a class="btn btn-outline-secondary" href="/events">Back to events</a>
        </div>
    </div>
}
else if (!_isOwner)
{
    <div class="alert alert-danger" role="alert">
        You do not have permission to manage this event.
    </div>
}
else
{
    <div class="container page-shell">
        <PageHeader Title="Manage event" Description="@_event.Name">
            <Actions>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-outline-secondary" type="button" @onclick="HandleCancel">
                        <OpenWishIcon Name="arrow-left" /> Back to event
                    </button>
                    <button class="btn btn-danger" type="button" @onclick="ShowDeleteConfirmation">
                        <OpenWishIcon Name="trash" /> Delete event
                    </button>
                </div>
            </Actions>
        </PageHeader>

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="alert alert-success" role="status" aria-live="polite">@_statusMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(_saveError))
        {
            <div class="alert alert-danger" role="alert">@_saveError</div>
        }
        @if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <div class="alert alert-danger" role="alert">
                @_loadError
                <button class="btn btn-outline-danger d-block mt-2" type="button" @onclick="RetryLoadAsync">Try again</button>
            </div>
        }

        <div class="row g-4">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        @* <FormMappingScope Name="edit-event"> *@
                            <EventForm Model="@_event"
                                     OnSubmit="@HandleSubmit"
                                     ShowValidationSummary="true"
                                     LockEventType="@_event.NamesDrawnOn.HasValue"
                                     IsSubmitting="@_isSaving" />
                        @* </FormMappingScope> *@
                    </div>
                </div>

                <div class="mt-4">
                    <EventWishlistManager EventId="@EventId"
                                           Event="@_event"
                                           CurrentUserId="@_currentUserId"
                                           OnWishlistsChanged="HandleWishlistsChanged" />
                </div>
            </div>
            <div class="col-md-4">
                <EventInvitations EventId="@EventId"
                                  IsOwner="true"
                                  CurrentUserId="@_currentUserId"
                                  NamesDrawn="@_event.NamesDrawnOn.HasValue" />

                <div class="card shadow-sm mt-4">
                    <div class="card-body">
                        <h3 class="h5">Participants</h3>
                        @{
                            var participants = GetParticipantList().ToList();
                            var hasOwner = _event?.CreatedBy != null;
                        }
                        <div class="list-group mt-3">
                            @if (hasOwner)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@GetOwnerDisplayName()</strong>
                                        @if (GetOwnerContactDetail() is { } ownerContact)
                                        {
                                            <div class="small text-muted">@ownerContact</div>
                                        }
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            <span class="badge bg-secondary">Owner</span>
                                        </div>
                                    </div>
                                </div>
                            }

                            @foreach (var participant in participants)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="me-3">
                                        <strong>@GetParticipantDisplayName(participant)</strong>
                                        @if (GetParticipantContactDetail(participant) is { } contact)
                                        {
                                            <div class="small text-muted">@contact</div>
                                        }
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            <span class="badge bg-primary">@participant.Role</span>
                                            <span class="badge @GetStatusBadgeClass(participant)">@GetNormalizedStatus(participant)</span>
                                        </div>
                                    </div>
                                    @if (!_event!.NamesDrawnOn.HasValue &&
                                         participant.User?.Id is string participantUserId &&
                                         participantUserId != _currentUserId)
                                    {
                                        <button class="btn btn-outline-danger btn-sm"
                                                id="@GetParticipantRemoveButtonId(participant)"
                                                aria-label="@($"Remove {GetParticipantDisplayName(participant)} from event")"
                                                disabled="@_isRemovingParticipant"
                                                @onclick="() => PromptParticipantRemoval(participant)">
                                            Remove
                                        </button>
                                    }
                                </div>
                            }

                            @if (!hasOwner && participants.Count == 0)
                            {
                                <div class="list-group-item text-muted">No participants yet.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<Dialog @ref="_participantRemovalDialog"
        Title="Remove participant"
        DescriptionId="remove-event-participant-description"
        ReturnFocusElementId="@ParticipantRemovalReturnFocusId"
        CanClose="@(!_isRemovingParticipant)"
        OnClose="ClearParticipantRemoval">
    <div class="modal-body">
        <p id="remove-event-participant-description">
            Remove <strong>@ParticipantPendingRemovalName</strong> from this event?
            They will lose access to the event and will not be included when names are drawn.
        </p>
        @if (!string.IsNullOrWhiteSpace(_participantRemovalError))
        {
            <div class="alert alert-danger mb-0" role="alert">@_participantRemovalError</div>
        }
    </div>
    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-dialog-initial-focus
                disabled="@_isRemovingParticipant"
                @onclick="CloseParticipantRemovalAsync">
            Keep participant
        </button>
        @if (_participantRemovalUncertain)
        {
            <button type="button"
                    class="btn btn-primary"
                    disabled="@_isRemovingParticipant"
                    @onclick="ReloadParticipantRemovalAsync">
                Reload event
            </button>
        }
        else
        {
            <button type="button"
                    class="btn btn-danger"
                    disabled="@_isRemovingParticipant"
                    @onclick="ConfirmParticipantRemovalAsync">
                @if (_isRemovingParticipant)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                <span>Remove participant</span>
            </button>
        }
    </div>
</Dialog>

@if (_showDeleteConfirmation && _event is not null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-labelledby="delete-event-dialog-title"
         aria-describedby="delete-event-dialog-description">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="delete-event-dialog-title">Delete event</h5>
                    <button type="button"
                            class="btn-close"
                            aria-label="Close delete event confirmation"
                            @onclick="CancelDeleteEvent"
                            disabled="@_isDeleting"></button>
                </div>
                <div class="modal-body" id="delete-event-dialog-description">
                    @if (_deleteConfirmationStep == DeleteConfirmationStep.First)
                    {
                        <p>Deleting <strong>@_event.Name</strong> will remove all wishlists, participants, and activity. This action cannot be undone.</p>
                        <p class="mb-0">Click "Continue" to confirm once more before permanently deleting the event.</p>
                    }
                    else
                    {
                        <p>This is your final confirmation. Once you delete <strong>@_event.Name</strong>, it cannot be restored.</p>
                        <p class="text-danger mb-0">Are you absolutely sure you want to permanently delete this event?</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDeleteEvent" disabled="@_isDeleting">Cancel</button>
                    @if (_deleteConfirmationStep == DeleteConfirmationStep.First)
                    {
                        <button type="button" class="btn btn-warning" @onclick="ConfirmFirstDeleteStep">Continue</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteEventAsync" disabled="@_isDeleting">
                            @if (_isDeleting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                <span>Deleting...</span>
                            }
                            else
                            {
                                <span>Delete Event</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public string EventId { get; set; } = string.Empty;
    private EventModel? _event;
    private string? _currentUserId;
    private bool _isOwner;
    private bool _showDeleteConfirmation;
    private bool _isDeleting;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isRemovingParticipant;
    private bool _participantRemovalUncertain;
    private string? _loadError;
    private string? _saveError;
    private string? _statusMessage;
    private string? _participantRemovalError;
    private EventUserModel? _participantPendingRemoval;
    private Dialog _participantRemovalDialog = default!;
    private DeleteConfirmationStep _deleteConfirmationStep = DeleteConfirmationStep.First;

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = await UserContextService.GetUserIdAsync();
        await LoadEvent();
    }

    private async Task<bool> LoadEvent()
    {
        _isLoading = _event == null;
        _loadError = null;

        try
        {
            if (string.IsNullOrWhiteSpace(_currentUserId))
            {
                throw new InvalidOperationException("The current user could not be determined.");
            }

            _event = await EventService.GetEventByPublicIdAsync(EventId, _currentUserId);
            _isOwner = _event?.CreatedBy?.Id == _currentUserId;

            if (!_isOwner)
            {
                NavigationManager.NavigateTo($"/events/{EventId}");
            }

            return _event is not null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load event management for {EventId}", EventId);
            _loadError = "We couldn't load the event settings. Check your connection and try again.";
            return false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSubmit(EventModel updatedEvent)
    {
        if (_event == null || _isSaving)
        {
            return;
        }

        _isSaving = true;
        _saveError = null;
        _statusMessage = null;

        try
        {
            await EventService.UpdateEventByPublicIdAsync(EventId, updatedEvent, _currentUserId!);
            var reloaded = await LoadEvent();
            _statusMessage = reloaded
                ? "Event changes saved."
                : "Event changes were saved, but the latest event details couldn't be reloaded.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update event {EventId}", EventId);
            _saveError = "We couldn't save the event changes. Review the details and try again.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task RetryLoadAsync()
    {
        _statusMessage = null;
        await LoadEvent();
    }

    private void HandleCancel()
    {
        NavigationManager.NavigateTo($"/events/{EventId}");
    }

    private void ShowDeleteConfirmation()
    {
        if (_event == null)
        {
            return;
        }

        _deleteConfirmationStep = DeleteConfirmationStep.First;
        _showDeleteConfirmation = true;
    }

    private void CancelDeleteEvent()
    {
        if (_isDeleting)
        {
            return;
        }

        _showDeleteConfirmation = false;
        _deleteConfirmationStep = DeleteConfirmationStep.First;
    }

    private void ConfirmFirstDeleteStep()
    {
        if (_event == null)
        {
            return;
        }

        _deleteConfirmationStep = DeleteConfirmationStep.Second;
    }

    private async Task ConfirmDeleteEventAsync()
    {
        if (_event == null || _isDeleting)
        {
            return;
        }

        _isDeleting = true;

        try
        {
            await EventService.DeleteEventByPublicIdAsync(EventId, _currentUserId!);
            _showDeleteConfirmation = false;
            NavigationManager.NavigateTo("/events");
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private void PromptParticipantRemoval(EventUserModel participant)
    {
        if (_isRemovingParticipant || participant.User?.Id is null)
        {
            return;
        }

        _participantPendingRemoval = participant;
        _participantRemovalError = null;
        _participantRemovalUncertain = false;
        _participantRemovalDialog.Show();
    }

    private async Task ConfirmParticipantRemovalAsync()
    {
        if (_isRemovingParticipant ||
            _participantPendingRemoval is not { User.Id: string participantUserId } participantToRemove ||
            string.IsNullOrEmpty(_currentUserId))
        {
            return;
        }

        _isRemovingParticipant = true;
        _participantRemovalError = null;
        _statusMessage = null;

        try
        {
            var removed = await EventService.RemoveUserFromEventByPublicIdAsync(EventId, participantUserId, _currentUserId);
            if (!removed)
            {
                _participantRemovalUncertain = true;
                _participantRemovalError = "We couldn't confirm whether the participant was removed. Reload the event before trying again.";
                return;
            }

            var participantName = ParticipantPendingRemovalName;
            _event?.EventUsers?.Remove(participantToRemove);
            _statusMessage = $"{participantName} was removed from the event.";
            await _participantRemovalDialog.CloseAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove participant {ParticipantId} from event {EventId}", participantUserId, EventId);
            _participantRemovalUncertain = true;
            _participantRemovalError = "We couldn't confirm whether the participant was removed. Reload the event before trying again.";
        }
        finally
        {
            _isRemovingParticipant = false;
        }
    }

    private async Task ReloadParticipantRemovalAsync()
    {
        if (_participantPendingRemoval?.User?.Id is not string participantUserId)
        {
            return;
        }

        _isRemovingParticipant = true;
        var participantName = ParticipantPendingRemovalName;
        var loaded = await LoadEvent();
        _isRemovingParticipant = false;

        if (!loaded)
        {
            _participantRemovalError = "We still couldn't reload the event. Check your connection and try again.";
            return;
        }

        var participantStillExists = _event?.EventUsers?.Any(participant =>
            string.Equals(participant.User?.Id, participantUserId, StringComparison.Ordinal)) ?? false;
        if (participantStillExists)
        {
            _participantRemovalUncertain = false;
            _participantRemovalError = "The participant was not removed. You can try again.";
            return;
        }

        _statusMessage = $"{participantName} was removed from the event.";
        await _participantRemovalDialog.CloseAsync();
    }

    private Task CloseParticipantRemovalAsync() => _participantRemovalDialog.CloseAsync();

    private void ClearParticipantRemoval()
    {
        _participantPendingRemoval = null;
        _participantRemovalError = null;
        _participantRemovalUncertain = false;
    }

    private string ParticipantPendingRemovalName =>
        _participantPendingRemoval is null ? "this participant" : GetParticipantDisplayName(_participantPendingRemoval);

    private string? ParticipantRemovalReturnFocusId =>
        _participantPendingRemoval is null ? null : GetParticipantRemoveButtonId(_participantPendingRemoval);

    private static string GetParticipantRemoveButtonId(EventUserModel participant) =>
        $"remove-event-participant-{participant.Id}";

    private IEnumerable<EventUserModel> GetParticipantList() =>
        _event?.EventUsers?
            .Where(eu => !IsOwner(eu))
            .OrderBy(eu => GetStatusSortOrder(eu))
            .ThenBy(eu => GetParticipantDisplayName(eu), StringComparer.OrdinalIgnoreCase)
        ?? Enumerable.Empty<EventUserModel>();

    private bool IsOwner(EventUserModel eventUser) =>
        !string.IsNullOrWhiteSpace(_event?.CreatedBy?.Id) &&
        string.Equals(eventUser.User?.Id, _event!.CreatedBy!.Id, StringComparison.Ordinal);

    private static int GetStatusSortOrder(EventUserModel eventUser) => GetNormalizedStatus(eventUser) switch
    {
        "Accepted" => 0,
        "Pending" => 1,
        "Rejected" => 2,
        _ => 3
    };

    private static string GetStatusBadgeClass(EventUserModel eventUser) => GetNormalizedStatus(eventUser) switch
    {
        "Accepted" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetParticipantDisplayName(EventUserModel eventUser)
    {
        if (!string.IsNullOrWhiteSpace(eventUser.User?.UserName))
        {
            return eventUser.User.UserName!;
        }

        if (!string.IsNullOrWhiteSpace(eventUser.InviteeEmail))
        {
            return eventUser.InviteeEmail!;
        }

        return "Pending Invitation";
    }

    private static string? GetParticipantContactDetail(EventUserModel eventUser)
    {
        if (!string.IsNullOrWhiteSpace(eventUser.User?.Email))
        {
            return eventUser.User.Email!;
        }

        return eventUser.InviteeEmail;
    }

    private string GetOwnerDisplayName()
    {
        if (!string.IsNullOrWhiteSpace(_event?.CreatedBy?.UserName))
        {
            return _event!.CreatedBy!.UserName!;
        }

        if (!string.IsNullOrWhiteSpace(_event?.CreatedBy?.Email))
        {
            return _event!.CreatedBy!.Email!;
        }

        return "Event Owner";
    }

    private string? GetOwnerContactDetail() =>
        string.IsNullOrWhiteSpace(_event?.CreatedBy?.Email) ? null : _event!.CreatedBy!.Email!;

    private static string GetNormalizedStatus(EventUserModel eventUser)
    {
        if (!string.IsNullOrWhiteSpace(eventUser.Status))
        {
            return eventUser.Status;
        }

        return eventUser.IsAccepted ? "Accepted" : "Pending";
    }

    private Task HandleWishlistsChanged(IReadOnlyList<WishlistModel> wishlists)
    {
        if (_event != null)
        {
            _event.EventWishlists = wishlists.ToList();
        }

        return Task.CompletedTask;
    }

    private enum DeleteConfirmationStep
    {
        First,
        Second
    }
}