@using OpenWish.Web.Client.Components.Shared

@inject IEventService EventService
@inject ILogger<EventCard> Logger
@inject IUserContextService UserContextService
@inject NavigationManager NavigationManager

@if (Event == null)
{
    <p>Loading...</p>
}
else
{
    <div class="card h-100 event-card">
        <div class="card-body">
            <div class="card-title-row">
                <span class="event-card-icon"><OpenWishIcon Name="calendar-event" /></span>
                <div>
                    <h5 class="card-title">@Event.Name</h5>
                    <span class="card-owner">Hosted by @Event.CreatedBy?.UserName</span>
                </div>
            </div>
            <div class="event-meta">
                <span><OpenWishIcon Name="calendar-event" /> @Event.Date.ToString("MMM d, yyyy")</span>
                @if (Event.IsGiftExchange)
                {
                    <span><OpenWishIcon Name="gift" /> Secret Santa</span>
                }
            </div>
            @if (Event.IsGiftExchange)
            {
                <div class="event-status">
                    <span><OpenWishIcon Name="people" /> @AcceptedParticipantCount participants</span>
                    @if (Event.NamesDrawnOn.HasValue)
                    {
                        <span class="status-ready"><OpenWishIcon Name="check-circle" /> Names drawn</span>
                    }
                    else if (PendingInvitationCount > 0)
                    {
                        <span>@PendingInvitationCount waiting to respond</span>
                    }
                    else
                    {
                        <span>Ready for setup</span>
                    }
                </div>
            }
            <div class="card-footer-row">
                <a class="event-card-link" href="/events/@Event.PublicId">
                    @if (_currentUserId == Event.CreatedBy?.Id && Event.IsGiftExchange && !Event.NamesDrawnOn.HasValue)
                    {
                        <span>Continue setup</span>
                    }
                    else
                    {
                        <span>Open event</span>
                    }
                    <OpenWishIcon Name="arrow-right" />
                    <span class="visually-hidden">: @Event.Name</span>
                </a>
                @if (_currentUserId == Event.CreatedBy?.Id)
                {
                    <div class="dropdown d-inline-block">
                        <button class="btn btn-outline-secondary btn-sm kebab-menu"
                                type="button"
                                id="dropdownMenu@(Event.Id)"
                                data-bs-toggle="dropdown"
                                aria-label="Actions for @Event.Name"
                                aria-expanded="false"
                                @onclick:stopPropagation="true">
                            <OpenWishIcon Name="three-dots-vertical" />
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenu@(Event.Id)">
                            <li>
                                <button class="dropdown-item text-danger"
                                        @onclick="ShowDeleteDialog">
                                    Delete
                                </button>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>

}

<Dialog @ref="_deleteDialog"
        Title="@_deleteDialogTitle"
        ReturnFocusElementId="@($"dropdownMenu{Event?.Id}")">
    <div class="modal-body">
        <p>@_deleteDialogMessage</p>
        @if (!string.IsNullOrWhiteSpace(_deleteErrorMessage))
        {
            <div class="alert alert-danger mb-0" role="alert">
                <OpenWishIcon Name="exclamation-circle" Class="me-1" />
                @_deleteErrorMessage
                @if (_deleteCompleted)
                {
                    <button type="button" class="btn btn-outline-danger d-block mt-2" @onclick="ReloadEvents">
                        Reload events
                    </button>
                }
            </div>
        }
        @if (_deleteConfirmationStage == DeleteConfirmationStage.First)
        {
            <p class="mb-0">Select "Continue" to confirm again before deleting.</p>
        }
        else
        {
            <p class="text-danger mb-0">This is permanent. Are you absolutely sure?</p>
        }
    </div>
    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-dialog-initial-focus
                @ref="_cancelDeleteButton"
                @onclick="CloseDeleteDialog"
                disabled="@_isDeleting">
            @(_deleteCompleted ? "Close" : "Cancel")
        </button>
        @if (_deleteConfirmationStage == DeleteConfirmationStage.First)
        {
            <button type="button" class="btn btn-warning" @onclick="ConfirmFirstDeleteStep">Continue</button>
        }
        else if (!_deleteCompleted)
        {
            <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_isDeleting">
                @if (_isDeleting)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                <span>Delete event</span>
            </button>
        }
    </div>
</Dialog>

@code {
    private string? _currentUserId;

    protected override async Task OnInitializedAsync() =>
        _currentUserId = await UserContextService.GetUserIdAsync();

    [Parameter]
    public EventModel? Event { get; set; }

    [Parameter]
    public EventCallback<EventModel> OnDelete { get; set; }

    private Dialog _deleteDialog = default!;
    private string _deleteDialogTitle = "Delete event";
    private string _deleteDialogMessage = string.Empty;
    private string? _deleteErrorMessage;
    private bool _isDeleting;
    private bool _deleteCompleted;
    private ElementReference _cancelDeleteButton;
    private DeleteConfirmationStage _deleteConfirmationStage = DeleteConfirmationStage.First;
    private int AcceptedParticipantCount
    {
        get
        {
            var acceptedUserIds = Event?.EventUsers?
                .Where(participant =>
                    !participant.Deleted &&
                    participant.IsAccepted &&
                    string.Equals(participant.Status, "Accepted", StringComparison.OrdinalIgnoreCase))
                .Select(participant => participant.UserId)
                .Where(userId => !string.IsNullOrWhiteSpace(userId))
                .ToHashSet(StringComparer.Ordinal) ?? [];

            if (!string.IsNullOrWhiteSpace(Event?.CreatedBy?.Id))
            {
                acceptedUserIds.Add(Event.CreatedBy.Id);
            }

            return acceptedUserIds.Count;
        }
    }
    private int PendingInvitationCount =>
        Event?.EventUsers?.Count(participant =>
            !participant.Deleted &&
            string.Equals(participant.Status, "Pending", StringComparison.OrdinalIgnoreCase)) ?? 0;

    private void ShowDeleteDialog()
    {
        if (Event is null)
        {
            return;
        }

        if (_deleteCompleted)
        {
            ReloadEvents();
            return;
        }

        _deleteConfirmationStage = DeleteConfirmationStage.First;
        _deleteErrorMessage = null;
        _deleteDialogMessage = $"Deleting '{Event.Name}' will remove all wishlists, participants, and activity.";
        _deleteDialog.Show();
    }

    private async Task CloseDeleteDialog()
    {
        if (_isDeleting)
        {
            return;
        }

        if (_deleteCompleted)
        {
            ReloadEvents();
            return;
        }

        _deleteConfirmationStage = DeleteConfirmationStage.First;
        _deleteErrorMessage = null;
        await _deleteDialog.CloseAsync();
    }

    private async Task ConfirmFirstDeleteStep()
    {
        if (Event is null)
        {
            return;
        }

        _deleteConfirmationStage = DeleteConfirmationStage.Second;
        _deleteErrorMessage = null;
        _deleteDialogMessage = $"This is your final confirmation. '{Event.Name}' cannot be recovered once deleted.";
        StateHasChanged();
        await Task.Yield();
        await _cancelDeleteButton.FocusAsync();
    }

    private async Task ConfirmDeleteAsync()
    {
        if (Event is null || _isDeleting || _deleteConfirmationStage != DeleteConfirmationStage.Second)
        {
            return;
        }

        _isDeleting = true;
        _deleteErrorMessage = null;
        var currentUserId = _currentUserId ?? string.Empty;

        try
        {
            try
            {
                if (string.IsNullOrWhiteSpace(currentUserId))
                {
                    _deleteErrorMessage = "Sign in again to delete this event.";
                    return;
                }

                Logger.LogInformation("Deleting event {EventPublicId}", Event.PublicId);
                await EventService.DeleteEventByPublicIdAsync(Event.PublicId, currentUserId);
                _deleteCompleted = true;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error deleting event {EventPublicId}", Event.PublicId);
                try
                {
                    await EventService.GetEventByPublicIdAsync(Event.PublicId, currentUserId);
                    _deleteErrorMessage = $"We couldn't delete '{Event.Name}'. Try again.";
                }
                catch (Exception reconciliationException) when (IsMissingEvent(reconciliationException))
                {
                    _deleteCompleted = true;
                    _deleteErrorMessage = "Event deleted, but the confirmation response was interrupted. Reload events.";
                }
                catch (Exception reconciliationException)
                {
                    Logger.LogError(
                        reconciliationException,
                        "Could not reconcile deletion of event {EventPublicId}",
                        Event.PublicId);
                    _deleteCompleted = true;
                    _deleteErrorMessage = "The deletion outcome couldn't be confirmed. Reload events before trying again.";
                }
                return;
            }

            try
            {
                if (OnDelete.HasDelegate)
                {
                    await OnDelete.InvokeAsync(Event);
                }

                await _deleteDialog.CloseAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Event {EventPublicId} was deleted but the event list did not refresh", Event.PublicId);
                _deleteErrorMessage = "Event deleted, but the event list couldn't refresh. Reload events.";
            }
        }
        finally
        {
            _isDeleting = false;
            StateHasChanged();
        }
    }

    private void ReloadEvents() => NavigationManager.NavigateTo("/events", forceLoad: true);

    private static bool IsMissingEvent(Exception exception) =>
        exception is KeyNotFoundException ||
        exception is HttpRequestException { StatusCode: System.Net.HttpStatusCode.NotFound };

    private enum DeleteConfirmationStage
    {
        First,
        Second
    }
}
