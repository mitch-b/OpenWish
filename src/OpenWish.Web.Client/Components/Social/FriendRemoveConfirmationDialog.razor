@using OpenWish.Web.Client.Components.Shared

<Dialog @ref="dialog" Title="@Title" DescriptionId="friend-removal-description" CanClose="@(!_isRemoving)" OnClose="HandleClosed">
    <div class="modal-body">
        <p id="friend-removal-description" class="mb-0">@Message</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dialog-initial-focus disabled="@_isRemoving" @onclick="Close">
            Keep friend
        </button>
        <button type="button" class="btn btn-danger" disabled="@_isRemoving" @onclick="HandleConfirm">
            @if (_isRemoving)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span role="status">Removing...</span>
            }
            else
            {
                <span>Remove friend</span>
            }
        </button>
    </div>
</Dialog>

@code {
    private Dialog dialog = default!;
    private string Title { get; set; } = string.Empty;
    private string Message { get; set; } = string.Empty;
    private bool _isRemoving;

    [Parameter]
    public EventCallback<string> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnClosed { get; set; }

    [Parameter]
    public string FriendId { get; set; } = string.Empty;

    public void Show(string title, string message, string friendId)
    {
        Title = title;
        Message = message;
        FriendId = friendId;
        // Re-render first so the dialog receives the new title before it opens.
        StateHasChanged();
        dialog.Show();
    }

    public Task Close() => dialog.CloseAsync();

    private Task HandleClosed() => OnClosed.InvokeAsync();

    private async Task HandleConfirm()
    {
        if (_isRemoving)
        {
            return;
        }

        try
        {
            _isRemoving = true;
            await OnConfirm.InvokeAsync(FriendId);
        }
        finally
        {
            _isRemoving = false;
        }

        await dialog.CloseAsync();
    }
}
