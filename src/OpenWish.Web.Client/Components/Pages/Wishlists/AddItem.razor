@attribute [Authorize]
@page "/wishlists/{WishlistId}/items/new"

@using OpenWish.Shared.Products
@using OpenWish.Web.Client.Components.Wishlist

@inject IWishlistService WishlistService
@inject IUserContextService UserContextService
@inject NavigationManager NavigationManager
@inject ILogger<AddItem> Logger

@rendermode InteractiveServer

<PageTitle>@(FirstIdea ? "Add your first idea" : "Add an item")</PageTitle>

<div class="container page-shell">
    <PageHeader Title="@(FirstIdea ? "Add your first idea" : "Add an item")"
                Description="@(FirstIdea ? "Start with a name or a product link. You can refine the details later." : "Save the details you know now. You can refine this gift idea later.")">
        <Actions>
            <a href="/wishlists/@WishlistId" class="btn btn-outline-secondary page-header-back">
                <OpenWishIcon Name="arrow-left" /> Back to wishlist
            </a>
        </Actions>
    </PageHeader>
    <div class="row">
        <div class="col-lg-8">
        @if (FirstIdea)
        {
            <div class="alert alert-success" role="status">
                Your wishlist is ready. Add an idea to get it started.
            </div>
        }
        @if (_lastAddedName is not null)
        {
            <div class="alert alert-success" role="status" data-testid="added-another-note">
                <OpenWishIcon Name="check-circle" /> @_lastAddedName was added. Add the next idea whenever you're ready.
            </div>
        }
        <WishlistItemForm @key="_formVersion"
                          Model="@_item"
                          ExistingItems="@_existingItems"
                          OnSubmit="@HandleSubmit"
                          OnSubmitAndAddAnother="@HandleAddAnother"
                          OnCancel="@HandleCancel"
                          AutoFocusImport="true"
                          InitialImportLink="@_initialImportLink"
                          IsSubmitting="@_isSubmitting" />
        @* Shown beside the actions so the person who just pressed save sees it, even on a long phone form. *@
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert">@_errorMessage</div>
        }
        </div>
    </div>
</div>


@code {
    [Parameter] public string WishlistId { get; set; } = string.Empty;
    private WishlistItemModel _item = new() { PublicId = Guid.NewGuid().ToString() };
    private List<WishlistItemModel> _existingItems = [];
    private string? _lastAddedName;
    private int _formVersion;
    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _initialImportLink;

    // Filled by the share page, the "Add to OpenWish" bookmarklet, or the installed app's share target.
    [SupplyParameterFromQuery(Name = "url")] public string? SharedUrl { get; set; }
    [SupplyParameterFromQuery(Name = "text")] public string? SharedText { get; set; }
    [SupplyParameterFromQuery(Name = "title")] public string? SharedTitle { get; set; }
    [SupplyParameterFromQuery(Name = "description")] public string? SharedDescription { get; set; }
    [SupplyParameterFromQuery(Name = "price")] public string? SharedPrice { get; set; }
    [SupplyParameterFromQuery(Name = "image")] public string? SharedImage { get; set; }
    [SupplyParameterFromQuery(Name = "firstIdea")] public bool FirstIdea { get; set; }

    // Runs before the lookup below can yield, so the importer sees the shared link on its first render.
    protected override void OnInitialized()
    {
        var capture = ProductCapture.FromQuery(SharedUrl, SharedText, SharedTitle, SharedDescription, SharedPrice, SharedImage);
        capture.ApplyTo(_item);
        _initialImportLink = capture.Link?.AbsoluteUri;
    }

    protected override async Task OnInitializedAsync()
    {
        // Only used for a duplicate heads-up, so a failed lookup should never block adding an idea.
        try
        {
            var userId = await UserContextService.GetUserIdAsync();
            if (string.IsNullOrWhiteSpace(userId) ||
                !await WishlistService.CanUserEditWishlistByPublicIdAsync(WishlistId, userId))
            {
                return;
            }

            _existingItems = (await WishlistService.GetWishlistItemsByPublicIdAsync(WishlistId, userId)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Unable to load existing ideas for wishlist {WishlistPublicId}", WishlistId);
        }
    }

    private async Task HandleSubmit(WishlistItemModel item)
    {
        if (await SaveAsync(item))
        {
            NavigationManager.NavigateTo($"/wishlists/{WishlistId}?added={Uri.EscapeDataString(item.PublicId)}");
        }
    }

    private async Task HandleAddAnother(WishlistItemModel item)
    {
        if (!await SaveAsync(item))
        {
            return;
        }

        _existingItems.Add(item);
        _lastAddedName = item.Name;
        _item = new WishlistItemModel { PublicId = Guid.NewGuid().ToString() };
        _initialImportLink = null;
        _formVersion++;
    }

    private async Task<bool> SaveAsync(WishlistItemModel item)
    {
        if (_isSubmitting)
        {
            return false;
        }

        _isSubmitting = true;
        _errorMessage = null;
        StateHasChanged();
        await Task.Yield();

        try
        {
            await WishlistService.AddItemToWishlistByPublicIdAsync(WishlistId, item);
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add an item to wishlist {WishlistPublicId}", WishlistId);
            _errorMessage = "We couldn't add this item. Review the details and try again.";
            return false;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void HandleCancel()
    {
        if (_isSubmitting)
        {
            return;
        }

        NavigationManager.NavigateTo($"/wishlists/{WishlistId}");
    }
}