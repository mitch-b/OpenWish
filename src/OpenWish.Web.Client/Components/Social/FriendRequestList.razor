@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IFriendService FriendService
@inject IUserContextService UserContextService
@inject ILogger<FriendRequestList> Logger

<div class="friend-requests" aria-busy="@(_loading || _processingRequestId.HasValue)">
    <div class="social-heading">
        <span class="social-heading-icon"><OpenWishIcon Name="person-check" /></span>
        <div>
            <h2>Friend requests@(_receivedRequests.Count > 0 ? $" ({_receivedRequests.Count})" : "")</h2>
            <p>Choose who joins your trusted circle.</p>
        </div>
    </div>

    @if (_loading)
    {
        <div class="spinner-border spinner-border-sm" role="status">
            <span class="visually-hidden">Loading friend requests...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <p class="mb-2">@_loadErrorMessage</p>
            <button class="btn btn-outline-danger btn-sm"
                    type="button"
                    disabled="@_loading"
                    @onclick="RetryLoadRequests">
                Try again
            </button>
        </div>
    }
    else if (!_receivedRequests.Any())
    {
        <div class="alert alert-info">
            No requests waiting for you. People who ask to connect will show up here.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var request in _receivedRequests)
            {
                <div class="list-group-item request-row">
                    <div class="request-identity">
                        <span class="request-avatar"><OpenWishIcon Name="person-circle" /></span>
                        <strong>@request.Requester?.UserName</strong>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm"
                                type="button"
                                disabled="@_processingRequestId.HasValue"
                                aria-label="Accept friend request from @GetRequesterName(request)"
                                @onclick="() => AcceptRequest(request)">
                            <OpenWishIcon Name="check" />
                            @(_processingRequestId == request.Id ? "Accepting..." : "Accept")
                        </button>
                        <button class="btn btn-outline-secondary btn-sm"
                                type="button"
                                disabled="@_processingRequestId.HasValue"
                                aria-label="Reject friend request from @GetRequesterName(request)"
                                @onclick="() => RejectRequest(request)">
                            <OpenWishIcon Name="x" /> Reject
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    @if (string.IsNullOrWhiteSpace(_loadErrorMessage) && (_sentRequests.Any() || _pendingInvites.Any()))
    {
        <h3 class="h5 mt-4 mb-3">Sent requests</h3>
        <div class="list-group">
            @foreach (var invite in _pendingInvites)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center" data-testid="pending-invite">
                    <div class="text-break">
                        <OpenWishIcon Name="envelope" Class="me-2" />
                        @invite.Email
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="badge bg-secondary">Invited</span>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Email invitation actions">
                            <button class="btn btn-outline-secondary d-flex align-items-center gap-1"
                                    type="button"
                                    disabled="@_processingRequestId.HasValue"
                                    aria-label="Resend invitation to @invite.Email"
                                    @onclick="() => ResendInvite(invite)">
                                <OpenWishIcon Name="arrow-clockwise" />
                                <span>@(_processingRequestId == invite.Id ? "Resending..." : "Resend")</span>
                            </button>
                            <button class="btn btn-outline-danger d-flex align-items-center gap-1"
                                    type="button"
                                    disabled="@_processingRequestId.HasValue"
                                    aria-label="Cancel invitation to @invite.Email"
                                    @onclick="() => CancelInvite(invite)">
                                <OpenWishIcon Name="trash" />
                                <span>Cancel</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
            @foreach (var request in _sentRequests)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <OpenWishIcon Name="person-circle" Class="me-2" />
                        @request.Receiver?.UserName
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="badge bg-secondary">Pending</span>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Sent request actions">
                            <button class="btn btn-outline-secondary d-flex align-items-center gap-1"
                                    type="button"
                                    disabled="@_processingRequestId.HasValue"
                                    aria-label="Resend friend request to @GetReceiverName(request)"
                                    @onclick="() => ResendSentRequest(request)">
                                <OpenWishIcon Name="arrow-clockwise" />
                                <span>@(_processingRequestId == request.Id ? "Resending..." : "Resend")</span>
                            </button>
                            <button class="btn btn-outline-danger d-flex align-items-center gap-1"
                                    type="button"
                                    disabled="@_processingRequestId.HasValue"
                                    aria-label="Cancel friend request to @GetReceiverName(request)"
                                    @onclick="() => CancelSentRequest(request)">
                                <OpenWishIcon Name="trash" />
                                <span>Cancel</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-success mt-3" role="status" aria-live="polite">
            @_statusMessage
            @if (_acceptedFriendName is not null)
            {
                <a class="alert-link ms-1" href="/wishlists?tab=friends&owner=@Uri.EscapeDataString(_acceptedFriendName)">View their lists</a>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">
            @_errorMessage
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnFriendshipsChanged { get; set; }

    private List<FriendRequestModel> _receivedRequests = [];
    private List<FriendRequestModel> _sentRequests = [];
    private List<PendingFriendInviteModel> _pendingInvites = [];
    private bool _loading = true;
    private string? _currentUserId;
    private int? _processingRequestId;
    private string? _statusMessage;
    private string? _errorMessage;
    private string? _loadErrorMessage;
    private string? _acceptedFriendName;

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _loadErrorMessage is not null && _currentUserId == null)
        {
            // If we had an error during SSR and no user ID, try again after first render
            await LoadRequests();
        }
    }

    public Task ReloadAsync() => LoadRequests(clearFeedback: false, silent: true);

    private async Task LoadRequests(bool clearFeedback = true, bool silent = false)
    {
        try
        {
            _loading = !silent;
            _loadErrorMessage = null;
            if (clearFeedback)
            {
                _statusMessage = null;
                _errorMessage = null;
            }
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                var receivedRequests = await FriendService.GetReceivedFriendRequestsAsync(_currentUserId);
                var sentRequests = await FriendService.GetSentFriendRequestsAsync(_currentUserId);

                _receivedRequests = receivedRequests.ToList();
                _sentRequests = sentRequests.ToList();
                _pendingInvites = (await FriendService.GetPendingFriendInvitesAsync(_currentUserId)).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load friend requests");
            _loadErrorMessage = "Friend requests could not be loaded. Try again.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RetryLoadRequests()
    {
        if (_loading)
        {
            return;
        }

        await LoadRequests();
    }

    private async Task AcceptRequest(FriendRequestModel request)
    {
        var requesterName = GetRequesterName(request);
        try
        {
            BeginRequestAction(request.Id);
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                if (await FriendService.AcceptFriendRequestAsync(request.Id, _currentUserId))
                {
                    await LoadRequests(clearFeedback: false, silent: true);
                    await OnFriendshipsChanged.InvokeAsync();
                    _statusMessage = $"{requesterName} is now your friend.";
                    _acceptedFriendName = request.Requester?.UserName;
                }
                else
                {
                    _errorMessage = $"The friend request from {requesterName} is no longer pending. Refresh and try again.";
                }
            }
            else
            {
                _errorMessage = "Sign in again to accept this friend request.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to accept friend request {FriendRequestId}", request.Id);
            _errorMessage = $"The friend request from {requesterName} could not be accepted. Try again.";
        }
        finally
        {
            _processingRequestId = null;
        }
    }

    private async Task RejectRequest(FriendRequestModel request)
    {
        var requesterName = GetRequesterName(request);
        try
        {
            BeginRequestAction(request.Id);
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                if (await FriendService.RejectFriendRequestAsync(request.Id, _currentUserId))
                {
                    await LoadRequests(clearFeedback: false, silent: true);
                    _statusMessage = $"Friend request from {requesterName} rejected.";
                }
                else
                {
                    _errorMessage = $"The friend request from {requesterName} is no longer pending. Refresh and try again.";
                }
            }
            else
            {
                _errorMessage = "Sign in again to reject this friend request.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reject friend request {FriendRequestId}", request.Id);
            _errorMessage = $"The friend request from {requesterName} could not be rejected. Try again.";
        }
        finally
        {
            _processingRequestId = null;
        }
    }

    private async Task CancelSentRequest(FriendRequestModel request)
    {
        var receiverName = GetReceiverName(request);
        try
        {
            BeginRequestAction(request.Id);
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                if (await FriendService.CancelFriendRequestAsync(request.Id, _currentUserId))
                {
                    await LoadRequests(clearFeedback: false, silent: true);
                    _statusMessage = $"Friend request to {receiverName} canceled.";
                }
                else
                {
                    _errorMessage = $"The friend request to {receiverName} is no longer pending. Refresh and try again.";
                }
            }
            else
            {
                _errorMessage = "Sign in again to cancel this friend request.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to cancel friend request {FriendRequestId}", request.Id);
            _errorMessage = $"The friend request to {receiverName} could not be canceled. Try again.";
        }
        finally
        {
            _processingRequestId = null;
        }
    }

    private async Task ResendSentRequest(FriendRequestModel request)
    {
        var receiverName = GetReceiverName(request);
        try
        {
            BeginRequestAction(request.Id);
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                await FriendService.ResendFriendRequestAsync(request.Id, _currentUserId);
                await LoadRequests(clearFeedback: false, silent: true);
                _statusMessage = $"Friend request sent to {receiverName} again.";
            }
            else
            {
                _errorMessage = "Sign in again to resend this friend request.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to resend friend request {FriendRequestId}", request.Id);
            _errorMessage = $"The friend request to {receiverName} could not be resent. Try again.";
        }
        finally
        {
            _processingRequestId = null;
        }
    }

    private async Task ResendInvite(PendingFriendInviteModel invite)
    {
        try
        {
            BeginRequestAction(invite.Id);
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                await FriendService.ResendPendingFriendInviteAsync(invite.Id, _currentUserId);
                await LoadRequests(clearFeedback: false, silent: true);
                _statusMessage = $"Invitation sent to {invite.Email} again.";
            }
            else
            {
                _errorMessage = "Sign in again to resend this invitation.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to resend friend invitation {InviteId}", invite.Id);
            _errorMessage = $"The invitation to {invite.Email} could not be resent. Try again.";
        }
        finally
        {
            _processingRequestId = null;
        }
    }

    private async Task CancelInvite(PendingFriendInviteModel invite)
    {
        try
        {
            BeginRequestAction(invite.Id);
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                if (await FriendService.CancelPendingFriendInviteAsync(invite.Id, _currentUserId))
                {
                    await LoadRequests(clearFeedback: false, silent: true);
                    _statusMessage = $"Invitation to {invite.Email} canceled.";
                }
                else
                {
                    _errorMessage = $"The invitation to {invite.Email} is no longer pending. Refresh and try again.";
                }
            }
            else
            {
                _errorMessage = "Sign in again to cancel this invitation.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to cancel friend invitation {InviteId}", invite.Id);
            _errorMessage = $"The invitation to {invite.Email} could not be canceled. Try again.";
        }
        finally
        {
            _processingRequestId = null;
        }
    }

    private void BeginRequestAction(int requestId)
    {
        _processingRequestId = requestId;
        _statusMessage = null;
        _acceptedFriendName = null;
        _errorMessage = null;
    }

    private static string GetRequesterName(FriendRequestModel request) =>
        request.Requester?.UserName ?? request.Requester?.Email ?? "this person";

    private static string GetReceiverName(FriendRequestModel request) =>
        request.Receiver?.UserName ?? request.Receiver?.Email ?? "this person";
}