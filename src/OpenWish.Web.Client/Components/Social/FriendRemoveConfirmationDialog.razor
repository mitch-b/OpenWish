@using OpenWish.Web.Client.Components.Shared

<Dialog @ref="dialog" Title="@Title" DescriptionId="friend-removal-description">
    <div class="modal-body">
        <p id="friend-removal-description">@Message</p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dialog-initial-focus @onclick="Close">Keep friend</button>
        <button type="button" class="btn btn-danger" @onclick="HandleConfirm">Remove friend</button>
    </div>
</Dialog>

@code {
    private Dialog dialog = default!;
    private string Title { get; set; } = string.Empty;
    private string Message { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnConfirm { get; set; }
    
    [Parameter]
    public string FriendId { get; set; } = string.Empty;

    public void Show(string title, string message, string friendId)
    {
        Title = title;
        Message = message;
        FriendId = friendId;
        dialog.Show();
    }

    public Task Close() => dialog.CloseAsync();

    private async Task HandleConfirm()
    {
        await OnConfirm.InvokeAsync(FriendId);
        await dialog.CloseAsync();
    }
}