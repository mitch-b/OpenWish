@using System.Collections.Generic
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@using OpenWish.Shared.Models
@using OpenWish.Shared.Services
@inject INotificationService NotificationService
@inject IUserContextService UserContextService
@inject IEventService EventService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<NotificationFlyout> Logger
@rendermode InteractiveServer
@implements IAsyncDisposable

<div class="notification-flyout-container position-relative">
    <button class="btn btn-link text-decoration-none notification-bell"
            @onclick="ToggleFlyout"
            @onclick:stopPropagation="true"
            aria-label="@(_unreadCount > 0 ? $"Notifications, {_unreadCount} unread" : "Notifications")"
            aria-expanded="@(_isVisible ? "true" : "false")"
            aria-controls="notification-flyout"
            type="button">
        <OpenWishIcon Name="bell" />
        @if (_unreadCount > 0)
        {
            <span class="badge bg-danger position-absolute translate-middle rounded-pill notification-badge">
                @(_unreadCount > 99 ? "99+" : _unreadCount.ToString())
            </span>
        }
    </button>

    @if (_isVisible)
    {
        <div id="notification-flyout"
             class="notification-flyout shadow-lg"
             role="dialog"
             aria-labelledby="notification-flyout-title"
             aria-describedby="notification-flyout-description"
             @onclick:stopPropagation="true">
            <div class="notification-header d-flex justify-content-between align-items-center p-3 border-bottom">
                <div>
                    <h2 class="notification-heading" id="notification-flyout-title">Notifications</h2>
                    <p class="notification-subheading" id="notification-flyout-description">Recent updates and invitations</p>
                </div>
                <div class="d-flex gap-2">
                    @if (_notifications?.Any(n => !n.IsRead) == true)
                    {
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="MarkAllAsRead"
                                disabled="@(_isLoading || _isMarkingRead)"
                                aria-busy="@_isMarkingRead"
                                data-dialog-initial-focus>
                            Mark all as read
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-secondary"
                            id="notification-close-button"
                            aria-label="Close notifications"
                            data-dialog-close
                            data-dialog-initial-focus="@(_notifications?.Any(n => !n.IsRead) != true)"
                            @onclick="CloseFlyout">
                        <OpenWishIcon Name="x-lg" />
                    </button>
                </div>
            </div>

            <div class="notification-content">
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="alert alert-danger notification-error" role="alert">
                        @_errorMessage
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_statusMessage))
                {
                    <div class="visually-hidden" role="status" aria-live="polite">
                        @_statusMessage
                    </div>
                }
                @if (_isLoading)
                {
                    <div class="text-center p-4" role="status">
                        <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
                        <div class="mt-2">Loading notifications...</div>
                    </div>
                }
                else if (_notifications?.Any() == true)
                {
                    <div class="notification-list">
                        @foreach (var notification in _notifications.Take(20))
                        {
                            <div class="notification-item @(notification.IsRead ? "read" : "unread")"
                                 @onmouseenter="() => MarkAsReadOnHover(notification)"
                                 @ontouchstart="() => MarkAsReadOnTouch(notification)">
                                <div class="d-flex justify-content-between align-items-start p-3">
                                    <div class="notification-body flex-grow-1">
                                        @if (!string.IsNullOrEmpty(notification.Title))
                                        {
                                            <div class="notification-title fw-semibold mb-1">@notification.Title</div>
                                        }
                                        <div class="notification-message small">@notification.Message</div>
                                        <div class="notification-date text-muted small">@notification.Date.ToString("MMM dd, yyyy HH:mm")</div>
                                        @if (notification.Action is { } action && ((action.Options?.Count ?? 0) > 0 || !string.IsNullOrWhiteSpace(action.NavigateTo)))
                                        {
                                            <div class="notification-cta">
                                                @if ((action.Options?.Count ?? 0) > 0)
                                                {
                                                    foreach (var option in action.Options ?? new List<NotificationActionOptionModel>())
                                                    {
                                                        var buttonClass = option.IsPrimary ? "btn btn-sm btn-success" : "btn btn-sm btn-outline-secondary";
                                                        <button class="@buttonClass"
                                                                disabled="@IsNotificationProcessing(notification.Id)"
                                                                aria-busy="@IsNotificationProcessing(notification.Id)"
                                                                @onclick="() => HandleActionOption(notification, option.Key)"
                                                                @onclick:stopPropagation="true">
                                                            @if (option.IsPrimary && IsNotificationProcessing(notification.Id))
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                                            }
                                                            @option.Label
                                                        </button>
                                                    }
                                                }
                                                @if (!string.IsNullOrWhiteSpace(action.NavigateTo))
                                                {
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            @onclick="() => NavigateTo(action.NavigateTo!)"
                                                            @onclick:stopPropagation="true">
                                                        View
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="notification-actions">
                                        @if (!notification.IsRead)
                                        {
                                            <span class="unread-indicator bg-primary rounded-circle"></span>
                                        }
                                        <button class="btn btn-sm btn-outline-danger ms-2"
                                                aria-label="Delete notification"
                                                @onclick="() => ShowDeleteConfirmation(notification)"
                                                @onclick:stopPropagation="true">
                                            <OpenWishIcon Name="trash3" />
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (_notifications.Count() > 20)
                    {
                        <div class="text-center p-3 border-top">
                            <small class="text-muted">Showing 20 of @_notifications.Count() notifications</small>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center p-4 text-muted">
                        <OpenWishIcon Name="bell" Class="notification-empty-icon" />
                        <div class="mt-2 fw-semibold">You're all caught up</div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (_showDeleteConfirmation && _notificationToDelete != null)
{
    <div class="modal notification-delete-modal show d-block"
         id="notification-delete-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="notification-delete-title"
         aria-describedby="notification-delete-description"
         tabindex="-1"
         @onclick="CancelDelete">
        <div class="notification-modal-backdrop"></div>
        <div class="modal-dialog modal-sm" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h6" id="notification-delete-title">Delete notification</h2>
                </div>
                <div class="modal-body">
                    <p class="mb-0" id="notification-delete-description">
                        Delete “@GetNotificationName(_notificationToDelete)”? This cannot be undone.
                    </p>
                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">
                            @_errorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm"
                            data-dialog-close
                            data-dialog-initial-focus
                            @onclick="CancelDelete">Keep notification</button>
                    <button type="button" class="btn btn-danger btn-sm" @onclick="ConfirmDelete" disabled="@_isDeleting">
                        @if (_isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible = false;
    private bool _isLoading = false;
    private bool _isDeleting = false;
    private bool _showDeleteConfirmation = false;
    private bool _isMarkingRead = false;
    private string? _errorMessage;
    private string? _statusMessage;
    private int _unreadCount = 0;
    private string? _userId;
    private IEnumerable<NotificationModel>? _notifications;
    private NotificationModel? _notificationToDelete;
    private readonly HashSet<int> _notificationsInFlight = new();
    private bool _activateFlyoutAfterRender;
    private bool _activateDeleteDialogAfterRender;
    private bool _focusFlyoutCloseAfterRender;

    protected override async Task OnInitializedAsync()
    {
        _userId = await UserContextService.GetUserIdAsync();
        if (_userId != null)
        {
            await LoadNotificationCount();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_activateFlyoutAfterRender)
        {
            _activateFlyoutAfterRender = false;
            await JSRuntime.InvokeVoidAsync("openWishActivateDialog", "notification-flyout");
        }

        if (_activateDeleteDialogAfterRender)
        {
            _activateDeleteDialogAfterRender = false;
            await JSRuntime.InvokeVoidAsync("openWishActivateDialog", "notification-delete-dialog");
        }

        if (_focusFlyoutCloseAfterRender)
        {
            _focusFlyoutCloseAfterRender = false;
            await JSRuntime.InvokeVoidAsync("openWishFocusElement", "notification-close-button");
        }
    }

    private async Task LoadNotificationCount()
    {
        if (_userId is not null)
        {
            try
            {
                _unreadCount = await NotificationService.GetUnreadNotificationCountAsync(_userId);
                StateHasChanged();
            }
            catch (Exception ex) when (ex is InvalidOperationException or DbUpdateException or DbException)
            {
                Logger.LogError(ex, "Unable to load the notification count for user {UserId}.", _userId);
                _unreadCount = 0;
            }
        }
    }

    private async Task LoadNotifications()
    {
        if (_userId is not null && !_isLoading)
        {
            _isLoading = true;
            try
            {
                _notifications = await NotificationService.GetUserNotificationsAsync(_userId, includeRead: true);
            }
            catch (Exception ex) when (ex is InvalidOperationException or DbUpdateException or DbException)
            {
                Logger.LogError(ex, "Unable to load notifications for user {UserId}.", _userId);
                _errorMessage = "Notifications could not be loaded. Refresh the page and try again.";
                _notifications = new List<NotificationModel>();
            }
            finally
            {
                _isLoading = false;
            }
        }
    }

    private async Task ToggleFlyout()
    {
        if (_isVisible)
        {
            await CloseFlyout();
            return;
        }

        _isVisible = true;
        _errorMessage = null;
        _statusMessage = null;
        _activateFlyoutAfterRender = true;
        if (_notifications == null)
        {
            await LoadNotifications();
        }
        StateHasChanged();
    }

    private async Task CloseFlyout()
    {
        if (_showDeleteConfirmation)
        {
            await CancelDelete();
        }

        await JSRuntime.InvokeVoidAsync("openWishDeactivateDialog", "notification-flyout");
        _isVisible = false;
        StateHasChanged();
    }

    private async Task MarkAsReadOnHover(NotificationModel notification)
    {
        if (!notification.IsRead)
        {
            await MarkNotificationAsRead(notification);
        }
    }

    private async Task MarkAsReadOnTouch(NotificationModel notification)
    {
        // For mobile devices, mark as read on touch
        if (!notification.IsRead)
        {
            await MarkNotificationAsRead(notification);
        }
    }

    private async Task MarkNotificationAsRead(NotificationModel notification)
    {
        if (_isMarkingRead) return;

        _isMarkingRead = true;
        _errorMessage = null;
        try
        {
            var success = await NotificationService.MarkNotificationAsReadAsync(notification.PublicId, _userId!);
            if (success)
            {
                notification.IsRead = true;
                await LoadNotificationCount();
                StateHasChanged();
            }
            else
            {
                _errorMessage = "This notification could not be marked as read. Try again.";
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or DbUpdateException or DbException)
        {
            Logger.LogError(ex, "Unable to mark notification {NotificationPublicId} as read.", notification.PublicId);
            _errorMessage = "This notification could not be marked as read. Try again.";
        }
        finally
        {
            _isMarkingRead = false;
        }
    }

    private async Task MarkAllAsRead()
    {
        if (_userId is not null && !_isMarkingRead)
        {
            _isMarkingRead = true;
            _errorMessage = null;
            _statusMessage = null;
            try
            {
                var success = await NotificationService.MarkAllNotificationsAsReadAsync(_userId);
                if (success)
                {
                    if (_notifications != null)
                    {
                        foreach (var notification in _notifications)
                        {
                            notification.IsRead = true;
                        }
                    }
                    await LoadNotificationCount();
                    _statusMessage = "All notifications marked as read.";
                    _focusFlyoutCloseAfterRender = true;
                    StateHasChanged();
                }
                else
                {
                    _errorMessage = "Notifications could not be marked as read. Try again.";
                }
            }
            catch (Exception ex) when (ex is InvalidOperationException or DbUpdateException or DbException)
            {
                Logger.LogError(ex, "Unable to mark all notifications as read for user {UserId}.", _userId);
                _errorMessage = "Notifications could not be marked as read. Try again.";
            }
            finally
            {
                _isMarkingRead = false;
            }
        }
    }

    private void ShowDeleteConfirmation(NotificationModel notification)
    {
        _errorMessage = null;
        _statusMessage = null;
        _notificationToDelete = notification;
        _showDeleteConfirmation = true;
        _activateDeleteDialogAfterRender = true;
        StateHasChanged();
    }

    private async Task CancelDelete()
    {
        await JSRuntime.InvokeVoidAsync("openWishDeactivateDialog", "notification-delete-dialog");
        _showDeleteConfirmation = false;
        _notificationToDelete = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (_notificationToDelete is null || _userId is null || _isDeleting)
        {
            return;
        }

        _isDeleting = true;
        _errorMessage = null;
        var notificationIdToDelete = _notificationToDelete.PublicId;
        try
        {
            var success = await NotificationService.DeleteNotificationAsync(notificationIdToDelete, _userId);
            if (!success)
            {
                _errorMessage = "This notification could not be deleted. Refresh the page and try again.";
                Logger.LogWarning(
                    "Notification {NotificationPublicId} could not be deleted for user {UserId}.",
                    notificationIdToDelete,
                    _userId);
                return;
            }

            _notifications = _notifications?.Where(n => n.PublicId != notificationIdToDelete).ToList();
            await LoadNotificationCount();
            await JSRuntime.InvokeVoidAsync("openWishDeactivateDialog", "notification-delete-dialog");
            _showDeleteConfirmation = false;
            _notificationToDelete = null;
            _statusMessage = "Notification deleted.";
            _focusFlyoutCloseAfterRender = true;
        }
        catch (Exception ex) when (ex is InvalidOperationException or DbUpdateException or DbException)
        {
            Logger.LogError(
                ex,
                "Unable to delete notification {NotificationPublicId} for user {UserId}.",
                notificationIdToDelete,
                _userId);
            _errorMessage = "This notification could not be deleted. Refresh the page and try again.";
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private bool IsNotificationProcessing(int notificationId) => _notificationsInFlight.Contains(notificationId);

    private async Task HandleActionOption(NotificationModel notification, string optionKey)
    {
        if (notification.Action is null)
        {
            return;
        }

        var actionType = notification.Action.Type ?? string.Empty;
        var handled = false;

        if (string.Equals(actionType, "EventInvitation", StringComparison.OrdinalIgnoreCase))
        {
            handled = await HandleEventInvitationAction(notification, optionKey);
        }

        if (!handled && !string.IsNullOrWhiteSpace(notification.Action.NavigateTo))
        {
            await NavigateTo(notification.Action.NavigateTo);
        }
    }

    private async Task<bool> HandleEventInvitationAction(NotificationModel notification, string optionKey)
    {
        if (notification.Action?.Parameters is null)
        {
            return false;
        }

        if (!TryGetActionParameter(notification.Action, "eventUserId", out var eventUserIdRaw) ||
            !int.TryParse(eventUserIdRaw, out var eventUserId))
        {
            return false;
        }

        var accept = string.Equals(optionKey, "accept", StringComparison.OrdinalIgnoreCase);
        var decline = string.Equals(optionKey, "decline", StringComparison.OrdinalIgnoreCase) ||
                      string.Equals(optionKey, "reject", StringComparison.OrdinalIgnoreCase);

        if (!accept && !decline)
        {
            return false;
        }

        var userId = _userId ?? await UserContextService.GetUserIdAsync();
        if (userId is null)
        {
            return false;
        }

        if (_notificationsInFlight.Contains(notification.Id))
        {
            return true;
        }

        _notificationsInFlight.Add(notification.Id);
        _errorMessage = null;
        _statusMessage = null;
        try
        {
            bool success;
            try
            {
                success = accept
                    ? await EventService.AcceptEventInvitationAsync(eventUserId, userId)
                    : await EventService.RejectEventInvitationAsync(eventUserId, userId);
            }
            catch (Exception ex) when (ex is InvalidOperationException or DbUpdateException or DbException)
            {
                Logger.LogError(ex, "Unable to update invitation from notification {NotificationPublicId}.", notification.PublicId);
                _errorMessage = "The invitation could not be updated. Try again.";
                return true;
            }

            if (!success)
            {
                _errorMessage = "The invitation could not be updated. Try again.";
                return true;
            }

            try
            {
                var markedAsRead = await NotificationService.MarkNotificationAsReadAsync(notification.PublicId, _userId!);
                if (markedAsRead)
                {
                    notification.IsRead = true;
                }
                else
                {
                    _errorMessage = "The invitation was updated, but its notification could not be marked as read.";
                }
            }
            catch (Exception ex) when (ex is InvalidOperationException or DbUpdateException or DbException)
            {
                Logger.LogError(
                    ex,
                    "Invitation was updated, but notification {NotificationPublicId} could not be marked as read.",
                    notification.PublicId);
                _errorMessage = "The invitation was updated, but its notification could not be marked as read.";
            }

            await LoadNotificationCount();
            _statusMessage = accept ? "Invitation accepted." : "Invitation declined.";

            if (accept && !string.IsNullOrWhiteSpace(notification.Action?.NavigateTo))
            {
                await NavigateTo(notification.Action.NavigateTo);
            }
        }
        finally
        {
            _notificationsInFlight.Remove(notification.Id);
            StateHasChanged();
        }

        return true;
    }

    private static bool TryGetActionParameter(NotificationActionModel action, string key, out string value)
    {
        value = string.Empty;
        if (action.Parameters is null)
        {
            return false;
        }

        if (action.Parameters.TryGetValue(key, out var exact))
        {
            value = exact;
            return true;
        }

        foreach (var pair in action.Parameters)
        {
            if (string.Equals(pair.Key, key, StringComparison.OrdinalIgnoreCase))
            {
                value = pair.Value;
                return true;
            }
        }

        return false;
    }

    private async Task NavigateTo(string route)
    {
        if (string.IsNullOrWhiteSpace(route))
        {
            return;
        }

        await CloseFlyout();
        NavigationManager.NavigateTo(route, forceLoad: true);
    }

    private static string GetNotificationName(NotificationModel notification) =>
        !string.IsNullOrWhiteSpace(notification.Title) ? notification.Title : "this notification";

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("openWishDeactivateDialog", "notification-delete-dialog");
            await JSRuntime.InvokeVoidAsync("openWishDeactivateDialog", "notification-flyout");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}