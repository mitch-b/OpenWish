@using System.Linq
@using System.Net.Http
@using System.Net.Mail
@using OpenWish.Shared.Models
@using OpenWish.Shared.RequestModels
@using OpenWish.Shared.Services

@inject IEventService EventService
@inject IUserContextService UserContextService
@inject IFriendService FriendService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<EventInvitations> Logger

<section class="card shadow-sm event-invitations" aria-busy="@(_isLoading || IsInvitationActionBusy || _isSending ? "true" : "false")"
         aria-labelledby="event-invitations-title">
    <div class="card-body">
        <div class="invitations-header">
            <div>
                <h2 id="event-invitations-title" class="h4 mb-1">@(IsOwner ? "Invite people" : "Invitations")</h2>
                <p class="small text-muted mb-0">@InvitationGuidance</p>
            </div>
            @if (!_isLoading && _invitations.Any())
            {
                <div class="invitation-summary" aria-label="Invitation status">
                    <span class="invitation-summary-item invitation-summary-accepted">
                        <strong>@_invitations.Count(IsAccepted)</strong> accepted
                    </span>
                    <span class="invitation-summary-item invitation-summary-pending">
                        <strong>@_invitations.Count(i => HasStatus(i, "Pending"))</strong> waiting
                    </span>
                    @if (_invitations.Any(i => HasStatus(i, "Rejected")))
                    {
                        <span class="invitation-summary-item">
                            <strong>@_invitations.Count(i => HasStatus(i, "Rejected"))</strong> declined
                        </span>
                    }
                </div>
            }
        </div>

        @if (IsOwner && !NamesDrawn)
        {
            <div class="invite-composer" aria-busy="@(_isSending ? "true" : "false")">
                <div class="invite-mode-tabs" role="tablist" aria-label="How to invite">
                    <button class="invite-mode-tab @(_inviteMode == "email" ? "active" : "")"
                            id="event-invite-email-tab"
                            role="tab"
                            aria-selected="@(_inviteMode == "email")"
                            aria-controls="event-invite-email-panel"
                            disabled="@_isSending"
                            @onclick="SetInviteModeEmailAsync"
                            type="button">
                        <OpenWishIcon Name="envelope" /> By email
                    </button>
                    <button class="invite-mode-tab @(_inviteMode == "friends" ? "active" : "")"
                            id="event-invite-friends-tab"
                            role="tab"
                            aria-selected="@(_inviteMode == "friends")"
                            aria-controls="event-invite-friends-panel"
                            disabled="@_isSending"
                            @onclick="SetInviteModeFriendsAsync"
                            type="button">
                        <OpenWishIcon Name="people" /> From friends
                    </button>
                </div>

                <div id="event-invite-email-panel" role="tabpanel"
                     aria-labelledby="event-invite-email-tab" hidden="@(_inviteMode != "email")">
                    <label for="emailInput" class="form-label">Email addresses</label>
                    <textarea class="form-control" id="emailInput" rows="3"
                              @bind="_emailsToInvite"
                              @bind:event="oninput"
                              disabled="@_isSending"
                              aria-describedby="emailInputHelp"
                              placeholder="alex@example.com, jordan@example.com"></textarea>
                    <div id="emailInputHelp" class="form-text">
                        Paste as many addresses as you need, separated by commas, semicolons, or new lines.
                    </div>
                </div>
                <div id="event-invite-friends-panel" role="tabpanel"
                     aria-labelledby="event-invite-friends-tab" hidden="@(_inviteMode != "friends")">
                    @if (_friends == null || _pendingFriendInvites == null)
                    {
                        @if (!string.IsNullOrWhiteSpace(_friendsLoadError))
                        {
                            <div class="alert alert-danger" role="alert">
                                <p class="mb-2">@_friendsLoadError</p>
                                <button type="button" class="btn btn-outline-danger" @onclick="RetryFriendsAsync">
                                    Try again
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted d-flex align-items-center gap-2 mb-0" role="status">
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>Loading your friends...</span>
                            </p>
                        }
                    }
                    else if (_friends.Count == 0 && _pendingFriendInvites.Count == 0)
                    {
                        <p class="text-muted mb-0">You don't have any friends or pending invites yet. Invite people by email instead.</p>
                    }
                    else
                    {
                        <label for="event-invite-friend-search" class="form-label">Select friends or pending invites</label>
                        <input class="form-control form-control-sm mb-2"
                               id="event-invite-friend-search"
                               type="search"
                               placeholder="Search friends..."
                               disabled="@_isSending"
                               @bind="_friendSearchTerm"
                               @bind:event="oninput" />
                        var filteredFriends = FilteredFriends.ToList();
                        var filteredPendingInvites = FilteredPendingInvites.ToList();
                        @if (filteredFriends.Any() || filteredPendingInvites.Any())
                        {
                            <div class="friend-list border rounded overflow-auto">
                                @foreach (var friend in filteredFriends)
                                {
                                    var isFriendSelected = _selectedFriendIds.Contains(friend.Id);
                                    var alreadyInvited = IsAlreadyInvited(friend);
                                    <label class="friend-option border-bottom" for="friend-@friend.Id">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="friend-@friend.Id"
                                               checked="@isFriendSelected"
                                               disabled="@(_isSending || alreadyInvited)"
                                               @onchange="args => ToggleFriendSelection(friend.Id, IsChecked(args.Value))" />
                                        <div class="friend-option__content">
                                            <span>@(friend.UserName ?? friend.Email ?? "Unnamed Friend")</span>
                                            @if (alreadyInvited)
                                            {
                                                <small class="text-muted">Already invited</small>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(friend.Email))
                                            {
                                                <small class="text-muted">@friend.Email</small>
                                            }
                                        </div>
                                    </label>
                                }
                                @foreach (var pendingInvite in filteredPendingInvites)
                                {
                                    var isPendingInviteSelected = _selectedPendingInviteEmails.Contains(pendingInvite.Email);
                                    <label class="friend-option border-bottom" for="pending-@pendingInvite.Id">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="pending-@pendingInvite.Id"
                                               checked="@isPendingInviteSelected"
                                               disabled="@_isSending"
                                               @onchange="args => TogglePendingInviteSelection(pendingInvite.Email, IsChecked(args.Value))" />
                                        <div class="friend-option__content">
                                            <span>@pendingInvite.Email</span>
                                            <small class="text-muted"><OpenWishIcon Name="clock-history" /> Hasn't joined OpenWish yet</small>
                                        </div>
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No friends match your search.</p>
                        }
                    }
                </div>

                <div class="invite-composer-actions">
                    <button type="button" class="btn btn-primary invite-send-button" @onclick="HandleSendInvitation" disabled="@DisableSendButton">
                        @if (_isSending)
                        {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span>Sending...</span>
                        }
                        else
                        {
                            <OpenWishIcon Name="send" />
                            <span>@SendButtonLabel</span>
                        }
                    </button>
                    @if (!_isSending && _inviteMode == "email" && EmailAddressTokens.Count > ParsedEmailAddresses.Count)
                    {
                        <span class="small text-danger">@(EmailAddressTokens.Count - ParsedEmailAddresses.Count) address@(EmailAddressTokens.Count - ParsedEmailAddresses.Count == 1 ? " doesn't" : "es don't") look valid yet.</span>
                    }
                </div>

                @if (_isSending && _sendTotal > 0)
                {
                    <div class="invite-progress" data-testid="invite-progress">
                        <div class="invite-progress-label" role="status" aria-live="polite">
                            <span>Sending @Math.Min(_sendCompleted + 1, _sendTotal) of @_sendTotal...</span>
                            @if (!string.IsNullOrEmpty(_sendCurrent))
                            {
                                <span class="invite-progress-current">@_sendCurrent</span>
                            }
                        </div>
                        <div class="progress" role="progressbar" aria-label="Invitations sent"
                             aria-valuemin="0" aria-valuemax="@_sendTotal" aria-valuenow="@_sendCompleted">
                            <div class="progress-bar" style="width: @SendProgressPercent%"></div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">@_errorMessage</div>
                }
                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert alert-success mt-3 mb-0" role="status" aria-live="polite">@_successMessage</div>
                }
            </div>
        }
        else if (IsOwner && NamesDrawn)
        {
            <p class="invite-locked small text-muted">
                <OpenWishIcon Name="lock" /> Names are drawn, so the group is locked. Reset the draw to invite or remove people.
            </p>
        }

        @if (IsOwner && !NamesDrawn && _invitations.Any(i => HasStatus(i, "Pending")))
        {
            <p class="invite-hint small">
                <OpenWishIcon Name="info-circle" />
                <span>Only accepted people are included in the draw. If someone won't get around to it, use <strong>Mark as accepted</strong> to add them yourself.</span>
            </p>
        }

        @if (!string.IsNullOrEmpty(_inlineErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @_inlineErrorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(_inlineSuccessMessage))
        {
            <div class="alert alert-success" role="status" aria-live="polite">
                @_inlineSuccessMessage
            </div>
        }

        @if (_isLoading)
        {
            <div class="text-center py-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading invitations...</span>
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <p class="mb-2">@_loadErrorMessage</p>
                <button type="button" class="btn btn-outline-danger" @onclick="LoadInvitations">
                    Try again
                </button>
            </div>
        }
        else if (_invitations.Any())
        {
            <div class="d-flex flex-wrap invitation-filters mb-3" role="group" aria-label="Filter invitations by status">
                <button type="button" class="btn btn-sm @(_filter == "All" ? "btn-primary" : "btn-outline-primary")"
                        aria-pressed="@(_filter == "All")"
                        aria-controls="event-invitations-list"
                        @onclick="@(() => _filter = "All")">
                    All (@_invitations.Count())
                </button>
                <button type="button" class="btn btn-sm @(_filter == "Pending" ? "btn-warning" : "btn-outline-warning")"
                        aria-pressed="@(_filter == "Pending")"
                        aria-controls="event-invitations-list"
                        @onclick="@(() => _filter = "Pending")">
                    Pending (@_invitations.Count(i => HasStatus(i, "Pending")))
                </button>
                <button type="button" class="btn btn-sm @(_filter == "Accepted" ? "btn-success" : "btn-outline-success")"
                        aria-pressed="@(_filter == "Accepted")"
                        aria-controls="event-invitations-list"
                        @onclick="@(() => _filter = "Accepted")">
                    Accepted (@_invitations.Count(IsAccepted))
                </button>
                <button type="button" class="btn btn-sm @(_filter == "Rejected" ? "btn-danger" : "btn-outline-danger")"
                        aria-pressed="@(_filter == "Rejected")"
                        aria-controls="event-invitations-list"
                        @onclick="@(() => _filter = "Rejected")">
                    Rejected (@_invitations.Count(i => HasStatus(i, "Rejected")))
                </button>
            </div>

            <p class="visually-hidden" aria-live="polite">@FilteredInvitationCountMessage</p>
            <div id="event-invitations-list" class="list-group">
                @foreach (var invitation in FilteredInvitations)
                {
                    <div class="list-group-item">
                        <div class="d-flex flex-column gap-2">
                            <div class="invitation-identity">
                                @if (invitation.User != null)
                                {
                                    <strong>@invitation.User.UserName</strong>
                                    <span>@invitation.User.Email</span>
                                }
                                else if (!string.IsNullOrEmpty(invitation.InviteeEmail))
                                {
                                    <strong>@(invitation.GuestDisplayName ?? invitation.InviteeEmail)</strong>
                                    <span>@invitation.InviteeEmail</span>
                                    <span>@GuestAccessStatus(invitation)</span>
                                }
                                <div class="mt-1">
                                    <span class="badge @GetStatusBadgeClass(invitation.Status)">@invitation.Status</span>
                                    <small class="text-muted ms-2">
                                        Invited @invitation.InvitationDate.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                            </div>
                            @if (IsOwner && (AllowGuests || invitation.GuestDisplayName is not null || HasStatus(invitation, "Rejected")) &&
                                invitation.UserId is null && invitation.Status is "Pending" or "Accepted" or "Rejected")
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @if (CanMarkAccepted(invitation))
                                    {
                                        @MarkAcceptedButton(invitation)
                                    }
                                    @if (!HasStatus(invitation, "Rejected"))
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                                disabled="@(IsInvitationActionBusy || !AllowGuests)"
                                                @onclick="() => HandleGuestAccess(invitation, false)">
                                            @(IsProcessingGuest(invitation, "guest-send") ? "Sending..." : "Resend private access")
                                        </button>
                                    }
                                    @if (invitation.HasGuestAccess)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm"
                                                id="@($"revoke-guest-{invitation.PublicId}")"
                                                disabled="@IsInvitationActionBusy"
                                                @onclick="() => PromptGuestRevoke(invitation, false)">
                                            @(IsProcessingGuest(invitation, "guest-revoke") ? "Revoking..." : "Revoke private access")
                                        </button>
                                    }
                                    @if (!NamesDrawn)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled="@IsInvitationActionBusy"
                                                id="@($"remove-guest-{invitation.PublicId}")"
                                                @onclick="() => PromptGuestRevoke(invitation, true)">Remove guest</button>
                                    }
                                </div>
                            }
                            else if (IsOwner && HasStatus(invitation, "Pending"))
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @if (CanMarkAccepted(invitation))
                                    {
                                        @MarkAcceptedButton(invitation)
                                    }
                                    <button class="btn btn-outline-secondary btn-sm"
                                            disabled="@IsInvitationActionBusy"
                                            @onclick="() => CopyInvitationLinkAsync(invitation)"
                                            title="Copy a link to share directly">
                                        <OpenWishIcon Name="copy" Class="me-1" /> Copy link
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm"
                                            disabled="@IsInvitationActionBusy"
                                            @onclick="() => HandleResendInvitation(invitation.Id)"
                                            title="Resend invitation">
                                        @if (IsProcessingInvitation(invitation.Id, "resend"))
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                            <span>Resending...</span>
                                        }
                                        else
                                        {
                                            <OpenWishIcon Name="arrow-repeat" Class="me-1" />
                                            <span>Resend</span>
                                        }
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm"
                                            disabled="@IsInvitationActionBusy"
                                            @onclick="() => HandleCancelInvitation(invitation.Id)"
                                            title="Cancel invitation">
                                        @if (IsProcessingInvitation(invitation.Id, "cancel"))
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                            <span>Canceling...</span>
                                        }
                                        else
                                        {
                                            <OpenWishIcon Name="x-lg" Class="me-1" />
                                            <span>Cancel</span>
                                        }
                                    </button>
                                </div>
                            }
                            else if (IsOwner &&
                                     !NamesDrawn &&
                                     IsAccepted(invitation) &&
                                     !string.IsNullOrEmpty(invitation.UserId))
                            {
                                <div class="btn-group flex-shrink-0">
                                    <button class="btn btn-outline-danger btn-sm"
                                            disabled="@IsInvitationActionBusy"
                                            @onclick="() => PromptRemoveParticipant(invitation)"
                                            title="Remove from event">
                                        <OpenWishIcon Name="person-dash" /> @("Remove")
                                    </button>
                                </div>
                            }
                            else if (!IsOwner && IsCurrentUserInvitee(invitation) && HasStatus(invitation, "Pending"))
                            {
                                <div class="btn-group flex-shrink-0">
                                    <button class="btn btn-success btn-sm"
                                            disabled="@IsInvitationActionBusy"
                                            @onclick="() => HandleAcceptInvitation(invitation.Id)"
                                            title="Accept invitation">
                                        @if (IsProcessingInvitation(invitation.Id, "accept"))
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                            <span>Accepting...</span>
                                        }
                                        else
                                        {
                                            <OpenWishIcon Name="check-lg" />
                                            <span>Accept</span>
                                        }
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm"
                                            disabled="@IsInvitationActionBusy"
                                            @onclick="() => HandleRejectInvitation(invitation.Id)"
                                            title="Reject invitation">
                                        @if (IsProcessingInvitation(invitation.Id, "reject"))
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                            <span>Rejecting...</span>
                                        }
                                        else
                                        {
                                            <OpenWishIcon Name="x-lg" />
                                            <span>Reject</span>
                                        }
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (!IsOwner)
        {
            <p class="text-muted mb-0">No one has been invited yet.</p>
        }
        else
        {
            <p class="invite-empty text-muted mb-0">No one has been invited yet. Add a few email addresses above to get started.</p>
        }
    </div>
</section>

<Dialog @ref="_guestRevokeDialog" Title="@(_removeGuest ? "Remove guest?" : "Revoke private guest access?")"
        DescriptionId="guest-revoke-description" ReturnFocusElementId="@(_guestPendingRevoke is null ? null : $"{(_removeGuest ? "remove" : "revoke")}-guest-{_guestPendingRevoke.PublicId}")"
        CanClose="@(!IsInvitationActionBusy)">
    <p id="guest-revoke-description">This stops the private link and access on every device for <strong>@(_guestPendingRevoke?.GuestDisplayName ?? _guestPendingRevoke?.InviteeEmail)</strong>. @(_removeGuest ? "They will no longer be included in the draw." : "Their place in the draw is unchanged.")</p>
    <p class="text-muted">@(_removeGuest ? "Send a new invitation if you want them to join again." : "Resend private access to restore it with a fresh link.")</p>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-secondary" data-dialog-initial-focus disabled="@IsInvitationActionBusy"
                @onclick="CloseGuestRevoke">@(_removeGuest ? "Keep guest" : "Keep private access")</button>
        <button type="button" class="btn btn-danger" disabled="@IsInvitationActionBusy" @onclick="ConfirmGuestRevoke">
            @(IsInvitationActionBusy ? (_removeGuest ? "Removing..." : "Revoking...") : (_removeGuest ? "Remove guest" : "Revoke private access"))
        </button>
    </div>
</Dialog>

@if (_showRemoveConfirmation && _invitationPendingRemoval != null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-busy="@(_isRemovingParticipant ? "true" : "false")"
         aria-labelledby="remove-participant-dialog-title" aria-describedby="remove-participant-dialog-description">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="remove-participant-dialog-title" class="modal-title">Remove participant</h5>
                    <button type="button" class="btn-close" aria-label="Close removal confirmation"
                            @onclick="CancelRemoveParticipant" disabled="@_isRemovingParticipant"></button>
                </div>
                <div class="modal-body">
                    <p id="remove-participant-dialog-description">
                        Are you sure you want to remove
                        <strong>@GetInvitationDisplayName(_invitationPendingRemoval)</strong>
                        from this event?
                    </p>
                    <p class="text-muted mb-0">
                        They will lose access to event details and any attached wishlists.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelRemoveParticipant" disabled="@_isRemovingParticipant">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="HandleRemoveParticipantAsync" disabled="@_isRemovingParticipant">
                        @if (_isRemovingParticipant)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            @("Removing...")
                        }
                        else
                        {
                            <OpenWishIcon Name="person-dash" /> @(textContent: "Remove")
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<Dialog @ref="_markAcceptedDialog" Title="Mark as accepted"
        DescriptionId="mark-accepted-description"
        ReturnFocusElementId="@(_invitationPendingAccept is null ? null : $"mark-accepted-{_invitationPendingAccept.PublicId}")"
        CanClose="@(!_isMarkingAccepted)">
    @if (_invitationPendingAccept is { } pendingAccept)
    {
        <form @onsubmit="ConfirmMarkAcceptedAsync" @onsubmit:preventDefault aria-busy="@(_isMarkingAccepted ? "true" : "false")">
            <p id="mark-accepted-description">
                Add <strong>@GetInvitationDisplayName(pendingAccept)</strong> to this event as if they accepted.
                They'll be included when you draw names@(pendingAccept.UserId is null ? " and will get their match by email" : " and will see the event in OpenWish").
            </p>
            @if (pendingAccept.UserId is null)
            {
                <div class="mb-3">
                    <label for="mark-accepted-name" class="form-label">Name to show the group</label>
                    <input id="mark-accepted-name" class="form-control" maxlength="80" autocomplete="off"
                           data-dialog-initial-focus
                           disabled="@_isMarkingAccepted"
                           aria-describedby="mark-accepted-name-help"
                           @bind="_markAcceptedName" @bind:event="oninput" />
                    <div id="mark-accepted-name-help" class="form-text">Use the name your group knows them by, like "Grandma Jo".</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_markAcceptedError))
            {
                <div class="alert alert-danger" role="alert">@_markAcceptedError</div>
            }
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-secondary" disabled="@_isMarkingAccepted"
                        data-dialog-initial-focus="@(pendingAccept.UserId is null ? null : "true")"
                        @onclick="CloseMarkAcceptedAsync">Cancel</button>
                <button type="submit" class="btn btn-primary" disabled="@(_isMarkingAccepted || (pendingAccept.UserId is null && string.IsNullOrWhiteSpace(_markAcceptedName)))">
                    @if (_isMarkingAccepted)
                    {
                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        <span>Adding to event...</span>
                    }
                    else
                    {
                        <OpenWishIcon Name="person-check" Class="me-1" />
                        <span>Mark as accepted</span>
                    }
                </button>
            </div>
        </form>
    }
</Dialog>

@code {
    [Parameter] public string EventId { get; set; } = string.Empty;
    [Parameter] public bool IsOwner { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public bool NamesDrawn { get; set; }
    [Parameter] public bool AllowGuests { get; set; }
    [Parameter] public EventCallback OnInvitationsChanged { get; set; }
    private Dialog? _markAcceptedDialog;
    private EventUserModel? _invitationPendingAccept;
    private string _markAcceptedName = string.Empty;
    private string? _markAcceptedError;
    private bool _isMarkingAccepted;
    private int _sendTotal;
    private int _sendCompleted;
    private string? _sendCurrent;
    private Dialog? _guestRevokeDialog;
    private EventUserModel? _guestPendingRevoke;
    private bool _removeGuest;
    private string? _processingGuestPublicId;

    private List<EventUserModel> _invitations = new();
    private List<ApplicationUserModel>? _friends = null;
    private List<PendingFriendInviteModel>? _pendingFriendInvites = null;
    private readonly HashSet<string> _selectedFriendIds = new();
    private readonly HashSet<string> _selectedPendingInviteEmails = new();
    private bool _isLoading = true;
    private bool _isSending = false;
    private bool _showRemoveConfirmation = false;
    private bool _isRemovingParticipant;
    private int? _processingInvitationId;
    private string? _processingInvitationAction;
    private string _filter = "All";
    private string _inviteMode = "email";
    private string _emailsToInvite = string.Empty;
    private string _friendSearchTerm = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _inlineErrorMessage;
    private string? _inlineSuccessMessage;
    private string? _loadErrorMessage;
    private string? _friendsLoadError;
    private EventUserModel? _invitationPendingRemoval;
    private bool IsInvitationActionBusy => _processingInvitationId.HasValue || _isRemovingParticipant || _isMarkingAccepted;
    private int SendProgressPercent => _sendTotal == 0 ? 0 : (int)Math.Round(_sendCompleted * 100.0 / _sendTotal);
    private string InvitationGuidance => !IsOwner
        ? "People invited to this event and where they stand."
        : NamesDrawn
            ? "Everyone below is part of this exchange."
            : AllowGuests
                ? "Add people by email. They can accept and see their own match without creating an account."
                : "Add people by email or from your friends. They'll get an email with a link to join.";
    private bool IsProcessingInvitation(int invitationId, string action) =>
        _processingInvitationId == invitationId &&
        string.Equals(_processingInvitationAction, action, StringComparison.Ordinal);
    private IReadOnlyList<string> ParsedEmailAddresses => ParseEmailAddresses(_emailsToInvite);
    private bool DisableSendButton =>
        _isSending ||
        (_inviteMode == "email"
            ? ParsedEmailAddresses.Count == 0
            : !_selectedFriendIds.Any() && !_selectedPendingInviteEmails.Any());
    private string SendButtonLabel => _inviteMode == "email" && ParsedEmailAddresses.Count > 1
        ? $"Send {ParsedEmailAddresses.Count} invitations"
        : "Send invitation";
    private string FilteredInvitationCountMessage
    {
        get
        {
            var count = FilteredInvitations.Count();
            return $"{count} {(_filter == "All" ? "total" : _filter.ToLowerInvariant())} " +
                $"invitation{(count == 1 ? string.Empty : "s")} shown.";
        }
    }

    private IEnumerable<EventUserModel> FilteredInvitations =>
        _filter == "All" ? _invitations : _invitations.Where(i => i.Status == _filter);

    private IEnumerable<ApplicationUserModel> FilteredFriends =>
        string.IsNullOrWhiteSpace(_friendSearchTerm)
            ? _friends ?? Enumerable.Empty<ApplicationUserModel>()
            : (_friends ?? Enumerable.Empty<ApplicationUserModel>())
                .Where(friend =>
                    (!string.IsNullOrEmpty(friend.UserName) && friend.UserName.Contains(_friendSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(friend.Email) && friend.Email.Contains(_friendSearchTerm, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<PendingFriendInviteModel> FilteredPendingInvites =>
        string.IsNullOrWhiteSpace(_friendSearchTerm)
            ? _pendingFriendInvites ?? Enumerable.Empty<PendingFriendInviteModel>()
            : (_pendingFriendInvites ?? Enumerable.Empty<PendingFriendInviteModel>())
                .Where(invite => invite.Email.Contains(_friendSearchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadInvitations();
    }

    private bool IsCurrentUserInvitee(EventUserModel invitation)
    {
        if (string.IsNullOrEmpty(CurrentUserId))
            return false;

        return invitation.UserId == CurrentUserId;
    }

    private async Task LoadInvitations()
    {
        _isLoading = true;
        _loadErrorMessage = null;
        try
        {
            if (string.IsNullOrEmpty(CurrentUserId))
            {
                _loadErrorMessage = "Authentication required to view invitations.";
                return;
            }

            var invitations = await EventService.GetEventInvitationsByPublicIdAsync(EventId, CurrentUserId);
            _invitations = invitations.ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load invitations for event {EventPublicId}", EventId);
            _invitations.Clear();
            _loadErrorMessage = "We couldn't load event invitations. Try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public async Task FocusComposerAsync()
    {
        if (!IsOwner || NamesDrawn)
        {
            return;
        }

        if (_inviteMode != "email")
        {
            _inviteMode = "email";
            StateHasChanged();
            await Task.Yield();
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("openWishFocusElement", "emailInput");
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "Invitation composer could not be focused");
        }
    }

    private Task NotifyInvitationsChangedAsync() => OnInvitationsChanged.InvokeAsync();

    private bool IsAlreadyInvited(ApplicationUserModel friend) =>
        _invitations.Any(invitation => !invitation.Deleted &&
            !HasStatus(invitation, "Rejected") &&
            (string.Equals(invitation.UserId, friend.Id, StringComparison.Ordinal) ||
             (!string.IsNullOrWhiteSpace(friend.Email) &&
              string.Equals(invitation.InviteeEmail, friend.Email, StringComparison.OrdinalIgnoreCase))));

    private bool CanMarkAccepted(EventUserModel invitation) =>
        IsOwner && !NamesDrawn && HasStatus(invitation, "Pending");

    private RenderFragment MarkAcceptedButton(EventUserModel invitation) => __builder =>
    {
        <button type="button" class="btn btn-outline-primary btn-sm"
                id="@($"mark-accepted-{invitation.PublicId}")"
                disabled="@IsInvitationActionBusy"
                aria-label="@($"Mark {GetInvitationDisplayName(invitation)} as accepted")"
                @onclick="() => PromptMarkAccepted(invitation)">
            <OpenWishIcon Name="person-check" Class="me-1" /> Mark as accepted
        </button>
    };

    private void PromptMarkAccepted(EventUserModel invitation)
    {
        if (IsInvitationActionBusy)
        {
            return;
        }

        _inlineErrorMessage = null;
        _inlineSuccessMessage = null;
        _markAcceptedError = null;
        _invitationPendingAccept = invitation;
        _markAcceptedName = invitation.UserId is null
            ? invitation.GuestDisplayName ?? SuggestDisplayName(invitation.InviteeEmail)
            : string.Empty;
        _markAcceptedDialog?.Show();
    }

    private Task CloseMarkAcceptedAsync() => _markAcceptedDialog?.CloseAsync() ?? Task.CompletedTask;

    private async Task ConfirmMarkAcceptedAsync()
    {
        if (_isMarkingAccepted || _invitationPendingAccept is not { } invitation)
        {
            return;
        }

        var needsName = invitation.UserId is null;
        if (needsName && string.IsNullOrWhiteSpace(_markAcceptedName))
        {
            _markAcceptedError = "Enter the name your group knows them by.";
            return;
        }

        _markAcceptedError = null;
        _isMarkingAccepted = true;
        try
        {
            var userId = await UserContextService.GetUserIdAsync();
            if (string.IsNullOrWhiteSpace(userId))
            {
                _markAcceptedError = "Sign in again to add people to this event.";
                return;
            }

            var request = new OrganizerAcceptInvitationRequest
            {
                DisplayName = needsName ? _markAcceptedName.Trim() : null
            };
            var accepted = await EventService.AcceptInvitationForParticipantAsync(EventId, invitation.PublicId, request, userId);
            if (!accepted)
            {
                _markAcceptedError = "We couldn't add them. Reload the page and try again.";
                return;
            }

            var name = needsName ? request.DisplayName! : GetInvitationDisplayName(invitation);
            _isMarkingAccepted = false;
            await CloseMarkAcceptedAsync();
            _invitationPendingAccept = null;
            _inlineSuccessMessage = $"{name} is in. They'll be included when you draw names.";
            await LoadInvitations();
            await NotifyInvitationsChangedAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Organizer could not accept invitation {ParticipantPublicId} for event {EventPublicId}", invitation.PublicId, EventId);
            _markAcceptedError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to accept invitation {ParticipantPublicId} on behalf of an invitee for event {EventPublicId}", invitation.PublicId, EventId);
            _markAcceptedError = "We couldn't add them. Check your connection and try again.";
        }
        finally
        {
            _isMarkingAccepted = false;
        }
    }

    private static string SuggestDisplayName(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return string.Empty;
        }

        var localPart = email.Split('@')[0];
        var words = localPart
            .Split(['.', '_', '-', '+'], StringSplitOptions.RemoveEmptyEntries)
            .Where(word => word.All(char.IsLetter))
            .Select(word => char.ToUpperInvariant(word[0]) + word[1..].ToLowerInvariant())
            .ToList();
        var suggestion = string.Join(' ', words);
        return suggestion.Length is > 0 and <= 80 ? suggestion : string.Empty;
    }

    private async Task HandleSendInvitation()
    {
        if (_isSending)
        {
            return;
        }

        _isSending = true;
        _errorMessage = null;
        _successMessage = null;
        _inlineErrorMessage = null;
        _inlineSuccessMessage = null;
        _sendTotal = 0;
        _sendCompleted = 0;
        _sendCurrent = null;
        var attemptedInvitation = false;
        var failedEmailAddresses = new List<string>();

        try
        {
            var userId = await UserContextService.GetUserIdAsync();
            if (string.IsNullOrEmpty(userId))
            {
                _errorMessage = "You must be logged in to send invitations.";
                return;
            }

            if (_inviteMode == "email")
            {
                var addresses = ParsedEmailAddresses;
                var invalidAddresses = EmailAddressTokens
                    .Where(address => !MailAddress.TryCreate(address, out _))
                    .ToList();
                if (addresses.Count == 0)
                {
                    _errorMessage = "Enter at least one valid email address.";
                    return;
                }

                var invitedAddresses = new List<string>();
                var failedAddresses = new List<string>(invalidAddresses);
                _sendTotal = addresses.Count;
                foreach (var address in addresses)
                {
                    _sendCurrent = address;
                    StateHasChanged();
                    try
                    {
                        attemptedInvitation = true;
                        await EventService.InviteByEmailToEventByPublicIdAsync(EventId, userId, address);
                        invitedAddresses.Add(address);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to invite {InviteeEmail} to event {EventPublicId}", address, EventId);
                        failedAddresses.Add(address);
                        failedEmailAddresses.Add(address);
                    }
                    _sendCompleted++;
                }

                if (invitedAddresses.Count > 0)
                {
                    _successMessage = invitedAddresses.Count == 1
                        ? $"Invitation sent to {invitedAddresses[0]}."
                        : $"{invitedAddresses.Count} invitations sent.";
                    _emailsToInvite = string.Join(Environment.NewLine, failedAddresses);
                }

                if (failedAddresses.Count > 0)
                {
                    _errorMessage = $"Check or retry: {string.Join(", ", failedAddresses)}.";
                }

                if (invitedAddresses.Count == 0)
                {
                    return;
                }
            }
            else
            {
                if (!_selectedFriendIds.Any() && !_selectedPendingInviteEmails.Any())
                {
                    _errorMessage = "Please select at least one friend or pending invite to invite.";
                    return;
                }

                var invitedFriends = new List<(string Id, string Name)>();
                var invitedEmails = new List<string>();
                var failedFriends = new List<string>();
                _sendTotal = _selectedFriendIds.Count + _selectedPendingInviteEmails.Count;

                // Invite confirmed friends by user ID
                foreach (var friendId in _selectedFriendIds.ToList())
                {
                    var friend = _friends?.FirstOrDefault(f => f.Id == friendId);
                    var friendName = friend?.UserName ?? friend?.Email ?? "Friend";
                    _sendCurrent = friendName;
                    StateHasChanged();

                    try
                    {
                        attemptedInvitation = true;
                        await EventService.InviteUserToEventByPublicIdAsync(EventId, userId, friendId);
                        invitedFriends.Add((friendId, friendName));
                    }
                    catch (HttpRequestException ex)
                    {
                        Logger.LogWarning(ex, "Failed to invite friend {FriendId} to event {EventPublicId}", friendId, EventId);
                        failedFriends.Add(friendName);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Unexpected failure inviting friend {FriendId} to event {EventPublicId}", friendId, EventId);
                        failedFriends.Add(friendName);
                    }
                    _sendCompleted++;
                }

                // Invite pending friend invites by email
                foreach (var email in _selectedPendingInviteEmails.ToList())
                {
                    _sendCurrent = email;
                    StateHasChanged();
                    try
                    {
                        attemptedInvitation = true;
                        await EventService.InviteByEmailToEventByPublicIdAsync(EventId, userId, email);
                        invitedEmails.Add(email);
                    }
                    catch (HttpRequestException ex)
                    {
                        Logger.LogWarning(ex, "Failed to invite pending friend {InviteeEmail} to event {EventPublicId}", email, EventId);
                        failedFriends.Add(email);
                        failedEmailAddresses.Add(email);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Unexpected failure inviting pending friend {InviteeEmail} to event {EventPublicId}", email, EventId);
                        failedFriends.Add(email);
                        failedEmailAddresses.Add(email);
                    }
                    _sendCompleted++;
                }

                foreach (var invited in invitedFriends)
                {
                    _selectedFriendIds.Remove(invited.Id);
                }

                foreach (var email in invitedEmails)
                {
                    _selectedPendingInviteEmails.Remove(email);
                }

                var allInvitedNames = invitedFriends.Select(f => f.Name).Concat(invitedEmails).ToList();
                if (allInvitedNames.Any())
                {
                    _successMessage = BuildFriendInviteSuccessMessage(allInvitedNames);
                }

                if (failedFriends.Any())
                {
                    _errorMessage = failedFriends.Count == 1
                        ? $"Could not invite {failedFriends[0]}."
                        : $"Could not invite {failedFriends.Count} friends: {string.Join(", ", failedFriends)}.";
                }

                if (!allInvitedNames.Any())
                {
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send invitations for event {EventPublicId}", EventId);
            _errorMessage = "Invitations couldn't be sent. Check the addresses and try again.";
        }
        finally
        {
            if (attemptedInvitation)
            {
                await LoadInvitations();
                if (AllowGuests && failedEmailAddresses.Any(email =>
                    _invitations.Any(invitation => invitation.UserId is null &&
                        string.Equals(invitation.InviteeEmail, email, StringComparison.OrdinalIgnoreCase))))
                {
                    _errorMessage = "Some private invitations already exist, but their email wasn't sent. Use Resend private access on the saved invitation below. Check any remaining addresses before retrying.";
                }
            }
            _isSending = false;
            _sendTotal = 0;
            _sendCompleted = 0;
            _sendCurrent = null;
            if (attemptedInvitation)
            {
                await NotifyInvitationsChangedAsync();
            }
        }
    }

    private Task SetInviteModeEmailAsync()
    {
        _inviteMode = "email";
        return Task.CompletedTask;
    }

    private async Task SetInviteModeFriendsAsync()
    {
        _inviteMode = "friends";
        await EnsureFriendsLoadedAsync();
    }

    private async Task EnsureFriendsLoadedAsync()
    {
        if (_inviteMode != "friends" || (_friends != null && _pendingFriendInvites != null))
        {
            return;
        }

        try
        {
            _friendsLoadError = null;
            var userId = await UserContextService.GetUserIdAsync();
            if (string.IsNullOrEmpty(userId))
            {
                _errorMessage = "You must be logged in to view your friends.";
                _friends = new List<ApplicationUserModel>();
                _pendingFriendInvites = new List<PendingFriendInviteModel>();
                return;
            }

            // Load confirmed friends
            var friends = await FriendService.GetFriendsAsync(userId);
            _friends = friends
                .OrderBy(f => f.UserName ?? f.Email ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                .ToList();

            // Load pending friend invites (email-based invites to non-registered users)
            var pendingInvites = await FriendService.GetPendingFriendInvitesAsync(userId);
            _pendingFriendInvites = pendingInvites
                .OrderBy(p => p.Email, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load friends for event invitation {EventPublicId}", EventId);
            _friendsLoadError = "We couldn't load your friends. Try again.";
            _friends = null;
            _pendingFriendInvites = null;
        }
    }

    private async Task RetryFriendsAsync()
    {
        _friendsLoadError = null;
        await EnsureFriendsLoadedAsync();
    }

    private void ToggleFriendSelection(string friendId, bool isSelected)
    {
        if (string.IsNullOrEmpty(friendId))
        {
            return;
        }

        if (isSelected)
        {
            _selectedFriendIds.Add(friendId);
        }
        else
        {
            _selectedFriendIds.Remove(friendId);
        }
    }

    private void TogglePendingInviteSelection(string email, bool isSelected)
    {
        if (string.IsNullOrEmpty(email))
        {
            return;
        }

        if (isSelected)
        {
            _selectedPendingInviteEmails.Add(email);
        }
        else
        {
            _selectedPendingInviteEmails.Remove(email);
        }
    }

    private static bool IsChecked(object? value) => value is bool selected && selected;

    private static string BuildFriendInviteSuccessMessage(IReadOnlyList<string> friendNames)
    {
        if (friendNames.Count == 0)
        {
            return string.Empty;
        }

        if (friendNames.Count == 1)
        {
            return $"Invitation sent to {friendNames[0]}.";
        }

        var previewNames = friendNames.Take(3).ToList();
        var suffix = friendNames.Count > previewNames.Count
            ? $" and {friendNames.Count - previewNames.Count} more"
            : string.Empty;

        return $"Invitations sent to {string.Join(", ", previewNames)}{suffix}.";
    }

    private IReadOnlyList<string> EmailAddressTokens =>
        _emailsToInvite.Split([',', ';', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private static IReadOnlyList<string> ParseEmailAddresses(string value) =>
        value.Split([',', ';', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(address => MailAddress.TryCreate(address, out var parsed) ? parsed.Address : null)
            .Where(address => address is not null)
            .Select(address => address!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private async Task HandleAcceptInvitation(int invitationId)
    {
        await RunInvitationActionAsync(
            invitationId,
            "accept",
            "Invitation accepted.",
            "The invitation couldn't be accepted. Try again.",
            userId => EventService.AcceptEventInvitationAsync(invitationId, userId));
    }

    private async Task HandleRejectInvitation(int invitationId)
    {
        await RunInvitationActionAsync(
            invitationId,
            "reject",
            "Invitation rejected.",
            "The invitation couldn't be rejected. Try again.",
            userId => EventService.RejectEventInvitationAsync(invitationId, userId));
    }

    private async Task CopyInvitationLinkAsync(EventUserModel invitation)
    {
        var email = invitation.InviteeEmail ?? invitation.User?.Email;
        if (string.IsNullOrWhiteSpace(email))
        {
            _inlineErrorMessage = "This invitation does not have an email address to match.";
            return;
        }

        var route = $"/events/{EventId}/accept-invite?email={Uri.EscapeDataString(email)}";
        var invitationLink = NavigationManager.ToAbsoluteUri(route).ToString();
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", invitationLink);
            _inlineErrorMessage = null;
            _inlineSuccessMessage = $"Invitation link copied for {email}.";
        }
        catch (JSException)
        {
            _inlineErrorMessage = null;
            _inlineSuccessMessage = $"Copy is unavailable in this browser. Share this link: {invitationLink}";
        }
    }

    private static bool HasStatus(EventUserModel invitation, string status) =>
        string.Equals(invitation.Status, status, StringComparison.OrdinalIgnoreCase);

    private static bool IsAccepted(EventUserModel invitation) =>
        !invitation.Deleted && invitation.IsAccepted && HasStatus(invitation, "Accepted");

    private async Task HandleResendInvitation(int invitationId)
    {
        var name = GetInvitationName(invitationId);
        await RunInvitationActionAsync(
            invitationId,
            "resend",
            $"Invitation resent to {name}.",
            $"The invitation for {name} couldn't be resent. Try again.",
            userId => EventService.ResendEventInvitationAsync(invitationId, userId));
    }

    private async Task HandleGuestAccess(EventUserModel invitation, bool revoke)
    {
        if (IsInvitationActionBusy)
        {
            return;
        }
        _processingGuestPublicId = invitation.PublicId;
        try
        {
        await RunInvitationActionAsync(
            invitation.Id, revoke ? "guest-revoke" : "guest-send",
            revoke ? "Private guest access revoked." : "A fresh private link was emailed. Previous links and sessions no longer work.",
            revoke ? "Private access couldn't be revoked. Reload and try again." : "Private access couldn't be emailed. Reload and resend.",
            userId => revoke
                ? EventService.RevokeGuestAccessAsync(EventId, invitation.PublicId, userId)
                : EventService.SendGuestAccessAsync(EventId, invitation.PublicId, userId));
        }
        finally
        {
            _processingGuestPublicId = null;
        }
    }

    private bool IsProcessingGuest(EventUserModel invitation, string action) =>
        _processingGuestPublicId == invitation.PublicId && IsProcessingInvitation(invitation.Id, action);

    private void PromptGuestRevoke(EventUserModel invitation, bool remove)
    {
        _guestPendingRevoke = invitation;
        _removeGuest = remove;
        _guestRevokeDialog?.Show();
    }

    private Task CloseGuestRevoke() => _guestRevokeDialog?.CloseAsync() ?? Task.CompletedTask;

    private async Task ConfirmGuestRevoke()
    {
        if (_guestPendingRevoke is not null)
        {
            if (_removeGuest)
            {
                var invitation = _guestPendingRevoke;
                await RunInvitationActionAsync(invitation.Id, "guest-remove", "Guest removed from the event.",
                    "The guest couldn't be removed. Reset a drawn exchange before changing participants.",
                    userId => EventService.RemoveGuestParticipantAsync(EventId, invitation.PublicId, userId));
            }
            else
            {
                await HandleGuestAccess(_guestPendingRevoke, true);
            }
            await CloseGuestRevoke();
        }
    }

    private async Task HandleCancelInvitation(int invitationId)
    {
        var name = GetInvitationName(invitationId);
        await RunInvitationActionAsync(
            invitationId,
            "cancel",
            $"Invitation canceled for {name}.",
            $"The invitation for {name} couldn't be canceled. Try again.",
            userId => EventService.CancelEventInvitationAsync(invitationId, userId));
    }

    private void PromptRemoveParticipant(EventUserModel invitation)
    {
        _inlineErrorMessage = null;
        _inlineSuccessMessage = null;

        if (invitation == null || string.IsNullOrEmpty(invitation.UserId))
        {
            _inlineErrorMessage = "Unable to remove this participant.";
            return;
        }

        _invitationPendingRemoval = invitation;
        _showRemoveConfirmation = true;
    }

    private void CancelRemoveParticipant()
    {
        if (_isRemovingParticipant)
        {
            return;
        }

        _showRemoveConfirmation = false;
        _invitationPendingRemoval = null;
    }

    private async Task HandleRemoveParticipantAsync()
    {
        if (IsInvitationActionBusy)
        {
            return;
        }

        if (_invitationPendingRemoval == null || string.IsNullOrEmpty(_invitationPendingRemoval.UserId))
        {
            _inlineErrorMessage = "Unable to remove this participant.";
            _showRemoveConfirmation = false;
            return;
        }

        _inlineErrorMessage = null;
        _inlineSuccessMessage = null;
        _isRemovingParticipant = true;

        try
        {
            var requestorId = await UserContextService.GetUserIdAsync();
            if (string.IsNullOrEmpty(requestorId))
            {
                _inlineErrorMessage = "You must be logged in to remove participants.";
                return;
            }

            var removed = await EventService.RemoveUserFromEventByPublicIdAsync(EventId, _invitationPendingRemoval.UserId, requestorId);
            if (!removed)
            {
                _inlineErrorMessage = "Participant could not be removed.";
                return;
            }

            var removedName = GetInvitationDisplayName(_invitationPendingRemoval);
            _inlineSuccessMessage = $"Removed {removedName} from the event.";
            _showRemoveConfirmation = false;
            _invitationPendingRemoval = null;

            await LoadInvitations();
            await NotifyInvitationsChangedAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove participant from event {EventPublicId}", EventId);
            _inlineErrorMessage = "The participant couldn't be removed. Try again.";
        }
        finally
        {
            _isRemovingParticipant = false;
        }
    }

    private static string GetInvitationDisplayName(EventUserModel invitation)
    {
        if (!string.IsNullOrWhiteSpace(invitation.GuestDisplayName))
        {
            return invitation.GuestDisplayName;
        }
        if (!string.IsNullOrWhiteSpace(invitation.User?.UserName))
        {
            return invitation.User.UserName!;
        }

        if (!string.IsNullOrWhiteSpace(invitation.User?.Email))
        {
            return invitation.User.Email!;
        }

        if (!string.IsNullOrWhiteSpace(invitation.InviteeEmail))
        {
            return invitation.InviteeEmail;
        }

        return "this participant";
    }

    private string GuestAccessStatus(EventUserModel invitation)
    {
        if (!AllowGuests)
        {
            return invitation.GuestDisplayName is not null ? "Guest access disabled for this event" : "Not registered";
        }
        if (invitation.GuestAccessExpiresOn <= DateTimeOffset.UtcNow)
        {
            return "Guest access expired; resend it";
        }
        return invitation.HasGuestAccess
            ? (invitation.GuestEmailSentOn.HasValue ? "Guest access emailed" : "Guest email needs resend")
            : "Guest access revoked or not sent";
    }

    private string GetInvitationName(int invitationId)
    {
        var invitation = _invitations.FirstOrDefault(item => item.Id == invitationId);
        return invitation is null ? "this participant" : GetInvitationDisplayName(invitation);
    }

    private async Task RunInvitationActionAsync(
        int invitationId,
        string action,
        string successMessage,
        string errorMessage,
        Func<string, Task<bool>> operation)
    {
        if (IsInvitationActionBusy)
        {
            return;
        }

        _inlineErrorMessage = null;
        _inlineSuccessMessage = null;
        _processingInvitationId = invitationId;
        _processingInvitationAction = action;

        try
        {
            var userId = await UserContextService.GetUserIdAsync();
            if (string.IsNullOrWhiteSpace(userId))
            {
                _inlineErrorMessage = $"Sign in again to {action} this invitation.";
                return;
            }

            var succeeded = await operation(userId);
            if (!succeeded)
            {
                _inlineErrorMessage = errorMessage;
                return;
            }

            _inlineSuccessMessage = successMessage;
            await LoadInvitations();
            await NotifyInvitationsChangedAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Failed to {InvitationAction} invitation {InvitationId} for event {EventPublicId}",
                action,
                invitationId,
                EventId);
            _inlineErrorMessage = errorMessage;
        }
        finally
        {
            _processingInvitationId = null;
            _processingInvitationAction = null;
        }
    }

    private static string GetStatusBadgeClass(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Accepted" => "bg-success",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };
}
