@attribute [Authorize]
@page "/wishlists/{WishlistId}"

@using OpenWish.Shared.Products
@using OpenWish.Shared.RequestModels
@using OpenWish.Shared.Services
@using OpenWish.Web.Client.Components.Wishlist

@inject IUserContextService UserContextService
@inject IWishlistService WishlistService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<WishlistDetails> Logger

@implements IAsyncDisposable
@rendermode InteractiveAuto

<PageTitle>@(_wishlist?.Name ?? "Wishlist")</PageTitle>

@if (_wishlist == null)
{
    <div class="loading-container">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading wishlist...</span>
        </div>
        <p>Loading wishlist...</p>
    </div>
}
else
{
    <div class="wishlist-hero">
        <div class="hero-content">
            <div class="hero-title">
                @if (!string.IsNullOrEmpty(_wishlist.Icon))
                {
                    <span class="hero-icon">@_wishlist.Icon</span>
                }
                <h1>@_wishlist.Name</h1>
            </div>
            <div class="hero-context">
                @if (_wishlist.IsCollaborative)
                {
                    <span class="badge badge-collaborative">
                        <OpenWishIcon Name="people-fill" /> Collaborative
                    </span>
                }
                @if (_wishlist.IsPrivate)
                {
                    <span class="badge badge-private"><OpenWishIcon Name="lock" /> Only you can see this list</span>
                }
            </div>
        </div>
        <div class="hero-actions">
            @if (_canEdit)
            {
                <button id="add-wishlist-item"
                        class="fab"
                        type="button"
                        @onclick="ShowAddItemModal">
                    <OpenWishIcon Name="plus-lg" />
                    <span class="fab-label">Add item</span>
                </button>
            }
            <button class="btn btn-outline-secondary" type="button" @onclick="ShareWishlist">
                <OpenWishIcon Name="share" />
                <span class="btn-text">Copy link</span>
            </button>
            @if (_isOwner)
            {
                <a href="/wishlists/@WishlistId/manage" class="btn btn-outline-secondary">
                    <OpenWishIcon Name="gear" />
                    <span class="btn-text">Manage list</span>
                </a>
            }
        </div>
    </div>

    @if (_canEdit)
    {
        <p class="paste-hint">
            <OpenWishIcon Name="clipboard" />
            <span>Have a product link? Paste it anywhere on this page to add it.</span>
        </p>
    }

    @if (_wishlist.Event != null)
    {
        <div class="event-indicator">
            <a href="/events/@_wishlist.Event.PublicId" class="event-link" aria-label="View event @_wishlist.Event.Name">
                <span class="event-icon" aria-hidden="true"><OpenWishIcon Name="calendar-event" /></span>
                <div class="event-info">
                    <span class="event-label">Part of event</span>
                    <span class="event-name">@_wishlist.Event.Name</span>
                </div>
                <OpenWishIcon Name="arrow-right" />
            </a>
        </div>
    }

    @if (!string.IsNullOrEmpty(_feedbackMessage))
    {
        <div class="alert @(_feedbackIsError ? "alert-danger" : "alert-success") alert-dismissible mt-2" role="alert">
            @_feedbackMessage
            <button type="button" class="btn-close" aria-label="Close" @onclick="() => _feedbackMessage = string.Empty"></button>
        </div>
    }

    @if (!_isOwner && _wishlist is not null && !string.IsNullOrEmpty(_currentUserId))
    {
        <GiftProfilePanel WishlistPublicId="@_wishlist.PublicId" ViewerId="@_currentUserId" />
    }

    <div class="stats-dashboard">
        <div class="stat-card">
            <div class="stat-icon"><OpenWishIcon Name="box-seam" /></div>
            <div class="stat-content">
                <div class="stat-value">@_items.Count</div>
                <div class="stat-label">Total items</div>
            </div>
        </div>
        @if (!_isOwner)
        {
            <div class="stat-card">
                <div class="stat-icon"><OpenWishIcon Name="check-circle" /></div>
                <div class="stat-content">
                    <div class="stat-value">@GetReservedCount()</div>
                    <div class="stat-label">Reserved</div>
                </div>
            </div>
            <button class="stat-card stat-action"
                    type="button"
                    aria-label="Show items reserved by you"
                    aria-pressed="@(StatusFilters.Contains("mine") ? "true" : "false")"
                    @onclick='() => ToggleFilter(StatusFilters, "mine")'>
                <div class="stat-icon"><OpenWishIcon Name="gift" /></div>
                <div class="stat-content">
                    <div class="stat-value">@GetMyReservedCount()</div>
                    <div class="stat-label">Reserved by you</div>
                </div>
            </button>
        }
        <button class="stat-card stat-action"
                type="button"
                aria-label="Show items with comments"
                @onclick="FocusCommentsAsync">
            <div class="stat-icon"><OpenWishIcon Name="chat" /></div>
            <div class="stat-content">
                <div class="stat-value">@GetCommentCount()</div>
                <div class="stat-label">Comments</div>
            </div>
        </button>
    </div>

    <div class="search-filter-bar">
        <div class="search-container">
            <OpenWishIcon Name="search" Class="search-icon" />
            <label for="wishlist-item-search" class="visually-hidden">Search wishlist items</label>
            <input id="wishlist-item-search"
                   type="search"
                   class="search-input"
                   placeholder="Search items by name, description, or store..."
                   aria-controls="wishlist-items"
                   @bind="SearchQuery"
                   @bind:event="oninput"
                   @bind:after="ApplyFiltersAndSort" />
            @if (!string.IsNullOrEmpty(SearchQuery))
            {
                <button class="search-clear"
                        type="button"
                        aria-label="Clear wishlist item search"
                        @onclick="ClearSearch">
                    <OpenWishIcon Name="x-lg" />
                </button>
            }
        </div>

        <button class="btn btn-filter @(_showFilters ? "active" : "")"
                type="button"
                aria-expanded="@(_showFilters ? "true" : "false")"
                aria-controls="wishlist-filters"
                @onclick="ToggleFilters">
            <OpenWishIcon Name="funnel" />
            <span class="btn-text">Filters</span>
            @if (GetActiveFilterCount() > 0)
            {
                <span class="filter-count">@GetActiveFilterCount()</span>
            }
        </button>

        <div class="btn-group view-toggle" role="group" aria-label="Wishlist view">
            <button type="button"
                    class="btn @(ViewMode == "grid" ? "active" : "")"
                    aria-label="Grid view"
                    aria-pressed="@(ViewMode == "grid" ? "true" : "false")"
                    aria-controls="wishlist-items"
                    @onclick="@(() => SetViewMode("grid"))">
                <OpenWishIcon Name="grid-3x3-gap" />
            </button>
            <button type="button"
                    class="btn @(ViewMode == "list" ? "active" : "")"
                    aria-label="List view"
                    aria-pressed="@(ViewMode == "list" ? "true" : "false")"
                    aria-controls="wishlist-items"
                    @onclick="@(() => SetViewMode("list"))">
                <OpenWishIcon Name="list-ul" />
            </button>
        </div>
    </div>
    <p class="visually-hidden" role="status" aria-live="polite">@FilteredItemCountMessage</p>
    @if (HasActiveFilters)
    {
        <section class="applied-filters" aria-labelledby="applied-filters-title">
            <div class="applied-filters-heading">
                <div>
                    <h2 id="applied-filters-title">Showing a filtered view</h2>
                    <p>@FilteredItemCountMessage</p>
                </div>
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearAllFilters">
                    <OpenWishIcon Name="x-circle" /> Clear all
                </button>
            </div>
            <div class="applied-filter-list" aria-label="Active filters">
                @if (!string.IsNullOrWhiteSpace(SearchQuery))
                {
                    <button class="applied-filter" type="button" @onclick="ClearSearch">
                        Search: @SearchQuery <OpenWishIcon Name="x-lg" />
                        <span class="visually-hidden">Remove search filter</span>
                    </button>
                }
                @foreach (var priority in PriorityFilters.Order())
                {
                    <button class="applied-filter" type="button" @onclick="@(() => ToggleFilter(PriorityFilters, priority))">
                        Priority: @GetPriorityText(int.Parse(priority)) <OpenWishIcon Name="x-lg" />
                        <span class="visually-hidden">Remove priority filter</span>
                    </button>
                }
                @foreach (var status in StatusFilters.Order())
                {
                    <button class="applied-filter" type="button" @onclick="@(() => ToggleFilter(StatusFilters, status))">
                        @GetStatusFilterLabel(status) <OpenWishIcon Name="x-lg" />
                        <span class="visually-hidden">Remove status filter</span>
                    </button>
                }
                @if (MinPrice > 0 || MaxPrice < PriceCeiling)
                {
                    <button class="applied-filter" type="button" @onclick="ClearPriceRange">
                        Price: @GetPriceRangeLabel() <OpenWishIcon Name="x-lg" />
                        <span class="visually-hidden">Remove price filter</span>
                    </button>
                }
                @if (BudgetFilterActive)
                {
                    <button class="applied-filter" type="button" @onclick="ToggleBudgetFilter">
                        Within budget <OpenWishIcon Name="x-lg" />
                        <span class="visually-hidden">Remove budget filter</span>
                    </button>
                }
            </div>
        </section>
    }
    @if (_isOwner)
    {
        <p id="wishlist-ranking-help" class="ranking-help" role="status">
            @if (CanReorder)
            {
                <span>Use the most wanted and move controls to organize your ideas. Pinned ideas stay at the top.</span>
            }
            else
            {
                <span>Choose owner order and clear filters to rearrange ideas.</span>
            }
        </p>
    }

    @if (_isOwner && !string.IsNullOrEmpty(_currentUserId))
    {
        <WishlistOrganizePanel WishlistId="@WishlistId"
                               CurrentUserId="@_currentUserId"
                               Items="@(_items.Where(item => !item.IsHiddenFromOwner).ToList())"
                               OnChanged="@HandleOrganizeChangedAsync" />
    }

    @if (HasBudget)
    {
        <section class="budget-guide" aria-labelledby="budget-guide-title">
            <div>
                <h2 id="budget-guide-title">Shopping with a @BudgetDisplay budget</h2>
                @if (PricedItemCount == 0)
                {
                    <p>No ideas have a price yet. Add prices to compare them with this budget.</p>
                }
                else
                {
                    <p>@WithinBudgetItemCount of @PricedItemCount priced @IdeaLabel(PricedItemCount) fit this budget.</p>
                }
            </div>
            <button id="wishlist-budget-filter"
                    class="btn @(BudgetFilterActive ? "btn-primary" : "btn-outline-primary")"
                    type="button"
                    disabled="@(PricedItemCount == 0)"
                    aria-pressed="@(BudgetFilterActive ? "true" : "false")"
                    aria-controls="wishlist-items"
                    @onclick="ToggleBudgetFilter">
                <OpenWishIcon Name="currency-dollar" />
                <span>@(BudgetFilterActive ? "Showing within budget" : "Show within budget")</span>
            </button>
        </section>
    }

    @if (_showFilters)
    {
        <div id="wishlist-filters" class="filter-panel">
            <div class="filter-section" role="group" aria-labelledby="priority-filter-label">
                <span id="priority-filter-label" class="filter-label">Priority</span>
                <div class="filter-chips">
                    <button type="button"
                            class="filter-chip @(PriorityFilters.Contains("1") ? "active" : "")"
                            aria-pressed="@(PriorityFilters.Contains("1") ? "true" : "false")"
                            @onclick='() => ToggleFilter(PriorityFilters, "1")'>
                        <span class="priority-dot high" aria-hidden="true"></span> High
                    </button>
                    <button type="button"
                            class="filter-chip @(PriorityFilters.Contains("2") ? "active" : "")"
                            aria-pressed="@(PriorityFilters.Contains("2") ? "true" : "false")"
                            @onclick='() => ToggleFilter(PriorityFilters, "2")'>
                        <span class="priority-dot medium" aria-hidden="true"></span> Medium
                    </button>
                    <button type="button"
                            class="filter-chip @(PriorityFilters.Contains("3") ? "active" : "")"
                            aria-pressed="@(PriorityFilters.Contains("3") ? "true" : "false")"
                            @onclick='() => ToggleFilter(PriorityFilters, "3")'>
                        <span class="priority-dot low" aria-hidden="true"></span> Low
                    </button>
                </div>
            </div>

            <div class="filter-section" role="group" aria-labelledby="status-filter-label">
                <span id="status-filter-label" class="filter-label">Status</span>
                <div class="filter-chips">
                    @if (!_isOwner)
                    {
                        <button type="button"
                                class="filter-chip @(StatusFilters.Contains("reserved") ? "active" : "")"
                                aria-pressed="@(StatusFilters.Contains("reserved") ? "true" : "false")"
                                @onclick='() => ToggleFilter(StatusFilters, "reserved")'>
                            <OpenWishIcon Name="check-circle" /> Reserved
                        </button>
                        <button type="button"
                                class="filter-chip @(StatusFilters.Contains("unreserved") ? "active" : "")"
                                aria-pressed="@(StatusFilters.Contains("unreserved") ? "true" : "false")"
                                @onclick='() => ToggleFilter(StatusFilters, "unreserved")'>
                            <OpenWishIcon Name="circle" /> Available
                        </button>
                        <button type="button"
                                class="filter-chip @(StatusFilters.Contains("mine") ? "active" : "")"
                                aria-pressed="@(StatusFilters.Contains("mine") ? "true" : "false")"
                                @onclick='() => ToggleFilter(StatusFilters, "mine")'>
                            <OpenWishIcon Name="gift" /> Reserved by you
                        </button>
                    }
                    <button type="button"
                            class="filter-chip @(StatusFilters.Contains("commented") ? "active" : "")"
                            aria-pressed="@(StatusFilters.Contains("commented") ? "true" : "false")"
                            @onclick='() => ToggleFilter(StatusFilters, "commented")'>
                        <OpenWishIcon Name="chat" /> Has comments
                    </button>
                </div>
            </div>

            <div class="filter-section">
                <span class="filter-label">Price range: @GetPriceRangeLabel()</span>
                <div class="price-range-slider">
                    <input type="range"
                           class="form-range"
                           aria-label="Minimum price"
                           min="0"
                           max="@PriceCeiling"
                           step="10"
                           @bind="MinPrice"
                           @bind:event="oninput"
                           @bind:after="ApplyMinimumPrice" />
                    <input type="range"
                           class="form-range"
                           aria-label="Maximum price"
                           min="0"
                           max="@PriceCeiling"
                           step="10"
                           @bind="MaxPrice"
                           @bind:event="oninput"
                           @bind:after="ApplyMaximumPrice" />
                </div>
            </div>

            <div class="filter-section" role="group" aria-labelledby="wishlist-sort-label">
                <span id="wishlist-sort-label" class="filter-label">Sort by</span>
                <div class="sort-options">
                    <button type="button"
                            class="sort-option @(SortBy == "custom" ? "active" : "")"
                            aria-pressed="@(SortBy == "custom" ? "true" : "false")"
                            @onclick="@(() => SortItems("custom"))">
                        <OpenWishIcon Name="list-ol" /> Owner order
                    </button>
                    <button type="button"
                            class="sort-option @(SortBy == "priority" ? "active" : "")"
                            aria-pressed="@(SortBy == "priority" ? "true" : "false")"
                            @onclick="@(() => SortItems("priority"))">
                        <OpenWishIcon Name="star" /> Priority
                        @if (SortBy == "priority")
                        {
                            <i class="bi @(SortAscending ? "bi-arrow-up" : "bi-arrow-down")"></i>
                        }
                    </button>
                    @if (HasBudget)
                    {
                        <button type="button"
                                class="sort-option @(SortBy == "budget" ? "active" : "")"
                                aria-pressed="@(SortBy == "budget" ? "true" : "false")"
                                @onclick="@(() => SortItems("budget"))">
                            <OpenWishIcon Name="currency-dollar" /> Budget fit
                            @if (SortBy == "budget")
                            {
                                <i class="bi @(SortAscending ? "bi-arrow-up" : "bi-arrow-down")"></i>
                            }
                        </button>
                    }
                    <button type="button"
                            class="sort-option @(SortBy == "price" ? "active" : "")"
                            aria-pressed="@(SortBy == "price" ? "true" : "false")"
                            @onclick="@(() => SortItems("price"))">
                        <OpenWishIcon Name="currency-dollar" /> Price
                        @if (SortBy == "price")
                        {
                            <i class="bi @(SortAscending ? "bi-arrow-up" : "bi-arrow-down")"></i>
                        }
                    </button>
                    <button type="button"
                            class="sort-option @(SortBy == "name" ? "active" : "")"
                            aria-pressed="@(SortBy == "name" ? "true" : "false")"
                            @onclick="@(() => SortItems("name"))">
                        <OpenWishIcon Name="sort-alpha-down" /> Name
                        @if (SortBy == "name")
                        {
                            <i class="bi @(SortAscending ? "bi-arrow-up" : "bi-arrow-down")"></i>
                        }
                    </button>
                    <button type="button"
                            class="sort-option @(SortBy == "date" ? "active" : "")"
                            aria-pressed="@(SortBy == "date" ? "true" : "false")"
                            @onclick="@(() => SortItems("date"))">
                        <OpenWishIcon Name="calendar" /> Date added
                        @if (SortBy == "date")
                        {
                            <i class="bi @(SortAscending ? "bi-arrow-up" : "bi-arrow-down")"></i>
                        }
                    </button>
                </div>
            </div>

            <div class="filter-actions">
                <button class="btn btn-link" type="button" @onclick="ClearAllFilters">Clear all filters</button>
                <span class="filter-results">Showing @_filteredItems.Count of @_items.Count items</span>
            </div>
        </div>
    }

    @if (_isOwner && _staleItems.Count > 0)
    {
        <section class="stale-panel" aria-labelledby="stale-title" data-testid="stale-ideas">
            <h2 id="stale-title" class="h5">Still want these?</h2>
            <p class="stale-intro">
                @(_staleItems.Count == 1 ? "This idea hasn't" : $"These {_staleItems.Count} ideas haven't") changed in over six months. Keep what you still want and remove the rest so shoppers see current ideas.
            </p>
            <ul class="stale-list">
                @foreach (var staleItem in _staleItems.Take(3))
                {
                    <li class="stale-row" data-stale-item="@staleItem.PublicId">
                        <span class="stale-copy">
                            <strong>@staleItem.Name</strong>
                            <small>Last updated @staleItem.UpdatedOn.ToString("MMM d, yyyy")</small>
                        </span>
                        <span class="stale-actions">
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm"
                                    disabled="@(_confirmingItemId is not null)"
                                    aria-label="Keep @staleItem.Name"
                                    @onclick="() => ConfirmStillWantedAsync(staleItem)">
                                @(_confirmingItemId == staleItem.PublicId ? "Keeping..." : "Still want it")
                            </button>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    disabled="@(_confirmingItemId is not null)"
                                    aria-label="Remove @staleItem.Name"
                                    @onclick="() => ShowItemDeleteDialogAsync(staleItem)">
                                Remove
                            </button>
                        </span>
                    </li>
                }
            </ul>
            @if (_staleItems.Count > 3)
            {
                <p class="stale-more">+ @(_staleItems.Count - 3) more after these</p>
            }
        </section>
    }

    @if (_receivedTarget is not null)
    {
        <section class="received-panel" aria-labelledby="received-form-title" data-testid="received-form">
            <h2 id="received-form-title" class="h5">Mark "@_receivedTarget.Name" as received</h2>
            <p class="received-hint">It moves off your active list and out of everyone else's view. You can move it back any time.</p>
            <label for="received-thank-you" class="form-label">Thank-you note (optional)</label>
            <textarea id="received-thank-you"
                      class="form-control"
                      rows="3"
                      maxlength="@SetWishlistItemReceivedRequest.MaxThankYouLength"
                      aria-describedby="received-thank-you-help"
                      data-testid="received-thank-you"
                      @bind="_thankYouMessage"
                      @bind:event="oninput"></textarea>
            <small id="received-thank-you-help" class="form-text">
                Send a thank-you to whoever got this for you. @_thankYouMessage.Length/@SetWishlistItemReceivedRequest.MaxThankYouLength
            </small>
            <div class="received-actions">
                <button type="button"
                        class="btn btn-primary btn-sm"
                        data-testid="confirm-received"
                        disabled="@_isSavingReceived"
                        @onclick="ConfirmMarkReceivedAsync">
                    @(_isSavingReceived ? "Saving..." : "Mark as received")
                </button>
                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        disabled="@_isSavingReceived"
                        @onclick="() => _receivedTarget = null">
                    Cancel
                </button>
            </div>
        </section>
    }

    <div id="wishlist-items" class="wishlist-content @ViewMode-view">
        @if (_items != null)
        {
            @if (_filteredItems.Count == 0)
            {
                <div class="empty-state">
                    @if (_items.Count == 0)
                    {
                        <div class="empty-icon"><OpenWishIcon Name="gift" /></div>
                        @if (_canEdit)
                        {
                            <h2>No ideas in this wishlist yet</h2>
                            <p>Add a name now, or paste a product link and we'll fill in what we can.</p>
                            <button class="btn btn-primary btn-lg" @onclick="ShowAddItemModal">
                                <OpenWishIcon Name="plus-lg" /> Add item
                            </button>
                        }
                        else
                        {
                            <h2>No ideas shared yet</h2>
                            <p>Check back when the owner adds something to this list.</p>
                        }
                    }
                    else
                    {
                        <div class="empty-icon"><OpenWishIcon Name="search" /></div>
                        <h2>No matching ideas</h2>
                        @if (!string.IsNullOrWhiteSpace(SearchQuery))
                        {
                            <p>Nothing matches "@SearchQuery". Try another search or remove a filter.</p>
                        }
                        else
                        {
                            <p>Try removing a filter to see more ideas.</p>
                        }
                        <button class="btn btn-outline-primary" @onclick="ClearAllFilters">
                            <OpenWishIcon Name="x-circle" /> Show all ideas
                        </button>
                    }
                </div>
            }
            else if (ViewMode == "grid")
            {
                <div class="items-grid">
                    @foreach (var item in _filteredItems)
                    {
                        <div @key="item.Id" class="wishlist-item-card @(_gridCoordinationItemId == item.Id ? "is-coordinating" : string.Empty)">
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <div class="item-image">
                                    <img src="@item.Image" alt="@(string.IsNullOrWhiteSpace(item.Name) ? "Wishlist item image" : item.Name)" />
                                    @if (!_isOwner && item.Reservations.Any())
                                    {
                                        <div class="item-badge reserved">
                                            <OpenWishIcon Name="check-circle-fill" /> @(IsReservedByCurrentUser(item) ? "Reserved by you" : "Reserved")
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="item-image item-image-placeholder">
                                    <OpenWishIcon Name="gift" />
                                    @if (!_isOwner && item.Reservations.Any())
                                    {
                                        <div class="item-badge reserved">
                                            <OpenWishIcon Name="check-circle-fill" /> @(IsReservedByCurrentUser(item) ? "Reserved by you" : "Reserved")
                                        </div>
                                    }
                                </div>
                            }

                            <div class="item-content">
                                <div class="item-header">
                                    <h3 class="item-title">@item.Name</h3>
                                    @if (item.IsPinned)
                                    {
                                        <span class="most-wanted"><OpenWishIcon Name="star-fill" /> Most wanted</span>
                                    }
                                    @if (item.Priority.HasValue)
                                    {
                                        <span class="priority-indicator priority-@item.Priority.Value">
                                            @GetPriorityText(item.Priority.Value)
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="item-description">@item.Description</p>
                                }

                                <div class="item-meta">
                                    @if (item.Price.HasValue)
                                    {
                                        <span class="item-price">@item.Price.Value.ToString("C")</span>
                                        @if (HasBudget)
                                        {
                                            <span class="@GetBudgetStatusClass(item)">@GetBudgetStatusText(item)</span>
                                        }
                                    }
                                    else if (HasBudget)
                                    {
                                        <span class="budget-status budget-status-unknown">Price not set</span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.WhereToBuy))
                                    {
                                        <span class="item-store">
                                            <OpenWishIcon Name="shop" /> @item.WhereToBuy
                                        </span>
                                    }
                                </div>

                                <div class="item-interactions">
                                    @if (item.Comments.Any())
                                    {
                                        <span class="interaction-badge">
                                            <OpenWishIcon Name="chat-fill" /> @item.Comments.Count
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Url))
                                    {
                                        <a href="@item.Url"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="interaction-badge"
                                           aria-label="View @item.Name product (opens in a new tab)">
                                           <OpenWishIcon Name="box-arrow-up-right" /> View product
                                        </a>
                                    }
                                </div>
                            </div>

                            <div class="item-actions @(!_isOwner ? "has-coordination" : "")">
                                @if (!_isOwner)
                                {
                                    <button class="btn-icon coordination-action"
                                            type="button"
                                            aria-expanded="@(_gridCoordinationItemId == item.Id ? "true" : "false")"
                                            aria-controls="item-coordination-@item.Id"
                                            @onclick="() => ToggleGridCoordination(item.Id)">
                                        <OpenWishIcon Name="@(_gridCoordinationItemId == item.Id ? "chevron-up" : "gift")" /> @(_gridCoordinationItemId == item.Id ? "Hide gift details" : GetCoordinationLabel(item))
                                    </button>
                                }
                                @if (_canEdit)
                                {
                                    <button class="btn-icon"
                                            type="button"
                                            aria-label="Edit @item.Name"
                                            @onclick="() => HandleItemEditClick(item)">
                                        <OpenWishIcon Name="pencil" />
                                    </button>
                                    <button class="btn-icon btn-danger"
                                            id="delete-wishlist-item-@item.Id"
                                            type="button"
                                            aria-label="Delete @item.Name"
                                            @onclick="() => ShowItemDeleteDialogAsync(item)">
                                        <OpenWishIcon Name="trash" />
                                    </button>
                                }
                                @if (_isOwner)
                                {
                                    <button class="btn-icon @(item.IsPinned ? "is-pinned" : "")"
                                            type="button"
                                            disabled="@_isRanking"
                                            aria-pressed="@item.IsPinned"
                                            aria-label="@(item.IsPinned ? $"Remove {item.Name} from most wanted" : $"Mark {item.Name} as most wanted")"
                                            @onclick="() => ToggleItemPinAsync(item)">
                                        <OpenWishIcon Name="star-fill" />
                                        <span class="rank-action-label">Most wanted</span>
                                    </button>
                                    @if (CanMarkReceived)
                                    {
                                        <button class="btn-icon"
                                                type="button"
                                                data-testid="mark-received"
                                                aria-label="Mark @item.Name as received"
                                                @onclick="() => BeginMarkReceived(item)">
                                            <OpenWishIcon Name="gift" />
                                            <span class="rank-action-label">Received</span>
                                        </button>
                                    }
                                    <div class="rank-actions" aria-label="Reorder @item.Name">
                                        <button class="btn-icon"
                                                type="button"
                                                disabled="@(!CanMoveItem(item, -1))"
                                                aria-describedby="wishlist-ranking-help"
                                                aria-label="Move @item.Name up"
                                                @onclick="() => MoveItemAsync(item, -1)">
                                            <OpenWishIcon Name="arrow-up" />
                                            <span class="rank-action-label">Move up</span>
                                        </button>
                                        <button class="btn-icon"
                                                type="button"
                                                disabled="@(!CanMoveItem(item, 1))"
                                                aria-describedby="wishlist-ranking-help"
                                                aria-label="Move @item.Name down"
                                                @onclick="() => MoveItemAsync(item, 1)">
                                            <OpenWishIcon Name="arrow-down" />
                                            <span class="rank-action-label">Move down</span>
                                        </button>
                                    </div>
                                }
                                <button class="btn-icon"
                                        type="button"
                                        aria-label="@(_expandedItemId == item.Id ? $"Hide details for {item.Name}" : $"Show details for {item.Name}")"
                                        aria-expanded="@(_expandedItemId == item.Id)"
                                        aria-controls="item-details-@item.Id"
                                        @onclick="() => ToggleItemDetails(item.Id)">
                                    <OpenWishIcon Name="three-dots" />
                                </button>
                            </div>

                            @if (!_isOwner && _gridCoordinationItemId == item.Id)
                            {
                                <div id="item-coordination-@item.Id"
                                     class="item-coordination"
                                     role="region"
                                     aria-label="Reservation and comments for @item.Name">
                                    <ItemReservation WishlistId="@WishlistId"
                                                     ItemId="@item.Id"
                                                     OwnerId="@(_wishlist?.OwnerId ?? string.Empty)"
                                                     ReservationVersion="@(item.Reservations.FirstOrDefault()?.PublicId ?? string.Empty)"
                                                     OnReservationChanged="@RefreshReservationsAsync" />
                                    <ItemComments WishlistId="@WishlistId" ItemId="@item.Id" IsWishlistOwner="false" />
                                </div>
                            }

                            @if (_expandedItemId == item.Id)
                            {
                                <div id="item-details-@item.Id" class="item-details-expanded">
                                    <div class="details-section">
                                        <h4><OpenWishIcon Name="info-circle" /> Details</h4>
                                        <div class="details-grid">
                                            <div class="detail-item">
                                                <span class="detail-label">Added</span>
                                                <span class="detail-value">@item.CreatedOn.ToString("MMM dd, yyyy")</span>
                                            </div>
                                            @if (item.Priority.HasValue)
                                            {
                                                <div class="detail-item">
                                                    <span class="detail-label">Priority</span>
                                                    <span class="detail-value">@GetPriorityText(item.Priority.Value)</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @if (item.Reservations.Any() || item.Comments.Any())
                                    {
                                        <div class="details-section">
                                            <h4><OpenWishIcon Name="people" /> Social</h4>
                                            @if (!_isOwner && item.Reservations.Any())
                                            {
                                                <p class="detail-info"><OpenWishIcon Name="check-circle" /> @(IsReservedByCurrentUser(item) ? "You have reserved this item" : "This item has been reserved")</p>
                                            }
                                            @if (item.Comments.Any())
                                            {
                                                <p class="detail-info"><OpenWishIcon Name="chat" /> @item.Comments.Count comment(s)</p>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @if (_canEdit)
                {
                    <WishlistItemList Items="@_filteredItems"
                                    OnEdit="@HandleItemEditClick"
                                    OnDelete="@ShowItemDeleteDialogAsync"
                                    OnTogglePin="@ToggleItemPinAsync"
                                    CanMarkReceived="@CanMarkReceived"
                                    OnMarkReceived="@BeginMarkReceived"
                                    OnMoveUp="@(item => MoveItemAsync(item, -1))"
                                    OnMoveDown="@(item => MoveItemAsync(item, 1))"
                                    CanReorder="@CanReorder"
                                    IsRanking="@_isRanking"
                                    ShowInteractions="true"
                                    WishlistId="@WishlistId"
                                    OwnerId="@(_wishlist?.OwnerId ?? "")"
                                    IsOwner="@_isOwner"
                                    Budget="ValidBudget"
                                    CurrentUserId="@_currentUserId"
                                    OnReservationChanged="@RefreshReservationsAsync"
                                    @ref="_itemListRef" />
                }
                else
                {
                    <WishlistItemList Items="@_filteredItems"
                                    CanReorder="false"
                                    IsRanking="false"
                                    ShowInteractions="true"
                                    WishlistId="@WishlistId"
                                    OwnerId="@(_wishlist?.OwnerId ?? "")"
                                    IsOwner="@_isOwner"
                                    Budget="ValidBudget"
                                    CurrentUserId="@_currentUserId"
                                    OnReservationChanged="@RefreshReservationsAsync"
                                    @ref="_itemListRef" />
                }
            }
        }
        else
        {
            <div class="loading-container">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading wishlist items...</span>
                </div>
                <p>Loading items...</p>
            </div>
        }
    </div>

    @if (_isOwner && _wishlist.ReceivedItems.Count > 0)
    {
        <details class="received-section" data-testid="received-section">
            <summary>Received (@_wishlist.ReceivedItems.Count)</summary>
            <ul class="received-list">
                @foreach (var received in _wishlist.ReceivedItems)
                {
                    <li class="received-row" data-received-item="@received.PublicId">
                        <span class="received-copy">
                            <strong>@received.Name</strong>
                            @if (received.ReceivedOn is { } receivedOn)
                            {
                                <small>Received @receivedOn.ToString("MMM d, yyyy")</small>
                            }
                        </span>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                data-testid="move-back-to-wishlist"
                                disabled="@(_restoringItemId is not null)"
                                aria-label="Move @received.Name back to wishlist"
                                @onclick="() => MoveBackToWishlistAsync(received)">
                            @(_restoringItemId == received.PublicId ? "Moving..." : "Move back to wishlist")
                        </button>
                    </li>
                }
            </ul>
        </details>
    }
}

<WishlistItemModal @ref="_itemModal" Model="@_modalItem" OnSubmit="@HandleModalSubmit" OnCancel="@HandleModalCancel" />
<WishlistDeleteDialog @ref="_deleteDialog"
                      OnConfirm="@ConfirmItemDeleteAsync"
                      IsBusy="@_isDeletingItem"
                      ErrorMessage="@_deleteItemError"
                      CancelLabel="Keep item"
                      ConfirmLabel="Delete item"
                      CloseOnConfirm="false" />

@code {

    [Parameter]
    public string WishlistId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "budget")]
    public string? BudgetQuery { get; set; }

    private WishlistModel? _wishlist;
    private List<WishlistItemModel> _items = new();
    private List<WishlistItemModel> _filteredItems = new();
    private WishlistItemModel _modalItem = new();
    private WishlistItemModal? _itemModal;
    private WishlistDeleteDialog _deleteDialog = default!;
    private string? _currentUserId;
    private bool _canEdit;
    private bool _isOwner;
    private string FilteredItemCountMessage =>
        $"{_filteredItems.Count} of {_items.Count} wishlist {(_items.Count == 1 ? "item" : "items")} shown.";
    private string SortBy { get; set; } = "custom";
    private bool SortAscending { get; set; } = true;
    private string ViewMode { get; set; } = "list"; // "grid" or "list"
    private string SearchQuery { get; set; } = "";
    private bool _showFilters = false;
    private HashSet<string> PriorityFilters = new();
    private HashSet<string> StatusFilters = new();
    private decimal MinPrice { get; set; } = 0;
    private decimal MaxPrice { get; set; } = 10000;
    private decimal PriceCeiling => Math.Max(10000, GetMaxPrice());
    private bool BudgetFilterActive { get; set; }
    private decimal? ValidBudget => GiftBudget.Parse(BudgetQuery);
    private bool HasBudget => ValidBudget.HasValue;
    private string BudgetDisplay => ValidBudget?.ToString("C") ?? string.Empty;
    private int PricedItemCount => _items.Count(item => item.Price.HasValue);
    private int WithinBudgetItemCount => HasBudget
        ? _items.Count(item => item.Price is { } price && price <= ValidBudget.GetValueOrDefault())
        : 0;
    private int? _expandedItemId = null;
    private WishlistItemList? _itemListRef;
    private int? _pendingInteractionItemId;
    private int? _gridCoordinationItemId;
    private string _feedbackMessage = string.Empty;
    private bool _feedbackIsError;
    private WishlistItemModel? _itemPendingDeletion;
    private bool _isDeletingItem;
    private bool _isRanking;
    private string? _deleteItemError;
    private string? _appliedBudgetQuery;
    private readonly string _pasteListenerKey = $"wishlist-details-{Guid.NewGuid():N}";
    private DotNetObjectReference<WishlistDetails>? _pasteListenerReference;
    private bool _isListeningForPaste;
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(SearchQuery) ||
        PriorityFilters.Count > 0 ||
        StatusFilters.Count > 0 ||
        MinPrice > 0 ||
        MaxPrice < PriceCeiling ||
        BudgetFilterActive;
    private bool CanReorder => _isOwner && !_isRanking && SortBy == "custom" && !HasActiveFilters;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _currentUserId = await UserContextService.GetUserIdAsync();
            _wishlist = await WishlistService.GetWishlistByPublicIdAsync(WishlistId, _currentUserId);
            await SetupSecurity();
            await LoadItems();
        }
        catch (UnauthorizedAccessException)
        {
            // Redirect to access denied or navigate away
            NavigationManager.NavigateTo("/wishlists", replace: true);
        }
        catch (KeyNotFoundException)
        {
            // Wishlist not found, redirect to wishlists
            NavigationManager.NavigateTo("/wishlists", replace: true);
        }
    }

    protected override void OnParametersSet()
    {
        if (string.Equals(_appliedBudgetQuery, BudgetQuery, StringComparison.Ordinal))
        {
            return;
        }

        _appliedBudgetQuery = BudgetQuery;
        ApplyBudgetQuery();
    }

    private async Task LoadItems()
    {
        var requesterId = _currentUserId;
        if (string.IsNullOrEmpty(requesterId))
        {
            requesterId = await UserContextService.GetUserIdAsync();
        }

        var items = await WishlistService.GetWishlistItemsByPublicIdAsync(WishlistId, requesterId);
        _items = items
            .Where(ShouldDisplayItem)
            .ToList();
        MaxPrice = PriceCeiling;
        ApplyBudgetQuery();
    }

    private void ApplyBudgetQuery()
    {
        BudgetFilterActive = HasBudget && PricedItemCount > 0;
        if (!HasBudget && SortBy == "budget")
        {
            SortBy = "custom";
            SortAscending = true;
        }

        ApplyFiltersAndSort();
    }

    private bool CanMoveItem(WishlistItemModel item, int direction)
    {
        if (!CanReorder)
        {
            return false;
        }

        var matchingItems = _filteredItems
            .Where(candidate => candidate.IsPinned == item.IsPinned)
            .ToList();
        var itemIndex = matchingItems.FindIndex(candidate => candidate.Id == item.Id);
        return itemIndex + direction >= 0 && itemIndex + direction < matchingItems.Count;
    }

    private async Task MoveItemAsync(WishlistItemModel item, int direction)
    {
        if (!CanMoveItem(item, direction))
        {
            return;
        }

        var orderedItems = _items
            .OrderByDescending(candidate => candidate.IsPinned)
            .ThenBy(candidate => candidate.OrderIndex)
            .ToList();
        var matchingIndexes = orderedItems
            .Select((candidate, index) => new { candidate, index })
            .Where(entry => entry.candidate.IsPinned == item.IsPinned)
            .Select(entry => entry.index)
            .ToList();
        var currentIndex = orderedItems.FindIndex(candidate => candidate.Id == item.Id);
        var matchingIndex = matchingIndexes.IndexOf(currentIndex);
        var targetIndex = matchingIndexes[matchingIndex + direction];

        (orderedItems[currentIndex], orderedItems[targetIndex]) = (orderedItems[targetIndex], orderedItems[currentIndex]);

        _isRanking = true;
        try
        {
            var savedItems = await WishlistService.ReorderWishlistItemsByPublicIdAsync(
                WishlistId,
                new() { OrderedItemPublicIds = orderedItems.Select(candidate => candidate.PublicId).ToList() });
            _items = savedItems.Where(ShouldDisplayItem).ToList();
            ApplyFiltersAndSort();
            _feedbackMessage = $"{item.Name} moved {(direction < 0 ? "up" : "down")}.";
            _feedbackIsError = false;
        }
        catch (HttpRequestException)
        {
            await RefreshItemsAfterRankingFailureAsync("The order could not be saved. Refresh your ideas and try again.");
        }
        catch (ArgumentException)
        {
            await RefreshItemsAfterRankingFailureAsync("Your ideas changed before this move was saved. They have been refreshed.");
        }
        catch (KeyNotFoundException)
        {
            await RefreshItemsAfterRankingFailureAsync("That idea is no longer available. Your ideas have been refreshed.");
        }
        finally
        {
            _isRanking = false;
        }
    }

    private IReadOnlyList<WishlistItemModel> _staleItems =>
        _items is null ? [] : WishlistFreshness.GetStaleItems(_items, DateTimeOffset.UtcNow);

    private string? _confirmingItemId;
    private WishlistItemModel? _receivedTarget;
    private string _thankYouMessage = string.Empty;
    private bool _isSavingReceived;
    private string? _restoringItemId;

    private bool CanMarkReceived =>
        _isOwner && (_wishlist?.Event is not { } occasion || occasion.Date <= DateTimeOffset.UtcNow);

    private void BeginMarkReceived(WishlistItemModel item)
    {
        _receivedTarget = item;
        _thankYouMessage = string.Empty;
    }

    private async Task ConfirmMarkReceivedAsync()
    {
        if (_receivedTarget is null || _isSavingReceived || string.IsNullOrWhiteSpace(_currentUserId))
        {
            return;
        }

        var target = _receivedTarget;
        _isSavingReceived = true;
        try
        {
            await WishlistService.SetWishlistItemReceivedByPublicIdAsync(
                WishlistId,
                target.PublicId,
                new SetWishlistItemReceivedRequest { IsReceived = true, ThankYouMessage = _thankYouMessage },
                _currentUserId);
            _receivedTarget = null;
            await ReloadAfterReceivedChangeAsync($"{target.Name} moved to Received.");
        }
        catch (Exception ex) when (ex is HttpRequestException or ArgumentException or KeyNotFoundException or UnauthorizedAccessException)
        {
            _feedbackMessage = ex is HttpRequestException or ArgumentException
                ? ex.Message
                : $"We couldn't mark {target.Name} as received. Refresh the page and try again.";
            _feedbackIsError = true;
        }
        finally
        {
            _isSavingReceived = false;
        }
    }

    private async Task MoveBackToWishlistAsync(WishlistItemModel item)
    {
        if (_restoringItemId is not null || string.IsNullOrWhiteSpace(_currentUserId))
        {
            return;
        }

        _restoringItemId = item.PublicId;
        try
        {
            await WishlistService.SetWishlistItemReceivedByPublicIdAsync(
                WishlistId,
                item.PublicId,
                new SetWishlistItemReceivedRequest { IsReceived = false },
                _currentUserId);
            await ReloadAfterReceivedChangeAsync($"{item.Name} is back on your wishlist.");
        }
        catch (Exception ex) when (ex is HttpRequestException or KeyNotFoundException or UnauthorizedAccessException)
        {
            _feedbackMessage = $"We couldn't move {item.Name} back. Refresh the page and try again.";
            _feedbackIsError = true;
        }
        finally
        {
            _restoringItemId = null;
        }
    }

    private async Task ReloadAfterReceivedChangeAsync(string message)
    {
        _wishlist = await WishlistService.GetWishlistByPublicIdAsync(WishlistId, _currentUserId);
        await LoadItems();
        _feedbackMessage = message;
        _feedbackIsError = false;
    }

    private async Task ConfirmStillWantedAsync(WishlistItemModel item)
    {
        if (_confirmingItemId is not null || string.IsNullOrWhiteSpace(_currentUserId))
        {
            return;
        }

        _confirmingItemId = item.PublicId;
        try
        {
            var savedItem = await WishlistService.ConfirmWishlistItemStillWantedByPublicIdAsync(WishlistId, item.PublicId, _currentUserId);
            var itemIndex = _items.FindIndex(candidate => candidate.Id == item.Id);
            if (itemIndex >= 0)
            {
                savedItem.Comments = _items[itemIndex].Comments;
                savedItem.Reservations = _items[itemIndex].Reservations;
                _items[itemIndex] = savedItem;
            }

            ApplyFiltersAndSort();
            _feedbackMessage = $"Kept {savedItem.Name} on your list.";
            _feedbackIsError = false;
        }
        catch (Exception ex) when (ex is HttpRequestException or KeyNotFoundException or UnauthorizedAccessException)
        {
            _feedbackMessage = $"We couldn't confirm {item.Name}. Refresh the page and try again.";
            _feedbackIsError = true;
        }
        finally
        {
            _confirmingItemId = null;
        }
    }

    private async Task HandleOrganizeChangedAsync(string message)
    {
        try
        {
            await LoadItems();
        }
        catch (Exception ex) when (ex is HttpRequestException or KeyNotFoundException or UnauthorizedAccessException)
        {
            _feedbackMessage = string.IsNullOrEmpty(message)
                ? "We couldn't refresh your ideas. Reload the page to see their current state."
                : $"{message} We couldn't refresh the list, so reload the page to see the latest.";
            _feedbackIsError = string.IsNullOrEmpty(message);
            return;
        }

        if (string.IsNullOrEmpty(message))
        {
            _feedbackMessage = "Your ideas changed before that was saved. They have been refreshed.";
            _feedbackIsError = true;
        }
        else
        {
            _feedbackMessage = message;
            _feedbackIsError = false;
        }
    }

    private async Task ToggleItemPinAsync(WishlistItemModel item)
    {
        if (_isRanking)
        {
            return;
        }

        _isRanking = true;
        try
        {
            var savedItem = await WishlistService.UpdateWishlistItemPinByPublicIdAsync(
                WishlistId,
                item.PublicId,
                !item.IsPinned);
            var itemIndex = _items.FindIndex(candidate => candidate.Id == item.Id);
            if (itemIndex >= 0)
            {
                savedItem.Comments = _items[itemIndex].Comments;
                savedItem.Reservations = _items[itemIndex].Reservations;
                _items[itemIndex] = savedItem;
            }

            ApplyFiltersAndSort();
            _feedbackMessage = savedItem.IsPinned
                ? $"{savedItem.Name} marked as most wanted."
                : $"{savedItem.Name} removed from most wanted.";
            _feedbackIsError = false;
        }
        catch (HttpRequestException)
        {
            await RefreshItemsAfterRankingFailureAsync("The most wanted status could not be saved. Refresh your ideas and try again.");
        }
        catch (ArgumentException)
        {
            await RefreshItemsAfterRankingFailureAsync("Your ideas changed before this update was saved. They have been refreshed.");
        }
        catch (KeyNotFoundException)
        {
            await RefreshItemsAfterRankingFailureAsync("That idea is no longer available. Your ideas have been refreshed.");
        }
        finally
        {
            _isRanking = false;
        }
    }

    private async Task RefreshItemsAfterRankingFailureAsync(string message)
    {
        try
        {
            _feedbackMessage = message;
            await LoadItems();
        }
        catch (HttpRequestException)
        {
            _feedbackMessage = "The ideas could not be refreshed. Try again.";
        }
        catch (KeyNotFoundException)
        {
            _feedbackMessage = "This wishlist is no longer available.";
        }

        _feedbackIsError = true;
    }

    private void ApplyFiltersAndSort()
    {
        var filtered = _items.AsEnumerable();

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            var query = SearchQuery.ToLower();
            filtered = filtered.Where(i =>
                (i.Name?.ToLower().Contains(query) ?? false) ||
                (i.Description?.ToLower().Contains(query) ?? false) ||
                (i.WhereToBuy?.ToLower().Contains(query) ?? false));
        }

        // Apply priority filters
        if (PriorityFilters.Any())
        {
            filtered = filtered.Where(i => i.Priority.HasValue && PriorityFilters.Contains(i.Priority.Value.ToString()));
        }

        // Apply status filters
        if (StatusFilters.Contains("reserved") != StatusFilters.Contains("unreserved"))
        {
            var showReserved = StatusFilters.Contains("reserved");
            filtered = filtered.Where(i => i.Reservations.Any() == showReserved);
        }
        if (StatusFilters.Contains("mine"))
        {
            filtered = filtered.Where(IsReservedByCurrentUser);
        }
        if (StatusFilters.Contains("commented"))
        {
            filtered = filtered.Where(i => i.Comments.Any());
        }

        // Apply price range filter
        if (MinPrice > 0 || MaxPrice < PriceCeiling)
        {
            filtered = filtered.Where(i => i.Price.HasValue && i.Price >= MinPrice && i.Price <= MaxPrice);
        }

        if (BudgetFilterActive && ValidBudget is { } budget)
        {
            filtered = filtered.Where(item => item.Price is { } price && price <= budget);
        }

        // Apply sorting
        filtered = SortBy switch
        {
            "custom" => filtered
                .OrderByDescending(i => i.IsPinned)
                .ThenBy(i => i.OrderIndex),

            "name" => SortAscending
                ? filtered.OrderBy(i => i.Name)
                : filtered.OrderByDescending(i => i.Name),

            "priority" => SortAscending
                ? filtered.OrderBy(i => i.Priority ?? int.MaxValue)
                : filtered.OrderByDescending(i => i.Priority ?? int.MinValue),

            "price" => SortAscending
                ? filtered.OrderBy(i => i.Price ?? decimal.MaxValue)
                : filtered.OrderByDescending(i => i.Price ?? decimal.MinValue),

            "budget" when ValidBudget is { } sortBudget => SortAscending
                ? filtered.OrderBy(item => GetBudgetSortOrder(item, sortBudget)).ThenBy(item => item.Price)
                : filtered.OrderByDescending(item => GetBudgetSortOrder(item, sortBudget)).ThenByDescending(item => item.Price),

            "date" => SortAscending
                ? filtered.OrderBy(i => i.CreatedOn)
                : filtered.OrderByDescending(i => i.CreatedOn),

            _ => filtered
        };

        _filteredItems = filtered.ToList();
    }

    private int GetReservedCount()
    {
        return _items.Count(i => i.Reservations.Any());
    }

    private bool IsReservedByCurrentUser(WishlistItemModel item) =>
        !string.IsNullOrEmpty(_currentUserId) && item.Reservations.Any(r => r.UserId == _currentUserId);

    private int GetMyReservedCount() => _items.Count(IsReservedByCurrentUser);

    private async Task RefreshReservationsAsync()
    {
        try
        {
            var fresh = await WishlistService.GetWishlistItemsByPublicIdAsync(WishlistId, _currentUserId);
            var reservationsById = fresh.ToDictionary(i => i.Id, i => i.Reservations);
            foreach (var item in _items)
            {
                item.Reservations = reservationsById.TryGetValue(item.Id, out var reservations) ? reservations : [];
            }

            ApplyFiltersAndSort();
        }
        catch (HttpRequestException)
        {
            // The reservation panel already shows the verified state; counts catch up on the next load.
        }
    }

    private string GetCoordinationLabel(WishlistItemModel item)
    {
        if (IsReservedByCurrentUser(item))
        {
            return "Your reservation";
        }

        return item.Reservations.Any() ? "Comment on gift" : "Reserve gift";
    }

    private int GetCommentCount()
    {
        return _items.Sum(i => i.Comments.Count);
    }

    private void ToggleFilters()
    {
        _showFilters = !_showFilters;
    }

    private void ToggleFilter(HashSet<string> filterSet, string value)
    {
        if (filterSet.Contains(value))
        {
            filterSet.Remove(value);
        }
        else
        {
            filterSet.Add(value);
        }
        ApplyFiltersAndSort();
    }

    private void ClearSearch()
    {
        SearchQuery = "";
        ApplyFiltersAndSort();
    }

    private void ClearPriceRange()
    {
        MinPrice = 0;
        MaxPrice = PriceCeiling;
        ApplyFiltersAndSort();
    }

    private void ApplyMinimumPrice()
    {
        MaxPrice = Math.Max(MinPrice, MaxPrice);
        ApplyFiltersAndSort();
    }

    private void ApplyMaximumPrice()
    {
        MinPrice = Math.Min(MinPrice, MaxPrice);
        ApplyFiltersAndSort();
    }

    private int GetActiveFilterCount()
    {
        int count = 0;
        count += PriorityFilters.Count;
        count += StatusFilters.Count;
        if (MinPrice > 0 || MaxPrice < PriceCeiling) count++;
        if (BudgetFilterActive) count++;
        return count;
    }

    private void ClearAllFilters()
    {
        SearchQuery = "";
        PriorityFilters.Clear();
        StatusFilters.Clear();
        MinPrice = 0;
        MaxPrice = PriceCeiling;
        BudgetFilterActive = false;
        ApplyFiltersAndSort();
    }

    private void ToggleBudgetFilter()
    {
        BudgetFilterActive = !BudgetFilterActive;
        ApplyFiltersAndSort();
    }

    private decimal GetMaxPrice()
    {
        if (!_items.Any()) return 1000;
        var max = _items.Where(i => i.Price.HasValue).Select(i => i.Price!.Value).DefaultIfEmpty(1000).Max();
        return Math.Ceiling(max / 100) * 100; // Round up to nearest 100
    }

    private string GetPriceRangeLabel()
    {
        if (MinPrice == 0 && MaxPrice >= PriceCeiling)
        {
            return "All prices";
        }

        return $"{MinPrice:C} - {MaxPrice:C}";
    }

    private static string GetStatusFilterLabel(string status) => status switch
    {
        "reserved" => "Reserved",
        "unreserved" => "Available",
        "mine" => "Reserved by you",
        "commented" => "Has comments",
        _ => status
    };

    private static int GetBudgetSortOrder(WishlistItemModel item, decimal budget)
    {
        if (item.Price is not { } price)
        {
            return 2;
        }

        return price <= budget ? 0 : 1;
    }

    private string GetBudgetStatusText(WishlistItemModel item)
    {
        if (item.Price is not { } price || ValidBudget is not { } budget)
        {
            return "Price not set";
        }

        return price <= budget ? "Within budget" : $"{price - budget:C} over budget";
    }

    private string GetBudgetStatusClass(WishlistItemModel item) =>
        item.Price is { } price && ValidBudget is { } budget
            ? price <= budget
                ? "budget-status budget-status-within"
                : "budget-status budget-status-over"
            : "budget-status budget-status-unknown";

    private static string IdeaLabel(int count) => count == 1 ? "idea" : "ideas";

    private void SortItems(string sortBy)
    {
        if (sortBy == "custom")
        {
            SortBy = "custom";
            SortAscending = true;
            ApplyFiltersAndSort();
            return;
        }

        if (SortBy == sortBy)
        {
            // Toggle sort direction
            SortAscending = !SortAscending;
        }
        else
        {
            // New sort field, default to ascending
            SortBy = sortBy;
            SortAscending = true;
        }

        ApplyFiltersAndSort();
    }

    private void ShowAddItemModal()
    {
        _modalItem = new WishlistItemModel();
        _itemModal?.Show(_modalItem);
    }

    /// <summary>
    /// Called from app.js when someone pastes a product link outside a text field on this page.
    /// </summary>
    [JSInvokable]
    public Task ImportPastedProductLink(string text)
    {
        if (!_canEdit || _itemModal is null || _itemModal.IsVisible || !ProductLink.ContainsWebAddress(text))
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(() =>
        {
            _modalItem = new WishlistItemModel();
            _itemModal.Show(_modalItem, text);
        });
    }

    private void HandleItemEditClick(WishlistItemModel item)
    {
        _modalItem = new WishlistItemModel
        {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description,
            Price = item.Price,
            Url = item.Url,
            WhereToBuy = item.WhereToBuy,
            Priority = item.Priority,
            IsPrivate = item.IsPrivate,
            Image = item.Image,
            WishlistId = _wishlist?.Id ?? 0 // Keep the integer ID for the model
        };
        _itemModal?.Show(_modalItem);
    }

    private async Task HandleModalSubmit(WishlistItemModel item)
    {
        WishlistItemModel savedItem;
        var existingItemIndex = _items.FindIndex(existingItem => existingItem.Id == item.Id);

        if (item.Id > 0)
        {
            savedItem = await WishlistService.UpdateWishlistItemByPublicIdAsync(WishlistId, item.Id, item);
        }
        else
        {
            savedItem = await WishlistService.AddItemToWishlistByPublicIdAsync(WishlistId, item);
        }

        if (existingItemIndex >= 0)
        {
            if (ShouldDisplayItem(savedItem))
            {
                var existingItem = _items[existingItemIndex];
                savedItem.Comments = existingItem.Comments;
                savedItem.Reservations = existingItem.Reservations;
                _items[existingItemIndex] = savedItem;
            }
            else
            {
                _items.RemoveAt(existingItemIndex);
            }
        }
        else if (ShouldDisplayItem(savedItem))
        {
            _items.Add(savedItem);
        }

        ApplyFiltersAndSort();
        _feedbackMessage = item.Id > 0
            ? $"Changes to {savedItem.Name} saved."
            : $"{savedItem.Name} added to the wishlist.";
        _feedbackIsError = false;
    }

    private void HandleModalCancel()
    {
        _modalItem = new WishlistItemModel();
    }

    private async Task ShowItemDeleteDialogAsync(WishlistItemModel item)
    {
        if (_isDeletingItem)
        {
            return;
        }

        _itemPendingDeletion = item;
        _deleteItemError = null;
        var itemName = GetItemName(item);
        await _deleteDialog.ShowAsync(
            "Delete item",
            $"Delete {itemName} and its gift coordination? This cannot be undone.",
            $"delete-wishlist-item-{item.Id}");
    }

    private async Task ConfirmItemDeleteAsync()
    {
        if (_isDeletingItem || _itemPendingDeletion is null)
        {
            return;
        }

        var item = _itemPendingDeletion;
        var itemName = GetItemName(item);
        _isDeletingItem = true;
        _deleteItemError = null;
        try
        {
            var deleted = await WishlistService.RemoveItemFromWishlistByPublicIdAsync(WishlistId, item.Id);
            if (!deleted)
            {
                throw new InvalidOperationException("The delete request was not completed.");
            }

            _items.RemoveAll(existingItem => existingItem.Id == item.Id);
            if (_expandedItemId == item.Id)
            {
                _expandedItemId = null;
            }
            ApplyFiltersAndSort();
            _feedbackMessage = $"{itemName} deleted.";
            _feedbackIsError = false;
            _itemPendingDeletion = null;
            await _deleteDialog.Close();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            _deleteItemError = $"{itemName} could not be deleted. Check your connection and try again.";
        }
        finally
        {
            _isDeletingItem = false;
        }
    }

    private static string GetItemName(WishlistItemModel item) =>
        string.IsNullOrWhiteSpace(item.Name) ? "This item" : item.Name;

    private async Task SetupSecurity()
    {
        if (_wishlist == null || string.IsNullOrEmpty(_currentUserId))
            return;

        _isOwner = _wishlist.OwnerId == _currentUserId;
        if (_isOwner)
        {
            _canEdit = true;
            return;
        }

        try
        {
            // Match the server's rules: Edit or Admin sharing, or an accepted member of a collaborative event list.
            _canEdit = await WishlistService.CanUserEditWishlistByPublicIdAsync(WishlistId, _currentUserId);
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Could not check edit access for wishlist {WishlistId}", WishlistId);
            _canEdit = false;
        }
    }

    private async Task ShareWishlist()
    {
        string wishlistUrl = NavigationManager.Uri;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", wishlistUrl);
            _feedbackMessage = "Wishlist URL copied to clipboard!";
            _feedbackIsError = false;
        }
        catch
        {
            _feedbackMessage = "Unable to copy. Please copy the URL manually.";
            _feedbackIsError = true;
        }
        StateHasChanged();
    }

    private void SetViewMode(string mode)
    {
        ViewMode = mode;
        StateHasChanged();
    }

    private void ToggleItemDetails(int itemId)
    {
        _expandedItemId = _expandedItemId == itemId ? null : itemId;
    }

    private bool ShouldDisplayItem(WishlistItemModel item)
    {
        if (_isOwner)
        {
            return !item.IsHiddenFromOwner;
        }

        return !item.IsPrivate;
    }

    private async Task FocusCommentsAsync()
    {
        if (GetCommentCount() == 0)
        {
            await NotifyNoCommentsAsync();
            return;
        }

        if (!_filteredItems.Any(i => i.Comments.Any()))
        {
            SearchQuery = "";
            PriorityFilters.Clear();
            StatusFilters.Clear();
            StatusFilters.Add("commented");
            MinPrice = 0;
            MaxPrice = PriceCeiling;
            ApplyFiltersAndSort();
        }

        var targetItem = _filteredItems.FirstOrDefault(i => i.Comments.Any())
                         ?? _items.FirstOrDefault(i => i.Comments.Any());

        if (targetItem == null)
        {
            await NotifyNoCommentsAsync();
            return;
        }

        ViewMode = "list";
        _showFilters = false;
        _pendingInteractionItemId = targetItem.Id;

        await InvokeAsync(StateHasChanged);
    }

    private async Task NotifyNoCommentsAsync()
    {
        _feedbackMessage = "No comments to display yet.";
        _feedbackIsError = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleGridCoordination(int itemId) =>
        _gridCoordinationItemId = _gridCoordinationItemId == itemId ? null : itemId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (_canEdit && !_isListeningForPaste)
        {
            _pasteListenerReference ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("openWishListenForProductLinkPaste", _pasteListenerKey, _pasteListenerReference);
            _isListeningForPaste = true;
        }

        if (_pendingInteractionItemId.HasValue && ViewMode == "list" && _itemListRef is not null)
        {
            var targetId = _pendingInteractionItemId.Value;
            _pendingInteractionItemId = null;
            await _itemListRef.ExpandItemAsync(targetId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_isListeningForPaste)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("openWishStopListeningForProductLinkPaste", _pasteListenerKey);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (TaskCanceledException)
            {
            }
        }

        _pasteListenerReference?.Dispose();
    }

    private string GetPriorityText(int priority) => priority switch
    {
        1 => "High priority",
        2 => "Medium priority",
        3 => "Low priority",
        _ => "No priority"
    };
}
