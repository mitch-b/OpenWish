<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15.0</LangVersion>
    <Version>0.21.3</Version>
    <UserSecretsId>openwish-7a370443-2fc2-41e2-9fe4-815e03888f26</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <!-- Runtime Async is CoreCLR-only; shared and client assemblies also run on Mono WebAssembly. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'OpenWish.Shared' and '$(MSBuildProjectName)' != 'OpenWish.Web.Client'">
    <Features Condition="'$(Features)' != ''">$(Features);runtime-async=on</Features>
    <Features Condition="'$(Features)' == ''">runtime-async=on</Features>
  </PropertyGroup>
</Project>