@using System
@using System.Linq
@using System.Net.Http
@using OpenWish.Shared.Models
@using OpenWish.Shared.Services
@using OpenWish.Web.Client.Components.Wishlist
@using OpenWish.Web.Client.Components.Shared
@inject IEventService EventService
@inject IWishlistService WishlistService
@inject IUserContextService UserContextService
@inject ILogger<EventWishlistManager> Logger

@if (!_hasLoaded && _isLoading)
{
    <div class="card shadow-sm event-wishlist-manager" aria-busy="true">
        <div class="card-body">
            <h2 class="h4 mb-3">Event wishlists</h2>
            <div class="event-wishlist-loading" role="status">
                <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
                <span>Loading event wishlists...</span>
            </div>
        </div>
    </div>
}
else if (!_hasLoaded && !string.IsNullOrWhiteSpace(_loadErrorMessage))
{
    <div class="card shadow-sm event-wishlist-manager">
        <div class="card-body">
            <h2 class="h4 mb-3">Event wishlists</h2>
            <div class="alert alert-danger mb-0" role="alert">
                <p class="mb-2">@_loadErrorMessage</p>
                <button type="button" class="btn btn-outline-danger" disabled="@(!RendererInfo.IsInteractive)" @onclick="LoadWishlistsAsync">
                    <OpenWishIcon Name="arrow-clockwise" />
                    <span>Try again</span>
                </button>
            </div>
        </div>
    </div>
}
else
{
    var myWishlists = GetCurrentUserWishlists().ToList();
    var attachableWishlists = GetAttachableWishlists().ToList();
    var hasOwnWishlist = myWishlists.Count > 0;

    <div class="card shadow-sm event-wishlist-manager" aria-busy="@(_isLoading ? "true" : "false")">
        <div class="card-body">
            <div class="event-wishlist-header">
                <h2 class="h4 mb-0">Event wishlists</h2>
                <span class="event-wishlist-refreshing small" role="status">
                    @if (_isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>Refreshing...</span>
                    }
                </span>
            </div>

            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <div class="alert alert-success event-wishlist-status" role="status">
                    <span>@_statusMessage</span>
                    @if (_createdWishlistPublicId is not null)
                    {
                        <a class="btn btn-primary" href="/wishlists/@_createdWishlistPublicId/items/new?firstIdea=true">
                            <OpenWishIcon Name="plus-lg" />
                            <span>Add my first gift idea</span>
                        </a>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger" role="alert">@_errorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <p class="mb-2">@_loadErrorMessage</p>
                    <button type="button" class="btn btn-outline-danger" disabled="@(!RendererInfo.IsInteractive)" @onclick="LoadWishlistsAsync">
                        <OpenWishIcon Name="arrow-clockwise" />
                        <span>Try again</span>
                    </button>
                </div>
            }

            <section class="event-wishlist-owner-section" aria-labelledby="event-wishlist-mine-title">
                <h3 class="h5 mb-1" id="event-wishlist-mine-title">Your wishlists</h3>
                @if (!_showCreateForm)
                {
                    <p class="event-wishlist-privacy">
                        <OpenWishIcon Name="eye-slash" />
                        <span>Everyone in this event can see lists you share here. Reservations stay hidden from you.</span>
                    </p>
                }

                @if (hasOwnWishlist)
                {
                    <ul class="list-group event-wishlist-list">
                        @foreach (var wishlist in myWishlists)
                        {
                            <li class="list-group-item event-wishlist-row">
                                <div class="event-wishlist-summary">
                                    <span class="fw-semibold">@wishlist.Name</span>
                                    <span class="event-wishlist-count">@GetItemCountText(wishlist)</span>
                                </div>
                                <div class="event-wishlist-actions">
                                    <a href="/wishlists/@wishlist.PublicId/items/new"
                                       class="btn btn-primary btn-sm event-wishlist-add">
                                        <OpenWishIcon Name="plus-lg" />
                                        <span>Add gift ideas</span>
                                    </a>
                                    <a href="/wishlists/@wishlist.PublicId"
                                       class="btn btn-outline-primary btn-sm"
                                       aria-label="@($"View {wishlist.Name}")">View</a>
                                    @if (CanDetach(wishlist))
                                    {
                                        <button class="btn btn-outline-secondary btn-sm"
                                                type="button"
                                                id="@($"remove-my-event-wishlist-{wishlist.PublicId}")"
                                                disabled="@(_isSubmitting || !RendererInfo.IsInteractive)"
                                                @onclick="() => PromptWishlistRemoval(wishlist.PublicId)">
                                            Remove
                                        </button>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }

                @if (!_showCreateForm)
                {
                    <div class="@(hasOwnWishlist ? "event-wishlist-more" : "event-wishlist-empty")" data-testid="@(hasOwnWishlist ? null : "event-wishlist-empty")">
                    @if (!hasOwnWishlist)
                    {
                        <div class="event-wishlist-empty-message">
                            <OpenWishIcon Name="gift" Class="event-wishlist-empty-icon" />
                            <div>
                                <p class="fw-semibold mb-1">Give your gift giver a few clues.</p>
                                <p class="mb-0 small text-muted">
                                    @(attachableWishlists.Count > 0
                                        ? "Share a list you already have, or start a new one for this event."
                                        : "Start a list for this event. You can add ideas right after.")
                                </p>
                            </div>
                        </div>
                    }
                    <div class="event-wishlist-tools">
                        @if (attachableWishlists.Count == 1)
                        {
                            var onlyWishlist = attachableWishlists[0];
                            <div class="event-wishlist-share-single">
                                <button class="btn @(hasOwnWishlist ? "btn-outline-primary" : "btn-primary") event-wishlist-share-button"
                                        type="button"
                                        aria-label="@GetShareWishlistAccessibleName(onlyWishlist)"
                                        disabled="@(_isSubmitting || !RendererInfo.IsInteractive)"
                                        @onclick="() => AttachWishlistAsync(onlyWishlist)">
                                    <OpenWishIcon Name="link-45deg" />
                                    <span>@GetShareWishlistButtonText()</span>
                                </button>
                                <span class="text-muted small event-wishlist-share-target">Not shared yet: @onlyWishlist.Name</span>
                            </div>
                        }
                        else if (attachableWishlists.Count > 1)
                        {
                            <div class="event-wishlist-share-options">
                                <label for="event-wishlist-select" class="form-label">Share an existing wishlist</label>
                                <div class="event-wishlist-share-picker">
                                    <select id="event-wishlist-select" class="form-select"
                                            @bind="_selectedWishlistId"
                                            disabled="@(_isSubmitting || !RendererInfo.IsInteractive)">
                                        <option value="">Select a wishlist</option>
                                        @foreach (var option in attachableWishlists)
                                        {
                                            <option value="@option.PublicId">@option.Name</option>
                                        }
                                    </select>
                                    <button class="btn @(hasOwnWishlist ? "btn-outline-primary" : "btn-primary")"
                                            type="button"
                                            disabled="@(string.IsNullOrEmpty(_selectedWishlistId) || _isSubmitting || !RendererInfo.IsInteractive)"
                                            @onclick="AttachSelectedWishlistAsync">
                                        <OpenWishIcon Name="link-45deg" />
                                        <span>@(_isSubmitting ? "Sharing..." : "Share wishlist")</span>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (!hasOwnWishlist && HasUnattachedPrivateWishlist)
                        {
                            <p class="form-text mb-0 event-wishlist-private-note">
                                <OpenWishIcon Name="lock" />
                                <span>Private lists can't be shared with an event.</span>
                            </p>
                        }

                        <button class="btn @GetCreateButtonClass(hasOwnWishlist, attachableWishlists.Count) event-wishlist-create-button"
                                type="button"
                                disabled="@(_isSubmitting || !RendererInfo.IsInteractive)"
                                @onclick="ToggleCreateForm">
                            <OpenWishIcon Name="plus-lg" />
                            <span>Create a wishlist for this event</span>
                        </button>
                    </div>
                    </div>
                }
                else
                {
                    <div class="event-wishlist-create-form">
                        <WishlistForm Model="_draftWishlist"
                                      OnSubmit="HandleCreateWishlistAsync"
                                      OnCancel="CancelCreateWishlist"
                                      IsEventWishlist="true"
                                      AutoFocusName="true"
                                      IsSubmitting="@_isSubmitting" />
                    </div>
                }
            </section>

            <section class="event-wishlist-participants-section" aria-labelledby="event-wishlist-participants-title">
                <h3 class="h5 mb-3" id="event-wishlist-participants-title">Participant wishlists</h3>

                @if (BuildParticipantGroups() is not { Count: > 0 } participantGroups)
                {
                    <p class="text-muted small mb-0">Participant lists will appear here once people join.</p>
                }
                else
                {
                    <div class="event-participant-list">
                        @foreach (var participant in participantGroups)
                        {
                            <article class="event-participant-row" aria-label="@participant.Label">
                                <div class="event-participant-header">
                                    <div class="event-participant-identity">
                                        <span class="fw-semibold">@participant.Label</span>
                                        @if (string.IsNullOrWhiteSpace(participant.UserId) && !string.IsNullOrEmpty(participant.Email))
                                        {
                                            <span class="small text-muted event-participant-email">@participant.Email</span>
                                        }
                                    </div>
                                    <div class="event-participant-badges">
                                        @if (participant.IsCurrentUser)
                                        {
                                            <span class="badge event-participant-badge event-participant-badge-you">You</span>
                                        }
                                        @if (ShouldShowRole(participant))
                                        {
                                            <span class="badge event-participant-badge">@participant.Role</span>
                                        }
                                        @if (ShouldShowStatus(participant))
                                        {
                                            <span class="badge @GetStatusBadgeClass(participant.Status)">@participant.Status</span>
                                        }
                                    </div>
                                </div>

                                @if (participant.Wishlists.Any())
                                {
                                    <ul class="event-participant-wishlists">
                                        @foreach (var wishlist in participant.Wishlists)
                                        {
                                            <li class="event-participant-wishlist">
                                                <div class="event-wishlist-summary">
                                                    <span class="event-participant-wishlist-name">@wishlist.Name</span>
                                                    <span class="event-wishlist-count">@GetItemCountText(wishlist)</span>
                                                </div>
                                                <div class="event-wishlist-actions">
                                                    <a href="/wishlists/@wishlist.PublicId"
                                                       class="btn btn-outline-primary btn-sm"
                                                       aria-label="@($"View {wishlist.Name}")">View</a>
                                                    @if (CanDetach(wishlist) && _isEventOwner && !participant.IsCurrentUser)
                                                    {
                                                        <button class="btn btn-outline-secondary btn-sm"
                                                                type="button"
                                                                id="@($"remove-participant-event-wishlist-{wishlist.PublicId}")"
                                                                disabled="@(_isSubmitting || !RendererInfo.IsInteractive)"
                                                                @onclick="() => PromptWishlistRemoval(wishlist.PublicId)">
                                                            Remove
                                                        </button>
                                                    }
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="event-participant-empty mb-0">No wishlist shared yet.</p>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
}

<Dialog @ref="_removeDialog"
        Title="Remove wishlist"
        DescriptionId="remove-wishlist-dialog-description"
        CanClose="@(!_isSubmitting)"
        OnClose="ClearWishlistRemoval">
    @if (_wishlistPendingRemoval is not null)
    {
        <div class="modal-body">
            <p id="remove-wishlist-dialog-description">Remove <strong>@_wishlistPendingRemoval.Name</strong> from this event?</p>
            <p class="mb-0 text-muted">The list and its ideas stay in place. People in this event just won't see it here anymore.</p>
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">@_errorMessage</div>
            }
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dialog-initial-focus @onclick="CancelWishlistRemoval" disabled="@_isSubmitting">Keep wishlist</button>
            <button type="button"
                    class="btn btn-danger"
                    @onclick="ConfirmWishlistRemovalAsync"
                    disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    <span>Removing...</span>
                }
                else
                {
                    <span>Remove</span>
                }
            </button>
        </div>
    }
</Dialog>

@code {
    [Parameter] public string EventId { get; set; } = string.Empty;
    [Parameter] public EventModel? Event { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<WishlistModel>> OnWishlistsChanged { get; set; }

    private readonly List<WishlistModel> _eventWishlists = [];
    private readonly List<WishlistModel> _userWishlists = [];
    private WishlistModel _draftWishlist = new() { Name = "My gift ideas" };
    private string? _selectedWishlistId;
    private string? _statusMessage;
    private string? _errorMessage;
    private string? _loadErrorMessage;
    private string? _currentUserId;
    private bool _showCreateForm;
    private bool _isLoading;
    private bool _isSubmitting;
    private bool _isInitialized;
    private bool _hasLoaded;
    private bool _isEventOwner;
    private Dialog _removeDialog = default!;
    private string? _createdWishlistPublicId;
    private WishlistModel? _wishlistPendingRemoval;
    private string _lastEventId = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(EventId))
        {
            return;
        }

        await EnsureCurrentUserAsync();
        EvaluateOwnership();

        if (!_isInitialized || _lastEventId != EventId)
        {
            _isInitialized = true;
            _lastEventId = EventId;
            await LoadWishlistsAsync();
        }
        else if (Event?.EventWishlists != null && Event.EventWishlists.Count != _eventWishlists.Count)
        {
            await LoadWishlistsAsync();
        }
    }

    private async Task EnsureCurrentUserAsync()
    {
        if (!string.IsNullOrEmpty(CurrentUserId))
        {
            if (!string.Equals(_currentUserId, CurrentUserId, StringComparison.Ordinal))
            {
                _currentUserId = CurrentUserId;
            }
            return;
        }

        if (string.IsNullOrEmpty(_currentUserId))
        {
            _currentUserId = await UserContextService.GetUserIdAsync();
        }
    }

    private void EvaluateOwnership()
    {
        _isEventOwner = !string.IsNullOrEmpty(_currentUserId) &&
                        Event?.CreatedBy?.Id != null &&
                        string.Equals(Event.CreatedBy.Id, _currentUserId, StringComparison.Ordinal);
    }

    private async Task LoadWishlistsAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        _loadErrorMessage = null;

        try
        {
            if (string.IsNullOrEmpty(_currentUserId))
            {
                throw new UnauthorizedAccessException("Sign in to view event wishlists.");
            }

            var wishlists = (await EventService.GetEventWishlistsByPublicIdAsync(EventId, _currentUserId)).ToList();
            _eventWishlists.Clear();
            _eventWishlists.AddRange(wishlists);

            if (Event is not null)
            {
                Event.EventWishlists = wishlists;
            }

            if (!string.IsNullOrEmpty(_currentUserId))
            {
                var userWishlists = (await WishlistService.GetUserWishlistsAsync(_currentUserId)).ToList();
                _userWishlists.Clear();
                _userWishlists.AddRange(userWishlists);
            }
            else
            {
                _userWishlists.Clear();
            }

            if (OnWishlistsChanged.HasDelegate)
            {
                await OnWishlistsChanged.InvokeAsync(_eventWishlists);
            }

            _hasLoaded = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load wishlists for event {EventId}", EventId);
            _loadErrorMessage = "We couldn't load event wishlists. Try again.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<WishlistModel> GetCurrentUserWishlists()
    {
        if (string.IsNullOrEmpty(_currentUserId))
        {
            return Enumerable.Empty<WishlistModel>();
        }

        return _eventWishlists
            .Where(w => string.Equals(w.OwnerId, _currentUserId, StringComparison.Ordinal))
            .OrderBy(w => w.Name, StringComparer.OrdinalIgnoreCase);
    }

    private IEnumerable<WishlistModel> GetAttachableWishlists()
    {
        if (string.IsNullOrEmpty(_currentUserId))
        {
            return Enumerable.Empty<WishlistModel>();
        }

        var attachedIds = _eventWishlists.Select(w => w.PublicId).ToHashSet();

        return _userWishlists
            .Where(w => !w.IsPrivate && !IsAttachedToAnEvent(w) && !attachedIds.Contains(w.PublicId))
            .OrderBy(w => w.Name, StringComparer.OrdinalIgnoreCase);
    }

    private bool HasUnattachedPrivateWishlist
    {
        get
        {
            var attachedIds = _eventWishlists.Select(wishlist => wishlist.PublicId).ToHashSet();
            return _userWishlists.Any(wishlist =>
                wishlist.IsPrivate &&
                !IsAttachedToAnEvent(wishlist) &&
                !attachedIds.Contains(wishlist.PublicId));
        }
    }

    // EventId is not serialized, so a wishlist loaded over HTTP only reveals its event through Event.
    private static bool IsAttachedToAnEvent(WishlistModel wishlist) =>
        wishlist.EventId.HasValue || wishlist.Event is not null;

    private async Task AttachSelectedWishlistAsync()
    {
        if (string.IsNullOrEmpty(_selectedWishlistId) || string.IsNullOrEmpty(_currentUserId))
        {
            return;
        }

        await ExecuteWithFeedback(async () =>
        {
            // Find the wishlist to get its PublicId
            var selectedWishlist = _userWishlists.FirstOrDefault(w => w.PublicId == _selectedWishlistId);
            if (selectedWishlist != null)
            {
                var attached = await EventService.AttachWishlistByPublicIdAsync(EventId, selectedWishlist.PublicId, _currentUserId);
                _statusMessage = $"Added '{attached.Name}' to this event.";
            }
        });

        _selectedWishlistId = null;
    }

    private async Task AttachWishlistAsync(WishlistModel wishlist)
    {
        _selectedWishlistId = wishlist.PublicId;
        await AttachSelectedWishlistAsync();
    }

    private string GetShareWishlistButtonText() => _isSubmitting ? "Sharing wishlist..." : "Share wishlist";

    private string GetShareWishlistAccessibleName(WishlistModel wishlist) =>
        $"{GetShareWishlistButtonText()} {wishlist.Name}";

    private void PromptWishlistRemoval(string wishlistId)
    {
        if (_isSubmitting)
        {
            return;
        }

        var wishlist = _eventWishlists.FirstOrDefault(w => w.PublicId == wishlistId);
        if (wishlist == null)
        {
            return;
        }

        _wishlistPendingRemoval = wishlist;
        _errorMessage = null;
        _removeDialog.Show();
    }

    private async Task CancelWishlistRemoval()
    {
        if (_isSubmitting)
        {
            return;
        }

        await _removeDialog.CloseAsync();
    }

    private void ClearWishlistRemoval() => _wishlistPendingRemoval = null;

    private async Task ConfirmWishlistRemovalAsync()
    {
        if (_isSubmitting || _wishlistPendingRemoval is null)
        {
            return;
        }

        if (await HandleDetachWishlistAsync(_wishlistPendingRemoval.PublicId))
        {
            await _removeDialog.CloseAsync();
        }
    }

    private async Task<bool> HandleDetachWishlistAsync(string wishlistId)
    {
        if (string.IsNullOrEmpty(_currentUserId))
        {
            _errorMessage = "We couldn't confirm your account. Please sign in again.";
            return false;
        }

        return await ExecuteWithFeedback(async () =>
        {
            // Find the wishlist to get its PublicId
            var wishlist = _eventWishlists.FirstOrDefault(w => w.PublicId == wishlistId);
            if (wishlist != null)
            {
                var removed = await EventService.DetachWishlistByPublicIdAsync(EventId, wishlist.PublicId, _currentUserId);
                if (removed)
                {
                    _statusMessage = "Wishlist removed from this event.";
                }
                else
                {
                    throw new InvalidOperationException("We couldn't remove this wishlist. Try again.");
                }
            }
            else
            {
                throw new InvalidOperationException("This wishlist is no longer available. Refresh the event and try again.");
            }
        });
    }

    private async Task HandleCreateWishlistAsync(WishlistModel model)
    {
        if (_isSubmitting)
        {
            return;
        }

        if (string.IsNullOrEmpty(_currentUserId))
        {
            _errorMessage = "We couldn't confirm your account. Please sign in again.";
            return;
        }

        var createdSuccessfully = false;
        await ExecuteWithFeedback(async () =>
        {
            var created = await EventService.CreateEventWishlistByPublicIdAsync(EventId, model, _currentUserId);
            _createdWishlistPublicId = created.PublicId;
            _statusMessage = $"Your wishlist '{created.Name}' is shared with this event.";
            createdSuccessfully = true;
        });

        if (createdSuccessfully)
        {
            _showCreateForm = false;
            ResetDraftWishlist();
        }
    }

    private void ToggleCreateForm()
    {
        if (_isSubmitting)
        {
            return;
        }
        _errorMessage = null;
        _statusMessage = null;

        if (_showCreateForm)
        {
            _showCreateForm = false;
            return;
        }

        ResetDraftWishlist();
        _showCreateForm = true;
    }

    private void CancelCreateWishlist()
    {
        if (_isSubmitting)
        {
            return;
        }
        _showCreateForm = false;
        ResetDraftWishlist();
    }

    private void ResetDraftWishlist()
    {
        _draftWishlist = new WishlistModel
        {
            Name = "My gift ideas",
            Icon = null,
            IsCollaborative = false,
            IsPrivate = false,
            IsFriendsOnly = true
        };
    }

    private bool CanDetach(WishlistModel wishlist)
    {
        if (string.IsNullOrEmpty(_currentUserId))
        {
            return false;
        }

        return string.Equals(wishlist.OwnerId, _currentUserId, StringComparison.Ordinal) || _isEventOwner;
    }

    private IReadOnlyList<ParticipantWishlistViewModel> BuildParticipantGroups()
    {
        var result = new List<ParticipantWishlistViewModel>();

        if (Event == null)
        {
            return result;
        }

        var wishlistsByOwner = _eventWishlists
            .Where(w => !string.IsNullOrEmpty(w.OwnerId))
            .GroupBy(w => w.OwnerId!, StringComparer.Ordinal)
            .ToDictionary(
                g => g.Key,
                g => (IReadOnlyList<WishlistModel>)g.OrderBy(w => w.Name, StringComparer.OrdinalIgnoreCase).ToList(),
                StringComparer.Ordinal);

        if (Event.CreatedBy != null)
        {
            var ownerId = Event.CreatedBy.Id;
            wishlistsByOwner.TryGetValue(ownerId, out var ownerWishlists);

            result.Add(new ParticipantWishlistViewModel
            {
                Label = PublicDisplayName.ForGiftRecipient(Event.CreatedBy.UserName, null),
                Email = Event.CreatedBy.Email,
                UserId = ownerId,
                Role = "Organizer",
                Status = "Owner",
                IsOwner = true,
                IsCurrentUser = string.Equals(ownerId, _currentUserId, StringComparison.Ordinal),
                Wishlists = ownerWishlists ?? Array.Empty<WishlistModel>()
            });
        }

        if (Event.EventUsers != null)
        {
            foreach (var participant in Event.EventUsers
                .OrderBy(eu => eu.User?.UserName ?? eu.GuestDisplayName ?? eu.User?.Email ?? eu.InviteeEmail ?? string.Empty, StringComparer.OrdinalIgnoreCase))
            {
                var participantId = participant.User?.Id;
                IReadOnlyList<WishlistModel> participantWishlists = Array.Empty<WishlistModel>();

                if (!string.IsNullOrEmpty(participantId) && wishlistsByOwner.TryGetValue(participantId, out var lists))
                {
                    participantWishlists = lists;
                }

                result.Add(new ParticipantWishlistViewModel
                {
                    Label = participant.User is not null
                        ? PublicDisplayName.ForGiftRecipient(participant.User.UserName, participant.GuestDisplayName)
                        : PublicDisplayName.From(participant.GuestDisplayName, "Invited guest"),
                    Email = participant.User?.Email ?? participant.InviteeEmail,
                    UserId = participantId,
                    InviteeEmail = participant.InviteeEmail,
                    Role = participant.Role,
                    Status = NormalizeStatus(participant),
                    IsOwner = false,
                    IsCurrentUser = !string.IsNullOrEmpty(participantId) && string.Equals(participantId, _currentUserId, StringComparison.Ordinal),
                    Wishlists = participantWishlists
                });
            }
        }

        var unownedWishlists = _eventWishlists.Where(w => string.IsNullOrEmpty(w.OwnerId)).ToList();
        if (unownedWishlists.Any())
        {
            result.Add(new ParticipantWishlistViewModel
            {
                Label = "Shared event lists",
                Role = "Shared",
                Status = "Attached",
                IsOwner = false,
                IsCurrentUser = false,
                Wishlists = unownedWishlists
            });
        }

        return result;
    }

    private async Task<bool> ExecuteWithFeedback(Func<Task> action)
    {
        if (_isSubmitting)
        {
            return false;
        }

        try
        {
            _isSubmitting = true;
            _errorMessage = null;
            _statusMessage = null;
            _createdWishlistPublicId = null;

            await action();
            await LoadWishlistsAsync();
            return true;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Network failure while updating event {EventId}", EventId);
            _errorMessage = "We could not reach the server. Please try again.";
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Unauthorized wishlist operation for event {EventId}", EventId);
            _errorMessage = "You do not have permission to complete that action.";
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "Unable to update wishlists for event {EventId}", EventId);
            _errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while updating wishlists for event {EventId}", EventId);
            _errorMessage = "We couldn't update this event's wishlists. Check your connection and try again.";
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }

        return false;
    }

    private static string GetItemCountText(WishlistModel wishlist)
    {
        var count = GetWishlistItemCount(wishlist);

        return count switch
        {
            0 => "No ideas yet",
            1 => "1 idea",
            _ => $"{count} ideas"
        };
    }

    private static int GetWishlistItemCount(WishlistModel wishlist) =>
        EventGiftIdeas.Count(wishlist);

    private static string GetCreateButtonClass(bool hasOwnWishlist, int attachableCount) =>
        hasOwnWishlist ? "btn-link" : attachableCount > 0 ? "btn-outline-primary" : "btn-primary";

    // Every row is a participant, so only roles beyond that (and the organizer) are worth a badge.
    private static bool ShouldShowRole(ParticipantWishlistViewModel participant) =>
        !string.IsNullOrWhiteSpace(participant.Role) &&
        !string.Equals(participant.Role, "Participant", StringComparison.OrdinalIgnoreCase);

    // Accepted is the expected state; only call out invitations that still need attention.
    private static bool ShouldShowStatus(ParticipantWishlistViewModel participant) =>
        !participant.IsOwner &&
        !string.Equals(participant.Status, "Owner", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(participant.Status, "Accepted", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(participant.Status, "Attached", StringComparison.OrdinalIgnoreCase);

    private static string NormalizeStatus(EventUserModel participant)
    {
        if (!string.IsNullOrWhiteSpace(participant.Status))
        {
            return participant.Status;
        }

        return participant.IsAccepted ? "Accepted" : "Pending";
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "accepted" => "bg-success",
            "pending" => "bg-warning text-dark",
            "rejected" => "bg-danger",
            "owner" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private sealed class ParticipantWishlistViewModel
    {
        public required string Label { get; init; }
        public string? Email { get; init; }
        public string? UserId { get; init; }
        public string? InviteeEmail { get; init; }
        public string Role { get; init; } = "Participant";
        public string Status { get; init; } = "Pending";
        public bool IsOwner { get; init; }
        public bool IsCurrentUser { get; init; }
        public IReadOnlyList<WishlistModel> Wishlists { get; init; } = Array.Empty<WishlistModel>();
    }
}
