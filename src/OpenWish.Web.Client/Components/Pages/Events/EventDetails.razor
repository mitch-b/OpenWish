@page "/events/{EventId}"
@attribute [Authorize]

@using OpenWish.Shared.Services
@using OpenWish.Web.Client.Components.Event
@using System.Collections.Generic
@using System.Linq
@using OpenWish.Shared.Models

@inject IEventService EventService
@inject IUserContextService UserContextService
@inject NavigationManager NavigationManager

@rendermode InteractiveAuto

<PageTitle>@(_event?.Name ?? "Event Details")</PageTitle>

@if (_event == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading event...</span>
        </div>
    </div>
}
else
{
    <div class="event-header">
        <div class="container">
            <div class="event-header-content">
                <div class="event-header-copy">
                    <h1 class="display-4">@_event.Name</h1>
                    <p class="lead mb-0">@_event.Description</p>
                    @if (_event.Tags != null)
                    {
                        <div class="mt-3">
                            @foreach (var tag in _event.Tags ?? [])
                            {
                                <span class="badge event-tag me-2">@tag.Trim()</span>
                            }
                        </div>
                    }
                </div>
                @if (_isOwner)
                {
                    <a href="/events/@EventId/manage" class="btn btn-light event-manage-action">
                        <OpenWishIcon Name="gear" Class="me-2" /> Manage Event
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="container event-page py-4">
        @if (_event.IsGiftExchange && _isOwner && !_event.NamesDrawnOn.HasValue)
        {
            <div id="secret-santa-setup">
                <SecretSantaSetup Event="@_event" CurrentUserId="@(_currentUserId ?? string.Empty)" />
            </div>
        }
        else if (_event.IsGiftExchange && _isAcceptedParticipant && !_event.NamesDrawnOn.HasValue)
        {
            <div class="alert alert-info d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" role="status">
                <div>
                    <strong>You're in the Secret Santa.</strong>
                    Add a few gift ideas now, then you can leave the rest to the organizer.
                </div>
                <a class="btn btn-primary" href="#event-wishlists">Add my wishlist</a>
            </div>
        }

        @if (_isPendingInvitee)
        {
            <div class="alert alert-info shadow-sm" role="status">
                <h2 class="h4">Accept your invitation to join</h2>
                <p>
                    Accept before the organizer draws names so you can be included and add gift ideas for your match.
                </p>
                @if (!string.IsNullOrWhiteSpace(PendingInvitationEmail))
                {
                    <a class="btn btn-success" href="@PendingInvitationLink">Review invitation</a>
                }
            </div>
        }
        else
        {
          <div class="row g-4">
            <div class="col-lg-8">
                @if (_event.IsGiftExchange && _event.NamesDrawnOn.HasValue)
                {
                    <GiftExchangeDisplay EventId="@EventId"
                                         CurrentUserId="@_currentUserId"
                                         EventWishlists="@_event.EventWishlists" />
                }

                <div class="card shadow-sm event-overview-card">
                    <div class="card-body">
                        <h2 class="h4 mb-3">Event overview</h2>
                        <div class="event-facts">
                            <div class="event-fact">
                                <span class="event-fact-label">Date and time</span>
                                <strong>@_event.Date.ToString("ddd, MMM d, yyyy 'at' h:mm tt")</strong>
                            </div>
                            <div class="event-fact">
                                <span class="event-fact-label">Budget</span>
                                <strong>@(_event.Budget?.ToString("C") ?? "Not set")</strong>
                            </div>
                            <div class="event-fact">
                                <span class="event-fact-label">Hosted by</span>
                                <strong>@GetOwnerDisplayName()</strong>
                            </div>
                            <div class="event-fact">
                                <span class="event-fact-label">Event type</span>
                                <strong>@(_event.IsGiftExchange ? "Secret Santa" : "Celebration")</strong>
                            </div>
                            @if (_event.IsRecurring)
                            {
                                <div class="event-fact">
                                    <span class="event-fact-label">Schedule</span>
                                    <strong>Recurring event</strong>
                                </div>
                            }
                        </div>

                        @{
                            var participants = GetParticipantList().ToList();
                            var hasOwner = _event.CreatedBy != null;
                            var participantCount = participants.Count + (hasOwner ? 1 : 0);
                        }
                        <div class="section-heading">
                            <h3 class="h5 mb-0">People</h3>
                            <span>@participantCount total</span>
                        </div>
                        <div class="participant-grid">
                            @if (!hasOwner && participants.Count == 0)
                            {
                                <p class="participant-empty">No participants yet.</p>
                            }
                            else if (hasOwner)
                            {
                                <div class="participant-card">
                                    <strong>@GetOwnerDisplayName()</strong>
                                    @if (GetOwnerContactDetail() is { } ownerContact)
                                    {
                                        <span class="participant-contact">@ownerContact</span>
                                    }
                                    <span class="participant-status">Organizer</span>
                                </div>
                            }

                            @foreach (var participant in participants)
                            {
                                <div class="participant-card">
                                    <strong>@GetParticipantDisplayName(participant)</strong>
                                    @if (GetParticipantContactDetail(participant) is { } contact)
                                    {
                                        <span class="participant-contact">@contact</span>
                                    }
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="participant-status">@participant.Role</span>
                                        <span class="participant-status @GetStatusClass(participant)">@GetNormalizedStatus(participant)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-4" id="event-wishlists">
                    <EventWishlistManager EventId="@EventId"
                                           Event="@_event"
                                           CurrentUserId="@_currentUserId"
                                           OnWishlistsChanged="HandleWishlistsChanged" />
                </div>

                @if (_event.IsGiftExchange && _isOwner)
                {
                    <div class="mt-4" id="gift-exchange">
                        <GiftExchangeManager Event="@_event"
                                             CurrentUserId="@_currentUserId"
                                             OnNamesDrawn="HandleNamesDrawn" />
                    </div>
                }

                @* @if (_event.EventWishlists.Any())
                {
                    <div class="card shadow-sm mt-4">
                        <div class="card-body">
                            <h3>Event Wishlists</h3>
                            <div class="row g-3 mt-2">
                                @foreach (var wishlist in _event.EventWishlists)
                                {
                                    <div class="col-md-6">
                                        <div class="card h-100">
                                            <div class="card-body">
                                                <h5 class="card-title">@wishlist.Name</h5>
                                                <p class="card-text">Created by @wishlist.Owner.UserName</p>
                                                <a href="/wishlists/@wishlist.PublicId" class="btn btn-outline-primary btn-sm">
                                                    View Wishlist
                                                </a>
                                            </div>
                                          </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                } *@
            </div>

            <div class="col-lg-4">
                @if (_isOwner)
                {
                    <div id="event-invitations">
                        <EventInvitations EventId="@EventId"
                                          IsOwner="true"
                                          CurrentUserId="@_currentUserId"
                                          NamesDrawn="@_event.NamesDrawnOn.HasValue" />
                    </div>
                }

                <div class="mt-4">
                    <EventReservedItems EventId="@EventId"
                                         CurrentUserId="@_currentUserId" />
                </div>

                @* @if (_event.IsGiftExchange && _event.GiftExchanges.Any())
                {
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h3>Gift Exchange</h3>
                            <p>You are gifting to:</p>
                            @{
                                var myExchange = _event.GiftExchanges.FirstOrDefault(ge => ge.GiverId == _currentUserId);
                                if (myExchange != null)
                                {
                                    <div class="alert alert-info">
                                        <strong>@myExchange.Receiver.UserName</strong>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                } *@
            </div>
        </div>
        }
    </div>
}

@code {
    [Parameter] public string EventId { get; set; } = string.Empty;
    private EventModel? _event;
    private string? _currentUserId;
    private bool _isOwner;
    private bool _isAcceptedParticipant;
    private bool _isPendingInvitee;
    private EventUserModel? _pendingInvitation;

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = await UserContextService.GetUserIdAsync();
        await LoadEvent();
    }

    private async Task LoadEvent()
    {
        _event = await EventService.GetEventByPublicIdAsync(EventId, _currentUserId!);
        _isOwner = _event?.CreatedBy.Id == _currentUserId;
        _isAcceptedParticipant = _isOwner ||
            (_event?.EventUsers?.Any(participant =>
                !participant.Deleted &&
                participant.IsAccepted &&
                string.Equals(participant.Status, "Accepted", StringComparison.OrdinalIgnoreCase) &&
                string.Equals(participant.UserId, _currentUserId, StringComparison.Ordinal)) ?? false);
        _isPendingInvitee = !_isOwner && !_isAcceptedParticipant;

        if (_isPendingInvitee)
        {
            var invitations = await EventService.GetPendingInvitationsForUserAsync(_currentUserId!);
            _pendingInvitation = invitations.FirstOrDefault(invitation =>
                string.Equals(invitation.Event?.PublicId, EventId, StringComparison.Ordinal));
        }
    }

    private string PendingInvitationLink =>
        $"/events/{EventId}/accept-invite?email={Uri.EscapeDataString(PendingInvitationEmail!)}";

    private string? PendingInvitationEmail =>
        _pendingInvitation?.InviteeEmail ?? _pendingInvitation?.User?.Email;

    private IEnumerable<EventUserModel> GetParticipantList() =>
        _event?.EventUsers?
            .Where(eu => !IsOwner(eu))
            .OrderBy(eu => GetStatusSortOrder(eu))
            .ThenBy(eu => GetParticipantDisplayName(eu), StringComparer.OrdinalIgnoreCase)
        ?? Enumerable.Empty<EventUserModel>();

    private bool IsOwner(EventUserModel eventUser) =>
        !string.IsNullOrWhiteSpace(_event?.CreatedBy?.Id) &&
        string.Equals(eventUser.User?.Id, _event!.CreatedBy!.Id, StringComparison.Ordinal);

    private static int GetStatusSortOrder(EventUserModel eventUser) => GetNormalizedStatus(eventUser) switch
    {
        "Accepted" => 0,
        "Pending" => 1,
        "Rejected" => 2,
        _ => 3
    };

    private static string GetStatusClass(EventUserModel eventUser) => GetNormalizedStatus(eventUser) switch
    {
        "Accepted" => "participant-status-success",
        "Pending" => "participant-status-warning",
        "Rejected" => "participant-status-danger",
        _ => string.Empty
    };

    private static string GetParticipantDisplayName(EventUserModel eventUser)
    {
        if (!string.IsNullOrWhiteSpace(eventUser.User?.UserName))
        {
            return eventUser.User.UserName!;
        }

        if (!string.IsNullOrWhiteSpace(eventUser.InviteeEmail))
        {
            return eventUser.InviteeEmail!;
        }

        return "Pending Invitation";
    }

    private static string? GetParticipantContactDetail(EventUserModel eventUser)
    {
        if (!string.IsNullOrWhiteSpace(eventUser.User?.Email))
        {
            return eventUser.User.Email!;
        }

        return eventUser.InviteeEmail;
    }

    private string GetOwnerDisplayName()
    {
        if (!string.IsNullOrWhiteSpace(_event?.CreatedBy?.UserName))
        {
            return _event!.CreatedBy!.UserName!;
        }

        if (!string.IsNullOrWhiteSpace(_event?.CreatedBy?.Email))
        {
            return _event!.CreatedBy!.Email!;
        }

        return "Event Owner";
    }

    private string? GetOwnerContactDetail() =>
        string.IsNullOrWhiteSpace(_event?.CreatedBy?.Email) ? null : _event!.CreatedBy!.Email!;

    private static string GetNormalizedStatus(EventUserModel eventUser)
    {
        if (!string.IsNullOrWhiteSpace(eventUser.Status))
        {
            return eventUser.Status;
        }

        return eventUser.IsAccepted ? "Accepted" : "Pending";
    }

    private Task HandleWishlistsChanged(IReadOnlyList<WishlistModel> wishlists)
    {
        if (_event != null)
        {
            _event.EventWishlists = wishlists.ToList();
        }

        return Task.CompletedTask;
    }

    private async Task HandleNamesDrawn()
    {
        await LoadEvent();
    }
}