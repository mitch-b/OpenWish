@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IGiftProfileService GiftProfileService
@inject ILogger<GiftProfilePanel> Logger

@if (_profile is { HasContent: true })
{
    <section class="gift-profile-panel" aria-labelledby="gift-profile-title" data-testid="gift-profile">
        <header class="gift-profile-header">
            <span class="gift-profile-icon"><OpenWishIcon Name="gift" /></span>
            <div>
                <h2 id="gift-profile-title">Gift hints</h2>
                <p class="gift-profile-intro">Shared by the list owner to help friends choose.</p>
            </div>
        </header>
        <dl class="gift-profile-hints">
            @if (!string.IsNullOrWhiteSpace(_profile.Sizes))
            {
                <div class="gift-profile-hint"><dt>Sizes</dt><dd>@_profile.Sizes</dd></div>
            }
            @if (!string.IsNullOrWhiteSpace(_profile.Favorites))
            {
                <div class="gift-profile-hint"><dt>Favorites</dt><dd>@_profile.Favorites</dd></div>
            }
            @if (!string.IsNullOrWhiteSpace(_profile.Avoid))
            {
                <div class="gift-profile-hint gift-profile-hint--avoid">
                    <dt><OpenWishIcon Name="exclamation-circle" />Please avoid</dt>
                    <dd>@_profile.Avoid</dd>
                </div>
            }
        </dl>
    </section>
}

@code {
    private GiftProfileModel? _profile;

    [Parameter, EditorRequired]
    public string WishlistPublicId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ViewerId { get; set; } = string.Empty;

    private string? _loadedKey;

    protected override async Task OnParametersSetAsync()
    {
        // The list re-renders as it changes; load hints once per list and viewer.
        var key = $"{WishlistPublicId}/{ViewerId}";
        if (key == _loadedKey)
        {
            return;
        }

        _loadedKey = key;
        try
        {
            _profile = await GiftProfileService.GetProfileForWishlistAsync(WishlistPublicId, ViewerId);
        }
        catch (Exception ex)
        {
            // Hints are optional; never block the list.
            Logger.LogWarning(ex, "Unable to load gift hints for wishlist {WishlistPublicId}.", WishlistPublicId);
            _profile = null;
            _loadedKey = null;
        }
    }
}
