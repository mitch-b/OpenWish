@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IWishlistService WishlistService
@inject IUserContextService UserContextService
@inject IGiftPlanService GiftPlanService

<div class="item-reservation" aria-busy="@(_loading || _isUpdating)">
    @if (_loading && !_hasLoaded)
    {
        <div class="reservation-loading" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Checking reservation…</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
    {
        <div class="alert alert-danger reservation-alert" role="alert">
            <p class="mb-2">@_loadErrorMessage</p>
            <button class="btn btn-outline-danger btn-sm"
                    type="button"
                    disabled="@(_loading || !RendererInfo.IsInteractive)"
                    @onclick="RetryReservation">
                <OpenWishIcon Name="arrow-clockwise" /> Try again
            </button>
        </div>
    }
    else if (_currentUserId is null)
    {
        <p class="reservation-hint mb-0">Sign in to reserve this item.</p>
    }
    else if (_currentUserId == OwnerId)
    {
        @* Owners never see reservation details or controls for their own list. *@
    }
    else if (_isReserved)
    {
        @if (_myReservation)
        {
            <div class="reservation-status reservation-status-mine" data-testid="reservation-status">
                <OpenWishIcon Name="check-circle-fill" Class="reservation-status-icon" />
                <div class="reservation-status-body">
                    <strong class="reservation-status-title">You reserved this gift</strong>
                    <span class="reservation-status-meta">
                        Reserved @FormatDate(_reservation.ReservationDate)@(_reservation.IsAnonymous ? " · Your name is hidden from other shoppers" : string.Empty)
                    </span>
                </div>
                <button class="btn btn-sm btn-outline-danger reservation-cancel"
                        @ref="_cancelReservationButton"
                        type="button"
                        disabled="@(_isUpdating || _loading || _showCancelConfirmation || !RendererInfo.IsInteractive)"
                        @onclick="ShowCancelConfirmation">
                    <OpenWishIcon Name="x-circle" /> Cancel reservation
                </button>
            </div>
        }
        else
        {
            <div class="reservation-status reservation-status-taken" data-testid="reservation-status">
                <OpenWishIcon Name="lock" Class="reservation-status-icon" />
                <div class="reservation-status-body">
                    <strong class="reservation-status-title">
                        @if (_reservation.IsAnonymous)
                        {
                            @:Someone reserved this gift
                        }
                        else
                        {
                            @:Reserved by @(_reservation.User?.UserName ?? "another shopper")
                        }
                    </strong>
                    <span class="reservation-status-meta">
                        Reserved @FormatDate(_reservation.ReservationDate) · Pick another idea to avoid a duplicate gift.
                    </span>
                </div>
            </div>
        }
        @if (_showCancelConfirmation)
        {
            <div class="alert alert-warning reservation-confirm"
                 role="alertdialog"
                 aria-labelledby="cancel-reservation-title-@ItemPublicId"
                 aria-describedby="cancel-reservation-description-@ItemPublicId">
                <div id="cancel-reservation-title-@ItemPublicId" class="fw-semibold">Release this reservation?</div>
                <p id="cancel-reservation-description-@ItemPublicId" class="mb-2">
                    Other shoppers will be able to reserve this item.
                </p>
                <div class="reservation-confirm-actions">
                    <button @ref="_keepReservationButton"
                            type="button"
                            class="btn btn-sm btn-secondary"
                            disabled="@(_isUpdating || _loading || !RendererInfo.IsInteractive)"
                            @onclick="KeepReservation">
                        Keep reservation
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-danger"
                            disabled="@(_isUpdating || _loading || !RendererInfo.IsInteractive)"
                            @onclick="CancelReservation">
                        @(_isUpdating ? "Releasing…" : "Release reservation")
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <p class="reservation-hint" id="reservation-hint-@ItemPublicId">
            Reserve it so other shoppers know it's covered. The list owner never sees reservations.
        </p>
        @if (_givenMatches.Count > 0)
        {
            <div class="alert alert-warning reservation-alert" role="note" data-testid="duplicate-gift-warning">
                <OpenWishIcon Name="exclamation-triangle" />
                You marked a gift like this as given to @_givenMatches[0].RecipientName on @FormatDate(_givenMatches[0].PurchasedOn). Reserve anyway?
            </div>
        }
        <div class="form-check reservation-anonymous">
            <input class="form-check-input"
                   type="checkbox"
                   id="anonymousCheckbox-@ItemPublicId"
                   aria-describedby="anonymousHelp-@ItemPublicId"
                   disabled="@(_isUpdating || _loading || !RendererInfo.IsInteractive)"
                   @bind="_anonymous" />
            <label class="form-check-label" for="anonymousCheckbox-@ItemPublicId">
                Reserve anonymously
            </label>
            <div id="anonymousHelp-@ItemPublicId" class="reservation-anonymous-help">Hide your name from other shoppers.</div>
        </div>

        <button class="btn btn-primary reservation-reserve"
                @ref="_reserveItemButton"
                type="button"
                disabled="@(_isUpdating || _loading || !RendererInfo.IsInteractive)"
                aria-busy="@_isUpdating"
                aria-describedby="reservation-hint-@ItemPublicId"
                @onclick="ReserveItem">
            <OpenWishIcon Name="gift" /> @(_isUpdating ? "Reserving…" : "Reserve this item")
        </button>
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <p class="reservation-feedback" role="status" aria-live="polite">
            <OpenWishIcon Name="check-circle" />
            <span>
                @_statusMessage
                @if (_showGiftPlanLink)
                {
                    <a class="ms-1" href="/gift-plan" data-testid="reservation-gift-plan-link">View my gift plan</a>
                }
            </span>
        </p>
    }

    @if (_error)
    {
        <div @ref="_errorAlert" class="alert alert-danger reservation-alert" role="alert" tabindex="-1">
            @_errorMessage
        </div>
    }
</div>

@code {
    [Parameter]
    public string WishlistId { get; set; } = string.Empty;

    [Parameter]
    public string ItemPublicId { get; set; } = string.Empty;
    
    [Parameter]
    public string OwnerId { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnReservationChanged { get; set; }

    // Identifies the reservation the parent list currently knows about, so the panel reloads when it differs from its own.
    [Parameter]
    public string? ReservationVersion { get; set; }

    private bool _loading = true;
    private bool _hasLoaded;
    private bool _showGiftPlanLink;
    private bool _error = false;
    private string _errorMessage = "An error occurred. Please try again.";
    private string? _loadErrorMessage;
    private bool _isReserved = false;
    private bool _myReservation = false;
    private bool _anonymous = false;
    private bool _isUpdating;
    private bool _showCancelConfirmation;
    private bool _focusCancelConfirmation;
    private string? _statusMessage;
    private ElementReference _keepReservationButton;
    private ElementReference _cancelReservationButton;
    private ElementReference _reserveItemButton;
    private ElementReference _errorAlert;
    private bool _focusCancelReservationButton;
    private bool _focusReserveItemButton;
    private bool _focusErrorAlert;
    private ItemReservationModel _reservation = new ItemReservationModel();
    private string? _currentUserId;
    private IReadOnlyList<GivenGiftMatchModel> _givenMatches = [];

    private string? _loadedKey;

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{WishlistId}/{ItemPublicId}";
        if (key == _loadedKey)
        {
            var current = _isReserved ? _reservation.PublicId : string.Empty;
            if (ReservationVersion is null || ReservationVersion == current || _loading || _isUpdating)
            {
                return;
            }
        }

        if (key != _loadedKey)
        {
            _hasLoaded = false;
            _showGiftPlanLink = false;
        }

        _loadedKey = key;
        await CheckReservation();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCancelConfirmation)
        {
            _focusCancelConfirmation = false;
            await _keepReservationButton.FocusAsync();
        }

        if (_focusCancelReservationButton)
        {
            _focusCancelReservationButton = false;
            await _cancelReservationButton.FocusAsync();
        }

        if (_focusReserveItemButton)
        {
            _focusReserveItemButton = false;
            await _reserveItemButton.FocusAsync();
        }

        if (_focusErrorAlert)
        {
            _focusErrorAlert = false;
            await _errorAlert.FocusAsync();
        }

        if (firstRender && _loadErrorMessage is not null && _currentUserId == null)
        {
            // If we had an error during SSR and no user ID, try again after first render
            await CheckReservation();
        }
    }

    [Inject] private ILogger<ItemReservation> Logger { get; set; } = default!;

    private async Task<bool> CheckReservation()
    {
        try
        {
            _loading = true;
            _error = false;
            _loadErrorMessage = null;
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId == null)
            {
                _loading = false;
                _isReserved = false;
                return true;
            }

            if (_currentUserId == OwnerId)
            {
                _loading = false;
                _isReserved = false;
                return true;
            }

            var reservation = await WishlistService.GetItemReservationByPublicIdAsync(WishlistId, ItemPublicId, _currentUserId);
            
            if (reservation != null)
            {
                _isReserved = true;
                _reservation = reservation;
                _myReservation = reservation.UserId == _currentUserId;
            }
            else
            {
                _isReserved = false;
            }

            await LoadGivenMatchesAsync();
            return true;
        }
        catch (Exception ex)
        {
            _loadErrorMessage = "Reservation status could not be loaded. Try again.";
            Logger.LogError(ex, "Failed to check reservation for wishlist {WishlistPublicId}, item {WishlistItemId}", WishlistId, ItemPublicId);
            return false;
        }
        finally
        {
            _loading = false;
            _hasLoaded |= _loadErrorMessage is null;
            StateHasChanged();
        }
    }

    private async Task LoadGivenMatchesAsync()
    {
        _givenMatches = [];
        if (_isReserved || _currentUserId is null)
        {
            return;
        }

        try
        {
            _givenMatches = await GiftPlanService.GetPreviouslyGivenMatchesAsync(_currentUserId, WishlistId, ItemPublicId);
        }
        catch (Exception ex)
        {
            // The warning is a courtesy; never block reserving because it failed to load.
            Logger.LogWarning(ex, "Failed to check previously given gifts for wishlist {WishlistPublicId}, item {WishlistItemId}", WishlistId, ItemPublicId);
        }
    }

    private static string FormatDate(DateTimeOffset date) => date.ToLocalTime().ToString("MMM d, yyyy");

    private async Task RetryReservation()
    {
        if (_loading)
        {
            return;
        }

        await CheckReservation();
    }

    private async Task ReserveItem()
    {
        if (_loading || _isUpdating)
        {
            return;
        }

        try
        {
            _isUpdating = true;
            _error = false;
            _statusMessage = null;
            _showGiftPlanLink = false;
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                var result = await WishlistService.ReserveItemByPublicIdAsync(WishlistId, ItemPublicId, _currentUserId, _anonymous);
                
                if (result)
                {
                    var refreshed = await CheckReservation();
                    await OnReservationChanged.InvokeAsync();
                    if (refreshed)
                    {
                        _statusMessage = "Item reserved. Other shoppers can see that it is taken.";
                        _showGiftPlanLink = true;
                    }
                    else
                    {
                        _error = true;
                        _errorMessage = "The item was reserved, but its status could not be refreshed. Reload this page.";
                        _focusErrorAlert = true;
                    }
                }
                else
                {
                    await CheckReservation();
                    await OnReservationChanged.InvokeAsync();
                    _error = true;
                    _errorMessage = "Someone else reserved this item first. It is now marked as reserved.";
                    _focusErrorAlert = true;
                }
            }
            else
            {
                _error = true;
                _errorMessage = "Please log in to reserve items.";
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = "Failed to reserve this item. Please try again.";
            Logger.LogError(ex, "Failed to reserve wishlist {WishlistPublicId}, item {WishlistItemId}", WishlistId, ItemPublicId);
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }

    private void ShowCancelConfirmation()
    {
        _showCancelConfirmation = true;
        _statusMessage = null;
        _error = false;
        _focusCancelConfirmation = true;
    }

    private void KeepReservation()
    {
        _showCancelConfirmation = false;
        _focusCancelReservationButton = true;
    }

    private async Task CancelReservation()
    {
        if (_loading || _isUpdating)
        {
            return;
        }

        try
        {
            _isUpdating = true;
            _error = false;
            _statusMessage = null;
            _showGiftPlanLink = false;
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                var canceled = await WishlistService.CancelReservationByPublicIdAsync(WishlistId, ItemPublicId, _currentUserId);
                _showCancelConfirmation = false;
                var refreshed = await CheckReservation();
                await OnReservationChanged.InvokeAsync();
                if (canceled && refreshed)
                {
                    _statusMessage = "Reservation released.";
                    _focusReserveItemButton = true;
                }
                else if (canceled)
                {
                    _error = true;
                    _errorMessage = "The reservation was released, but its status could not be refreshed. Reload this page.";
                    _focusErrorAlert = true;
                }
                else
                {
                    _error = true;
                    _errorMessage = "The reservation could not be released. It may have already changed.";
                    _focusErrorAlert = true;
                }
            }
            else
            {
                _showCancelConfirmation = false;
                _error = true;
                _errorMessage = "Sign in again to release this reservation.";
                _focusErrorAlert = true;
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = "Failed to cancel the reservation. Please try again.";
            Logger.LogError(ex, "Failed to cancel reservation for wishlist {WishlistPublicId}, item {WishlistItemId}", WishlistId, ItemPublicId);
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }
}