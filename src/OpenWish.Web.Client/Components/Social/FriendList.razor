@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IFriendService FriendService
@inject IUserContextService UserContextService
@inject ILogger<FriendList> Logger

<div class="friend-list" aria-busy="@(_loading ? "true" : "false")">
    <div class="social-heading">
        <span class="social-heading-icon"><OpenWishIcon Name="people" /></span>
        <div>
            <h2>My friends</h2>
            <p>People who can share wishlists with you.</p>
        </div>
    </div>
    
    @if (_loading)
    {
        <div class="spinner-border spinner-border-sm" role="status">
            <span class="visually-hidden">Loading friends...</span>
        </div>
    }
    else if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">
            <p class="mb-2">@_errorMessage</p>
            <button class="btn btn-outline-danger btn-sm" type="button" @onclick="LoadFriends">
                Try again
            </button>
        </div>
    }
    else if (!_friends.Any())
    {
        <div class="alert alert-info">
            You don't have any friends yet. Find users to connect with!
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var friend in _friends)
            {
                <div class="list-group-item friend-row">
                    <div class="friend-identity">
                        <span class="friend-avatar"><OpenWishIcon Name="person-circle" /></span>
                        <strong>@friend.UserName</strong>
                    </div>
                    <div>
                        <button class="btn btn-outline-danger btn-sm"
                                type="button"
                                aria-label="Remove @GetFriendName(friend) from friends"
                                @onclick="() => ShowRemoveConfirmation(friend)">
                            <OpenWishIcon Name="person-dash" /> Remove
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    
    @if (_statusMessage is not null)
    {
        <div class="alert alert-success mt-3" role="status" aria-live="polite">
            @_statusMessage
        </div>
    }
</div>

<FriendRemoveConfirmationDialog @ref="_removeConfirmationDialog" OnConfirm="ConfirmRemoveFriend" />

@code {
    private List<ApplicationUserModel> _friends = [];
    private bool _loading = true;
    private string? _currentUserId;
    private string? _errorMessage;
    private string? _statusMessage;
    private FriendRemoveConfirmationDialog _removeConfirmationDialog;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadFriends();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _errorMessage is not null && _currentUserId == null)
        {
            // If we had an error during SSR and no user ID, try again after first render
            await LoadFriends();
        }
    }

    private async Task LoadFriends()
    {
        try
        {
            _loading = true;
            _errorMessage = null;
            _currentUserId ??= await UserContextService.GetUserIdAsync();
            
            if (_currentUserId != null)
            {
                var friends = await FriendService.GetFriendsAsync(_currentUserId);
                _friends = friends.ToList();
            }
            else
            {
                _errorMessage = "Sign in again to load your friends.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load friends.");
            _errorMessage = "Your friends could not be loaded. Try again.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
    
    private void ShowRemoveConfirmation(ApplicationUserModel friend)
    {
        var friendName = GetFriendName(friend);
        const string title = "Remove friend";
        var message = $"Remove {friendName} from your friends? You will no longer share friends-only wishlists.";
        _removeConfirmationDialog.Show(title, message, friend.Id);
    }
    
    private async Task ConfirmRemoveFriend(string friendId)
    {
        try
        {
            _errorMessage = null;
            _statusMessage = null;
            _currentUserId ??= await UserContextService.GetUserIdAsync();
            
            if (_currentUserId != null)
            {
                var friend = _friends.FirstOrDefault(candidate => candidate.Id == friendId);
                var friendName = friend is null ? "Friend" : GetFriendName(friend);
                if (await FriendService.RemoveFriendAsync(_currentUserId, friendId))
                {
                    await LoadFriends();
                    if (_errorMessage is null)
                    {
                        _statusMessage = $"{friendName} removed from your friends.";
                    }
                }
                else
                {
                    _errorMessage = $"{friendName} could not be removed. Refresh and try again.";
                }
            }
            else
            {
                _errorMessage = "Sign in again to remove this friend.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove friend {FriendId}.", friendId);
            _errorMessage = "This friend could not be removed. Try again.";
            StateHasChanged();
        }
    }

    private static string GetFriendName(ApplicationUserModel friend) =>
        friend.UserName ?? friend.Email ?? "this person";
}