# Required host paths. The source directory is this Git checkout. The deploy
# directory receives the active Compose file and logs.
OPENWISH_SOURCE_DIR=/home/your-user/src/OpenWish
OPENWISH_DEPLOY_DIR=/opt/openwish
OPENWISH_BACKUP_DIR=/opt/backups/openwish

# Published image and PostgreSQL settings.
OPENWISH_IMAGE=ghcr.io/mitch-b/openwish-web:latest
POSTGRES_IMAGE=postgres:18
OPENWISH_DB_NAME=OpenWish
OPENWISH_DB_USER=openwish
# Generate a unique value, for example: openssl rand -base64 36
OPENWISH_DB_PASSWORD=replace-with-a-long-random-password

# Public URL and local listener. Keep the loopback bind when a reverse proxy on
# the Docker host terminates HTTPS.
OPENWISH_BASE_URI=https://wish.example.com
OPENWISH_BIND_ADDRESS=127.0.0.1
OPENWISH_PORT=5001
TZ=America/Chicago

# Maintenance behavior.
COMPOSE_PROJECT_NAME=openwish
BACKUP_RETENTION_DAYS=30
HEALTH_URL=http://127.0.0.1:5001/
HEALTH_TIMEOUT=120
HEALTH_INTERVAL=5

# Configure exactly the proxy or proxy network that sends forwarded headers.
# Leave both blank if OpenWish is not behind a reverse proxy.
TRUSTED_PROXY_IP=172.17.0.1
TRUSTED_PROXY_NETWORK=

# Optional email settings. Email is disabled when SMTP_FROM or SMTP_HOST is blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
