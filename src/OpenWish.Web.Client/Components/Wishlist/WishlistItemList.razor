@using OpenWish.Shared.Extensions;

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col" class="col-name">Name</th>
                <th scope="col">Description</th>
                <th scope="col">Price</th>
                @if (Budget.HasValue)
                {
                    <th>Budget</th>
                }
                <th scope="col">Priority</th>
                <th scope="col" class="col-added">Added</th>
                <th scope="col" class="col-actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                <tr @key="item.PublicId"
                    class="item-row @(ExpandedInteractions.Contains(item.PublicId) ? "is-expanded" : string.Empty)"
                    tabindex="-1">
                    <td data-label="Name" class="item-cell-name">
                        <div class="item-title-line">
                            <span class="item-name">@item.Name</span>
                            @if (!string.IsNullOrEmpty(item.Url))
                            {
                                <a href="@item.Url"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="wishlist-external-link"
                                   title="Open product page"
                                   aria-label="View @item.Name product (opens in a new tab)">
                                    <OpenWishIcon Name="box-arrow-up-right" />
                                </a>
                            }
                        </div>
                        @if (item.IsPinned || !string.IsNullOrWhiteSpace(item.WhereToBuy) || !string.IsNullOrWhiteSpace(item.SourceAppName) || (!IsOwner && item.Reservations.Count > 0))
                        {
                            <div class="item-tags">
                                <ReservationBadge Item="item" CurrentUserId="@CurrentUserId" IsOwner="IsOwner" />
                                @if (item.IsPinned)
                                {
                                    <span class="most-wanted"><OpenWishIcon Name="star" /> Most wanted</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.WhereToBuy))
                                {
                                    <span class="item-store"><OpenWishIcon Name="shop" /> @item.WhereToBuy</span>
                                }
                                <ItemSourceBadge AppName="@item.SourceAppName" />
                            </div>
                        }
                    </td>
                    <td data-label="Description" class="item-cell-description">
                        @if (string.IsNullOrWhiteSpace(item.Description))
                        {
                            <span class="item-placeholder">Not added</span>
                        }
                        else
                        {
                            <span class="item-description">@item.Description</span>
                        }
                    </td>
                    <td data-label="Price" class="item-cell-price">
                        @if (item.Price is { } price)
                        {
                            <span class="item-price">@price.ToString("C")</span>
                        }
                        else
                        {
                            <span class="item-placeholder">Not added</span>
                        }
                    </td>
                    @if (Budget.HasValue)
                    {
                        <td data-label="Budget" class="item-cell-budget">
                            <span class="@GetBudgetStatusClass(item)">@GetBudgetStatusText(item)</span>
                        </td>
                    }
                    <td data-label="Priority" class="item-cell-priority">
                        <span class="priority-badge @GetPriorityClass(item.Priority)">
                            @GetPriorityText(item.Priority)
                        </span>
                    </td>
                    <td data-label="Added" class="item-cell-added">
                        <span class="tooltip-container">
                            @item.CreatedOn.ToLocalHumanizedString()
                            <span class="tooltip-text">@item.CreatedOn.ToLocalTime()</span>
                        </span>
                    </td>
                    <td data-label="Actions" class="item-cell-actions">
                        <div class="action-buttons">
                            @if (ShowInteractions)
                            {
                                <button
                                    class="btn btn-sm item-options-toggle @(ExpandedInteractions.Contains(item.PublicId) ? "is-open" : string.Empty)"
                                    type="button"
                                    disabled="@(!RendererInfo.IsInteractive)"
                                    @onclick="() => ToggleInteractions(item.PublicId)"
                                    aria-expanded="@ExpandedInteractions.Contains(item.PublicId)"
                                    aria-controls="item-interactions-@item.PublicId"
                                    aria-label="@(ExpandedInteractions.Contains(item.PublicId) ? "Hide" : "Show") gift options for @item.Name">
                                    <OpenWishIcon Name="@(ExpandedInteractions.Contains(item.PublicId) ? "x-lg" : "gift")" />
                                    <span>@(ExpandedInteractions.Contains(item.PublicId) ? "Hide options" : "Gift options")</span>
                                </button>
                            }
                            @if (OnEdit.HasDelegate || OnDelete.HasDelegate)
                            {
                                <div class="edit-actions">
                                    @if (OnEdit.HasDelegate)
                                    {
                                        <button
                                            class="btn btn-sm item-icon-action"
                                            type="button"
                                            disabled="@(!RendererInfo.IsInteractive)"
                                            aria-label="Edit @item.Name"
                                            @onclick="() => HandleEdit(item)"
                                            title="Edit">
                                            <OpenWishIcon Name="pencil" />
                                        </button>
                                    }
                                    @if (OnDelete.HasDelegate)
                                    {
                                        <button
                                            id="delete-wishlist-item-@item.PublicId"
                                            class="btn btn-sm item-icon-action item-delete-action"
                                            type="button"
                                            disabled="@(!RendererInfo.IsInteractive)"
                                            aria-label="Delete @item.Name"
                                            @onclick="() => HandleDelete(item)"
                                            title="Delete">
                                            <OpenWishIcon Name="trash" />
                                        </button>
                                    }
                                </div>
                            }
                            @if (IsOwner)
                            {
                                <div class="rank-actions" role="group" aria-label="Reorder @item.Name">
                                    <button class="btn btn-sm item-icon-action @(item.IsPinned ? "is-pinned" : string.Empty)"
                                            type="button"
                                            disabled="@(IsRanking || !RendererInfo.IsInteractive)"
                                            aria-pressed="@item.IsPinned"
                                            aria-label="@(item.IsPinned ? $"Remove {item.Name} from most wanted" : $"Mark {item.Name} as most wanted")"
                                            title="@(item.IsPinned ? "Remove from most wanted" : "Mark as most wanted")"
                                            @onclick="() => HandleTogglePin(item)">
                                        <OpenWishIcon Name="star" />
                                    </button>
                                    <button class="btn btn-sm item-icon-action"
                                            type="button"
                                            disabled="@(!CanMoveItem(item, -1) || !RendererInfo.IsInteractive)"
                                            aria-label="Move @item.Name up"
                                            title="Move up"
                                            @onclick="() => HandleMoveUp(item)">
                                        <OpenWishIcon Name="chevron-right" Class="icon-up" />
                                    </button>
                                    <button class="btn btn-sm item-icon-action"
                                            type="button"
                                            disabled="@(!CanMoveItem(item, 1) || !RendererInfo.IsInteractive)"
                                            aria-label="Move @item.Name down"
                                            title="Move down"
                                            @onclick="() => HandleMoveDown(item)">
                                        <OpenWishIcon Name="chevron-right" Class="icon-down" />
                                    </button>
                                    @if (CanMarkReceived)
                                    {
                                        <button class="btn btn-sm item-icon-action"
                                                type="button"
                                                data-testid="mark-received"
                                                disabled="@(!RendererInfo.IsInteractive)"
                                                aria-label="Mark @item.Name as received"
                                                title="Mark as received"
                                                @onclick="() => OnMarkReceived.InvokeAsync(item)">
                                            <OpenWishIcon Name="check-circle" />
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </td>
                </tr>
                @if (ShowInteractions)
                {
                    <tr class="interaction-row-expanded" hidden="@(!ExpandedInteractions.Contains(item.PublicId))">
                        <td colspan="@(Budget.HasValue ? 7 : 6)" class="interaction-row">
                            <div class="interaction-container"
                                 id="item-interactions-@item.PublicId"
                                 role="region"
                                 aria-label="Gift coordination for @item.Name">
                                @if (ExpandedInteractions.Contains(item.PublicId) && !IsOwner)
                                {
                                    <div class="interaction-section">
                                        <h6><OpenWishIcon Name="gift" /> Reservation</h6>
                                        <ItemReservation WishlistId="@WishlistId" ItemPublicId="@item.PublicId" OwnerId="@OwnerId" ReservationVersion="@GetReservationVersion(item)" OnReservationChanged="OnReservationChanged" />
                                    </div>
                                }
                                @if (ExpandedInteractions.Contains(item.PublicId))
                                {
                                    <div class="interaction-section">
                                        <ItemComments WishlistId="@WishlistId" ItemPublicId="@item.PublicId" IsWishlistOwner="@IsOwner" OnCommentsChanged="OnCommentsChanged" />
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IEnumerable<WishlistItemModel> Items { get; set; } = Array.Empty<WishlistItemModel>();
    [Parameter] public EventCallback<WishlistItemModel> OnEdit { get; set; }
    [Parameter] public EventCallback<WishlistItemModel> OnDelete { get; set; }
    [Parameter] public EventCallback<WishlistItemModel> OnTogglePin { get; set; }
    [Parameter] public EventCallback<WishlistItemModel> OnMoveUp { get; set; }
    [Parameter] public EventCallback<WishlistItemModel> OnMoveDown { get; set; }
    [Parameter] public EventCallback<WishlistItemModel> OnMarkReceived { get; set; }
    [Parameter] public bool CanMarkReceived { get; set; }
    [Parameter] public bool CanReorder { get; set; }
    [Parameter] public bool IsRanking { get; set; }
    [Parameter] public bool ShowInteractions { get; set; } = false;
    [Parameter] public string WishlistId { get; set; } = string.Empty;
    [Parameter] public string OwnerId { get; set; } = "";
    [Parameter] public bool IsOwner { get; set; } = false;
    [Parameter] public decimal? Budget { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }

    private static string GetReservationVersion(WishlistItemModel item) =>
        item.Reservations.FirstOrDefault()?.PublicId ?? string.Empty;

    [Parameter] public EventCallback OnReservationChanged { get; set; }

    [Parameter] public EventCallback<ItemComments.CommentsChange> OnCommentsChanged { get; set; }

    private HashSet<string> ExpandedInteractions = new();

    private void ToggleInteractions(string itemId)
    {
        if (ExpandedInteractions.Contains(itemId))
        {
            ExpandedInteractions.Remove(itemId);
        }
        else
        {
            ExpandedInteractions.Add(itemId);
        }
    }

    private async Task HandleEdit(WishlistItemModel item)
    {
        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync(item);
        }
    }

    private async Task HandleDelete(WishlistItemModel item)
    {
        if (OnDelete.HasDelegate)
        {
            await OnDelete.InvokeAsync(item);
        }
    }

    private bool CanMoveItem(WishlistItemModel item, int direction)
    {
        if (!CanReorder)
        {
            return false;
        }

        var matchingItems = Items.Where(candidate => candidate.IsPinned == item.IsPinned).ToList();
        var itemIndex = matchingItems.FindIndex(candidate => candidate.PublicId == item.PublicId);
        return itemIndex + direction >= 0 && itemIndex + direction < matchingItems.Count;
    }

    private async Task HandleTogglePin(WishlistItemModel item)
    {
        if (OnTogglePin.HasDelegate)
        {
            await OnTogglePin.InvokeAsync(item);
        }
    }

    private async Task HandleMoveUp(WishlistItemModel item)
    {
        if (CanMoveItem(item, -1) && OnMoveUp.HasDelegate)
        {
            await OnMoveUp.InvokeAsync(item);
        }
    }

    private async Task HandleMoveDown(WishlistItemModel item)
    {
        if (CanMoveItem(item, 1) && OnMoveDown.HasDelegate)
        {
            await OnMoveDown.InvokeAsync(item);
        }
    }

    public Task ExpandItemAsync(string itemId)
    {
        if (!ShowInteractions)
        {
            return Task.CompletedTask;
        }

        ExpandedInteractions.Clear();
        ExpandedInteractions.Add(itemId);

        return InvokeAsync(StateHasChanged);
    }

    private string GetPriorityClass(int? priority) => priority switch
    {
        1 => "priority-high",
        2 => "priority-medium",
        3 => "priority-low",
        _ => "priority-none"
    };

    private string GetPriorityText(int? priority) => priority switch
    {
        1 => "High",
        2 => "Medium",
        3 => "Low",
        _ => "None"
    };

    private string GetBudgetStatusText(WishlistItemModel item)
    {
        if (item.Price is not { } price || Budget is not { } budget)
        {
            return "Price not set";
        }

        return price <= budget ? "Within budget" : $"{price - budget:C} over budget";
    }

    private string GetBudgetStatusClass(WishlistItemModel item)
    {
        if (item.Price is not { } price || Budget is not { } budget)
        {
            return "budget-status budget-status-unknown";
        }

        return price <= budget ? "budget-status budget-status-within" : "budget-status budget-status-over";
    }
}