@page "/events/{EventId}/accept-invite"
@attribute [AllowAnonymous]

@using OpenWish.Shared.Models
@using OpenWish.Shared.Services
@using OpenWish.Web.Client.Components.Shared

@inject IEventService EventService
@inject IUserContextService UserContextService
@inject ILogger<AcceptInvite> Logger
@rendermode InteractiveAuto

<PageTitle>Event invitation</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h3 mb-3">You're almost in!</h1>

                    @if (_isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading invitation...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @_errorMessage
                                @if (_canRetry)
                                {
                                    <button class="btn btn-outline-danger d-block mt-2" type="button" disabled="@_isLoading" @onclick="OnParametersSetAsync">Try again</button>
                                }
                            </div>
                        }

                        @if (string.IsNullOrWhiteSpace(InviteEmail))
                        {
                            <div class="alert alert-warning" role="alert">
                                This invitation link is missing the email identifier we need to match you to the event.
                                Please click the link directly from your invitation email.
                            </div>
                        }
                        else if (!_isAuthenticated)
                        {
                            <p class="lead">
                                Sign in or create an account with <strong>@InviteEmail</strong> to accept your invitation.
                            </p>
                            <p class="text-muted">We'll bring you straight back here. You don't need to add friends or set up an event.</p>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-primary" href="@BuildIdentityUrl("Account/Register")" data-enhance-nav="false">
                                    Create account
                                </a>
                                <a class="btn btn-outline-primary" href="@BuildIdentityUrl("Account/Login")" data-enhance-nav="false">
                                    Sign in
                                </a>
                            </div>
                        }
                        else if (_invitation == null)
                        {
                            @if (string.IsNullOrEmpty(_errorMessage))
                            {
                                <div class="alert alert-warning" role="alert">
                                    We couldn't find a pending invitation for <strong>@InviteEmail</strong>.
                                    Double-check that you're signed in with the same email address that received the invite or ask the host to resend it.
                                </div>
                            }
                            <div class="d-flex flex-wrap gap-2" data-testid="invitation-recovery">
                                <a class="btn btn-primary" href="@BuildIdentityUrl("Account/Login")" data-enhance-nav="false" data-testid="invitation-switch-account">
                                    Sign in with a different account
                                </a>
                                <a class="btn btn-outline-secondary" href="/events">Back to events</a>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4">
                                @if (_event != null)
                                {
                                    <div class="mb-3">
                                        <p class="text-muted mb-1">Event</p>
                                        <h2 class="h4 mb-0">@_event.Name</h2>
                                        @if (!string.IsNullOrWhiteSpace(_event.Description))
                                        {
                                            <p class="mb-0 text-muted">@_event.Description</p>
                                        }
                                        <div class="mt-2 small text-muted">
                                            <OpenWishIcon Name="calendar-event" />
                                            @_event.Date.ToString("dddd, MMMM d, yyyy 'at' h:mm tt")
                                        </div>
                                        <div class="small text-muted">
                                            <OpenWishIcon Name="person-circle" />
                                            Hosted by @HostName
                                        </div>
                                    </div>
                                }

                                <div class="alert alert-info" role="alert">
                                    Invitation for <strong>@InviteEmail</strong>
                                </div>

                                @switch (NormalizeStatus(_invitation.Status))
                                {
                                    case "accepted":
                                        <div class="alert alert-success" role="status" data-testid="invitation-outcome">
                                            @(_successMessage ?? AcceptedMessage)
                                        </div>
                                        <a class="btn btn-success" href="/events/@EventId" @ref="_continueLink">
                                            Continue and add my wishlist
                                        </a>
                                        break;
                                    case "rejected":
                                        <div class="alert alert-warning" role="status" data-testid="invitation-outcome">
                                            @(_successMessage ?? "You previously declined this invitation. Ask the host to send a new one if you changed your mind.")
                                        </div>
                                        <a class="btn btn-outline-secondary" href="/events">Back to events</a>
                                        break;
                                    default:
                                        <p class="mb-3">Would you like to accept the invitation?</p>
                                        <div class="d-flex flex-wrap gap-2" aria-busy="@_isProcessing">
                                            <button class="btn btn-success" @onclick="AcceptInviteAsync" disabled="@_isProcessing">
                                                @if (_isProcessing && _processingAction == "accept")
                                                {
                                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                                    <span>Accepting invitation...</span>
                                                }
                                                else
                                                {
                                                    <span>Accept invite</span>
                                                }
                                            </button>
                                            <button id="decline-event-invitation"
                                                    class="btn btn-outline-secondary"
                                                    @onclick="PromptRejectInvite"
                                                    disabled="@_isProcessing">
                                                Decline invite
                                            </button>
                                        </div>
                                        break;
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<Dialog @ref="_rejectDialog"
        Title="Decline invitation"
        DescriptionId="decline-invitation-description"
        ReturnFocusElementId="decline-event-invitation"
        CanClose="@(!_isProcessing)"
        OnClose="ClearRejectDialog">
    <div class="modal-body">
        <p id="decline-invitation-description">
            Decline this invitation? The host will see that you declined, and you won't be included in the event.
        </p>
        @if (!string.IsNullOrWhiteSpace(_rejectErrorMessage))
        {
            <div class="alert alert-danger mb-0" role="alert">@_rejectErrorMessage</div>
        }
    </div>
    <div class="modal-footer">
        <button type="button"
                class="btn btn-secondary"
                data-dialog-initial-focus
                disabled="@_isProcessing"
                @onclick="CloseRejectDialogAsync">
            Keep invitation
        </button>
        <button type="button"
                class="btn btn-danger"
                disabled="@_isProcessing"
                @onclick="RejectInviteAsync">
            @if (_isProcessing && _processingAction == "reject")
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span>Declining invitation...</span>
            }
            else
            {
                <span>Decline invitation</span>
            }
        </button>
    </div>
</Dialog>

@code {
    [Parameter] public string EventId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "email")]
    public string? InviteEmail { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private EventModel? _event;
    private EventUserModel? _invitation;
    private string? _currentUserId;
    private bool _isAuthenticated;
    private bool _isLoading = true;
    private bool _isProcessing;
    private string? _processingAction;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _rejectErrorMessage;
    private Dialog _rejectDialog = default!;
    private ElementReference _continueLink;
    private bool _focusContinue;
    private bool _canRetry;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusContinue)
        {
            _focusContinue = false;
            await _continueLink.FocusAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _successMessage = null;
        _invitation = null;
        _event = null;
        _canRetry = false;

        var authState = await AuthenticationStateTask;
        _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!_isAuthenticated)
        {
            _isLoading = false;
            return;
        }

        _currentUserId = await UserContextService.GetUserIdAsync();
        if (string.IsNullOrEmpty(_currentUserId))
        {
            _errorMessage = "We couldn't determine your account. Please sign in again.";
            _isLoading = false;
            return;
        }

        if (!string.IsNullOrWhiteSpace(InviteEmail))
        {
            try
            {
                _invitation = await EventService.ClaimEventInvitationByEmailAsync(EventId, _currentUserId, InviteEmail);
            }
            catch (InvalidOperationException ex)
            {
                Logger.LogWarning(ex, "Unable to claim invitation for event {EventId}", EventId);
                _errorMessage = "We couldn't match this invitation to your account. Check the invited email address or ask the host to resend it.";
            }
            catch (ArgumentException ex)
            {
                Logger.LogWarning(ex, "Invalid invitation claim for event {EventId}", EventId);
                _errorMessage = "This invitation link isn't valid. Open the latest link from your invitation email.";
            }
            catch (KeyNotFoundException ex)
            {
                Logger.LogWarning(ex, "Invitation event {EventId} is no longer available", EventId);
                _errorMessage = "This event is no longer available. Ask the host for a new invitation.";
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unable to load invitation for event {EventId}", EventId);
                _errorMessage = "We couldn't load your invitation. Check your connection and try again.";
                _canRetry = true;
            }
        }

        try
        {
            if (_invitation is not null)
            {
                _event = await EventService.GetEventByPublicIdAsync(EventId, _currentUserId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load invitation event details for {EventId}", EventId);
            _errorMessage ??= "We couldn't load the event details. Check your connection and try again.";
            _canRetry = true;
        }

        _isLoading = false;
    }

    private string HostName =>
        !string.IsNullOrWhiteSpace(_event?.CreatedBy?.UserName) ? _event.CreatedBy.UserName
        : !string.IsNullOrWhiteSpace(_event?.CreatedBy?.Email) ? _event.CreatedBy.Email
        : "a friend";

    private string AcceptedMessage => _event?.IsGiftExchange == false
        ? "You're part of this event. Add a few gift ideas and you're done."
        : "You're part of the gift exchange. Add a few gift ideas and you're done.";

    private async Task AcceptInviteAsync()
    {
        if (_isProcessing || _invitation == null || string.IsNullOrEmpty(_currentUserId))
        {
            return;
        }

        _isProcessing = true;
        _processingAction = "accept";
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var accepted = await EventService.AcceptEventInvitationAsync(_invitation.Id, _currentUserId);
            if (accepted)
            {
                _invitation.Status = "Accepted";
                _invitation.IsAccepted = true;
                _focusContinue = true;
                _successMessage = _event?.IsGiftExchange == false
                    ? "You're in! Continue to the event and add a few gift ideas."
                    : "You're in! Continue to the event and add a few gift ideas for your match.";
            }
            else
            {
                _errorMessage = "We couldn't accept the invitation. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to accept invitation {InvitationId} for event {EventId}", _invitation.Id, EventId);
            _errorMessage = "We couldn't accept the invitation. Check your connection and try again.";
        }
        finally
        {
            _isProcessing = false;
            _processingAction = null;
        }
    }

    private async Task RejectInviteAsync()
    {
        if (_isProcessing || _invitation == null || string.IsNullOrEmpty(_currentUserId))
        {
            return;
        }

        _isProcessing = true;
        _processingAction = "reject";
        _errorMessage = null;
        _successMessage = null;
        _rejectErrorMessage = null;

        try
        {
            var rejected = await EventService.RejectEventInvitationAsync(_invitation.Id, _currentUserId);
            if (rejected)
            {
                _invitation.Status = "Rejected";
                _invitation.IsAccepted = false;
                _successMessage = "No worries, we've let the host know.";
                await _rejectDialog.CloseAsync();
            }
            else
            {
                _rejectErrorMessage = "We couldn't decline the invitation. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to decline invitation {InvitationId} for event {EventId}", _invitation.Id, EventId);
            _rejectErrorMessage = "We couldn't decline the invitation. Check your connection and try again.";
        }
        finally
        {
            _isProcessing = false;
            _processingAction = null;
        }
    }

    private void PromptRejectInvite()
    {
        if (_invitation is null || _isProcessing)
        {
            return;
        }

        _rejectErrorMessage = null;
        _rejectDialog.Show();
    }

    private Task CloseRejectDialogAsync() => _rejectDialog.CloseAsync();

    private void ClearRejectDialog() => _rejectErrorMessage = null;

    private static string NormalizeStatus(string? status)
    {
        return string.IsNullOrWhiteSpace(status)
            ? "pending"
            : status.Trim().ToLowerInvariant();
    }

    private string BuildIdentityUrl(string basePath)
    {
        var emailQuery = string.IsNullOrWhiteSpace(InviteEmail)
            ? string.Empty
            : $"?email={Uri.EscapeDataString(InviteEmail)}";
        var returnUrl = $"/events/{EventId}/accept-invite{emailQuery}";
        var encodedReturnUrl = Uri.EscapeDataString(returnUrl);
        var accountEmailQuery = string.IsNullOrWhiteSpace(InviteEmail)
            ? string.Empty
            : $"&email={Uri.EscapeDataString(InviteEmail)}";
        return $"/{basePath}?returnUrl={encodedReturnUrl}{accountEmailQuery}";
    }
}
