@page "/oauth/authorize"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using OpenWish.Application.Models.Configuration
@using OpenWish.Application.Integrations
@using OpenWish.Data.Entities
@using OpenWish.Shared.Integrations
@using OpenWish.Web.Integrations

@inject IIntegrationClientStore ClientStore
@inject IOptions<OpenWishSettings> Settings
@inject IIntegrationConnectionService ConnectionService
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject ILogger<ConnectApp> Logger

<PageTitle>@(app is null ? "Connect an app" : $"Connect {app.DisplayName}")</PageTitle>

<div class="consent-page">
    @if (fatalError is not null)
    {
        <header class="consent-heading">
            <span class="consent-mark consent-mark-warning"><OpenWishIcon Name="exclamation-triangle" /></span>
            <div>
                <h1>This connection can't continue</h1>
                <p>@fatalError</p>
            </div>
        </header>
        <p class="consent-help">Nothing was shared. Go back to the app you came from and try again, or ask the person who runs this OpenWish to check its connected-app settings.</p>
        <a class="btn btn-primary" href="/">Go to OpenWish</a>
    }
    else if (app is not null && consent is not null)
    {
        <header class="consent-heading">
            <div class="consent-pair" aria-hidden="true">
                <span class="consent-mark"><OpenWishIcon Name="gift" /></span>
                <span class="consent-link"><OpenWishIcon Name="arrow-left-right" /></span>
                <span class="consent-mark consent-mark-app">@IntegrationDisplay.Monogram(app.DisplayName)</span>
            </div>
            <div>
                <h1>Connect @app.DisplayName</h1>
                <p>
                    @if (consent.IsReconnecting)
                    {
                        <text>@app.DisplayName is already connected. Approving again replaces its old access and keeps the ideas it added.</text>
                    }
                    else
                    {
                        <text>@app.DisplayName wants to add gift ideas to your OpenWish lists.</text>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(app.Description))
                {
                    <p class="consent-app-description">@app.Description</p>
                }
            </div>
        </header>

        @if (app.IsSelfRegistered)
        {
            <div class="alert alert-warning consent-unverified" role="note" aria-labelledby="consent-unverified-title">
                <p class="consent-unverified-title" id="consent-unverified-title"><OpenWishIcon Name="exclamation-triangle" /> Only connect if you started this</p>
                <p class="mb-0">OpenWish can't confirm who made this assistant; "@app.DisplayName" is the name it gave itself. It will send you back to <strong>@RedirectHost</strong>. If you didn't just ask an AI assistant to connect to OpenWish, cancel.</p>
            </div>
        }

        <form method="post" @formname="consent-approve" @onsubmit="ApproveAsync" class="consent-form" novalidate>
            <AntiforgeryToken />

            @if (formError is not null)
            {
                <div class="alert alert-danger" role="alert" id="consent-error">@formError</div>
            }

            <fieldset class="consent-section" aria-describedby="consent-lists-help">
                <legend>Lists @app.DisplayName can use</legend>
                <p id="consent-lists-help" class="consent-help">New ideas go to the first list you choose. You can change this anytime.</p>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="consent-all-lists" name="allowAllWishlists" value="true" checked="@allowAllWishlists" aria-describedby="consent-all-lists-help" />
                    <label class="form-check-label" for="consent-all-lists">Allow all wishlists</label>
                    <div id="consent-all-lists-help" class="form-text">Includes every list you own now and create later, even private lists. Leave this off to allow only the lists you check below.</div>
                </div>

                @if (consent.Wishlists.Count > 0)
                {
                    <ul class="consent-lists" role="list">
                        @foreach (var wishlist in consent.Wishlists)
                        {
                            var inputId = $"consent-list-{wishlist.PublicId}";
                            <li>
                                <label class="consent-list" for="@inputId">
                                    <input class="form-check-input" type="checkbox" id="@inputId" name="wishlist" value="@wishlist.PublicId" checked="@selectedIds.Contains(wishlist.PublicId)" />
                                    <span class="consent-list-icon" aria-hidden="true">
                                        @if (string.IsNullOrWhiteSpace(wishlist.Icon))
                                        {
                                            <OpenWishIcon Name="list-ul" />
                                        }
                                        else
                                        {
                                            @wishlist.Icon
                                        }
                                    </span>
                                    <span class="consent-list-text">
                                        <span class="consent-list-name">@wishlist.Name</span>
                                        <span class="consent-list-meta">@ListMeta(wishlist)</span>
                                    </span>
                                    @if (wishlist.IsDefault)
                                    {
                                        <span class="consent-list-badge">Current default</span>
                                    }
                                </label>
                            </li>
                        }
                    </ul>
                }

                <div class="consent-new-list">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="consent-new-list" name="createList" value="true" checked="@createList" />
                        <label class="form-check-label" for="consent-new-list">Start a new list for these ideas</label>
                    </div>
                    <label class="form-label" for="consent-new-list-name">New list name</label>
                    <input class="form-control" id="consent-new-list-name" name="newListName" value="@newListName" maxlength="@IntegrationConnectionService.NewWishlistNameMaxLength" autocomplete="off" placeholder="Christmas @DateTime.UtcNow.Year" aria-describedby="consent-new-list-help" />
                    <div id="consent-new-list-help" class="form-text">A new list starts private and becomes where new ideas go. Share it from OpenWish when you're ready.</div>
                </div>
            </fieldset>

            <section class="consent-section consent-permissions" aria-labelledby="consent-permissions-title">
                <h2 id="consent-permissions-title">What @app.DisplayName can do</h2>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="consent-existing-items" name="manageExistingItems" value="true" checked="@manageExistingItems" aria-describedby="consent-existing-items-help" />
                    <label class="form-check-label" for="consent-existing-items">Manage existing items in allowed lists</label>
                    <div id="consent-existing-items-help" class="form-text">See, edit, move, and remove ideas already on these lists, including ideas you or other apps added. Turn this off for more privacy: the app can only see and manage ideas it added.</div>
                </div>
                <ul role="list">
                    <li><OpenWishIcon Name="check-circle" Class="consent-allowed" /> <span>See the names of the lists you choose</span></li>
                    <li><OpenWishIcon Name="check-circle" Class="consent-allowed" /> <span>Add ideas to those lists, and edit or remove the ideas it added</span></li>
                    <li><OpenWishIcon Name="eye-slash" Class="consent-denied" /> <span>It never sees reservations, purchases, comments, hidden surprises, your friends, or lists you haven't allowed</span></li>
                </ul>
                <p class="consent-help mb-0">Disconnect anytime from <strong>Account settings</strong> &gt; <strong>Connected apps</strong>. Ideas it added stay on your lists.</p>
            </section>

            <div class="consent-actions">
                <button type="submit" class="btn btn-outline-secondary" form="consent-deny-form">Cancel</button>
                <button type="submit" class="btn btn-primary" id="consent-approve">
                    <OpenWishIcon Name="link-45deg" /> @(consent.IsReconnecting ? "Reconnect" : "Connect") @app.DisplayName
                </button>
            </div>
            <p class="consent-signed-in">Signed in as @signedInAs. You'll return to @RedirectHost when you're done.</p>
        </form>

        @* Cancel lives in its own form so Enter in the list-name field always approves. *@
        <form method="post" @formname="consent-deny" @onsubmit="Deny" id="consent-deny-form" hidden>
            <AntiforgeryToken />
        </form>
    }
</div>

@code {
    private IntegrationApp? app;
    private ConsentState? consent;
    private string? fatalError;
    private string? formError;
    private string? userId;
    private string signedInAs = "you";
    private HashSet<string> selectedIds = new(StringComparer.Ordinal);
    private bool createList;
    private bool allowAllWishlists;
    private bool manageExistingItems = true;
    private string? newListName;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "response_type")]
    private string? ResponseType { get; set; }

    [SupplyParameterFromQuery(Name = "client_id")]
    private string? ClientId { get; set; }

    [SupplyParameterFromQuery(Name = "redirect_uri")]
    private string? RedirectUri { get; set; }

    [SupplyParameterFromQuery(Name = "state")]
    private string? State { get; set; }

    [SupplyParameterFromQuery(Name = "scope")]
    private string? Scope { get; set; }

    [SupplyParameterFromQuery(Name = "code_challenge")]
    private string? CodeChallenge { get; set; }

    [SupplyParameterFromQuery(Name = "code_challenge_method")]
    private string? CodeChallengeMethod { get; set; }

    [SupplyParameterFromQuery(Name = "resource")]
    private string? Resource { get; set; }

    private IntegrationAudience audience;
    private Uri baseUri = default!;

    private string RedirectHost => Uri.TryCreate(RedirectUri, UriKind.Absolute, out var uri) ? uri.Authority : "the app";

    protected override async Task OnInitializedAsync()
    {
        baseUri = PublicBaseUri.Resolve(HttpContext.Request, Settings.Value.BaseUri);
        app = await ClientStore.FindAsync(ClientId);
        if (app is null)
        {
            fatalError = "The app that sent you here isn't registered with this OpenWish.";
            return;
        }

        if (!IntegrationAppRegistry.IsRegisteredRedirect(app, RedirectUri))
        {
            Logger.LogWarning("Rejected an authorization request for {ClientId} with an unregistered redirect URI.", app.ClientId);
            fatalError = $"{app.DisplayName} asked to send you back to an address this OpenWish doesn't recognize.";
            return;
        }

        // The redirect target is trusted from here on, so protocol errors go back to the app (RFC 6749 section 4.1.2.1).
        // Browsers check form-action against redirects that follow a form post, so allow this app's origin.
        HttpContext.Items[IntegrationAuthenticationDefaults.FormActionOriginItem] =
            new Uri(RedirectUri!).GetLeftPart(UriPartial.Authority);

        if (!PublicBaseUri.TryResolveAudience(Resource, baseUri, ClientStore.IsMcpEnabled, out var requestedAudience))
        {
            RedirectToApp(new() { ["error"] = "invalid_target", ["error_description"] = "This OpenWish doesn't serve that resource." });
            return;
        }

        audience = requestedAudience ?? (app.IsSelfRegistered ? IntegrationAudience.Mcp : IntegrationAudience.Api);

        var protocolError = ValidateRequest();
        if (protocolError is not null)
        {
            RedirectToApp(new() { ["error"] = protocolError.Value.Error, ["error_description"] = protocolError.Value.Description });
            return;
        }

        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            fatalError = "Sign in again to continue.";
            return;
        }

        userId = user.Id;
        signedInAs = PublicDisplayName.From(user.UserName, user.Email ?? "you");
        consent = await ConnectionService.GetConsentStateAsync(user.Id, app.ClientId);

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            var allowed = consent.Wishlists.Where(w => w.IsAllowed).Select(w => w.PublicId).ToList();
            if (allowed.Count == 0 && consent.Wishlists.Count > 0)
            {
                allowed.Add(consent.Wishlists[0].PublicId);
            }

            selectedIds = new HashSet<string>(allowed, StringComparer.Ordinal);
            allowAllWishlists = consent.AllowAllWishlists;
            manageExistingItems = consent.ManageExistingItems;
            createList = consent.Wishlists.Count == 0;
            newListName = createList ? $"Ideas from {app.DisplayName}" : null;
        }
    }

    private async Task ApproveAsync()
    {
        if (app is null || consent is null || userId is null)
        {
            return;
        }

        var form = HttpContext.Request.Form;
        selectedIds = new HashSet<string>(
            form["wishlist"].Where(id => !string.IsNullOrWhiteSpace(id)).Select(id => id!),
            StringComparer.Ordinal);
        createList = string.Equals(form["createList"], "true", StringComparison.Ordinal);
        allowAllWishlists = string.Equals(form["allowAllWishlists"], "true", StringComparison.Ordinal);
        manageExistingItems = string.Equals(form["manageExistingItems"], "true", StringComparison.Ordinal);
        newListName = form["newListName"].ToString().Trim();

        if (createList && string.IsNullOrEmpty(newListName))
        {
            formError = "Name the new list, or clear \"Start a new list\".";
            return;
        }

        // Keep the on-screen order so "the first list you choose" is predictable.
        var ordered = consent.Wishlists
            .Where(w => allowAllWishlists || selectedIds.Contains(w.PublicId))
            .Select(w => w.PublicId)
            .ToList();
        var result = await ConnectionService.ApproveAsync(userId, new AuthorizationApproval(
            app.ClientId,
            RedirectUri!,
            CodeChallenge,
            ordered,
            ordered.FirstOrDefault(),
            createList ? newListName : null,
            audience,
            allowAllWishlists,
            manageExistingItems));

        if (result.Code is not null)
        {
            Logger.LogInformation("A user approved {ClientId} for {Count} wishlist(s).", app.ClientId, ordered.Count + (createList ? 1 : 0));
            RedirectToApp(new() { ["code"] = result.Code });
            return;
        }

        formError = result.Error switch
        {
            AuthorizationApprovalError.NoWishlistSelected => "Choose at least one list, or start a new one.",
            AuthorizationApprovalError.WishlistNotFound => "One of those lists is no longer available. Review your choices and try again.",
            AuthorizationApprovalError.InvalidNewWishlistName => $"Use a list name of {IntegrationConnectionService.NewWishlistNameMaxLength} characters or fewer.",
            _ => "Something went wrong. Try again."
        };
    }

    private void Deny()
    {
        if (app is null || consent is null)
        {
            return;
        }

        Logger.LogInformation("A user declined to connect {ClientId}.", app.ClientId);
        RedirectToApp(new() { ["error"] = "access_denied" });
    }

    private (string Error, string Description)? ValidateRequest()
    {
        if (!string.Equals(ResponseType, "code", StringComparison.Ordinal))
        {
            return ("unsupported_response_type", "Only response_type=code is supported.");
        }

        if (string.IsNullOrEmpty(State))
        {
            return ("invalid_request", "state is required.");
        }

        // AI assistants often ask for scopes they saw elsewhere; they only ever get wishlist.items.
        var lenientScopes = app!.IsSelfRegistered || audience == IntegrationAudience.Mcp;
        if (!lenientScopes && !string.IsNullOrEmpty(Scope) &&
            Scope.Split(' ', StringSplitOptions.RemoveEmptyEntries).Any(scope => scope != IntegrationScopes.WishlistItems))
        {
            return ("invalid_scope", $"Only the {IntegrationScopes.WishlistItems} scope is supported.");
        }

        if (!string.IsNullOrEmpty(CodeChallenge) &&
            (!string.Equals(CodeChallengeMethod, "S256", StringComparison.Ordinal) ||
                CodeChallenge.Length is < 43 or > 128))
        {
            return ("invalid_request", "Use a code_challenge of 43-128 characters with code_challenge_method=S256.");
        }

        if (string.IsNullOrEmpty(CodeChallenge) && (app.IsPublicClient || audience == IntegrationAudience.Mcp))
        {
            return ("invalid_request", "code_challenge is required; use PKCE with code_challenge_method=S256.");
        }

        if (string.IsNullOrEmpty(CodeChallenge) && !string.IsNullOrEmpty(CodeChallengeMethod))
        {
            return ("invalid_request", "code_challenge_method was sent without a code_challenge.");
        }

        return null;
    }

    private void RedirectToApp(Dictionary<string, string?> parameters)
    {
        if (!string.IsNullOrEmpty(State))
        {
            parameters["state"] = State;
        }

        // RFC 9207 lets the app confirm the response came from this OpenWish.
        parameters["iss"] = baseUri.ToString();

        NavigationManager.NavigateTo(QueryHelpers.AddQueryString(RedirectUri!, parameters));
    }

    private static string ListMeta(ConsentWishlistOption wishlist)
    {
        var count = wishlist.ItemCount == 1 ? "1 idea" : $"{wishlist.ItemCount} ideas";
        return wishlist.EventName is null ? count : $"{count}, for {wishlist.EventName}";
    }
}
