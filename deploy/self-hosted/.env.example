# Pin this to a published monthly or release tag for controlled upgrades.
OPENWISH_IMAGE=ghcr.io/mitch-b/openwish-web:latest
POSTGRES_IMAGE=postgres:18

# Public URL and local listener. Keep the default loopback bind when using a
# reverse proxy on the Docker host.
OPENWISH_BASE_URI=https://wish.example.com
OPENWISH_BIND_ADDRESS=127.0.0.1
OPENWISH_PORT=5001
TZ=America/Chicago

# Generate a unique value, for example: openssl rand -base64 36
POSTGRES_DB=OpenWish
POSTGRES_USER=openwish
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Configure exactly the proxy or proxy network that sends forwarded headers.
# Leave both blank if OpenWish is not behind a reverse proxy.
TRUSTED_PROXY_IP=172.17.0.1
TRUSTED_PROXY_NETWORK=

# Optional email settings. Email is disabled when SMTP_FROM or SMTP_HOST is blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Local backup policy used by maintain.sh.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
