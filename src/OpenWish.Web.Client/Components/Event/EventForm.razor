
<FocusOnFirstRender ElementId="name" Enabled="@AutoFocusName" />
<EditForm Enhance Model="@Model" OnValidSubmit="@HandleSubmit" FormName="EventForm">
    <DataAnnotationsValidator />

    @if (ShowValidationSummary)
    {
        <ValidationSummary class="alert alert-danger" />
    }

    <fieldset class="mb-4" disabled="@LockEventType">
        <legend class="form-label fw-bold">What are you planning?</legend>
        <div class="row g-3">
            <div class="col-sm-6">
                <button type="button"
                        class="event-type-option @(Model!.IsGiftExchange ? "event-type-option-selected" : string.Empty)"
                        aria-pressed="@Model.IsGiftExchange"
                        @onclick="SelectGiftExchange">
                    <span class="event-type-icon" aria-hidden="true"><OpenWishIcon Name="gift" /></span>
                    <strong>Gift exchange</strong>
                    <small>Invite people, collect wishlists, and draw names privately.</small>
                </button>
            </div>
            @if (LockEventType)
            {
                <div class="form-text">Reset the current assignments before changing the event type.</div>
            }
            <div class="col-sm-6">
                <button type="button"
                        class="event-type-option @(!Model!.IsGiftExchange ? "event-type-option-selected" : string.Empty)"
                        aria-pressed="@(!Model.IsGiftExchange)"
                        @onclick="SelectCelebration">
                    <span class="event-type-icon" aria-hidden="true"><OpenWishIcon Name="stars" /></span>
                    <strong>Birthday or celebration</strong>
                    <small>Coordinate wishlists without drawing names.</small>
                </button>
            </div>
        </div>
    </fieldset>

    @if (Model!.IsGiftExchange)
    {
        <fieldset class="mb-4">
            <legend class="form-label fw-bold">Choose an exchange style</legend>
            <p class="form-text mt-0">Both styles keep assignments private. Choose the language your group will recognize.</p>
            <div class="exchange-style-options" role="group" aria-label="Gift exchange style">
                <button type="button"
                        class="exchange-style-option @(IsSecretSantaStyle ? "exchange-style-option-selected" : string.Empty)"
                        aria-pressed="@IsSecretSantaStyle"
                        @onclick="SelectSecretSantaStyle">
                    <OpenWishIcon Name="stars" />
                    <span><strong>Secret Santa</strong><small>A familiar holiday name for a private name draw.</small></span>
                </button>
                <button type="button"
                        class="exchange-style-option @(!IsSecretSantaStyle ? "exchange-style-option-selected" : string.Empty)"
                        aria-pressed="@(!IsSecretSantaStyle)"
                        @onclick="SelectGiftExchangeStyle">
                    <OpenWishIcon Name="gift" />
                    <span><strong>Gift exchange</strong><small>Flexible for birthdays, teams, families, and any occasion.</small></span>
                </button>
            </div>
        </fieldset>
    }

    <div class="mb-4">
        <label for="name" class="form-label fw-bold">Event Name</label>
        <InputText id="name" class="form-control form-control-lg"
                   autofocus="@AutoFocusName"
                   placeholder="@EventNamePlaceholder" @bind-Value="@Model!.Name" />
        <ValidationMessage For="@(() => Model.Name)" class="text-danger" />
    </div>

    <div class="mb-4">
        <label for="description" class="form-label fw-bold">Note for your group <span class="text-muted fw-normal">(optional)</span></label>
        <InputTextArea id="description" class="form-control" rows="3" 
            placeholder="@DescriptionPlaceholder" @bind-Value="@Model!.Description" />
        <ValidationMessage For="@(() => Model.Description)" class="text-danger" />
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <label for="date" class="form-label fw-bold">@DateLabel</label>
            <InputDate id="date" class="form-control" @bind-Value="@Model!.Date" />
            <div class="form-text">@DateHelpText</div>
            <ValidationMessage For="@(() => Model.Date)" class="text-danger" />
        </div>
        <div class="col-md-6">
            <label for="budget" class="form-label fw-bold">@BudgetLabel <span class="text-muted fw-normal">(optional)</span></label>
            <InputNumber id="budget" class="form-control" placeholder="$0.00" @bind-Value="@Model!.Budget" />
            <ValidationMessage For="@(() => Model.Budget)" class="text-danger" />
        </div>
    </div>

    <div class="d-grid gap-2">
        <button type="submit" class="btn btn-primary btn-lg" disabled="@IsSubmitting">
            @if (IsSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span>@(_isEditMode ? "Saving changes..." : "Creating your event...")</span>
            }
            else if (_isEditMode)
            {
                <span>Save changes</span>
            }
            else if (Model!.IsGiftExchange)
            {
                <span>Create and invite people</span>
                <OpenWishIcon Name="arrow-right" Class="ms-2" />
            }
            else
            {
                <span>Create event</span>
            }
        </button>
    </div>
</EditForm>

@code {
    [Parameter] public EventModel? Model { get; set; }
    [Parameter] public EventCallback<EventModel> OnSubmit { get; set; }
    [Parameter] public bool ShowValidationSummary { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public bool LockEventType { get; set; }
    [Parameter] public bool AutoFocusName { get; set; }

    private bool _isEditMode => Model?.Id > 0;
    private bool IsSecretSantaStyle => string.Equals(Model?.GiftExchangeStyle, "SecretSanta", StringComparison.Ordinal);
    private string EventNamePlaceholder => IsSecretSantaStyle
        ? "e.g. Family Secret Santa 2026"
        : "e.g. Summer cabin gift swap";
    private string DescriptionPlaceholder => IsSecretSantaStyle
        ? "Gift guidelines, gathering details, or anything your group should know"
        : "What you are celebrating, gift guidelines, or anything your group should know";
    private string DateLabel => Model?.IsGiftExchange == true ? "Gift exchange date" : "Celebration date";
    private string DateHelpText => Model?.IsGiftExchange == true
        ? "When gifts will be exchanged. Shown in each participant's local time."
        : "Shown in each participant's local time.";
    private string BudgetLabel => Model?.IsGiftExchange == true ? "Suggested budget per gift" : "Suggested budget";

    private void SelectGiftExchange()
    {
        Model!.IsGiftExchange = true;
        Model.GiftExchangeStyle = "GiftExchange";
    }

    private void SelectCelebration() => Model!.IsGiftExchange = false;
    private void SelectSecretSantaStyle() => Model!.GiftExchangeStyle = "SecretSanta";
    private void SelectGiftExchangeStyle() => Model!.GiftExchangeStyle = "GiftExchange";

    private async Task HandleSubmit()
    {
        if (OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync(Model);
        }
    }
}
