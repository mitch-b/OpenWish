# Copy to .env.agent to customize the isolated agent-managed environment.
OPENWISH_AGENT_PORT=9090
OPENWISH_AGENT_DB_PORT=55433
OPENWISH_AGENT_DB_NAME=OpenWishAgent
OPENWISH_AGENT_DB_USER=openwish
OPENWISH_AGENT_DB_PASSWORD=openwish-agent-local

# Optional OpenTelemetry OTLP/HTTP receivers on the Docker host.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://host.docker.internal:4318/v1/metrics
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
