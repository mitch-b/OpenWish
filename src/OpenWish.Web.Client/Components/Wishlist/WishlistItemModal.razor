@using OpenWish.Web.Client.CustomEvents
@implements IAsyncDisposable

@inject IProductService ProductService
@inject IJSRuntime JSRuntime

@if (IsVisible)
{
    <div class="modal-backdrop" data-dialog-background-allowed @onclick="Cancel"></div>
    <div class="modal-dialog-container"
         id="wishlist-item-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="wishlist-item-dialog-title"
         @onclick:stopPropagation="true">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="wishlist-item-dialog-title" class="modal-title">@(Model?.Id > 0 ? "Edit item" : "Add item")</h5>
                <button type="button" class="btn-close" data-dialog-close @onclick="Cancel" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (isLoading)
                {
                    <div class="alert alert-info">
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm me-2" role="status">
                                <span class="visually-hidden">Loading item details...</span>
                            </div>
                            <span>Importing product details...</span>
                        </div>
                    </div>
                }
                
                @if (_showImportMessage && !string.IsNullOrEmpty(_importMessage))
                {
                    <div class="alert @(_importSuccess ? "alert-success" : "alert-danger") mt-2" role="alert">
                        @_importMessage
                    </div>
                }
                
                <div class="url-import-section mb-4">
                    <label for="product-url-import-modal" class="form-label">Product URL</label>
                    <div class="input-group">
                        <input id="product-url-import-modal"
                               class="form-control"
                               type="url"
                               inputmode="url"
                               autocomplete="url"
                               aria-describedby="product-url-import-modal-help"
                               data-dialog-initial-focus
                               placeholder="Paste a product URL"
                               value="@ImportUrl"
                               @oninput="UpdateImportUrl"
                               @onopenwishpaste="HandleUrlPaste" />
                        <button class="btn btn-primary"
                                type="button"
                                @onclick="ImportFromUrl"
                                disabled="@(isLoading || string.IsNullOrWhiteSpace(ImportUrl))">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            }
                            else
                            {
                                <OpenWishIcon Name="download" />
                            }
                            Import
                        </button>
                    </div>
                    <small id="product-url-import-modal-help" class="text-muted">Paste a product URL to fill in details, or enter them manually below.</small>
                </div>

                <EditForm Model="@Model" OnValidSubmit="@HandleSubmit" FormName="WishlistItemModal">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
                                <InputText id="name" class="form-control" @bind-Value="@Model!.Name" placeholder="e.g., Wireless Headphones" />
                                <ValidationMessage For="@(() => Model.Name)" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="priority" class="form-label">Priority</label>
                                <InputSelect id="priority" class="form-select" @bind-Value="@Model!.Priority">
                                    <option value="">None</option>
                                    <option value="1">High</option>
                                    <option value="2">Medium</option>
                                    <option value="3">Low</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <InputTextArea id="description" class="form-control" rows="3" @bind-Value="@Model!.Description" placeholder="Add any details, preferences, or specifications..." />
                        <ValidationMessage For="@(() => Model.Description)" />
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="price" class="form-label">Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <InputNumber id="price" class="form-control" @bind-Value="@Model!.Price" placeholder="0.00" />
                                </div>
                                <ValidationMessage For="@(() => Model.Price)" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="whereToBuy" class="form-label">Where to Buy</label>
                                <InputText id="whereToBuy" class="form-control" @bind-Value="@Model!.WhereToBuy" placeholder="e.g., Amazon, Target" />
                                <ValidationMessage For="@(() => Model.WhereToBuy)" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="url" class="form-label">Product Link</label>
                        <InputText id="url" class="form-control" type="url" inputmode="url" autocomplete="url" @bind-Value="@Model!.Url" placeholder="https://..." />
                        <ValidationMessage For="@(() => Model.Url)" />
                    </div>

                    <div class="mb-3 form-check">
                        <InputCheckbox id="isPrivate" class="form-check-input" @bind-Value="@Model!.IsPrivate" />
                        <label class="form-check-label" for="isPrivate">
                            Make this item private (only you can see it)
                        </label>
                        <ValidationMessage For="@(() => Model.IsPrivate)" />
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-dialog-close @onclick="Cancel">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <OpenWishIcon Name="check-lg" /> @(Model.Id > 0 ? "Save changes" : "Add item")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public WishlistItemModel? Model { get; set; } = new();
    [Parameter] public EventCallback<WishlistItemModel> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsVisible { get; set; }

    private bool isLoading;
    private string ImportUrl { get; set; } = string.Empty;
    private string _importMessage = string.Empty;
    private bool _showImportMessage;
    private bool _importSuccess;
    private bool _dialogActive;

    private void UpdateImportUrl(ChangeEventArgs eventArgs)
    {
        ImportUrl = eventArgs.Value?.ToString() ?? string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsVisible && !_dialogActive)
        {
            await JSRuntime.InvokeVoidAsync("openWishActivateDialog", "wishlist-item-dialog");
            _dialogActive = true;
        }
    }

    public void Show(WishlistItemModel? model = null)
    {
        Model = model ?? new WishlistItemModel();
        IsVisible = true;
        StateHasChanged();
    }

    private async Task HideAsync()
    {
        if (_dialogActive)
        {
            await JSRuntime.InvokeVoidAsync("openWishDeactivateDialog", "wishlist-item-dialog");
            _dialogActive = false;
        }

        IsVisible = false;
        ImportUrl = string.Empty;
        _showImportMessage = false;
        _importMessage = string.Empty;
        StateHasChanged();
    }

    private async Task ImportFromUrl()
    {
        if (string.IsNullOrWhiteSpace(ImportUrl))
            return;

        await ProcessUrlImport(ImportUrl);
    }

    private async Task HandleUrlPaste(OpenWishPasteEventArgs e)
    {
        ImportUrl = e.PastedData ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(ImportUrl))
        {
            await ProcessUrlImport(ImportUrl);
        }
    }

    private async Task ProcessUrlImport(string url)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var product = await ProductService.TryScrapeProductFromUrl(url);
            if (product != null)
            {
                // Only update empty fields
                if (string.IsNullOrWhiteSpace(Model!.Name) && !string.IsNullOrWhiteSpace(product.Name))
                    Model.Name = product.Name;

                if (string.IsNullOrWhiteSpace(Model.Description) && !string.IsNullOrWhiteSpace(product.Description))
                    Model.Description = product.Description;

                if (!Model.Price.HasValue && product.Price.HasValue)
                    Model.Price = product.Price;

                if (string.IsNullOrWhiteSpace(Model.Url))
                    Model.Url = url;

                if (string.IsNullOrWhiteSpace(Model.WhereToBuy))
                    Model.WhereToBuy = new Uri(url).Host.Replace("www.", "");

                // Set default priority if not set
                if (!Model.Priority.HasValue)
                    Model.Priority = 2; // Medium priority by default

                await JSRuntime.InvokeVoidAsync("console.log", "Product details imported successfully.");
                _importMessage = "Product details imported successfully!";
                _importSuccess = true;
                _showImportMessage = true;
            }
            else
            {
                _importMessage = "Could not extract product details. Please fill in the form manually.";
                _importSuccess = false;
                _showImportMessage = true;
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"Error scraping URL: {ex.Message}");
            _importMessage = "Error processing URL. Please fill in the form manually.";
            _importSuccess = false;
            _showImportMessage = true;
        }
        finally
        {
            // Clear the import URL field after processing
            ImportUrl = string.Empty;
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        if (OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync(Model);
        }

        await HideAsync();
    }

    private async Task Cancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }

        await HideAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (!_dialogActive)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("openWishDeactivateDialog", "wishlist-item-dialog");
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
