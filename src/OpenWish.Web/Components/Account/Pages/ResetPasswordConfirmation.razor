@page "/Account/ResetPasswordConfirmation"
<PageTitle>Password updated</PageTitle>

<div class="auth-page auth-page-compact">
    <header class="auth-heading">
        <span class="auth-mark auth-mark-success"><OpenWishIcon Name="check-circle" /></span>
        <div>
            <h1>Password updated</h1>
            <p>You're all set.</p>
        </div>
    </header>
    <section class="auth-card">
        <p class="auth-card-text" role="status">Your password has been reset. Sign in with your new password to get back to your wishlists and events.</p>
        <div class="auth-actions">
            <a class="btn btn-primary w-100" href="Account/Login">Sign in</a>
        </div>
    </section>
</div>
