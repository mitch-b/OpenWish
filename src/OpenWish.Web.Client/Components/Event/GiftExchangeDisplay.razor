@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IEventService EventService
@inject ILogger<GiftExchangeDisplay> Logger

<section class="gift-match" aria-labelledby="gift-match-title" aria-busy="@_loading">
    <h2 id="gift-match-title">Your gift exchange match</h2>

    @if (_loading)
    {
        <div class="gift-match-loading" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Loading your match...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger mb-0" role="alert">
            <p>@_errorMessage</p>
            <button type="button" class="btn btn-outline-danger" disabled="@_loading" @onclick="LoadGiftExchange">
                Try again
            </button>
        </div>
    }
    else if (_giftExchange == null)
    {
        <div class="alert alert-info mb-0" role="status">
            Your assignment isn't available yet. Ask the organizer to check the draw.
        </div>
    }
    else
    {
        <div class="gift-match-content">
            <div class="gift-match-introduction">
                <p class="gift-match-label">You're shopping for</p>
                <h3 class="gift-match-name">@RecipientDisplayName</h3>
            </div>

            <dl class="gift-match-facts">
                <div>
                    <dt>Suggested budget</dt>
                    <dd>@(_giftExchange.Budget?.ToString("C") ?? "Not set")</dd>
                </div>
                <div>
                    <dt>Exchange date</dt>
                    <dd>@ExchangeDate.ToString("ddd, MMM d, yyyy")</dd>
                </div>
            </dl>

            <div class="gift-match-next-step">
                @if (!WishlistsLoaded)
                {
                    <p role="status">Checking shared gift ideas...</p>
                    <a class="btn btn-outline-primary gift-match-action" href="#event-wishlists">See event wishlists</a>
                }
                else if (_recipientWishlist != null && RecipientItemCount > 0)
                {
                    <p>@($"{RecipientDisplayName} has {RecipientItemCount} gift {(RecipientItemCount == 1 ? "idea" : "ideas")} to explore.")</p>
                    <a href="/wishlists/@_recipientWishlist.PublicId" class="btn btn-primary gift-match-action">
                        <OpenWishIcon Name="list-check" />
                        <span>View @RecipientDisplayName's wishlist</span>
                    </a>
                    <p class="gift-match-guidance">Reserve an idea to avoid buying the same gift as someone else.</p>
                }
                else if (_recipientWishlist != null)
                {
                    <p>@($"{RecipientDisplayName} hasn't added gift ideas to their wishlist yet.")</p>
                    <a href="/wishlists/@_recipientWishlist.PublicId" class="btn btn-outline-primary gift-match-action">
                        View @RecipientDisplayName's wishlist
                    </a>
                }
                else
                {
                    <p>@($"{RecipientDisplayName} hasn't shared a wishlist for this exchange yet. Check back for gift ideas.")</p>
                }
            </div>

            <p class="gift-match-privacy">
                <OpenWishIcon Name="eye-slash" />
                <span>@($"Your match stays private. {RecipientDisplayName} won't see your reservations.")</span>
            </p>
        </div>
    }
</section>

@code {
    [Parameter] public string EventId { get; set; } = string.Empty;
    [Parameter] public string CurrentUserId { get; set; } = string.Empty;
    [Parameter] public DateTimeOffset ExchangeDate { get; set; }
    [Parameter] public bool WishlistsLoaded { get; set; }
    [Parameter] public ICollection<WishlistModel>? EventWishlists { get; set; }

    private GiftExchangeModel? _giftExchange;
    private WishlistModel? _recipientWishlist;
    private bool _loading = true;
    private string? _errorMessage;

    private string RecipientDisplayName => _giftExchange?.Receiver?.UserName
        ?? _giftExchange?.Receiver?.Email
        ?? _giftExchange?.ReceiverEmail
        ?? "your match";

    private int RecipientItemCount => _recipientWishlist is null ? 0 : GetItemCount(_recipientWishlist);

    private static int GetItemCount(WishlistModel wishlist) =>
        wishlist.ItemCount > 0 ? wishlist.ItemCount : wishlist.Items?.Count ?? 0;

    protected override async Task OnParametersSetAsync()
    {
        await LoadGiftExchange();
    }

    private async Task LoadGiftExchange()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _giftExchange = await EventService.GetMyGiftExchangeByPublicIdAsync(EventId, CurrentUserId);

            if (_giftExchange?.ReceiverId != null && EventWishlists != null)
            {
                _recipientWishlist = EventWishlists
                    .Where(wishlist => wishlist.OwnerId == _giftExchange.ReceiverId)
                    .OrderByDescending(GetItemCount)
                    .FirstOrDefault();
            }
            else
            {
                _recipientWishlist = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the gift exchange assignment for event {EventPublicId}", EventId);
            _giftExchange = null;
            _recipientWishlist = null;
            _errorMessage = "We couldn't load your gift exchange match. Try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
