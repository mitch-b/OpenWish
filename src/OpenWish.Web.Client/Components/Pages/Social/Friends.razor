@page "/friends"
@using OpenWish.Web.Client.Components.Social
@using OpenWish.Web.Client.Components.Shared
@attribute [Authorize]

@rendermode InteractiveAuto

<PageTitle>Friends</PageTitle>

<div class="container mt-4">
    <PageHeader Title="Friends"
                Description="Connect with friends and manage trusted sharing relationships." />

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">Find friends</h2>
                </div>
                <div class="card-body">
                    <FriendSearch />
                </div>
            </div>
            
            <div class="card mb-4">
                <div class="card-header">
                    <h2 class="h5 mb-0">Friend requests</h2>
                </div>
                <div class="card-body">
                    <FriendRequestList />
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="h5 mb-0">My friends</h2>
                </div>
                <div class="card-body">
                    <FriendList />
                </div>
            </div>
        </div>
    </div>
</div>

<OpenWish.Web.Client.Components.Diagnostics.SessionInformation />