@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>@(ShowWishlistTransfer ? "Wishlist import and export" : "Personal data")</PageTitle>

<StatusMessage />

@if (ShowWishlistTransfer)
{
        <h2>Wishlist import and export</h2>
        <section class="account-section" aria-labelledby="wishlist-export-heading">
            <h3 id="wishlist-export-heading">Export wishlists</h3>
            <p>
                Download every wishlist you own as a JSON file you can keep or import into another OpenWish.
                Reservations, comments, and ideas hidden from you as a surprise are never included.
            </p>
            <div class="account-actions">
                <a href="/api/portability/wishlists.json" class="btn btn-outline-primary" download data-testid="export-wishlists">
                    <OpenWishIcon Name="download" />
                    Download my wishlists
                </a>
            </div>
        </section>
        <section class="account-section" aria-labelledby="wishlist-import-heading">
            <h3 id="wishlist-import-heading">Import wishlists</h3>
            <form action="/api/portability/wishlists/import" method="post" enctype="multipart/form-data" class="account-form" data-testid="import-wishlists-form">
                <AntiforgeryToken />
                <label for="wishlist-import-file" class="form-label fw-semibold">Wishlist file</label>
                <input id="wishlist-import-file" name="file" type="file" accept=".json,application/json" required
                       class="form-control" aria-describedby="wishlist-import-hint" />
                <p id="wishlist-import-hint" class="form-text mb-3">
                    Choose a file downloaded from OpenWish. Lists are added as new, private lists, so nothing you have is replaced.
                </p>
                <div class="account-actions">
                    <button class="btn btn-outline-primary" type="submit">
                        Import
                    </button>
                </div>
            </form>
        </section>
}
else
{
        <h2>Personal data</h2>
        <section class="account-section" aria-labelledby="download-data-heading">
            <h3 id="download-data-heading">Download your data</h3>
            <p>Get a JSON copy of the personal data stored with your OpenWish account.</p>
            <form action="Account/Manage/DownloadPersonalData" method="post" class="account-actions">
                <AntiforgeryToken />
                <button class="btn btn-primary" type="submit">
                    <OpenWishIcon Name="download" />
                    Download personal data
                </button>
            </form>
        </section>
        <section class="account-section" aria-labelledby="delete-account-heading">
            <h3 id="delete-account-heading" class="text-danger-emphasis">Delete your account</h3>
            <p>Deleting your account permanently removes your personal data and cannot be undone.</p>
            <div class="account-actions">
                <a href="Account/Manage/DeletePersonalData" class="btn btn-outline-danger">
                    <OpenWishIcon Name="trash3" />
                    Review account deletion
                </a>
            </div>
        </section>
}

@code {
    [SupplyParameterFromQuery(Name = "section")] private string? Section { get; set; }
    private bool ShowWishlistTransfer => Section == "wishlists";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
