@page "/Account/Manage/GiftProfile"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using OpenWish.Data.Entities
@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject UserManager<ApplicationUser> UserManager
@inject IBirthdayService BirthdayService
@inject IGiftProfileService GiftProfileService
@inject IdentityRedirectManager RedirectManager

<PageTitle>@(ShowBirthday ? "Birthday" : "Gift hints")</PageTitle>

<h2>@(ShowBirthday ? "Birthday" : "Gift hints")</h2>
<StatusMessage Message="@_message" />

@if (Input is not null && Hints is not null)
{
    <div class="gift-profile-settings">
        @if (ShowBirthday)
        {
            <EditForm Model="Input" FormName="birthday" OnValidSubmit="SaveBirthdayAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <p id="birthday-help" class="gift-profile-lead">Share just the month and day, never the year. Friends get a reminder on their dashboard in the month before.</p>
                <div class="row g-2 mb-3">
                    <div class="col-8 form-floating">
                        <InputSelect @bind-Value="Input.Month" id="birthday-month" class="form-select" aria-describedby="birthday-help">
                            <option value="0">Not shared</option>
                            @for (var month = 1; month <= 12; month++)
                            {
                                <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                            }
                        </InputSelect>
                        <label for="birthday-month">Month</label>
                    </div>
                    <div class="col-4 form-floating">
                        <InputSelect @bind-Value="Input.Day" id="birthday-day" class="form-select" aria-describedby="birthday-help">
                            <option value="0">Not set</option>
                            @for (var day = 1; day <= 31; day++)
                            {
                                <option value="@day">@day</option>
                            }
                        </InputSelect>
                        <label for="birthday-day">Day</label>
                    </div>
                </div>
                <button type="submit" class="btn btn-lg btn-primary gift-profile-submit" id="save-birthday">Save birthday</button>
            </EditForm>
        }
        else
        {
            <EditForm Model="Hints" FormName="gift-hints" OnValidSubmit="SaveHintsAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />
                <p id="hints-help" class="gift-profile-lead">Optional. Friends see these on your wishlists when they shop for you. Leave a field blank to hide it; each can be up to @GiftProfileModel.MaxLength characters.</p>
                <div class="gift-hint-field">
                    <label for="gift-sizes" class="form-label">Sizes</label>
                    <InputTextArea @bind-Value="Hints.Sizes" id="gift-sizes" class="form-control" rows="3" maxlength="@GiftProfileModel.MaxLength" placeholder="e.g. Shirt M, shoe 10, ring 7" aria-describedby="gift-sizes-help hints-help" />
                    <p id="gift-sizes-help" class="form-text">Clothing, shoes, rings, anything that needs to fit.</p>
                    <ValidationMessage For="() => Hints.Sizes" class="text-danger" />
                </div>
                <div class="gift-hint-field">
                    <label for="gift-favorites" class="form-label">Favorites</label>
                    <InputTextArea @bind-Value="Hints.Favorites" id="gift-favorites" class="form-control" rows="3" maxlength="@GiftProfileModel.MaxLength" placeholder="e.g. Dark roast coffee, green, local bookshops" aria-describedby="gift-favorites-help hints-help" />
                    <p id="gift-favorites-help" class="form-text">Colors, brands, shops, or hobbies you love.</p>
                    <ValidationMessage For="() => Hints.Favorites" class="text-danger" />
                </div>
                <div class="gift-hint-field">
                    <label for="gift-avoid" class="form-label">Please avoid</label>
                    <InputTextArea @bind-Value="Hints.Avoid" id="gift-avoid" class="form-control" rows="3" maxlength="@GiftProfileModel.MaxLength" placeholder="e.g. Peanuts and scented candles" aria-describedby="gift-avoid-help hints-help" />
                    <p id="gift-avoid-help" class="form-text">Allergies, dislikes, or things you already have.</p>
                    <ValidationMessage For="() => Hints.Avoid" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-lg btn-primary gift-profile-submit" id="save-gift-hints">Save gift hints</button>
            </EditForm>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "section")] private string? Section { get; set; }
    private bool ShowBirthday => Section == "birthday";

    private string? _message;
    private ApplicationUser _user = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "birthday")]
    private BirthdayInput Input { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "gift-hints")]
    private GiftProfileModel Hints { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _user = await UserManager.GetUserAsync(HttpContext.User)
            ?? throw new InvalidOperationException("The signed-in user could not be loaded.");

        // Only the submitted form is bound on a POST; load the other from storage so it keeps its saved values.
        if (Input is null)
        {
            var birthday = await BirthdayService.GetBirthdayAsync(_user.Id);
            Input = new BirthdayInput { Month = birthday.Month ?? 0, Day = birthday.Day ?? 0 };
        }

        Hints ??= await GiftProfileService.GetMyProfileAsync(_user.Id);
    }

    private async Task SaveBirthdayAsync()
    {
        int? month = Input.Month == 0 ? null : Input.Month;
        int? day = Input.Day == 0 ? null : Input.Day;
        try
        {
            await BirthdayService.SetBirthdayAsync(_user.Id, month, day);
        }
        catch (ArgumentException ex)
        {
            _message = $"Error: {ex.Message}";
            return;
        }

        RedirectManager.RedirectToWithStatus("Account/Manage/GiftProfile?section=birthday",
            month is null ? "Your birthday is no longer shared." : "Your birthday has been saved.",
            HttpContext);
    }

    private async Task SaveHintsAsync()
    {
        try
        {
            await GiftProfileService.SetMyProfileAsync(_user.Id, Hints);
        }
        catch (ArgumentException ex)
        {
            _message = $"Error: {ex.Message}";
            return;
        }

        RedirectManager.RedirectToCurrentPageWithStatus("Your gift hints have been saved.", HttpContext);
    }

    private sealed class BirthdayInput
    {
        [Range(0, 12)]
        public int Month { get; set; }

        [Range(0, 31)]
        public int Day { get; set; }
    }
}
