@page "/events"
@attribute [Authorize]

@using OpenWish.Web.Client.Components.Event
@using OpenWish.Web.Client.Components.Shared
@using OpenWish.Shared.Services

@inject IEventService EventService
@inject IUserContextService UserContextService
@inject NavigationManager NavigationManager

@rendermode InteractiveAuto

<PageTitle>Events</PageTitle>

<div class="container page-shell">
    <PageHeader Title="Events"
                Description="Plan gift exchanges and special occasions with friends and family.">
        <Actions>
            <a href="/events/new" class="btn btn-light btn-lg">
                <OpenWishIcon Name="gift" Class="me-2" /> Start a Secret Santa
            </a>
        </Actions>
    </PageHeader>

    <PendingInvitations OnInvitationChanged="HandleInvitationChanged" />

    @if (_events == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading events...</span>
            </div>
        </div>
    }
    else if (!_events.Any())
    {
        <div class="empty-state text-center">
            <OpenWishIcon Name="calendar-event" Class="empty-state-icon" />
            <h2>No events yet</h2>
            <p class="lead">Invite your group and draw Secret Santa names in minutes.</p>
            <a href="/events/new" class="btn btn-primary btn-lg mt-3">
                Start your first Secret Santa
            </a>
        </div>
    }
    else
    {
        <div class="row g-3 event-grid">
            @foreach (var evt in _events)
            {
                <div class="col-md-6 col-lg-4">
                    <EventCard Event="@evt" OnDelete="@HandleEventDeleted" />
                </div>
            }
        </div>
    }
</div>


@code {
    private List<EventModel>? _events;
    
    protected override async Task OnInitializedAsync()
    {
        var userId = await UserContextService.GetUserIdAsync();
        if (userId is not null)
        {
            await LoadEvents(userId);
        }
    }

    private async Task LoadEvents(string userId)
    {
        _events = (await EventService.GetUserEventsAsync(userId)).ToList();
    }

    private async Task HandleEventDeleted(EventModel evt)
    {
        var userId = await UserContextService.GetUserIdAsync();
        if (userId is not null)
        {
            await LoadEvents(userId);
        }
    }

    private async Task HandleInvitationChanged()
    {
        var userId = await UserContextService.GetUserIdAsync();
        if (userId is not null)
        {
            await LoadEvents(userId);
        }
    }
}