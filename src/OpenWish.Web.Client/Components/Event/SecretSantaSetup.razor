@using OpenWish.Shared.Models

<div class="card border-0 shadow-sm mb-4 secret-santa-setup">
    <div class="card-body p-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
            <div>
                <span class="setup-kicker"><OpenWishIcon Name="check-circle" /> Organizer setup</span>
                <h2 class="h3 mb-1">Finish your Secret Santa setup</h2>
                <p class="text-muted mb-0">Follow these steps in order. Most groups are ready to draw in a few minutes.</p>
            </div>
            <div class="setup-progress">
                <strong>@CompletedStepCount of 5 ready</strong>
                <div class="progress mt-2" role="progressbar" aria-label="Secret Santa setup progress"
                     aria-valuenow="@ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar bg-success" style="width: @ProgressPercent%"></div>
                </div>
            </div>
        </div>

        <div class="setup-steps">
            <SetupStep Number="1"
                       Title="Event details"
                       Description="@($"{Event.Date:MMM d} · {BudgetText}")"
                       IsComplete="true"
                       ActionHref="@($"/events/{Event.PublicId}/manage")"
                       ActionLabel="Edit" />
            <SetupStep Number="2"
                       Title="Invite your group"
                       Description="@InvitationStatus"
                       IsComplete="@(AcceptedParticipantCount >= 2)"
                       ActionHref="#event-invitations"
                       ActionLabel="Invite people" />
            <SetupStep Number="3"
                       Title="Add your wishlist"
                       Description="@(OwnerHasWishlist ? "Your wishlist is attached." : "Give your match a few easy ideas.")"
                       IsComplete="@OwnerHasWishlist"
                       ActionHref="#event-wishlists"
                       ActionLabel="Add wishlist" />
            <SetupStep Number="4"
                       Title="Check everyone's readiness"
                       Description="@WishlistStatus"
                       IsComplete="@AllAcceptedParticipantsHaveWishlists"
                       ActionHref="#event-wishlists"
                       ActionLabel="Review lists" />
            <SetupStep Number="5"
                       Title="Draw names"
                       Description="@DrawStatus"
                       IsComplete="@Event.NamesDrawnOn.HasValue"
                       ActionHref="#gift-exchange"
                       ActionLabel="Go to draw" />
        </div>

        @if (PendingInvitationCount > 0)
        {
            <div class="alert alert-warning mt-4 mb-0" role="status">
                <OpenWishIcon Name="hourglass-split" Class="me-2" />
                <strong>@PendingInvitationCount invitation@(PendingInvitationCount == 1 ? " is" : "s are") still pending.</strong>
                You can draw now when at least two people have accepted; pending invitees will be left out.
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public EventModel Event { get; set; } = default!;

    [Parameter, EditorRequired]
    public string CurrentUserId { get; set; } = string.Empty;

    private IEnumerable<EventUserModel> AcceptedParticipants =>
        Event.EventUsers.Where(IsAccepted);

    private IEnumerable<string> AcceptedParticipantKeys
    {
        get
        {
            yield return $"user:{CurrentUserId}";

            foreach (var participant in AcceptedParticipants)
            {
                if (!string.IsNullOrWhiteSpace(participant.UserId))
                {
                    yield return $"user:{participant.UserId}";
                }
                else if (!string.IsNullOrWhiteSpace(participant.InviteeEmail))
                {
                    yield return $"email:{participant.InviteeEmail.Trim().ToUpperInvariant()}";
                }
            }
        }
    }

    private HashSet<string> AcceptedParticipantIds =>
        AcceptedParticipants
            .Select(participant => participant.UserId)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Append(CurrentUserId)
            .ToHashSet(StringComparer.Ordinal);

    private int AcceptedParticipantCount =>
        AcceptedParticipantKeys.Distinct(StringComparer.Ordinal).Count();

    private int PendingInvitationCount =>
        Event.EventUsers.Count(participant =>
            !participant.Deleted &&
            string.Equals(participant.Status, "Pending", StringComparison.OrdinalIgnoreCase));

    private bool OwnerHasWishlist =>
        Event.EventWishlists.Any(wishlist =>
            string.Equals(wishlist.OwnerId, CurrentUserId, StringComparison.Ordinal) &&
            GetItemCount(wishlist) > 0);

    private bool AllAcceptedParticipantsHaveWishlists
    {
        get
        {
            var participantIds = AcceptedParticipantIds;

            return participantIds.Count > 0 &&
                   participantIds.All(id => Event.EventWishlists.Any(wishlist =>
                       string.Equals(wishlist.OwnerId, id, StringComparison.Ordinal) &&
                       GetItemCount(wishlist) > 0));
        }
    }

    private int ParticipantsWithWishlists =>
        Event.EventWishlists
            .Where(wishlist =>
                !string.IsNullOrWhiteSpace(wishlist.OwnerId) &&
                AcceptedParticipantIds.Contains(wishlist.OwnerId) &&
                GetItemCount(wishlist) > 0)
            .Select(wishlist => wishlist.OwnerId)
            .Distinct(StringComparer.Ordinal)
            .Count();

    private int CompletedStepCount =>
        1 +
        (AcceptedParticipantCount >= 2 ? 1 : 0) +
        (OwnerHasWishlist ? 1 : 0) +
        (AllAcceptedParticipantsHaveWishlists ? 1 : 0) +
        (Event.NamesDrawnOn.HasValue ? 1 : 0);

    private int ProgressPercent => CompletedStepCount * 20;

    private string BudgetText => Event.Budget.HasValue
        ? $"{Event.Budget.Value:C} per gift"
        : "No budget set";

    private string InvitationStatus => AcceptedParticipantCount == 1
        ? "Invite at least one other person."
        : $"{AcceptedParticipantCount} people accepted" +
          (PendingInvitationCount > 0 ? $" · {PendingInvitationCount} waiting" : string.Empty);

    private string WishlistStatus =>
        $"{ParticipantsWithWishlists} of {AcceptedParticipantCount} accepted participants have gift ideas.";

    private string DrawStatus => Event.NamesDrawnOn.HasValue
        ? "Assignments are ready."
        : AcceptedParticipantCount >= 2
            ? $"{AcceptedParticipantCount} accepted participants are eligible."
            : "Waiting for one more person to accept.";

    private static bool IsAccepted(EventUserModel participant) =>
        !participant.Deleted &&
        participant.IsAccepted &&
        string.Equals(participant.Status, "Accepted", StringComparison.OrdinalIgnoreCase);

    private static int GetItemCount(WishlistModel wishlist) =>
        wishlist.ItemCount > 0 ? wishlist.ItemCount : wishlist.Items?.Count ?? 0;
}
