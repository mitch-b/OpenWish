@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IEventService EventService

@if (_loading)
{
    <div class="text-center py-3">
        <div class="spinner-border spinner-border-sm" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (_giftExchange != null)
{
    <div class="card gift-match-card mb-4">
        <div class="card-header gift-match-header">
            <h3 class="mb-0"><OpenWishIcon Name="gift" Class="me-2" />Your Secret Santa match</h3>
        </div>
        <div class="card-body">
            <div class="recipient-reveal" role="status">
                <h4 class="alert-heading">You're shopping for</h4>
                <h2>@RecipientDisplayName</h2>
            </div>

            @if (_recipientWishlist != null)
            {
                <div class="mt-4">
                    <p class="mb-2"><strong>Their gift ideas are ready.</strong></p>
                    <a href="/wishlists/@_recipientWishlist.PublicId" class="btn btn-primary btn-lg w-100">
                        <OpenWishIcon Name="list-check" Class="me-2" />View @RecipientDisplayName's wishlist
                    </a>
                    <p class="small text-muted mt-2 mb-0">
                        Reserve an item on the wishlist so other shoppers avoid buying the same gift.
                        @RecipientDisplayName won't see your reservation.
                    </p>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-4">
                    <OpenWishIcon Name="info-circle" Class="me-1" />
                    @RecipientDisplayName hasn't attached a wishlist yet. Check back after they add gift ideas.
                </div>
            }

            @if (_giftExchange.Budget.HasValue)
            {
                <div class="mt-3 text-muted">
                    <OpenWishIcon Name="cash" Class="me-1" /> Suggested budget: <strong>@_giftExchange.Budget.Value.ToString("C")</strong>
                </div>
            }

            <div class="small text-muted mt-3">
                <OpenWishIcon Name="eye-slash" Class="me-1" />
                Your match is private. Only you can see who you're shopping for.
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string EventId { get; set; } = string.Empty;
    [Parameter] public string CurrentUserId { get; set; } = string.Empty;
    [Parameter] public ICollection<WishlistModel>? EventWishlists { get; set; }

    private GiftExchangeModel? _giftExchange;
    private WishlistModel? _recipientWishlist;
    private bool _loading = true;

    private string RecipientDisplayName => _giftExchange?.Receiver?.UserName
        ?? _giftExchange?.Receiver?.Email
        ?? _giftExchange?.ReceiverEmail
        ?? "your match";

    protected override async Task OnParametersSetAsync()
    {
        await LoadGiftExchange();
    }

    private async Task LoadGiftExchange()
    {
        _loading = true;
        try
        {
            _giftExchange = await EventService.GetMyGiftExchangeByPublicIdAsync(EventId, CurrentUserId);

            if (_giftExchange?.ReceiverId != null && EventWishlists != null)
            {
                _recipientWishlist = EventWishlists
                    .FirstOrDefault(w => w.OwnerId == _giftExchange.ReceiverId);
            }
            else
            {
                _recipientWishlist = null;
            }
        }
        catch (Exception)
        {
            // No gift exchange found, which is fine
            _giftExchange = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
