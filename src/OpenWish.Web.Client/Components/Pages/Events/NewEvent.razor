@page "/events/new"
@attribute [Authorize]

@using OpenWish.Web.Client.Components.Event
@using OpenWish.Shared.Services

@inject IEventService EventService
@inject NavigationManager NavigationManager
@inject IUserContextService UserContextService
@inject ILogger<NewEvent> Logger

@rendermode InteractiveAuto

<PageTitle>Create a Secret Santa</PageTitle>

<div class="event-header">
    <div class="container">
        <span class="badge bg-light text-dark mb-2">Step 1 of 3</span>
        <h1 class="mb-1">Create a Secret Santa</h1>
        <p class="lead mb-0">Set the basics now. You'll invite everyone on the next screen.</p>
    </div>
</div>

<div class="container py-4">
  <div class="row g-4">
    <div class="col-md-8">
        <div class="event-content view-transition">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger" role="alert">@_errorMessage</div>
            }
            <EventForm Model="@_event" OnSubmit="@HandleSubmit" IsSubmitting="@_isSubmitting" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="add-item-section">
            <h2 class="h4">What happens next?</h2>
            <ol class="ps-3 mb-4">
                <li class="mb-2">Invite everyone by email or from your friends.</li>
                <li class="mb-2">Let people add a few gift ideas.</li>
                <li>Draw names when your group is ready.</li>
            </ol>
            <button class="btn btn-link" @onclick="@(() => NavigationManager.NavigateTo("/events"))">
                <i class="bi bi-arrow-left"></i> Back to events
            </button>
        </div>
    </div>
  </div>
</div>

<OpenWish.Web.Client.Components.Diagnostics.SessionInformation />

@code {
    private readonly EventModel _event = new()
    {
        Date = GetSuggestedDate(),
        Budget = 50m,
        IsGiftExchange = true,
        EventUsers = []
    };
    private bool _isSubmitting;
    private string? _errorMessage;

    private async Task HandleSubmit(EventModel submittedEvent)
    {
        try
        {
            _isSubmitting = true;
            _errorMessage = null;
            var userId = await UserContextService.GetUserIdAsync();
            if (userId is not null)
            {
                var createdEvent = await EventService.CreateEventAsync(submittedEvent, userId);
                var setupFragment = submittedEvent.IsGiftExchange ? "#secret-santa-setup" : string.Empty;
                NavigationManager.NavigateTo($"/events/{createdEvent.PublicId}{setupFragment}");
            }
            else
            {
                Logger.LogError("Could not determine UserId when creating event");
                _errorMessage = "We couldn't confirm your account. Please sign in again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create event");
            _errorMessage = "We couldn't create the event. Please review the details and try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private static DateTimeOffset GetSuggestedDate()
    {
        var now = DateTimeOffset.Now;
        var holiday = new DateTimeOffset(now.Year, 12, 25, 18, 0, 0, now.Offset);
        return holiday > now.AddDays(7) ? holiday : now.AddDays(30);
    }
}