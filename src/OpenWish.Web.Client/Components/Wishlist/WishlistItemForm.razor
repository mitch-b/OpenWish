@using OpenWish.Shared.Products

<FocusOnFirstRender ElementId="product-url-import" Enabled="@(AutoFocusImport && string.IsNullOrWhiteSpace(InitialImportLink))" />
<div class="url-import-section mb-3">
    <h2 class="h5">Have a product link?</h2>
    <p class="text-muted mb-2">Optional shortcut: paste a link from any store and we'll fill in the details we can find. You can also enter an idea below.</p>
    <ProductLinkImporter Model="@Model"
                         InputId="product-url-import"
                         HelpText="Links and text shared from shopping apps both work. Existing details won't be replaced."
                         Disabled="@IsSubmitting"
                         @bind-IsImporting="_isImporting"
                         InitialLink="@InitialImportLink" />
</div>

<EditForm @ref="_form" Model="@Model" OnValidSubmit="@HandleSubmit" OnInvalidSubmit="@RevealFirstProblem" FormName="WishlistItemForm" aria-busy="@(IsBusy ? "true" : "false")">
    <DataAnnotationsValidator />
    <IdeaFieldsValidator />

    <div class="item-fields">
        <div class="item-field-wide">
            <label for="name" class="form-label">Name</label>
            <InputText @ref="_nameInput" id="name" class="form-control" @bind-Value="@Model!.Name" autocomplete="off"
                       aria-describedby="item-name-help" placeholder="e.g., A travel mug" />
            <ValidationMessage For="@(() => Model.Name)" role="alert" />
            <div id="item-name-help" class="form-text">A name is enough to save an idea. Add other details whenever you like.</div>
            <DuplicateIdeaNotice Model="@Model" ExistingItems="@ExistingItems" />
        </div>

        <div class="item-field-wide">
            <label for="description" class="form-label">Description</label>
            <InputTextArea id="description" class="form-control" rows="3" @bind-Value="@Model!.Description"
                           placeholder="Color, size, or anything that would help a gift giver" />
            <ValidationMessage For="@(() => Model.Description)" />
        </div>

        <div>
            <label for="url" class="form-label">Product link</label>
            <InputText id="url" class="form-control" type="url" inputmode="url" autocomplete="url" @bind-Value="@Model!.Url"
                       placeholder="https://" @onblur="SuggestStore" />
            <ValidationMessage For="@(() => Model.Url)" />
        </div>

        <div>
            <label for="whereToBuy" class="form-label">Where to buy</label>
            <InputText id="whereToBuy" class="form-control" @bind-Value="@Model!.WhereToBuy" placeholder="e.g., Target or a local shop" />
            <ValidationMessage For="@(() => Model.WhereToBuy)" />
        </div>

        <div>
            <label for="price" class="form-label">Estimated price</label>
            <div class="input-group price-input">
                <span class="input-group-text" aria-hidden="true">$</span>
                <InputNumber @ref="_priceInput" id="price" class="form-control" inputmode="decimal" min="0" step="0.01" placeholder="0.00"
                             DisplayName="Estimated price" @bind-Value="@Model!.Price" />
            </div>
            <ValidationMessage For="@(() => Model.Price)" role="alert" />
        </div>

        <div>
            <label for="priority" class="form-label">Priority</label>
            <InputSelect id="priority" class="form-select" @bind-Value="@Model!.Priority">
                <option value="">No priority</option>
                <option value="1">High</option>
                <option value="2">Medium</option>
                <option value="3">Low</option>
            </InputSelect>
        </div>

        <div class="item-field-wide form-check private-option">
            <InputCheckbox id="isPrivate" class="form-check-input" @bind-Value="@Model!.IsPrivate" aria-describedby="item-private-help" />
            <label class="form-check-label" for="isPrivate">Keep this idea private</label>
            <div id="item-private-help" class="form-text">Only you can see private ideas, even on a shared wishlist.</div>
            <ValidationMessage For="@(() => Model.IsPrivate)" />
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@(IsBusy || !RendererInfo.IsInteractive)">
            @if (IsSubmitting)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span>@(Model.Id > 0 ? "Saving changes..." : "Adding item...")</span>
            }
            else
            {
                <span>@(Model.Id > 0 ? "Save changes" : "Add item")</span>
            }
        </button>
        @if (OnSubmitAndAddAnother.HasDelegate)
        {
            <button type="button" class="btn btn-outline-primary" data-testid="add-another-item" disabled="@(IsBusy || !RendererInfo.IsInteractive)" @onclick="HandleAddAnother">
                <OpenWishIcon Name="plus-lg" />
                <span>Add and add another</span>
            </button>
        }
        @if (OnCancel.HasDelegate)
        {
            <button type="button" class="btn btn-outline-secondary" disabled="@(IsSubmitting || !RendererInfo.IsInteractive)" @onclick="HandleCancel">Cancel</button>
        }
    </div>
</EditForm>

@code {
    [Parameter] public WishlistItemModel Model { get; set; } = new();
    [Parameter] public EventCallback<WishlistItemModel> OnSubmit { get; set; }
    [Parameter] public EventCallback<WishlistItemModel> OnSubmitAndAddAnother { get; set; }
    [Parameter] public EventCallback<WishlistItemModel> OnCancel { get; set; }
    [Parameter] public bool AutoFocusImport { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public IEnumerable<WishlistItemModel>? ExistingItems { get; set; }

    /// <summary>A product link, or text containing one, to import once the form is interactive.</summary>
    [Parameter] public string? InitialImportLink { get; set; }

    private EditForm? _form;
    private InputText? _nameInput;
    private InputNumber<decimal?>? _priceInput;
    private bool _isImporting;
    private bool IsBusy => IsSubmitting || _isImporting;

    private void SuggestStore() => ItemCaptureHints.SuggestStore(Model);

    private async Task HandleSubmit()
    {
        if (IsBusy)
        {
            return;
        }

        if (OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync(Model);
        }
    }

    private async Task HandleAddAnother()
    {
        if (IsBusy || _form?.EditContext is not { } editContext)
        {
            return;
        }

        if (!editContext.Validate())
        {
            await RevealFirstProblem(editContext);
            return;
        }

        await OnSubmitAndAddAnother.InvokeAsync(Model);
    }

    // Move to the first field that needs attention, scrolling it into view on a small screen.
    private async Task RevealFirstProblem(EditContext editContext)
    {
        var field = editContext.GetValidationMessages(editContext.Field(nameof(WishlistItemModel.Name))).Any()
            ? _nameInput?.Element
            : _priceInput?.Element;
        if (field is { } element)
        {
            await element.FocusAsync(preventScroll: false);
        }
    }

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
}