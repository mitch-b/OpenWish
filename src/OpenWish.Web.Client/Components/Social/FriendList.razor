@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IFriendService FriendService
@inject ICircleService CircleService
@inject IUserContextService UserContextService
@inject ILogger<FriendList> Logger

<div class="friend-list" aria-busy="@(_loading ? "true" : "false")">
    <div class="social-heading">
        <span class="social-heading-icon"><OpenWishIcon Name="people" /></span>
        <div>
            <h2 @ref="_heading" tabindex="-1">My friends@(_friends.Count > 0 ? $" ({_friends.Count})" : "")</h2>
            <p>People who can share wishlists with you.</p>
        </div>
    </div>

    @if (_statusMessage is not null)
    {
        <div class="alert alert-success" role="status" aria-live="polite">
            @_statusMessage
        </div>
    }

    @if (_loading)
    {
        <p class="loading-note" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Loading friends...
        </p>
    }
    else if (_errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">
            <p class="mb-2">@_errorMessage</p>
            <button class="btn btn-outline-danger btn-sm" type="button" disabled="@(!RendererInfo.IsInteractive)" @onclick="RetryLoadFriends">
                Try again
            </button>
        </div>
    }
    else if (!_friends.Any())
    {
        <div class="friend-empty" data-testid="friends-empty">
            <p class="friend-empty-title">No friends yet</p>
            <p class="friend-empty-copy">Invite someone by email, or show your code to a person next to you. Once you're connected, they'll appear here with a link to their lists.</p>
            <div class="friend-empty-actions">
                <a class="btn btn-primary" href="/friends?section=invite">
                    <OpenWishIcon Name="person-plus" /> Invite friends
                </a>
                <a class="btn btn-outline-secondary" href="/friends?section=in-person">
                    <OpenWishIcon Name="link-45deg" /> Connect in person
                </a>
            </div>
        </div>
    }
    else
    {
        @if (_circles.Count > 0)
        {
            <div class="circle-filter" role="group" aria-label="Filter friends by circle">
                <button type="button" class="btn btn-sm @(_circleFilter is null ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(_circleFilter is null ? "true" : "false")"
                        disabled="@(!RendererInfo.IsInteractive)"
                        @onclick="() => _circleFilter = null">All friends</button>
                @foreach (var circle in _circles)
                {
                    var selected = _circleFilter == circle.PublicId;
                    <button type="button" class="btn btn-sm @(selected ? "btn-primary" : "btn-outline-secondary")"
                            aria-pressed="@(selected ? "true" : "false")"
                            disabled="@(!RendererInfo.IsInteractive)"
                            @onclick="() => _circleFilter = circle.PublicId">@circle.Name (@circle.Members.Count)</button>
                }
            </div>
            @if (_circles.FirstOrDefault(circle => circle.PublicId == _circleFilter) is { Members.Count: > 0 } activeCircle)
            {
                <p class="circle-filter-lists" data-testid="circle-filter-lists">
                    <a href="/wishlists?tab=friends&circle=@Uri.EscapeDataString(activeCircle.PublicId)">View lists from @activeCircle.Name</a>
                </p>
            }
        }

        @if (VisibleFriends.Count == 0)
        {
            <p class="friend-filter-empty" role="status">
                No friends in this circle yet. <a href="/friends?section=circles">Add some from Circles</a>.
            </p>
        }
        else
        {
            <ul class="list-group friend-rows">
                @foreach (var friend in VisibleFriends)
                {
                    <li class="list-group-item friend-row">
                        <div class="friend-identity">
                            <span class="friend-avatar" aria-hidden="true">@GetInitial(friend)</span>
                            <div class="friend-name">
                                <strong>@GetFriendName(friend)</strong>
                                @foreach (var circleName in CircleNamesFor(friend))
                                {
                                    <span class="badge circle-badge">@circleName</span>
                                }
                            </div>
                        </div>
                        <div class="friend-actions">
                            <a class="btn btn-outline-primary btn-sm friend-lists-link"
                               href="@GetListsHref(friend)"
                               aria-label="View wishlists shared by @GetFriendName(friend)">
                                <OpenWishIcon Name="list-ul" /> View lists
                            </a>
                            <button class="btn btn-outline-danger btn-sm friend-remove"
                                    type="button"
                                    title="Remove from friends"
                                    aria-label="Remove @GetFriendName(friend) from friends"
                                    disabled="@(!RendererInfo.IsInteractive)"
                                    @onclick="() => ShowRemoveConfirmation(friend)">
                                <OpenWishIcon Name="person-dash" /> <span class="friend-action-label">Remove</span>
                            </button>
                        </div>
                    </li>
                }
            </ul>
        }
    }
</div>

<FriendRemoveConfirmationDialog @ref="_removeConfirmationDialog" OnConfirm="ConfirmRemoveFriend" OnClosed="HandleRemoveDialogClosed" />

@code {
    private List<ApplicationUserModel> _friends = [];
    private List<CircleModel> _circles = [];
    private string? _circleFilter;
    private bool _loading = true;
    private string? _currentUserId;
    private string? _errorMessage;
    private string? _statusMessage;
    private FriendRemoveConfirmationDialog? _removeConfirmationDialog;
    private ElementReference _heading;
    private bool _focusHeadingOnClose;

    [Parameter]
    public EventCallback OnFriendRemoved { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        await LoadFriends();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _errorMessage is not null && _currentUserId == null)
        {
            // If we had an error during SSR and no user ID, try again after first render
            await LoadFriends();
        }
    }

    public Task ReloadAsync() => LoadFriends(silent: true);

    private Task RetryLoadFriends() => LoadFriends();

    private async Task LoadFriends(bool silent = false)
    {
        try
        {
            _loading = !silent;
            _errorMessage = null;
            _currentUserId ??= await UserContextService.GetUserIdAsync();
            
            if (_currentUserId != null)
            {
                var friends = await FriendService.GetFriendsAsync(_currentUserId);
                _friends = FriendWishlistFilter.OrderFriends(friends).ToList();
                await LoadCirclesAsync();
            }
            else
            {
                _errorMessage = "Sign in again to load your friends.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load friends.");
            _errorMessage = "Your friends could not be loaded. Try again.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
    
    // Circles only decorate the list, so a failure here must not hide the friends themselves.
    private async Task LoadCirclesAsync()
    {
        try
        {
            _circles = (await CircleService.GetCirclesAsync(_currentUserId!)).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load circles for the friend list.");
            _circles = [];
        }

        if (_circleFilter is not null && _circles.All(circle => circle.PublicId != _circleFilter))
        {
            _circleFilter = null;
        }
    }

    private List<ApplicationUserModel> VisibleFriends =>
        _circleFilter is null
            ? _friends
            : _friends.Where(friend => _circles
                .Any(circle => circle.PublicId == _circleFilter && circle.Members.Any(member => member.UserId == friend.Id))).ToList();

    private IEnumerable<string> CircleNamesFor(ApplicationUserModel friend) =>
        _circles.Where(circle => circle.Members.Any(member => member.UserId == friend.Id)).Select(circle => circle.Name);

    private void ShowRemoveConfirmation(ApplicationUserModel friend)
    {
        var friendName = GetFriendName(friend);
        var title = $"Remove {friendName}?";
        var message = $"Remove {friendName} from your friends? You will no longer see each other's friends-only wishlists. Wishlists shared directly may remain available.";
        _removeConfirmationDialog?.Show(title, message, friend.Id);
    }
    
    private async Task ConfirmRemoveFriend(string friendId)
    {
        try
        {
            _errorMessage = null;
            _statusMessage = null;
            _currentUserId ??= await UserContextService.GetUserIdAsync();
            
            if (_currentUserId != null)
            {
                var friend = _friends.FirstOrDefault(candidate => candidate.Id == friendId);
                var friendName = friend is null ? "Friend" : GetFriendName(friend);
                if (await FriendService.RemoveFriendAsync(_currentUserId, friendId))
                {
                    _focusHeadingOnClose = true;
                    _statusMessage = $"{friendName} removed from your friends.";
                    await LoadFriends(silent: true);
                    await OnFriendRemoved.InvokeAsync();
                }
                else
                {
                    _errorMessage = $"{friendName} could not be removed. Refresh and try again.";
                }
            }
            else
            {
                _errorMessage = "Sign in again to remove this friend.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove friend {FriendId}.", friendId);
            _errorMessage = "This friend could not be removed. Try again.";
            StateHasChanged();
        }
    }

    // The removed row's button no longer exists, so keep focus in the list rather than at the page top.
    private async Task HandleRemoveDialogClosed()
    {
        if (!_focusHeadingOnClose)
        {
            return;
        }

        _focusHeadingOnClose = false;
        try
        {
            await _heading.FocusAsync(preventScroll: true);
        }
        catch (JSException)
        {
        }
    }

    private static string GetInitial(ApplicationUserModel friend) =>
        GetFriendName(friend).Trim() is { Length: > 0 } name ? name[..1].ToUpperInvariant() : "?";

    private static string GetListsHref(ApplicationUserModel friend) =>
        $"/wishlists?tab=friends&owner={Uri.EscapeDataString(friend.UserName ?? string.Empty)}";

    private static string GetFriendName(ApplicationUserModel friend) =>
        friend.UserName ?? friend.Email ?? "this person";
}