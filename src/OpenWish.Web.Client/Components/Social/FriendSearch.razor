@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IFriendService FriendService
@inject IUserContextService UserContextService
@inject ILogger<FriendSearch> Logger

<div class="friend-search" aria-busy="@(_sendingInvites ? "true" : "false")">
    <div class="social-heading">
        <span class="social-heading-icon"><OpenWishIcon Name="person-plus" /></span>
        <div>
            <h2>Invite friends</h2>
            <p>Add people by email. Anyone already on OpenWish gets a friend request right away; everyone else gets an invitation to join.</p>
        </div>
    </div>
    
    <div class="invite-form">
        <div class="form-group mb-3">
            <label for="emailInvites" class="form-label">Email addresses</label>
            <textarea id="emailInvites" class="form-control" rows="3" 
                      placeholder="friend@example.com, another@example.com"
                      autocomplete="off"
                      inputmode="email"
                      spellcheck="false"
                      aria-describedby="emailInvitesHelp"
                      aria-invalid="@(_error ? "true" : "false")"
                      value="@inviteEmails"
                      @oninput="UpdateInviteEmails"
                      @onkeydown="HandleInviteKeyDown"></textarea>
            <div class="form-text" id="emailInvitesHelp">
                Paste one or several, separated by commas, spaces, or new lines.<span class="invite-shortcut-hint"> Press Ctrl+Enter to send.</span>
            </div>
        </div>
        
        <button class="btn btn-primary invite-send" type="button" @onclick="SendEmailInvites"
                disabled="@(!RendererInfo.IsInteractive || _sendingInvites || string.IsNullOrWhiteSpace(inviteEmails))">
            @if (_sendingInvites)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Sending invitations...</span>
            }
            else
            {
                <OpenWishIcon Name="send" />
                <span>Send invitations</span>
            }
        </button>
    </div>
    
    @if (_error)
    {
        <div class="alert alert-danger mt-3" role="alert">
            @_errorMessage
        </div>
    }
    
    @if (_success)
    {
        <div class="alert alert-success mt-3" role="status" aria-live="polite">
            @_successMessage
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnInvitesSent { get; set; }

    // Invite by email variables
    private string inviteEmails = "";
    private bool _sendingInvites = false;
    
    // Shared feedback variables
    private bool _error = false;
    private bool _success = false;
    private string _errorMessage = "An error occurred. Please try again.";
    private string _successMessage = "";
    private string? _currentUserId;

    private void UpdateInviteEmails(ChangeEventArgs eventArgs)
    {
        inviteEmails = eventArgs.Value?.ToString() ?? string.Empty;
        _error = false;
        _success = false;
    }
    
    private async Task HandleInviteKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey))
        {
            await SendEmailInvites();
        }
    }

    private async Task SendEmailInvites()
    {
        if (_sendingInvites)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(inviteEmails))
        {
            _error = true;
            _success = false;
            _errorMessage = "Please enter at least one email address.";
            return;
        }
        
        try
        {
            _sendingInvites = true;
            _error = false;
            _success = false;
            _currentUserId ??= await UserContextService.GetUserIdAsync();
            
            if (_currentUserId != null)
            {
                var parsed = FriendInviteInput.Parse(inviteEmails);
                var emails = parsed.Valid;

                if (parsed.Invalid.Count > 0)
                {
                    _error = true;
                    _errorMessage = parsed.Invalid.Count == 1
                        ? $"\"{parsed.Invalid[0]}\" is not a valid email address. Fix it or remove it, then send again."
                        : $"These are not valid email addresses: {string.Join(", ", parsed.Invalid)}. Fix or remove them, then send again.";
                    return;
                }

                if (emails.Count == 0)
                {
                    _error = true;
                    _errorMessage = "Please enter at least one valid email address.";
                    return;
                }
                
                bool result = await FriendService.SendFriendInvitesByEmailAsync(_currentUserId, emails);
                // Recipients are saved one by one, so a partial batch still changes Sent requests.
                await OnInvitesSent.InvokeAsync();
                
                if (result)
                {
                    _success = true;
                    _successMessage = emails.Count == 1 
                        ? "Invitation sent. Follow its status under Sent requests."
                        : $"Invitations sent to {emails.Count} email addresses. Follow them under Sent requests.";
                    inviteEmails = ""; // Clear the input field

                }
                else
                {
                    _error = true;
                    _errorMessage = "Some invitations could not be sent. Please check the email addresses and try again.";
                }
            }
            else
            {
                _error = true;
                _errorMessage = "Sign in again to send friend invitations.";
            }
        }
        catch (ArgumentException ex)
        {
            _error = true;
            _errorMessage = ex.Message;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning(ex, "Friend invitation session expired.");
            _currentUserId = null;
            _error = true;
            _errorMessage = "Sign in again to send friend invitations.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to send friend invitations.");
            _error = true;
            _errorMessage = "An error occurred while sending invitations. Please try again.";
        }
        finally
        {
            _sendingInvites = false;
            StateHasChanged();
        }
    }
}