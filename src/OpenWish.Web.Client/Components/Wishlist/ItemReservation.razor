@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IWishlistService WishlistService
@inject IUserContextService UserContextService

<div class="item-reservation" aria-busy="@(_loading || _isUpdating)">
    @if (_loading)
    {
        <div class="spinner-border spinner-border-sm" role="status">
            <span class="visually-hidden">Loading reservation...</span>
        </div>
    }
    else
    {
        @if (_isReserved)
        {
            <div class="alert alert-success mb-2">
                @if (_myReservation)
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>You have reserved this item.</strong>
                            <div class="small mt-1">Reserved on @_reservation.ReservationDate.ToLocalTime().ToString("MM/dd/yyyy")</div>
                        </div>
                        <button class="btn btn-sm btn-outline-danger"
                                @ref="_cancelReservationButton"
                                type="button"
                                disabled="@_isUpdating"
                                @onclick="ShowCancelConfirmation">
                            <OpenWishIcon Name="x-circle" /> Cancel reservation
                        </button>
                    </div>
                }
                else
                {
                    <div>
                        @if (_reservation.IsAnonymous)
                        {
                            <strong>This item has been reserved</strong>
                        }
                        else
                        {
                            <strong>Reserved by @(_reservation.User?.UserName ?? "Unknown User")</strong>
                        }
                        <div class="small mt-1">Reserved on @_reservation.ReservationDate.ToLocalTime().ToString("MM/dd/yyyy")</div>
                    </div>
                }
            </div>
            @if (_showCancelConfirmation)
            {
                <div class="alert alert-warning mt-2"
                     role="alertdialog"
                     aria-labelledby="cancel-reservation-title-@ItemId"
                     aria-describedby="cancel-reservation-description-@ItemId">
                    <div id="cancel-reservation-title-@ItemId" class="fw-semibold">Release this reservation?</div>
                    <p id="cancel-reservation-description-@ItemId" class="mb-2">
                        Other shoppers will be able to reserve this item.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <button @ref="_keepReservationButton"
                                type="button"
                                class="btn btn-sm btn-secondary"
                                disabled="@_isUpdating"
                                @onclick="KeepReservation">
                            Keep reservation
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-danger"
                                disabled="@_isUpdating"
                                @onclick="CancelReservation">
                            @(_isUpdating ? "Releasing..." : "Release reservation")
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="anonymousCheckbox-@ItemId" disabled="@_isUpdating" @bind="_anonymous" />
                <label class="form-check-label" for="anonymousCheckbox-@ItemId">
                    Reserve anonymously
                </label>
            </div>
            
            <button class="btn btn-success w-100"
                    @ref="_reserveItemButton"
                    type="button"
                    disabled="@_isUpdating"
                    aria-busy="@_isUpdating"
                    @onclick="ReserveItem">
                <OpenWishIcon Name="gift" /> @(_isUpdating ? "Reserving..." : "Reserve this item")
            </button>
        }
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-success mt-2" role="status" aria-live="polite">
            @_statusMessage
        </div>
    }
    
    @if (_error)
    {
        <div @ref="_errorAlert" class="alert alert-danger mt-2" role="alert" tabindex="-1">
            @_errorMessage
        </div>
    }
</div>

@code {
    [Parameter]
    public string WishlistId { get; set; } = string.Empty;

    [Parameter]
    public int ItemId { get; set; }
    
    [Parameter]
    public string OwnerId { get; set; }

    private bool _loading = true;
    private bool _error = false;
    private string _errorMessage = "An error occurred. Please try again.";
    private bool _isReserved = false;
    private bool _myReservation = false;
    private bool _anonymous = false;
    private bool _isUpdating;
    private bool _showCancelConfirmation;
    private bool _focusCancelConfirmation;
    private string? _statusMessage;
    private ElementReference _keepReservationButton;
    private ElementReference _cancelReservationButton;
    private ElementReference _reserveItemButton;
    private ElementReference _errorAlert;
    private bool _focusCancelReservationButton;
    private bool _focusReserveItemButton;
    private bool _focusErrorAlert;
    private ItemReservationModel _reservation = new ItemReservationModel();
    private string? _currentUserId;

    protected override async Task OnParametersSetAsync()
    {
        await CheckReservation();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCancelConfirmation)
        {
            _focusCancelConfirmation = false;
            await _keepReservationButton.FocusAsync();
        }

        if (_focusCancelReservationButton)
        {
            _focusCancelReservationButton = false;
            await _cancelReservationButton.FocusAsync();
        }

        if (_focusReserveItemButton)
        {
            _focusReserveItemButton = false;
            await _reserveItemButton.FocusAsync();
        }

        if (_focusErrorAlert)
        {
            _focusErrorAlert = false;
            await _errorAlert.FocusAsync();
        }

        if (firstRender && _error && _currentUserId == null)
        {
            // If we had an error during SSR and no user ID, try again after first render
            await CheckReservation();
        }
    }

    [Inject] private ILogger<ItemReservation> Logger { get; set; } = default!;

    private async Task<bool> CheckReservation()
    {
        try
        {
            _loading = true;
            _error = false;
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId == null)
            {
                _loading = false;
                _isReserved = false;
                return true;
            }

            if (_currentUserId == OwnerId)
            {
                _loading = false;
                _isReserved = false;
                return true;
            }

            var reservation = await WishlistService.GetItemReservationByPublicIdAsync(WishlistId, ItemId, _currentUserId);
            
            if (reservation != null)
            {
                _isReserved = true;
                _reservation = reservation;
                _myReservation = reservation.UserId == _currentUserId;
            }
            else
            {
                _isReserved = false;
            }

            return true;
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = "Failed to check reservation status. This may be resolved when the page becomes interactive.";
            Logger.LogError(ex, "Failed to check reservation for wishlist {WishlistPublicId}, item {WishlistItemId}", WishlistId, ItemId);
            return false;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ReserveItem()
    {
        try
        {
            _isUpdating = true;
            _error = false;
            _statusMessage = null;
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                var result = await WishlistService.ReserveItemByPublicIdAsync(WishlistId, ItemId, _currentUserId, _anonymous);
                
                if (result)
                {
                    if (await CheckReservation())
                    {
                        _statusMessage = "Item reserved. Other shoppers can see that it is taken.";
                    }
                    else
                    {
                        _error = true;
                        _errorMessage = "The item was reserved, but its status could not be refreshed. Reload this page.";
                        _focusErrorAlert = true;
                    }
                }
                else
                {
                    _error = true;
                    _errorMessage = "This item has already been reserved by someone else.";
                }
            }
            else
            {
                _error = true;
                _errorMessage = "Please log in to reserve items.";
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = "Failed to reserve this item. Please try again.";
            Logger.LogError(ex, "Failed to reserve wishlist {WishlistPublicId}, item {WishlistItemId}", WishlistId, ItemId);
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }

    private void ShowCancelConfirmation()
    {
        _showCancelConfirmation = true;
        _statusMessage = null;
        _error = false;
        _focusCancelConfirmation = true;
    }

    private void KeepReservation()
    {
        _showCancelConfirmation = false;
        _focusCancelReservationButton = true;
    }

    private async Task CancelReservation()
    {
        try
        {
            _isUpdating = true;
            _error = false;
            _statusMessage = null;
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                var canceled = await WishlistService.CancelReservationByPublicIdAsync(WishlistId, ItemId, _currentUserId);
                _showCancelConfirmation = false;
                var refreshed = await CheckReservation();
                if (canceled && refreshed)
                {
                    _statusMessage = "Reservation released.";
                    _focusReserveItemButton = true;
                }
                else if (canceled)
                {
                    _error = true;
                    _errorMessage = "The reservation was released, but its status could not be refreshed. Reload this page.";
                    _focusErrorAlert = true;
                }
                else
                {
                    _error = true;
                    _errorMessage = "The reservation could not be released. It may have already changed.";
                    _focusErrorAlert = true;
                }
            }
            else
            {
                _showCancelConfirmation = false;
                _error = true;
                _errorMessage = "Sign in again to release this reservation.";
                _focusErrorAlert = true;
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = "Failed to cancel the reservation. Please try again.";
            Logger.LogError(ex, "Failed to cancel reservation for wishlist {WishlistPublicId}, item {WishlistItemId}", WishlistId, ItemId);
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }
}