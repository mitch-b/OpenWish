@page "/"

@using OpenWish.Web.Client.Components.Wishlist
@using OpenWish.Web.Client.Components.Event

@inject IWishlistService WishlistService
@inject IEventService EventService
@inject IUserContextService UserContextService
@inject IFriendService FriendService
@inject ILogger<Home> Logger

@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<AuthorizeView>
    <Authorized>
        <section class="dashboard-hero">
            <div class="dashboard-hero-copy">
                <p class="welcome-note"><OpenWishIcon Name="stars" /> Welcome Back!</p>
                <h1>Make the next gift feel effortless.</h1>
                <p>Keep every idea, invitation, and surprise beautifully organized in one place.</p>
                <div class="hero-actions">
                    <a href="/events/new" class="btn btn-primary btn-lg">
                        <OpenWishIcon Name="gift" /> Start a Secret Santa
                    </a>
                    <a href="/wishlists/new" class="btn btn-quiet btn-lg">
                        <OpenWishIcon Name="plus-lg" /> Create a wishlist
                    </a>
                </div>
            </div>
            <div class="hero-mark" aria-hidden="true">
                <OpenWishIcon Name="gift" />
                <span class="hero-spark hero-spark-one"></span>
                <span class="hero-spark hero-spark-two"></span>
            </div>
        </section>

        @if (_loadError is not null)
        {
            <div class="alert alert-warning" role="alert">@_loadError</div>
        }

        @if (_userId != null)
        {
            <div class="dashboard-grid">
                <section class="action-panel">
                    <div class="section-intro">
                        <div>
                            <h2>Where do you want to start?</h2>
                            <p>Jump straight into the things you do most.</p>
                        </div>
                    </div>
                    <div class="action-grid">
                        <a href="/events/new" class="action-tile action-tile-primary">
                            <span class="action-icon"><OpenWishIcon Name="gift" /></span>
                            <span><strong>Secret Santa</strong><small>Set up a draw</small></span>
                            <OpenWishIcon Name="arrow-right" Class="action-arrow" />
                        </a>
                        <a href="/wishlists/new" class="action-tile">
                            <span class="action-icon"><OpenWishIcon Name="plus-lg" /></span>
                            <span><strong>New wishlist</strong><small>Capture gift ideas</small></span>
                            <OpenWishIcon Name="arrow-right" Class="action-arrow" />
                        </a>
                        <a href="/friends" class="action-tile">
                            <span class="action-icon"><OpenWishIcon Name="people" /></span>
                            <span><strong>Friends</strong><small>Manage your circle</small></span>
                            <OpenWishIcon Name="arrow-right" Class="action-arrow" />
                        </a>
                        <a href="/wishlists" class="action-tile">
                            <span class="action-icon"><OpenWishIcon Name="list-ul" /></span>
                            <span><strong>All wishlists</strong><small>Browse and organize</small></span>
                            <OpenWishIcon Name="arrow-right" Class="action-arrow" />
                        </a>
                    </div>
                </section>

                <aside class="attention-panel">
                    <div class="section-intro">
                        <div>
                            <h2>For your attention</h2>
                            <p>Nothing important gets lost.</p>
                        </div>
                    </div>
                    <div class="attention-list">
                        @if (_pendingEventInvitations?.Any() == true)
                        {
                            <a href="/events" class="attention-item">
                                <span class="attention-icon attention-warm"><OpenWishIcon Name="envelope" /></span>
                                <span class="attention-copy">
                                    <strong>Event invitations</strong>
                                    <small>@_pendingEventInvitations.Count() waiting for you</small>
                                </span>
                                <span class="count-pill">@_pendingEventInvitations.Count()</span>
                            </a>
                        }
                        @if (_pendingFriendRequests?.Any() == true)
                        {
                            <a href="/friends" class="attention-item">
                                <span class="attention-icon attention-warm"><OpenWishIcon Name="person-plus" /></span>
                                <span class="attention-copy">
                                    <strong>Friend Requests</strong>
                                    <small>@_pendingFriendRequests.Count() waiting for you</small>
                                </span>
                                <span class="count-pill">@_pendingFriendRequests.Count()</span>
                            </a>
                        }
                        @if (_upcomingEvents?.Any() == true)
                        {
                            <a href="/events" class="attention-item">
                                <span class="attention-icon attention-cool"><OpenWishIcon Name="calendar-event" /></span>
                                <span class="attention-copy">
                                    <strong>Upcoming Events</strong>
                                    <small>@_upcomingEvents.Count() in the next 30 days</small>
                                </span>
                                <OpenWishIcon Name="chevron-right" Class="attention-arrow" />
                            </a>
                        }
                        @if (_pendingEventInvitations?.Any() != true &&
                             _pendingFriendRequests?.Any() != true &&
                             _upcomingEvents?.Any() != true)
                        {
                            <div class="attention-empty">
                                <span class="attention-icon attention-cool"><OpenWishIcon Name="check-circle" /></span>
                                <span><strong>You're all caught up</strong><small>No invitations or events need attention.</small></span>
                            </div>
                        }
                    </div>
                </aside>
            </div>
        }

        @if (_featuredWishlists != null || _events != null)
        {
            <div class="collection-grid">
                <section class="collection-section">
                    <div class="section-intro section-intro-row">
                        <div>
                            <h2>Recent wishlists</h2>
                            <p>Ideas you have been shaping lately.</p>
                        </div>
                        <a href="/wishlists">View all <OpenWishIcon Name="arrow-right" /></a>
                    </div>
                    @if (_featuredWishlists?.Any() == true)
                    {
                        <div class="collection-list">
                            @foreach (var wishlist in _featuredWishlists.Take(3))
                            {
                                <WishlistCard Wishlist="@wishlist" OnDelete="@HandleWishlistDeleted" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state compact">
                            <OpenWishIcon Name="gift" />
                            <h3>Your first wishlist starts here</h3>
                            <p>Save a few ideas now and make gifting easier later.</p>
                            <a href="/wishlists/new" class="btn btn-primary">Create a wishlist</a>
                        </div>
                    }
                </section>

                <section class="collection-section">
                    <div class="section-intro section-intro-row">
                        <div>
                            <h2>Events</h2>
                            <p>Celebrations and exchanges on your radar.</p>
                        </div>
                        <a href="/events">View all <OpenWishIcon Name="arrow-right" /></a>
                    </div>
                    @if (_events?.Any() == true)
                    {
                        <div class="collection-list">
                            @foreach (var evt in _events.Take(3))
                            {
                                <EventCard Event="@evt" OnDelete="@HandleEventDeleted" />
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state compact">
                            <OpenWishIcon Name="calendar-event" />
                            <h3>Bring everyone together</h3>
                            <p>Create an event, invite your people, and let OpenWish handle the details.</p>
                            <a href="/events/new" class="btn btn-primary">Create an event</a>
                        </div>
                    }
                </section>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <section class="dashboard-hero marketing-hero">
            <div class="dashboard-hero-copy">
                <p class="welcome-note"><OpenWishIcon Name="stars" /> Thoughtful gifting, minus the guesswork</p>
                <h1>Make every gift feel personal.</h1>
                <p>Build wishlists, bring people together, and run effortless gift exchanges on software you control.</p>
                <div class="hero-actions">
                    <a href="/Account/Register" class="btn btn-primary btn-lg">Create your account</a>
                    <a href="/Account/Login" class="btn btn-quiet btn-lg">Sign in</a>
                </div>
            </div>
            <div class="hero-mark" aria-hidden="true"><OpenWishIcon Name="gift" /></div>
        </section>

        <section class="marketing-features">
            <article>
                <span class="feature-icon"><OpenWishIcon Name="heart" /></span>
                <h2>Wishlists people actually use</h2>
                <p>Save links, details, and priorities. Share with everyone or only the people you choose.</p>
            </article>
            <article>
                <span class="feature-icon"><OpenWishIcon Name="gift" /></span>
                <h2>Secret Santa without the admin</h2>
                <p>Invite your group, confirm readiness, and draw private matches from one guided flow.</p>
            </article>
            <article>
                <span class="feature-icon"><OpenWishIcon Name="shield-check" /></span>
                <h2>Private by design</h2>
                <p>Reservations stay hidden, assignments remain secret, and self-hosters keep control of their data.</p>
            </article>
        </section>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<WishlistModel>? _featuredWishlists;
    private List<EventModel>? _events;
    private List<EventModel>? _upcomingEvents;
    private IEnumerable<FriendRequestModel>? _pendingFriendRequests;
    private IEnumerable<EventUserModel>? _pendingEventInvitations;

    private string? _userId;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        _userId = await UserContextService.GetUserIdAsync();
        if (_userId != null)
        {
            try
            {
                await LoadFeaturedWishlists();
                await LoadEvents();
                await LoadFriendRequests();
                await LoadPendingEventInvitations();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unable to load the home dashboard for user {UserId}.", _userId);
                _loadError = "Some dashboard information could not be loaded. Refresh the page to try again.";
            }
        }
    }

    private async Task LoadFeaturedWishlists()
    {
        if (_userId is not null)
        {
            _featuredWishlists = (await WishlistService.GetUserWishlistsAsync(_userId))
                .OrderByDescending(GetWishlistActivityTimestamp)
                .ToList();
        }
    }

    private async Task LoadEvents()
    {
        if (_userId is not null)
        {
            var allEvents = (await EventService.GetUserEventsAsync(_userId)).ToList();
            _events = allEvents
                .OrderByDescending(GetEventActivityTimestamp)
                .ToList();

            var thirtyDaysFromNow = DateTimeOffset.UtcNow.AddDays(30);
            _upcomingEvents = allEvents
                .Where(e => e.Date <= thirtyDaysFromNow && e.Date >= DateTimeOffset.UtcNow)
                .OrderBy(e => e.Date)
                .ToList();
        }
    }

    private async Task LoadFriendRequests()
    {
        if (_userId is not null)
        {
            _pendingFriendRequests = await FriendService.GetReceivedFriendRequestsAsync(_userId);
        }
    }

    private async Task LoadPendingEventInvitations()
    {
        if (_userId is not null)
        {
            _pendingEventInvitations = await EventService.GetPendingInvitationsForUserAsync(_userId);
        }
    }



    private async Task HandleWishlistDeleted(WishlistModel wishlist)
    {
        await LoadFeaturedWishlists();
    }

    private async Task HandleEventDeleted(EventModel evt)
    {
        await LoadEvents();
    }

    private static DateTimeOffset GetWishlistActivityTimestamp(WishlistModel wishlist)
    {
        if (wishlist is null)
        {
            return DateTimeOffset.MinValue;
        }

        var latest = GetLaterTimestamp(wishlist.CreatedOn, wishlist.UpdatedOn);

        if (wishlist.Items?.Any() == true)
        {
            var itemsLatest = wishlist.Items
                .Select(item => GetLaterTimestamp(item.CreatedOn, item.UpdatedOn))
                .DefaultIfEmpty(DateTimeOffset.MinValue)
                .Max();

            latest = itemsLatest > latest ? itemsLatest : latest;
        }

        return latest;
    }

    private static DateTimeOffset GetEventActivityTimestamp(EventModel evt)
    {
        if (evt is null)
        {
            return DateTimeOffset.MinValue;
        }

        var latest = GetLaterTimestamp(evt.CreatedOn, evt.UpdatedOn);

        if (evt.EventWishlists?.Any() == true)
        {
            var wishlistLatest = evt.EventWishlists
                .Select(GetWishlistActivityTimestamp)
                .DefaultIfEmpty(DateTimeOffset.MinValue)
                .Max();

            latest = wishlistLatest > latest ? wishlistLatest : latest;
        }

        return latest;
    }

    private static DateTimeOffset GetLaterTimestamp(DateTimeOffset first, DateTimeOffset second) =>
        first > second ? first : second;


}
