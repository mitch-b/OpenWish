@using OpenWish.Shared.Models

<div class="card border-0 shadow-sm mb-4 gift-exchange-setup">
    <div class="card-body p-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4">
            <div>
                <span class="setup-kicker"><OpenWishIcon Name="check-circle" /> Organizer setup</span>
                <h2 class="h3 mb-1">Ready the exchange</h2>
                <p class="text-muted mb-0">@StyleGuidance</p>
            </div>
            <div class="setup-progress">
                <strong>@CompletedStepCount of 5 steps done</strong>
                <div class="progress mt-2" role="progressbar" aria-label="Gift exchange setup progress"
                     aria-valuenow="@ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar bg-success" style="width: @ProgressPercent%"></div>
                </div>
                @if (NextStepTitle is not null)
                {
                    <p class="setup-next mb-0">Next: <strong>@NextStepTitle</strong></p>
                }
            </div>
        </div>

        <div class="setup-steps">
            <SetupStep Number="1"
                       Title="Event details"
                       Description="@($"{Event.Date:MMM d} · {BudgetText}")"
                       IsComplete="true"
                       ActionHref="@($"/events/{Event.PublicId}/manage")"
                       ActionLabel="Edit" />
            <SetupStep Number="2"
                       IsNext="@(NextStepNumber == 2)"
                       Title="Invite your group"
                       Description="@InvitationStatus"
                       IsComplete="@(AcceptedParticipantCount >= 2)"
                       ActionHref="@($"/events/{Event.PublicId}?section=event-invitations")"
                       ActionLabel="Invite people"
                       OnAction="OnInviteRequested" />
            <SetupStep Number="3"
                       IsNext="@(NextStepNumber == 3)"
                       Title="Add your wishlist"
                       Description="@(WishlistsLoaded ? OwnerHasWishlist ? "Your gift ideas are shared." : "Give your match a few easy ideas." : "Checking shared gift ideas...")"
                       IsComplete="@OwnerHasWishlist"
                       ActionHref="@($"/events/{Event.PublicId}?section=event-wishlists")"
                       ActionLabel="Add wishlist" />
            <SetupStep Number="4"
                       Title="Check everyone's readiness"
                       Description="@WishlistStatus"
                       IsComplete="@AllAcceptedParticipantsHaveWishlists"
                       ActionHref="@($"/events/{Event.PublicId}?section=event-wishlists")"
                       ActionLabel="Review lists" />
            <SetupStep Number="5"
                       IsNext="@(NextStepNumber == 5)"
                       Title="@DrawStepTitle"
                       Description="@DrawStatus"
                       IsComplete="@Event.NamesDrawnOn.HasValue"
                       ActionHref="@($"/events/{Event.PublicId}?section=gift-exchange")"
                       ActionLabel="Go to draw" />
        </div>

        @if (PendingInvitationCount > 0)
        {
            <div class="alert alert-warning setup-pending-note mt-4 mb-0" role="status">
                <OpenWishIcon Name="hourglass-split" />
                <div>
                    @if (Event.NamesDrawnOn.HasValue)
                    {
                        <strong>@PendingInvitationCount pending invitation@(PendingInvitationCount == 1 ? " wasn't" : "s weren't") included in the draw.</strong>
                    }
                    else
                    {
                        <strong>@PendingInvitationText still waiting for a reply.</strong>
                        <span>Only accepted people are included in the draw. If someone said yes outside OpenWish, use <strong>Mark as accepted</strong> under Invite people.</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public EventModel Event { get; set; } = default!;

    [Parameter, EditorRequired]
    public string CurrentUserId { get; set; } = string.Empty;

    [Parameter]
    public bool WishlistsLoaded { get; set; }

    [Parameter]
    public EventCallback OnInviteRequested { get; set; }

    private IEnumerable<EventUserModel> AcceptedParticipants =>
        Event.EventUsers.Where(IsAccepted);

    private IEnumerable<string> AcceptedParticipantKeys
    {
        get
        {
            yield return $"user:{CurrentUserId}";

            foreach (var participant in AcceptedParticipants)
            {
                if (!string.IsNullOrWhiteSpace(participant.UserId))
                {
                    yield return $"user:{participant.UserId}";
                }
                else if (!string.IsNullOrWhiteSpace(participant.InviteeEmail))
                {
                    yield return $"email:{participant.InviteeEmail.Trim().ToUpperInvariant()}";
                }
            }
        }
    }

    private HashSet<string> AcceptedParticipantIds =>
        AcceptedParticipants
            .Select(participant => participant.UserId)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Cast<string>()
            .Append(CurrentUserId)
            .ToHashSet(StringComparer.Ordinal);

    private int AcceptedParticipantCount =>
        AcceptedParticipantKeys.Distinct(StringComparer.Ordinal).Count();

    private int PendingInvitationCount =>
        Event.EventUsers.Count(participant =>
            !participant.Deleted &&
            string.Equals(participant.Status, "Pending", StringComparison.OrdinalIgnoreCase));

    private bool OwnerHasWishlist =>
        WishlistsLoaded && Event.EventWishlists.Any(wishlist =>
            string.Equals(wishlist.OwnerId, CurrentUserId, StringComparison.Ordinal) &&
            GetItemCount(wishlist) > 0);

    private bool AllAcceptedParticipantsHaveWishlists
    {
        get
        {
            var participantIds = AcceptedParticipantIds;

            return WishlistsLoaded && participantIds.Count > 0 &&
                   participantIds.All(id => Event.EventWishlists.Any(wishlist =>
                       string.Equals(wishlist.OwnerId, id, StringComparison.Ordinal) &&
                       GetItemCount(wishlist) > 0));
        }
    }

    private int ParticipantsWithWishlists =>
        (WishlistsLoaded ? Event.EventWishlists : [])
            .Where(wishlist =>
                !string.IsNullOrWhiteSpace(wishlist.OwnerId) &&
                AcceptedParticipantIds.Contains(wishlist.OwnerId) &&
                GetItemCount(wishlist) > 0)
            .Select(wishlist => wishlist.OwnerId)
            .Distinct(StringComparer.Ordinal)
            .Count();

    private int CompletedStepCount =>
        1 +
        (AcceptedParticipantCount >= 2 ? 1 : 0) +
        (OwnerHasWishlist ? 1 : 0) +
        (AllAcceptedParticipantsHaveWishlists ? 1 : 0) +
        (Event.NamesDrawnOn.HasValue ? 1 : 0);

    private int ProgressPercent => CompletedStepCount * 20;

    private string BudgetText => Event.Budget.HasValue
        ? $"{Event.Budget.Value:C} per gift"
        : "No budget set";

    private int? NextStepNumber =>
        AcceptedParticipantCount < 2 ? 2
        : WishlistsLoaded && !OwnerHasWishlist ? 3
        : !Event.NamesDrawnOn.HasValue ? 5
        : null;

    private string? NextStepTitle => NextStepNumber switch
    {
        2 => "Invite your group",
        3 => "Add your wishlist",
        5 => DrawStepTitle,
        _ => null
    };

    private string PendingInvitationText => PendingInvitationCount == 1
        ? "1 invitation is"
        : $"{PendingInvitationCount} invitations are";

    private string InvitationStatus => AcceptedParticipantCount == 1
        ? "Invite at least one other person."
        : $"{AcceptedParticipantCount} people accepted" +
          (PendingInvitationCount > 0 ? $" · {PendingInvitationCount} waiting" : string.Empty);

    private string WishlistStatus => WishlistsLoaded
        ? AllAcceptedParticipantsHaveWishlists
            ? $"Everyone who accepted has gift ideas ({ParticipantsWithWishlists} of {AcceptedParticipantCount})."
            : $"{ParticipantsWithWishlists} of {AcceptedParticipantCount} accepted participants have gift ideas. You can draw now; ideas can come later."
        : "Checking shared gift ideas...";

    private string DrawStatus => Event.NamesDrawnOn.HasValue
        ? "Assignments are ready. Everyone can see their own match."
        : AcceptedParticipantCount >= 2
            ? $"Ready when you are: {AcceptedParticipantCount} accepted people will be included."
            : "Needs at least one more person to accept first.";

    private bool IsSecretSantaStyle =>
        string.Equals(Event.GiftExchangeStyle, "SecretSanta", StringComparison.Ordinal);

    private string StyleGuidance => IsSecretSantaStyle
        ? "Invite your group, review wishlists, then draw names privately."
        : "Invite your group, review wishlists, then make private assignments.";

    private string DrawStepTitle => IsSecretSantaStyle ? "Draw Secret Santa names" : "Make assignments";

    private static bool IsAccepted(EventUserModel participant) =>
        !participant.Deleted &&
        participant.IsAccepted &&
        string.Equals(participant.Status, "Accepted", StringComparison.OrdinalIgnoreCase);

    private static int GetItemCount(WishlistModel wishlist) =>
        EventGiftIdeas.Count(wishlist);
}
