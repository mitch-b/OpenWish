@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Diagnostics.CodeAnalysis
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using OpenWish.Data.Entities
@using OpenWish.Shared.Services
@using OpenWish.Web.Services

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IBaseUriService BaseUriService
@inject IFriendService FriendService

<PageTitle>Create your account</PageTitle>

<div class="auth-page">
<div class="registration-layout">
<aside class="registration-story" aria-label="Welcome to OpenWish">
    <span class="registration-gift" aria-hidden="true"><OpenWishIcon Name="gift" /></span>
    <p class="registration-story-title">Good gifts start with a little thought.</p>
    <p>A place for your ideas, your people, and the surprises you keep for them.</p>
    <div class="registration-promise"><OpenWishIcon Name="eye-slash" /><span>Gift reservations stay hidden from the person receiving them.</span></div>
</aside>
<div class="registration-main">
<header class="auth-heading">
    <div>
        <h1>Create your account</h1>
        <p>@((_isInvitedRegistration || !string.IsNullOrWhiteSpace(InvitedEmail)) ? "Your invitation is waiting. Start here, then join your group." : "Save your gift ideas and plan something thoughtful together.")</p>
    </div>
</header>
<p class="guest-access-choice" data-guest-access-choice data-testid="register-without-account" hidden>
    <OpenWishIcon Name="person-circle" />
    <span>Rather not make an account? <a href="/guest" data-enhance-nav="false">Continue without an account</a> to accept and see your own match.</span>
</p>
        <section class="auth-card">
          <StatusMessage Message="@Message" />
          <EditForm Model="Input"
                    asp-route-returnUrl="@ReturnUrl"
                    asp-route-invite="@Invite"
                    method="post"
                    OnValidSubmit="RegisterUser"
                    FormName="register">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            @if (_isInvitedRegistration)
            {
                <div class="registration-invite mb-3">
                    <span class="form-label">Invited email</span>
                    <strong>@Input.Email</strong>
                    <InputHidden @bind-Value="Input.Email" />
                    <div class="form-text">
                        Invitations are tied to the address they were sent to. To use another address, request a new invitation.
                    </div>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label for="Input.Email" class="form-label">Email</label>
                    <InputText type="email" inputmode="email" @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" aria-describedby="email-guidance" autofocus="@string.IsNullOrWhiteSpace(InvitedEmail)" placeholder="name@example.com" />
                    <ValidationMessage For="() => Input.Email" class="text-danger" />
                    <p id="email-guidance" class="form-text mb-0">@(string.IsNullOrWhiteSpace(InvitedEmail) ? "You'll use this to sign in. We'll send a link to confirm it." : "Use the address that received your invitation so we can find it for you.")</p>
                </div>
            }
            <div class="mb-3">
                <label for="Input.Password" class="form-label">Password</label>
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" aria-describedby="password-guidance" autofocus="@(_isInvitedRegistration || !string.IsNullOrWhiteSpace(InvitedEmail))" />
                <ValidationMessage For="() => Input.Password" class="text-danger" />
                <div id="password-guidance" class="form-text">
                    Use 6 to 100 characters with an uppercase letter, lowercase letter, number, and symbol.
                </div>
            </div>
            <div class="mb-3">
                <label for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            <button type="button" class="registration-password-toggle btn btn-outline-secondary mb-3" hidden data-password-toggle aria-controls="Input.Password Input.ConfirmPassword" aria-pressed="false">Show passwords</button>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Create account</button>
            <p class="registration-next-step">Next, confirm your email@((_isInvitedRegistration || !string.IsNullOrWhiteSpace(InvitedEmail)) ? " and return to your invitation." : " to start sharing ideas.")</p>
            <p class="mt-3 mb-0">
                Already have an account?
                <a data-enhance-nav="false" data-carry-guest-access href="@(NavigationManager.GetUriWithQueryParameters("Account/Login", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl, ["email"] = InvitedEmail ?? (_isInvitedRegistration ? Input.Email : null) }))">Log in</a>.
            </p>
          </EditForm>
        </section>
    <div class="registration-external">
        <ExternalLoginPicker />
    </div>
</div>
</div>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;
    private string? inviterUserId;
    private bool _isInvitedRegistration;
    private InputModel _input = new();

    [SupplyParameterFromForm(FormName = "register")]
    [AllowNull]
    private InputModel Input
    {
        get => _input;
        set => _input = value ?? new();
    }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    private string? InvitedEmail { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    
    [SupplyParameterFromQuery(Name = "invite")]
    private string? Invite { get; set; }

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    protected override void OnInitialized()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method) && !string.IsNullOrWhiteSpace(InvitedEmail))
        {
            Input.Email = InvitedEmail.Trim();
        }

        // Process invite parameter if present
        if (!string.IsNullOrEmpty(Invite))
        {
            try
            {
                // The invite parameter contains email|userId
                var inviteData = Uri.UnescapeDataString(Invite).Split('|');
                if (inviteData.Length == 2 &&
                    !string.IsNullOrWhiteSpace(inviteData[0]) &&
                    !string.IsNullOrWhiteSpace(inviteData[1]))
                {
                    Input.Email = inviteData[0];
                    inviterUserId = inviteData[1];
                    _isInvitedRegistration = true;
                }
                else
                {
                    Logger.LogWarning("Invalid friend invitation parameter received.");
                }
            }
            catch (UriFormatException ex)
            {
                Logger.LogWarning(ex, "Invalid friend invitation parameter received.");
            }
        }
        
        base.OnInitialized();
    }

    public async Task RegisterUser(EditContext editContext)
    {
        Input.Email = Input.Email.Trim();
        var user = CreateUser();

        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
        var emailStore = GetEmailStore();
        await emailStore.SetEmailAsync(user, Input.Email, CancellationToken.None);
        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }

        Logger.LogInformation("User created a new account with password.");

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            BaseUriService.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });

        await EmailSender.SendConfirmationLinkAsync(user, Input.Email, callbackUrl);

        // If registration is from an invite, create the friendship
        if (!string.IsNullOrEmpty(inviterUserId))
        {
            try
            {
                if (await FriendService.CreateFriendshipFromInviteAsync(userId, inviterUserId))
                {
                    Logger.LogInformation("Created friendship between new user {NewUserId} and inviter {InviterId}", userId, inviterUserId);
                }
            }
            catch (Exception ex)
            {
                // Log error but continue with registration
                Logger.LogError(ex, "Could not confirm invitation completion for new user {NewUserId} and inviter {InviterId}", userId, inviterUserId);
            }
        }

        if (UserManager.Options.SignIn.RequireConfirmedAccount)
        {
            RedirectManager.RedirectTo(
                "Account/RegisterConfirmation",
                new() { ["email"] = Input.Email, ["returnUrl"] = ReturnUrl });
        }

        await SignInManager.SignInAsync(user, isPersistent: false);
        RedirectManager.RedirectTo(ReturnUrl);
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor.");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException("The default UI requires a user store with email support.");
        }
        return (IUserEmailStore<ApplicationUser>)UserStore;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Choose a password.")]
        [StringLength(100, ErrorMessage = "Use 6 to 100 characters for your password.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Enter your password again to confirm it.")]
        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "Your passwords don't match. Enter the same password in both fields.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
