@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using OpenWish.Data.Entities

@inject SignInManager<ApplicationUser> SignInManager
@if (externalLogins.Length > 0)
{
    <section class="external-login-options">
        <h2>Use an existing account</h2>
        <form class="external-login-form"
              action="/Account/PerformExternalLogin"
              method="post"
              data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            @foreach (var provider in externalLogins)
            {
                <button type="submit" class="btn btn-lg external-login-button" name="provider" value="@provider.Name">Continue with @provider.DisplayName</button>
            }
        </form>
    </section>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
