@using OpenWish.Shared.Models
@using OpenWish.Shared.Services

@inject IWishlistService WishlistService
@inject IUserContextService UserContextService
@inject ILogger<ItemComments> Logger
@inject IJSRuntime JSRuntime

<div class="item-comments" aria-busy="@(_loading || _isAdding || _deletingCommentId.HasValue)">
    <div class="item-comments-header">
        <h6 class="item-comments-title" id="comments-title-@ItemId">
            <OpenWishIcon Name="chat" /> Comments
            @if (_hasLoaded && _comments.Count > 0)
            {
                <span class="item-comments-count">@_comments.Count</span>
            }
        </h6>
        <p class="item-comments-privacy" data-testid="comments-visibility-note">
            <OpenWishIcon Name="eye" />
            @(IsWishlistOwner
                ? "Everyone who can view this list can read these."
                : "Everyone who can view this list can read these, including the list owner.")
        </p>
    </div>

    @if (_loading && !_hasLoaded)
    {
        <div class="item-comments-loading" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Loading comments…</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
    {
        <div class="alert alert-danger item-comments-alert" role="alert">
            <p class="mb-2">@_loadErrorMessage</p>
            <button class="btn btn-outline-danger btn-sm"
                    type="button"
                    disabled="@(_loading || !RendererInfo.IsInteractive)"
                    @onclick="RetryLoadComments">
                <OpenWishIcon Name="arrow-clockwise" /> Try again
            </button>
        </div>
    }
    else
    {
        @if (!_comments.Any())
        {
            <p class="item-comments-empty">No comments yet. Ask a question or share a size, color, or timing tip.</p>
        }
        else
        {
            <ul class="comment-list" aria-labelledby="comments-title-@ItemId">
                @foreach (var comment in _comments)
                {
                    var isSelf = comment.UserId == _currentUserId;
                    <li @key="comment.Id">
                        <article class="comment-item @(isSelf ? "comment-item-self" : string.Empty)">
                            <div class="comment-meta">
                                <div class="comment-byline">
                                    <span class="comment-author">
                                        <OpenWishIcon Name="person-circle" />
                                        <span class="comment-author-name">@(comment.User?.UserName ?? "Unknown User")</span>
                                        @if (isSelf)
                                        {
                                            <span class="comment-author-you">You</span>
                                        }
                                    </span>
                                    <time class="comment-time" datetime="@comment.CreatedOn.ToString("o")">
                                        @comment.CreatedOn.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                    </time>
                                </div>
                                @if (isSelf || _isWishlistOwner)
                                {
                                    <button class="btn btn-sm comment-delete"
                                            id="delete-comment-@comment.Id"
                                            type="button"
                                            disabled="@(_loading || _pendingDeleteComment is not null || _deletingCommentId.HasValue || !RendererInfo.IsInteractive)"
                                            aria-label="Delete comment by @GetCommentAuthor(comment)"
                                            title="Delete comment"
                                            @onclick="() => ShowDeleteConfirmation(comment)">
                                        <OpenWishIcon Name="trash" />
                                    </button>
                                }
                            </div>
                            <p class="comment-text">@comment.Text</p>
                        </article>
                        @if (_pendingDeleteComment?.Id == comment.Id)
                        {
                            <div class="alert alert-warning comment-confirm"
                                 role="alertdialog"
                                 aria-labelledby="delete-comment-title-@comment.Id"
                                 aria-describedby="delete-comment-description-@comment.Id">
                                <div id="delete-comment-title-@comment.Id" class="fw-semibold">Delete this comment?</div>
                                <p id="delete-comment-description-@comment.Id" class="mb-2">
                                    The comment by @GetCommentAuthor(comment) will be permanently removed.
                                </p>
                                <div class="comment-confirm-actions">
                                    <button @ref="_keepCommentButton"
                                            type="button"
                                            class="btn btn-sm btn-secondary"
                                            disabled="@(_loading || _deletingCommentId.HasValue || !RendererInfo.IsInteractive)"
                                            @onclick="CancelDelete">
                                        Keep comment
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            disabled="@(_loading || _deletingCommentId.HasValue || !RendererInfo.IsInteractive)"
                                            @onclick="ConfirmDeleteComment">
                                        @(_deletingCommentId == comment.Id ? "Deleting…" : "Delete comment")
                                    </button>
                                </div>
                            </div>
                        }
                    </li>
                }
            </ul>
        }

        <div class="comment-form">
            <label class="form-label comment-label" for="commentText-@ItemId">Add a comment</label>
            <textarea class="form-control comment-composer"
                      placeholder="Ask a question or share a tip"
                      id="commentText-@ItemId"
                      rows="3"
                      @ref="_commentComposer"
                      disabled="@(_loading || _isAdding || _deletingCommentId.HasValue || !RendererInfo.IsInteractive)"
                      aria-describedby="commentHint-@ItemId"
                      @bind="commentText"
                      @bind:event="oninput"
                      @onkeydown="HandleComposerKeyDown"></textarea>
            <div class="comment-form-footer">
                <div id="commentHint-@ItemId" class="comment-hint">Press Ctrl+Enter to send.</div>
                <button class="btn btn-primary comment-submit"
                        type="button"
                        aria-busy="@_isAdding"
                        @onclick="AddComment"
                        disabled="@(string.IsNullOrWhiteSpace(commentText) || _loading || _isAdding || _deletingCommentId.HasValue || !RendererInfo.IsInteractive)">
                    <OpenWishIcon Name="send" /> @(_isAdding ? "Adding…" : "Add comment")
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <p class="item-comments-feedback" role="status" aria-live="polite">
            <OpenWishIcon Name="check-circle" /> @_statusMessage
        </p>
    }

    @if (_error)
    {
        <div @ref="_errorAlert" class="alert alert-danger item-comments-alert" role="alert" tabindex="-1">
            @_errorMessage
        </div>
    }
</div>

@code {
    [Parameter]
    public string WishlistId { get; set; } = string.Empty;

    [Parameter]
    public int ItemId { get; set; }

    [Parameter]
    public bool IsWishlistOwner { get; set; }

    private List<ItemCommentModel> _comments = [];
    private string commentText = "";
    private bool _loading = true;
    private bool _hasLoaded;
    private bool _error = false;
    private string _errorMessage = "An error occurred. Please try again.";
    private string? _loadErrorMessage;
    private string? _statusMessage;
    private string? _currentUserId;
    private bool _isWishlistOwner => IsWishlistOwner;
    private bool _isAdding;
    private int? _deletingCommentId;
    private ItemCommentModel? _pendingDeleteComment;
    private ElementReference _keepCommentButton;
    private ElementReference _commentComposer;
    private ElementReference _errorAlert;
    private bool _focusDeleteConfirmation;
    private bool _focusCommentComposer;
    private bool _focusErrorAlert;
    private string? _restoreDeleteButtonId;

    private string? _loadedKey;

    protected override async Task OnParametersSetAsync()
    {
        // The list re-renders after reservations change; keep the thread, composer, and focus in place.
        var key = $"{WishlistId}/{ItemId}";
        if (key == _loadedKey)
        {
            return;
        }

        _loadedKey = key;
        _hasLoaded = false;
        _comments = [];
        await LoadComments();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDeleteConfirmation)
        {
            _focusDeleteConfirmation = false;
            await _keepCommentButton.FocusAsync();
        }

        if (_restoreDeleteButtonId is not null)
        {
            var elementId = _restoreDeleteButtonId;
            _restoreDeleteButtonId = null;
            await JSRuntime.InvokeVoidAsync("openWishFocusElement", elementId);
        }

        if (_focusCommentComposer)
        {
            _focusCommentComposer = false;
            await _commentComposer.FocusAsync();
        }

        if (_focusErrorAlert)
        {
            _focusErrorAlert = false;
            await _errorAlert.FocusAsync();
        }

        if (firstRender && _loadErrorMessage is not null && _currentUserId == null)
        {
            // If we had an error during SSR and no user ID, try again after first render
            await LoadComments();
        }
    }

    private async Task<bool> LoadComments()
    {
        try
        {
            _loading = true;
            _error = false;
            _loadErrorMessage = null;
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            var comments = await WishlistService.GetItemCommentsByPublicIdAsync(WishlistId, ItemId);
            _comments = comments.ToList();
            _hasLoaded = true;
            return true;
        }
        catch (Exception ex)
        {
            _loadErrorMessage = "Comments could not be loaded. Try again.";
            Logger.LogError(ex, "Failed to load comments for wishlist {WishlistPublicId}, item {WishlistItemId}", WishlistId, ItemId);
            return false;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RetryLoadComments()
    {
        if (_loading)
        {
            return;
        }

        await LoadComments();
    }

    private async Task HandleComposerKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey))
        {
            await AddComment();
        }
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(commentText) || _loading || _isAdding || _deletingCommentId.HasValue)
            return;

        try
        {
            _isAdding = true;
            _error = false;
            _statusMessage = null;
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                await WishlistService.AddCommentToItemByPublicIdAsync(WishlistId, ItemId, _currentUserId, commentText.Trim());
                commentText = "";
                if (await LoadComments())
                {
                    _statusMessage = "Comment added.";
                    _focusCommentComposer = true;
                }
            }
            else
            {
                _error = true;
                _errorMessage = "Please log in to add comments.";
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = "Failed to add comment. Please try again.";
            Logger.LogError(ex, "Failed to add comment to wishlist {WishlistPublicId}, item {WishlistItemId}", WishlistId, ItemId);
        }
        finally
        {
            _isAdding = false;
        }
    }

    private void ShowDeleteConfirmation(ItemCommentModel comment)
    {
        _pendingDeleteComment = comment;
        _statusMessage = null;
        _error = false;
        _focusDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        _restoreDeleteButtonId = $"delete-comment-{_pendingDeleteComment?.Id}";
        _pendingDeleteComment = null;
    }

    private async Task ConfirmDeleteComment()
    {
        if (_pendingDeleteComment is null || _loading)
        {
            return;
        }

        var commentId = _pendingDeleteComment.Id;
        try
        {
            _deletingCommentId = commentId;
            _error = false;
            _statusMessage = null;
            _currentUserId ??= await UserContextService.GetUserIdAsync();

            if (_currentUserId != null)
            {
                var removed = await WishlistService.RemoveItemCommentAsync(commentId, _currentUserId);
                _pendingDeleteComment = null;
                var refreshed = await LoadComments();
                if (removed && refreshed)
                {
                    _statusMessage = "Comment deleted.";
                    _focusCommentComposer = true;
                }
                else if (!removed)
                {
                    _error = true;
                    _errorMessage = "The comment could not be deleted. It may have already been removed.";
                    _focusErrorAlert = true;
                }
            }
            else
            {
                _error = true;
                _errorMessage = "Please log in to delete comments.";
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _errorMessage = "Failed to delete comment. Please try again.";
            Logger.LogError(ex, "Failed to delete comment {CommentId}", commentId);
        }
        finally
        {
            _deletingCommentId = null;
        }
    }

    private static string GetCommentAuthor(ItemCommentModel comment) =>
        comment.User?.UserName ?? "an OpenWish member";
}