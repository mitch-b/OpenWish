@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics

<PageTitle>Something went wrong | OpenWish</PageTitle>

<section class="status-page" aria-labelledby="error-title">
    <span class="status-page-mark status-page-mark-danger" aria-hidden="true">
        <OpenWishIcon Name="exclamation-triangle" />
    </span>
    <h1 id="error-title" tabindex="-1">Something went wrong</h1>
    <p class="status-page-lead">
        OpenWish couldn't finish that request. Your wishlists, reservations, and events are unchanged.
        Try again in a moment, or head back to your dashboard.
    </p>
    <div class="status-page-actions">
        @if (RetryPath is not null)
        {
            <a class="btn btn-primary" href="@RetryPath">
                <OpenWishIcon Name="arrow-clockwise" /> Try again
            </a>
            <a class="btn btn-outline-secondary" href="/">
                <OpenWishIcon Name="house-door" /> Go to dashboard
            </a>
        }
        else
        {
            <a class="btn btn-primary" href="/">
                <OpenWishIcon Name="house-door" /> Go to dashboard
            </a>
        }
    </div>
    @if (ShowRequestId)
    {
        <p class="status-page-reference">
            If this keeps happening, share this reference with whoever runs your OpenWish:
            <code>@RequestId</code>
        </p>
    }
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private string? RetryPath { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

        // Only offer to repeat a safe navigation; never resubmit a failed form.
        var failure = HttpContext?.Features.Get<IExceptionHandlerPathFeature>();
        if (failure is not null &&
            HttpMethods.IsGet(HttpContext!.Request.Method) &&
            failure.Path.StartsWith('/') &&
            !failure.Path.Equals("/Error", StringComparison.OrdinalIgnoreCase))
        {
            RetryPath = failure.Path;
        }
    }
}
