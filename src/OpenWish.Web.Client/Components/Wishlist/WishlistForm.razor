
@if (Model is not null)
{
    <FocusOnFirstRender ElementId="name" Enabled="@AutoFocusName" />
    <EditForm Model="@Model" OnValidSubmit="@HandleSubmit" FormName="WishlistForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="name" class="form-label">Title</label>
            <InputText id="name"
                       class="form-control"
                       autofocus="@AutoFocusName"
                       @bind-Value="@Model!.Name" />
            <ValidationMessage For="@(() => Model.Name)" />
        </div>

        <div class="mb-3 wishlist-icon-field">
            <label class="form-label">Icon <span class="text-muted fw-normal">(optional)</span></label>
            <InputHidden @bind-Value="@Model!.Icon" />
            <div class="wishlist-icon-controls">
                <button type="button"
                        class="wishlist-icon-trigger"
                        aria-expanded="@_showIconPicker"
                        aria-controls="wishlist-icon-picker"
                        @onclick="ToggleIconPicker">
                    <span class="wishlist-icon-preview" aria-hidden="true">@(Model.Icon ?? "＋")</span>
                    <span>@(Model.Icon is null ? "Choose an icon" : "Change icon")</span>
                </button>
                @if (Model.Icon is not null)
                {
                    <button type="button" class="btn btn-link wishlist-icon-clear" @onclick="ClearIcon">
                        Clear
                    </button>
                }
            </div>
            @if (_showIconPicker)
            {
                <div id="wishlist-icon-picker" class="wishlist-icon-picker" role="group" aria-label="Choose a wishlist icon">
                    @foreach (var option in IconOptions)
                    {
                        <button type="button"
                                class="wishlist-icon-option @(Model.Icon == option.Value ? "selected" : null)"
                                aria-label="@option.Label"
                                aria-pressed="@(Model.Icon == option.Value)"
                                title="@option.Label"
                                @onclick="() => SelectIcon(option.Value)">
                            @option.Value
                        </button>
                    }
                </div>
            }
            <div class="form-text">Choose a symbol that makes this list easy to spot.</div>
            <ValidationMessage For="@(() => Model.Icon)" />
        </div>

        <div class="mb-3 form-check">
            <InputCheckbox id="isCollaborative" class="form-check-input" @bind-Value="@Model!.IsCollaborative" />
            <label class="form-check-label" for="isCollaborative">
                Is Collaborative? (allows other invited members to add items to your list)
            </label>
            <ValidationMessage For="@(() => Model.IsCollaborative)" />
        </div>

        <fieldset class="mb-4">
            <legend class="form-label h6 mb-3"><OpenWishIcon Name="lock" /> Who can see this wishlist?</legend>
            <div class="visibility-options" role="radiogroup" aria-label="Wishlist visibility">
                <div class="visibility-option @(!Model.IsPrivate && !Model.IsFriendsOnly ? "selected" : "")" 
                     role="radio"
                     aria-checked="@(!Model.IsPrivate && !Model.IsFriendsOnly ? "true" : "false")"
                     tabindex="0"
                     @onclick="@(() => SetVisibility(false, false))"
                     @onkeydown="@((e) => HandleVisibilityKeyDown(e, false, false))">
                    <div class="visibility-icon"><OpenWishIcon Name="people" /></div>
                    <div class="visibility-content">
                        <div class="visibility-title">All Friends</div>
                        <div class="visibility-desc">Everyone in your friend list can see this wishlist</div>
                    </div>
                    <div class="visibility-check">
                        @if (!Model.IsPrivate && !Model.IsFriendsOnly)
                        {
                            <OpenWishIcon Name="check-circle-fill" Class="text-success" />
                        }
                    </div>
                </div>
                <div class="visibility-option @(!Model.IsPrivate && Model.IsFriendsOnly ? "selected" : "")" 
                     role="radio"
                     aria-checked="@(!Model.IsPrivate && Model.IsFriendsOnly ? "true" : "false")"
                     tabindex="0"
                     @onclick="@(() => SetVisibility(false, true))"
                     @onkeydown="@((e) => HandleVisibilityKeyDown(e, false, true))">
                    <div class="visibility-icon"><OpenWishIcon Name="person-check" /></div>
                    <div class="visibility-content">
                        <div class="visibility-title">Specific Friends Only</div>
                        <div class="visibility-desc">Hand-pick who gets to see your wishlist</div>
                    </div>
                    <div class="visibility-check">
                        @if (!Model.IsPrivate && Model.IsFriendsOnly)
                        {
                            <OpenWishIcon Name="check-circle-fill" Class="text-success" />
                        }
                    </div>
                </div>
                <div class="visibility-option @(Model.IsPrivate ? "selected" : "")" 
                     role="radio"
                     aria-checked="@(Model.IsPrivate ? "true" : "false")"
                     tabindex="0"
                     @onclick="@(() => SetVisibility(true, false))"
                     @onkeydown="@((e) => HandleVisibilityKeyDown(e, true, false))">
                    <div class="visibility-icon"><OpenWishIcon Name="lock" /></div>
                    <div class="visibility-content">
                        <div class="visibility-title">Private</div>
                        <div class="visibility-desc">Only you can see this wishlist.</div>
                    </div>
                    <div class="visibility-check">
                        @if (Model.IsPrivate)
                        {
                            <OpenWishIcon Name="check-circle-fill" Class="text-success" />
                        }
                    </div>
                </div>
            </div>
        </fieldset>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@(Model.Id == 0 ? "Create" : "Update") Wishlist</button>
            @if (OnCancel.HasDelegate)
            {
                <button type="button" class="btn btn-outline-secondary" @onclick="HandleCancel">Cancel</button>
            }
        </div>
    </EditForm>
}
else
{
    <p>Loading form...</p>
}


@code {
    [Parameter] public WishlistModel? Model { get; set; }
    [Parameter] public EventCallback<WishlistModel> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool AutoFocusName { get; set; }

    private static readonly (string Value, string Label)[] IconOptions =
    [
        ("🎁", "Wrapped gift"),
        ("✨", "Sparkles"),
        ("⭐", "Star"),
        ("❤️", "Heart"),
        ("🎂", "Birthday cake"),
        ("🎄", "Christmas tree"),
        ("🏠", "Home"),
        ("✈️", "Travel"),
        ("📚", "Books"),
        ("🎮", "Games"),
        ("🎵", "Music"),
        ("🏕️", "Outdoors"),
        ("🍳", "Cooking"),
        ("👕", "Clothing"),
        ("🧸", "Toys"),
        ("💡", "Ideas")
    ];

    private bool _showIconPicker;

    private void ToggleIconPicker() => _showIconPicker = !_showIconPicker;

    private void SelectIcon(string icon)
    {
        Model!.Icon = icon;
        _showIconPicker = false;
    }

    private void ClearIcon()
    {
        Model!.Icon = null;
        _showIconPicker = false;
    }

    private void SetVisibility(bool isPrivate, bool isFriendsOnly)
    {
        if (Model is not null)
        {
            Model.IsPrivate = isPrivate;
            Model.IsFriendsOnly = isFriendsOnly;
        }
    }

    private void HandleVisibilityKeyDown(KeyboardEventArgs e, bool isPrivate, bool isFriendsOnly)
    {
        if (e.Key is " " or "Enter")
        {
            SetVisibility(isPrivate, isFriendsOnly);
        }
    }

    private async Task HandleSubmit()
    {
        if (OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync(Model);
        }
    }

    private async Task HandleCancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }
}