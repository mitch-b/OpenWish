@if (Groups.Count > 0)
{
    <div class="gift-preview">
        <h4 class="h6">@Heading</h4>
        @foreach (var group in Groups)
        {
            @if (!IncludeOwnerHistory)
            {
                <p class="fw-semibold mb-1">@group.Name</p>
            }
            <ul class="mb-2">
                @foreach (var item in group.Items)
                {
                    <li>@item.Name</li>
                }
            </ul>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<WishlistModel> Wishlists { get; set; } = [];
    [Parameter, EditorRequired] public string Heading { get; set; } = "";
    [Parameter] public bool IncludeOwnerHistory { get; set; }

    private IReadOnlyList<(string Name, WishlistItemModel[] Items)> Groups { get; set; } = [];

    protected override void OnParametersSet()
    {
        Groups = Wishlists
            .Select(list => (list.Name, Items: (IncludeOwnerHistory
                ? list.Items.Concat(list.ReceivedItems).Concat(list.ArchivedItems)
                : list.Items).ToArray()))
            .Where(group => group.Items.Length > 0)
            .ToArray();
    }
}
