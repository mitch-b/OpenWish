@attribute [Authorize]
@page "/wishlists/{WishlistId}/items/new"

@using OpenWish.Shared.Products
@using OpenWish.Web.Client.Components.Wishlist

@inject IWishlistService WishlistService
@inject NavigationManager NavigationManager
@inject ILogger<AddItem> Logger

@rendermode InteractiveAuto

<PageTitle>Add an item</PageTitle>

<div class="container page-shell">
    <PageHeader Title="Add an item"
                Description="Save the details you know now. You can refine this gift idea later.">
        <Actions>
            <a href="/wishlists/@WishlistId" class="btn btn-outline-secondary">
                <OpenWishIcon Name="arrow-left" /> Back to wishlist
            </a>
        </Actions>
    </PageHeader>
    <div class="row">
        <div class="col-lg-8">
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }
        <WishlistItemForm Model="@_item"
                          OnSubmit="@HandleSubmit"
                          OnCancel="@HandleCancel"
                          AutoFocusImport="true"
                          InitialImportLink="@_initialImportLink"
                          IsSubmitting="@_isSubmitting" />
        </div>
    </div>
</div>


@code {
    [Parameter] public string WishlistId { get; set; } = string.Empty;
    private readonly WishlistItemModel _item = new() { PublicId = Guid.NewGuid().ToString() };
    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _initialImportLink;
    private bool _captureApplied;

    // Filled by the share page, the "Add to OpenWish" bookmarklet, or the installed app's share target.
    [SupplyParameterFromQuery(Name = "url")] public string? SharedUrl { get; set; }
    [SupplyParameterFromQuery(Name = "text")] public string? SharedText { get; set; }
    [SupplyParameterFromQuery(Name = "title")] public string? SharedTitle { get; set; }
    [SupplyParameterFromQuery(Name = "description")] public string? SharedDescription { get; set; }
    [SupplyParameterFromQuery(Name = "price")] public string? SharedPrice { get; set; }
    [SupplyParameterFromQuery(Name = "image")] public string? SharedImage { get; set; }

    protected override void OnParametersSet()
    {
        if (_captureApplied)
        {
            return;
        }

        _captureApplied = true;
        var capture = ProductCapture.FromQuery(SharedUrl, SharedText, SharedTitle, SharedDescription, SharedPrice, SharedImage);
        capture.ApplyTo(_item);
        _initialImportLink = capture.Link?.AbsoluteUri;
    }

    private async Task HandleSubmit(WishlistItemModel item)
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        StateHasChanged();
        await Task.Yield();

        try
        {
            await WishlistService.AddItemToWishlistByPublicIdAsync(WishlistId, item);
            NavigationManager.NavigateTo($"/wishlists/{WishlistId}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add an item to wishlist {WishlistPublicId}", WishlistId);
            _errorMessage = "We couldn't add this item. Review the details and try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void HandleCancel()
    {
        if (_isSubmitting)
        {
            return;
        }

        NavigationManager.NavigateTo($"/wishlists/{WishlistId}");
    }
}